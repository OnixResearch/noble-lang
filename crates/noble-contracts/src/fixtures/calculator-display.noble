    signature ascii_fraction_scan_finish_stage forall<S:stack>
        [ S result@1.Result<ActiveDigit,Unit>
          -- S result@1.Result<Pair<AsciiFractionRoute,Bool>,Unit> ! pure ]
    export ascii_fraction_scan_finish_stage
    def ascii_fraction_scan_finish_stage [
        [ ActiveDigit.into unpair
          [ pair
            dup unpair swap drop FractionCompareCursor.into
            unpair drop false calc_bits@1.should_continue_bits
            [ drop unit result@1.Result.Err ]
            [ dup unpair swap drop FractionCompareCursor.into
              unpair swap drop 0 i64.cmp -1 =
              [ unpair drop
                FractionDigitCursor.into unpair
                unpair fraction_digit_collect unpair
                [ [ unpair ] dip
                  pair FractionAsciiActive.Running FractionAsciiState.Pending
                  pair FractionAsciiCursor.new AsciiFractionRoute.Ready ] dip
                pair result@1.Result.Ok ]
              [ drop unit result@1.Result.Err ] if ] if ]
          [ drop drop unit result@1.Result.Err ]
          FractionDigitScan.match ]
        [ result@1.Result.Err ]
        result@1.Result.match
    ]

    # Dip the retained State aside so the finish specialization and its
    # quotations never carry State on both sides of a Program type.
    signature ascii_fraction_scan_finish_with_state forall<S:stack>
        [ S calc_env@1.State result@1.Result<ActiveDigit,Unit>
          -- S Pair<calc_env@1.State,result@1.Result<Pair<AsciiFractionRoute,Bool>,Unit>> ! pure ]
    export ascii_fraction_scan_finish_with_state
    def ascii_fraction_scan_finish_with_state [
        swap [ ascii_fraction_scan_finish_stage ] dip swap pair
