            fraction_active_subtracting ]
          FractionDigitScan.match ]
        [ result@1.Result.Err false pair ]
        result@1.Result.match
    ]

    signature ascii_fraction_scan_subtract_finish_stage forall<S:stack>
        [ S result@1.Result<ActiveDigit,Unit>
          -- S Pair<result@1.Result<ActiveDigit,Unit>,Bool> ! pure ]
    export ascii_fraction_scan_subtract_finish_stage
    def ascii_fraction_scan_subtract_finish_stage [
        [ ActiveDigit.into unpair
          [ pair true fraction_active_comparing ]
          [ pair fraction_subtract_finish true fraction_active_comparing ]
          FractionDigitScan.match ]
        [ result@1.Result.Err false pair ]
