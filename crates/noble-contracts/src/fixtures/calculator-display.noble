    signature ascii_fraction_scan_done_signal forall<S:stack>
        [ S result@1.Result<Pair<AsciiFractionRoute,Bool>,Unit>
          -- S Pair<result@1.Result<AsciiFractionRoute,Unit>,Bool> ! pure ]
    export ascii_fraction_scan_done_signal
    def ascii_fraction_scan_done_signal [
        [ unpair [ result@1.Result.Ok ] dip pair ]
        [ result@1.Result.Err false pair ]
        result@1.Result.match
    ]
    signature ascii_fraction_scan_done_with_state forall<S:stack>
        [ S Pair<calc_env@1.State,result@1.Result<Pair<AsciiFractionRoute,Bool>,Unit>>
          -- S Pair<calc_env@1.State,Pair<result@1.Result<AsciiFractionRoute,Unit>,Bool>> ! pure ]
    export ascii_fraction_scan_done_with_state
    def ascii_fraction_scan_done_with_state [
        unpair swap [ ascii_fraction_scan_done_signal ] dip swap pair
    ]

    # The guest Bool reports whether the Result was Ok. On Err the route is
    # the guest Failed route with false; the host then refuses as an internal
    # failure and never formats it, so no cursor is ever invented.
    signature ascii_fraction_result_route_with_state forall<S:stack>
        [ S Pair<calc_env@1.State,result@1.Result<AsciiFractionRoute,Unit>>
          -- S Pair<calc_env@1.State,Pair<AsciiFractionRoute,Bool>> ! pure ]
    export ascii_fraction_result_route_with_state
    def ascii_fraction_result_route_with_state [
        unpair swap
        [ [ true pair ] [ AsciiFractionRoute.Failed false pair ] result@1.Result.match ] dip
        swap pair
    ]

    # Plain-route digit roots keep the retained State dipped aside.
    signature ascii_fraction_width_with_state forall<S:stack>
        [ S Pair<calc_env@1.State,AsciiFractionRoute>
          -- S Pair<calc_env@1.State,Pair<AsciiFractionRoute,Bool>> ! pure ]
    export ascii_fraction_width_with_state
    def ascii_fraction_width_with_state [
        unpair swap [ ascii_fraction_width_stage ] dip swap pair
