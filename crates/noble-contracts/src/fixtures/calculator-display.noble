    signature ascii_fraction_multiply_with_state forall<S:stack>
        [ S Pair<calc_env@1.State,AsciiFractionRoute>
          -- S Pair<calc_env@1.State,FractionProductRoute> ! pure ]
    export ascii_fraction_multiply_with_state
    def ascii_fraction_multiply_with_state [
        unpair swap [ ascii_fraction_multiply_stage ] dip swap pair
    ]


    signature fraction_subtract_bit forall<S:stack>
        [ S Pair<FractionDigitCursor,FractionSubtractCursor>
          -- S Pair<FractionDigitCursor,FractionSubtractCursor> ! pure ]
    export fraction_subtract_bit
    def fraction_subtract_bit [
        unpair FractionSubtractCursor.into
        unpair [ calc_bits@1.pop_two ] dip [ unpair ] dip
        [ swap ] dip swap unpair
        [ swap ] dip swap unpair
        [ [ 1 ] [ 0 ] if swap [ 1 ] [ 0 ] if
          [ swap ] dip swap [ 1 ] [ 0 ] if
          swap [ swap ] dip swap
          [ - ] dip -
          dup 0 i64.cmp -1 =
          [ 2 + true ] [ false ] if
          [ 1 = ] dip ] dip
        [ swap ] dip swap swap cons pair
        pair FractionSubtractCursor.new pair
    ]

    signature fraction_subtract_finish forall<S:stack>
        [ S Pair<FractionDigitCursor,FractionSubtractCursor>
          -- S Pair<FractionDigitCursor,FractionCompareCursor> ! pure ]
    def fraction_subtract_finish [
        # Normalize the remainder bits with the digit cursor parked above them.
        unpair swap
        [ FractionSubtractCursor.into
          unpair swap drop unpair swap drop
          calc_bits@1.reverse_bits calc_bits@1.trim_bits ] dip
        swap
        [ FractionDigitCursor.into unpair ] dip
        [ unpair ] dip swap unpair swap drop
        unpair 1 + pair pair pair pair FractionDigitCursor.new
        fraction_compare_start
    ]


    signature fraction_ascii_complete forall<S:stack>
        [ S Pair<Pair<Bool,List<I64>>,FractionBuild>
          -- S FractionAsciiRunning ! pure ]
    def fraction_ascii_complete [
        unpair
        [ dup unpair drop unpair drop calc_bits@1.bits_empty
          [ unpair [ unpair ] dip unpair unpair drop
            [ [ drop ] dip ] dip [ [ drop ] dip ] dip
            [ dup [ true ] [ drop drop false ] list.case ] dip swap
            [ [ drop ] dip ]
            [ [ calc_bits@1.reverse_i64 ] dip
              [ [ unpair ] dip ] dip
              [ 46 swap cons append_ascii ] dip
              [ pair ] dip ] if
            [ unpair
              swap [ 45 swap cons ] [ ] if
              DisplayAscii.new ] dip
            pair FractionAsciiCompleted.Ready FractionAsciiRunning.Completed ]
          [ FractionBuild.Running pair FractionAsciiRunning.Unfinished ] if ]
        [ swap drop FractionAsciiCompleted.Denied FractionAsciiRunning.Completed ]
        FractionBuild.match
    ]

    signature fraction_ascii_finish_state forall<S:stack>
        [ S FractionAsciiState -- S FractionAsciiResolved ! pure ]
    def fraction_ascii_finish_state [
        [ FractionAsciiCompleted.Ready FractionAsciiResolved.Completed ]
        [ [ fraction_ascii_complete
            [ FractionAsciiResolved.Completed ]
            [ FractionAsciiActive.Running FractionAsciiState.Pending
              FractionAsciiResolved.Unfinished ]
            FractionAsciiRunning.match ]
          [ FractionAsciiActive.Checked FractionAsciiState.Pending
            FractionAsciiResolved.Unfinished ]
          FractionAsciiActive.match ]
        FractionAsciiState.match
    ]

    signature ascii_fraction_finish_stage forall<S:stack>
        [ S AsciiFractionRoute -- S FractionAsciiFinal ! pure ]
    export ascii_fraction_finish_stage
    def ascii_fraction_finish_stage [
        [ AsciiFractionRoute.Failed FractionAsciiFinal.Unfinished ]
        [ FractionAsciiCursor.into unpair fraction_ascii_finish_state
          [ [ pair FractionAsciiOutcome.Ready ]
            [ pair FractionAsciiOutcome.Denied ]
            FractionAsciiCompleted.match FractionAsciiFinal.Complete ]
          [ pair FractionAsciiCursor.new AsciiFractionRoute.Ready
            FractionAsciiFinal.Unfinished ]
          FractionAsciiResolved.match ]
        AsciiFractionRoute.match
    ]

    signature finish_text forall<S:stack>
        [ S DisplayAscii num@1.Budget
          -- S result@1.Result<Pair<Text,num@1.Budget>,calc_errors@1.NumericError> ! pure ]
    export finish_text
    def finish_text [
        [ DisplayAscii.into text.from-ascii ] dip swap
        [ pair result@1.Result.Ok ]
        [ drop drop output_limit ] if
    ]


    signature decimal_bytes_step forall<S:stack>
        [ S Pair<List<calc_big@1.BigInt>,List<I64>>
          -- S Pair<List<calc_big@1.BigInt>,List<I64>> Bool ! pure ]
    def decimal_bytes_step [
        unpair swap
        [ nil swap pair false ]
        [ [ big_decimal_bytes swap
            [ ] [ cons 47 swap cons append_ascii ] list.case ] dip
          swap pair true ]
        list.case
    ]
]
