    signature decimal_digit_step forall<S:stack>
        [ S Pair<List<Bool>,List<I64>>
          -- S Pair<List<Bool>,List<I64>> Bool ! pure ]
    def decimal_digit_step [
        unpair swap dup calc_bits@1.bits_empty
        [ swap pair false ]
        [ divide_ten_bits unpair 48 +
          calc_bits@1.rot cons pair true ] if
    ]

    signature decimal_digit_bytes forall<S:stack>
        [ S List<Bool> -- S List<I64> ! pure ]
    def decimal_digit_bytes [
        dup calc_bits@1.bits_empty
        [ drop 48 nil cons ]
        [ nil pair [ decimal_digit_step ] iterate
          unpair swap drop ] if
    ]

    signature big_decimal_bytes forall<S:stack>
        [ S calc_big@1.BigInt -- S List<I64> ! pure ]
    def big_decimal_bytes [
        dup calc_big@1.big_sign swap calc_big@1.big_bits swap
        [ decimal_digit_bytes ] dip
        [ 45 swap cons ] [ ] if
    ]

    signature append_ascii forall<S:stack>
        [ S List<I64> List<I64> -- S List<I64> ! pure ]
    def append_ascii [
        [ calc_bits@1.reverse_i64 ] dip pair
        [ unpair swap
          [ nil swap pair false ]
          [ swap [ swap ] dip swap cons pair true ] list.case
        ] iterate
        unpair swap drop
    ]

    signature rat_decimal_bytes forall<S:stack>
        [ S num@1.Rat -- S List<I64> ! pure ]
    def rat_decimal_bytes [
        num@1.rat_parts unpair dup calc_big@1.big_mag_one_p
        [ drop nil cons ]
        [ swap nil cons cons ] if
        # Every call site is compiled as its own definition, so both parts go
        # through one big_decimal_bytes site: the denominator (if any) first,
        # then the numerator, prefixed onto "/" and the denominator bytes.
        nil pair [ decimal_bytes_step ] iterate
        unpair swap drop
    ]
    signature factor_two_step forall<S:stack>
        [ S List<Bool> -- S List<Bool> Bool ! pure ]
    def factor_two_step [
        # Little-endian normalized bits divide by two by dropping one zero
        # low bit; an odd bit keeps the original denominator.
        dup
        [ false ]
        [ swap [ drop false ] [ swap drop true ] if ]
        list.case
    ]

    signature five_digit forall<S:stack>
        [ S Pair<I64,List<Bool>> Bool -- S Pair<I64,List<Bool>> ! pure ]
    def five_digit [
        [ unpair ] dip [ swap ] dip
        [ 1 ] [ 0 ] if
        [ 2 * ] dip +
        dup 5 i64.cmp -1 =
        [ swap false swap cons pair ]
        [ 5 - swap true swap cons pair ] if
    ]

    signature divide_five_step forall<S:stack>
        [ S Pair<List<Bool>,Pair<I64,List<Bool>>>
          -- S Pair<List<Bool>,Pair<I64,List<Bool>>> Bool ! pure ]
    def divide_five_step [
        unpair swap
        [ nil swap pair false ]
        [ [ five_digit ] dip swap pair true ] list.case
    ]

    signature ten_digit forall<S:stack>
        [ S Pair<I64,List<Bool>> Bool -- S Pair<I64,List<Bool>> ! pure ]
    def ten_digit [
        [ unpair ] dip [ swap ] dip
        [ 1 ] [ 0 ] if
        [ 2 * ] dip +
        dup 10 i64.cmp -1 =
        [ swap false swap cons pair ]
        [ 10 - swap true swap cons pair ] if
    ]

    signature divide_ten_step forall<S:stack>
        [ S Pair<List<Bool>,Pair<I64,List<Bool>>>
          -- S Pair<List<Bool>,Pair<I64,List<Bool>>> Bool ! pure ]
    def divide_ten_step [
        unpair swap
        [ nil swap pair false ]
        [ [ ten_digit ] dip swap pair true ] list.case
    ]

    # Divide magnitude by ten with a bounded 0..9 remainder, never
    # materializing a variable-divisor quotient or widened power of ten.
    signature divide_ten_bits forall<S:stack>
        [ S List<Bool> -- S Pair<List<Bool>,I64> ! pure ]
    def divide_ten_bits [
        calc_bits@1.reverse_bits
        0 nil pair pair [ divide_ten_step ] iterate
        unpair swap drop unpair swap
        [ calc_bits@1.trim_bits ] dip pair
    ]

    # For a k-bit remainder, 10*r has either k+3 or k+4 bits.  The boundary
    # between them is (4/5)*2^k, whose first k binary digits are 1100 repeated.
    # Compare those digits from low to high: a more significant difference
    # replaces an earlier one.  This scans the original bits without allocating
    # a widened intermediate merely to decide whether that intermediate fits.
    signature pattern_bit_compare forall<S:stack>
        [ S Bool Bool -- S I64 ! pure ]
    def pattern_bit_compare [
        pair dup unpair calc_bits@1.bool_equal
        [ drop 0 ]
        [ unpair
          [ drop -1 ] [ drop 1 ] if ] if
    ]

    signature pattern_phase_compare forall<S:stack>
        [ S I64 Bool -- S Pair<I64,I64> ! pure ]
    def pattern_phase_compare [
        [ dup ] dip swap 2 i64.cmp -1 =
        [ true ] [ false ] if
        pattern_bit_compare
        [ dup 0 = [ drop 3 ] [ 1 - ] if ] dip pair
    ]

    signature pattern_update forall<S:stack>
        [ S Pair<I64,I64> Bool -- S Pair<I64,I64> ! pure ]
    def pattern_update [
        [ unpair ] dip [ swap ] dip
        pattern_phase_compare unpair
        calc_bits@1.rot swap
        dup 0 =
        [ drop pair ]
        [ swap drop pair ] if
    ]

    signature pattern_step forall<S:stack>
        [ S Pair<List<Bool>,Pair<I64,I64>>
          -- S Pair<List<Bool>,Pair<I64,I64>> Bool ! pure ]
    def pattern_step [
        unpair swap
        [ nil swap pair false ]
        [ [ pattern_update ] dip swap pair true ] list.case
    ]

    signature ten_product_width forall<S:stack>
        [ S List<Bool> -- S I64 ! pure ]
    def ten_product_width [
        dup calc_bits@1.bit_count
        dup 1 - 4 i64.div-rem drop swap drop
        0 pair
        calc_bits@1.rot swap pair
        [ pattern_step ] iterate
        unpair swap drop unpair swap drop
        0 i64.cmp 1 =
        [ 4 + ] [ 3 + ] if
    ]

    # Measure only a nonzero remainder's exact next width, before its separate
    # checked admission and only then the multiplication by ten.
    signature fraction_measure_width forall<S:stack>
        [ S FractionBuild -- S Pair<FractionBuild,Bool> ! pure ]
    def fraction_measure_width [
        [ dup unpair drop unpair drop calc_bits@1.bits_empty
          [ FractionBuild.Running false pair ]
          [ dup unpair drop unpair drop ten_product_width
            [ unpair [ unpair ] dip unpair unpair ] dip
            [ drop ] dip FractionWidth.Ready
            pair pair [ pair ] dip pair
            FractionBuild.Running true pair ] if ]
        [ FractionBuild.Denied false pair ]
        FractionBuild.match
    ]

    signature fraction_admit_unpack forall<S:stack>
        [ S FractionAdmitCarry num@1.Budget -- S FractionAdmitChecked ! pure ]
    def fraction_admit_unpack [
        pair FractionAdmitChecked.new
    ]

    signature fraction_admit_ready forall<S:stack>
        [ S List<Bool> List<Bool> List<I64> num@1.Budget I64
          -- S Pair<FractionAdmitChoice,Bool> ! pure ]
    def fraction_admit_ready [
        [ [ [ pair ] dip pair FractionAdmitCarry.new ] dip ] dip
        calc_bits@1.rot [ num@1.admit_bits ] dip
        [ [ FractionAdmitDecision.Allowed ]
          [ FractionAdmitDecision.Denied ]
          result@1.Result.match ] dip
        swap
        [ fraction_admit_unpack FractionAdmitChoice.Checked true pair ]
        [ swap drop FractionBuild.Denied
          FractionAdmitChoice.Running false pair ]
        FractionAdmitDecision.match
    ]

    signature fraction_admit_issue forall<S:stack>
        [ S FractionBuild -- S Pair<FractionAdmitChoice,Bool> ! pure ]
    def fraction_admit_issue [
        [ dup unpair drop unpair drop calc_bits@1.bits_empty
          [ FractionBuild.Running FractionAdmitChoice.Running false pair ]
          [ unpair [ unpair ] dip unpair
            unpair
            [ drop
              unit FractionWidth.Pending pair
              pair [ pair ] dip pair FractionBuild.Running
              FractionAdmitChoice.Running false pair ]
            [ fraction_admit_ready ]
            FractionWidth.match ] if ]
        [ FractionBuild.Denied FractionAdmitChoice.Running false pair ]
        FractionBuild.match
    ]

    signature fraction_admit_multiply forall<S:stack>
        [ S FractionAdmitChecked -- S FractionAdmitProduct ! pure ]
    def fraction_admit_multiply [
        FractionAdmitChecked.into unpair
        [ FractionAdmitCarry.into unpair [ unpair ] dip ] dip
        [ [ [ calc_bits@1.multiply_ten_bits ] dip ] dip ] dip
        [ [ pair ] dip pair FractionAdmitCarry.new ] dip
        pair FractionAdmitProduct.new
    ]

    signature fraction_digit_collect forall<S:stack>
        [ S Pair<List<I64>,num@1.Budget>
            Pair<List<Bool>,Pair<List<Bool>,I64>>
          -- S Pair<FractionBuild,Bool> ! pure ]
    def fraction_digit_collect [
        swap
        [ unpair unpair swap [ pair ] dip swap ] dip
        unpair
        [ [ unpair ] dip ] dip
        [ swap 48 + swap cons ] dip
        [ [ swap ] dip ] dip
        unit FractionWidth.Pending pair
        pair [ pair ] dip pair FractionBuild.Running true pair
    ]

    signature output_limit forall<S:stack>
        [ S -- S result@1.Result<Pair<Text,num@1.Budget>,calc_errors@1.NumericError> ! pure ]
    def output_limit [
        unit calc_errors@1.LimitIO.OutputSize
        calc_errors@1.LimitPrimary.IO
        calc_errors@1.LimitCategory.Primary
        calc_errors@1.NumericError.ResourceLimit result@1.Result.Err
    ]

    signature format_measure forall<S:stack>
        [ S num@1.Rat Bool num@1.Budget -- S FormatMeasured ! pure ]
    export format_measure
    def format_measure [
        [ pair DisplayPending.new ] dip
        [ dup DisplayPending.into unpair drop
          num@1.rat_total_width 2 + ] dip
        swap pair pair FormatMeasured.new
    ]

    signature format_admit_bits forall<S:stack>
        [ S FormatMeasured
          -- S result@1.Result<FormatBitsAdmitted,calc_errors@1.NumericError> ! pure ]
    export format_admit_bits
    def format_admit_bits [
        FormatMeasured.into unpair unpair dup
        [ num@1.admit_bits ] dip swap
        [ swap pair pair FormatBitsAdmitted.new result@1.Result.Ok ]
        [ [ drop ] dip swap drop result@1.Result.Err ]
        result@1.Result.match
    ]

    signature format_charge_work forall<S:stack>
        [ S FormatBitsAdmitted
          -- S result@1.Result<Pair<DisplayPending,num@1.Budget>,calc_errors@1.NumericError> ! pure ]
    export format_charge_work
    def format_charge_work [
        FormatBitsAdmitted.into unpair unpair
        dup * 100 * calc_bits@1.rot [ num@1.charge_work ] dip swap
        [ pair result@1.Result.Ok ]
        [ swap drop result@1.Result.Err ]
        result@1.Result.match
    ]


    # Avoid factoring an unrequested finite mode, and retain the powers of 2
    # for the next checked phase instead of factoring this denominator twice.
    signature factor_two_phase forall<S:stack>
        [ S DisplayPending -- S FactorTwoRoute ! pure ]
    export factor_two_phase
    def factor_two_phase [
        DisplayPending.into unpair
        [ dup num@1.rat_parts unpair swap drop calc_big@1.big_bits
          0 pair [ factor_two_count_step ] iterate
          pair FactorTwoRoute.Pending ]
        [ FractionPending.new FactorTwoRoute.Fraction ] if
    ]

    signature five_cursor_one forall<S:stack>
        [ S FiveCursor -- S Bool ! pure ]
    def five_cursor_one [
        FiveCursor.into unpair swap drop unpair swap drop unpair swap drop
    ]

    signature bits_one forall<S:stack>
        [ S List<Bool> -- S Bool ! pure ]
    def bits_one [
        [ false ]
        [ calc_bits@1.bits_empty swap
          [ ] [ drop false ] if ] list.case
    ]

    signature factor_five_seed forall<S:stack>
        [ S FactorTwoRoute -- S FactorFiveSeed ! pure ]
    export factor_five_seed
    def factor_five_seed [
        [ FactorFiveSeed.Fraction ]
        [ unpair unpair
          [ dup bits_one ] dip
          [ swap ] dip calc_bits@1.rot
          pair pair pair FiveSeed.new FactorFiveSeed.Pending ]
        FactorTwoRoute.match
    ]

    signature factor_five_begin forall<S:stack>
        [ S FactorFiveSeed -- S Pair<FactorFiveRoute,Bool> ! pure ]
    export factor_five_begin
    def factor_five_begin [
        [ FactorFiveRoute.Fraction false pair ]
        [ FiveSeed.into unpair unpair unpair
          [ swap ] dip
          [ calc_bits@1.reverse_bits ] dip
          [ [ pair ] dip ] dip
          [ 0 nil pair pair ] dip
          0 swap pair pair pair FiveCursor.new
          dup five_cursor_one calc_bits@1.bool_not
          [ FactorFiveRoute.Pending ] dip pair ]
        FactorFiveSeed.match
    ]

    # The quotient bit fold has no nested iterate.  The returned Bool means
    # that a source bit was consumed and the caller should tick again.
    signature factor_five_tick forall<S:stack>
        [ S FactorFiveRoute -- S Pair<FactorFiveRoute,Bool> ! pure ]
    export factor_five_tick
    def factor_five_tick [
        [ FactorFiveRoute.Fraction false pair ]
        [ FiveCursor.into unpair unpair
          [ divide_five_step ] dip swap
          [ pair ] dip
          [ pair FiveCursor.new FactorFiveRoute.Pending ] dip pair ]
        FactorFiveRoute.match
    ]

    signature five_cursor_remainder_zero forall<S:stack>
        [ S FiveCursor -- S Bool ! pure ]
    def five_cursor_remainder_zero [
        FiveCursor.into unpair unpair
        calc_bits@1.rot drop drop
        unpair swap drop unpair drop 0 =
    ]

    signature factor_five_round_check forall<S:stack>
        [ S FactorFiveRoute -- S FactorFiveRound ! pure ]
    export factor_five_round_check
    def factor_five_round_check [
        [ FactorFiveRoute.Fraction FactorFiveRound.Done ]
        [ dup five_cursor_remainder_zero
          [ FactorFiveRound.Exact ]
          [ FactorFiveRoute.Pending FactorFiveRound.Done ] if ]
        FactorFiveRoute.match
    ]

    signature factor_five_round_trim forall<S:stack>
        [ S FactorFiveRound -- S FactorFiveMeasured ! pure ]
    export factor_five_round_trim
    def factor_five_round_trim [
        [ FactorFiveMeasured.Done ]
        [ FiveCursor.into unpair unpair
          [ unpair swap drop unpair swap drop ] dip
          unpair drop
          [ calc_bits@1.trim_bits ] dip
          pair pair FiveRoundMeasured.new FactorFiveMeasured.Exact ]
        FactorFiveRound.match
    ]

    signature factor_five_round_compare forall<S:stack>
        [ S FactorFiveMeasured -- S FactorFiveReady ! pure ]
    export factor_five_round_compare
    def factor_five_round_compare [
        [ FactorFiveReady.Done ]
        [ FiveRoundMeasured.into unpair unpair
          [ dup bits_one ] dip
          [ swap ] dip calc_bits@1.rot
          pair pair pair FiveRoundReady.new FactorFiveReady.Exact ]
        FactorFiveMeasured.match
    ]

    # The Bool schedules another bit scan only when the exact quotient is not
    # yet one.  The quotient, count and certificate remain in the guest cursor.
    signature factor_five_round_advance forall<S:stack>
        [ S FactorFiveReady -- S Pair<FactorFiveRoute,Bool> ! pure ]
    export factor_five_round_advance
    def factor_five_round_advance [
        [ false pair ]
