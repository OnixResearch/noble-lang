    signature call_body_finish_guest forall<S:stack>
        [ S calc_env@1.State
          -- S calc_env@1.State Sum<Pair<Pair<Text,List<Pair<I64,Pair<I64,I64>>>>,I64>,Unit> ! pure ]
    export call_body_finish_guest
    def call_body_finish_guest [
        dup calc_env@1.state_functions swap [ call_stash_peek ] dip swap
        [ swap
          [ unpair
            [ dup calc_env@1.function_body unpair [ nil ] [ swap drop ] list.case pair ] dip
            unpair swap drop unpair swap drop pair inl ] dip
          rot calc_env@1.lexical_scope swap ]
        [ inr ]
        case
    ]

    # The caller resumes with its own Text and tokens over exactly one
    # result value pushed above its values; anything else is refused.
    signature call_return_resume_guest forall<S:stack>
        [ S FrameHot Sum<Pair<Pair<Text,List<Pair<I64,Pair<I64,I64>>>>,I64>,Unit>
          -- S FrameHot Bool ! pure ]
    export call_return_resume_guest
    def call_return_resume_guest [
        [ swap
          [ dup eval_values call_list_count
            rot dup unpair swap drop rot swap 1 + =
            [ unpair drop swap eval_unpack
              [ [ drop drop ] dip ] dip
              pair swap unpair swap rot unpair eval_frame
              FrameHot.Active true ]
            [ drop FrameHot.Active false ]
            if ]
          [ FrameHot.Failed swap drop false ]
          FrameHot.match ]
        [ drop false ]
        case
    ]


    # Resolve a finished ASCII route without State or Bool on the stack. The
    # host runs calc_display@1.ascii_fraction_finish_stage and this word as
    # separate compiles under its parked Pair<State,Bool>; the result equals
    # format_ascii_finite's.
    signature format_ascii_final forall<S:stack>
        [ S calc_display@1.FractionAsciiFinal -- S result@1.Result<FormatAscii,Unit> ! pure ]
    export format_ascii_final
    def format_ascii_final [
        [ [ FormatAscii.Ready result@1.Result.Ok ]
          [ unpair swap dup numeric FormatAscii.Failed result@1.Result.Ok ]
          calc_display@1.FractionAsciiOutcome.match ]
        [ [ pending_unavailable FormatAscii.Failed result@1.Result.Ok ]
          [ drop unit result@1.Result.Err ]
          calc_display@1.AsciiFractionRoute.match ]
        calc_display@1.FractionAsciiFinal.match
    ]
]
