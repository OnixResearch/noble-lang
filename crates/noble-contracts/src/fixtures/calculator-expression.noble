    signature pending_token forall<S:stack>
        [ S Pending -- S Pair<I64,Pair<I64,I64>> ! pure ]
    def pending_token [ Pending.into unpair swap drop ]

    signature pending_frame forall<S:stack>
        [ S Pending -- S EvalFrame ! pure ]
    def pending_frame [ Pending.into unpair drop ]

    signature pending_budget forall<S:stack>
        [ S Pending -- S num@1.Budget ! pure ]
    def pending_budget [ pending_frame eval_budget ]

    signature pending_numeric forall<S:stack>
        [ S Pending calc_errors@1.NumericError -- S Diagnostic ! pure ]
    def pending_numeric [
        [ pending_token calc_lex@1.token_span unpair ] dip
        rot rot numeric
    ]

    signature eval_push_result forall<S:stack>
        [ S EvalFrame Pair<num@1.Rat,num@1.Budget> -- S FrameHot ! pure ]
    def eval_push_result [
        [ eval_unpack ] dip swap [ unpair ] dip drop
        rot rot swap cons swap eval_frame FrameHot.Active
    ]

    signature frame_push_result forall<S:stack>
        [ S FrameHot Pair<num@1.Rat,num@1.Budget>
          -- S FrameHot ! pure ]
    export frame_push_result
    def frame_push_result [
        swap
        [ swap eval_push_result ]
        [ [ drop ] dip FrameHot.Failed ]
        FrameHot.match
    ]

    signature eval_name forall<S:stack>
        [ S FrameHot result@1.Result<num@1.Rat,Unit>
          -- S Pair<FrameHot,Bool> ! pure ]
    export eval_name
    def eval_name [
        [ swap
          [ swap [ dup eval_budget ] dip
            swap pair eval_push_result ]
          [ [ drop ] dip FrameHot.Failed ]
          FrameHot.match
          true pair ]
        [ drop false pair ]
        result@1.Result.match
    ]

    # A failed environment lookup is a typed source-spanned diagnostic, not
    # a silently unchanged evaluation frame.
    signature frame_name_result_guest forall<S:stack>
        [ S FrameHot result@1.Result<num@1.Rat,calc_env@1.Failure>
          -- S FrameHot ! pure ]
    export frame_name_result_guest
    def frame_name_result_guest [
        [ swap
          [ swap [ dup eval_budget ] dip
            swap pair eval_push_result ]
          [ [ drop ] dip FrameHot.Failed ]
          FrameHot.match ]
        [ [ drop ] dip
          env_failure_diagnostic compact_diagnostic FrameHot.Failed ]
        result@1.Result.match
    ]

    signature frame_name_begin forall<S:stack>
        [ S Pair<FrameHot,TokenTake>
          -- S Pair<FrameHot,result@1.Result<calc_env@1.Name,Unit>> ! pure ]
    export frame_name_begin
    def frame_name_begin [
        unpair
        [ swap
          [ swap dup calc_lex@1.token_kind 10 =
            [ [ dup eval_text ] dip
              calc_env@1.name_from_token result@1.Result.Ok
              [ FrameHot.Active ] dip pair ]
            [ drop FrameHot.Active unit result@1.Result.Err pair ] if ]
          [ [ drop ] dip FrameHot.Failed
            unit result@1.Result.Err pair ]
          FrameHot.match ]
        [ drop unit result@1.Result.Err pair ]
        TokenTake.match
    ]

    # Begin a bounded guest environment lookup without inlining the whole
    # name comparison into a selected root retaining State and FrameHot.
    # Those two originals stay on separate stack cells while the guest
    # advances its source-bound VariableSearch through its finite stages.
    signature frame_name_lookup_begin_guest forall<S:stack>
        [ S calc_env@1.State
            Pair<FrameHot,result@1.Result<calc_env@1.Name,Unit>>
          -- S calc_env@1.State FrameHot
               result@1.Result<calc_env@1.VariableSearch,Unit> ! pure ]
    export frame_name_lookup_begin_guest
    def frame_name_lookup_begin_guest [
        unpair
        rot dup calc_env@1.state_variables rot
        calc_env@1.variable_lookup_begin
        rot swap
    ]

    # A genuinely missing name carries its source span through the guest
    # environment; a failed projection remains an infrastructure failure.
    signature frame_name_missing_guest forall<S:stack>
        [ S calc_env@1.State FrameHot
            result@1.Result<calc_env@1.Failure,Unit>
          -- S calc_env@1.State FrameHot Bool ! pure ]
    export frame_name_missing_guest
    def frame_name_missing_guest [
        [ swap drop env_failure_diagnostic
          compact_diagnostic FrameHot.Failed true ]
        [ drop false ]
        result@1.Result.match
    ]

    # A call token contains its parser-checked source name and arity. This
    # projection rejects bare identifiers and all arithmetic token kinds.
    signature frame_call_name_begin forall<S:stack>
        [ S Pair<FrameHot,TokenTake>
          -- S Pair<FrameHot,result@1.Result<Pair<calc_env@1.Name,I64>,Unit>> ! pure ]
    export frame_call_name_begin
    def frame_call_name_begin [
        unpair
        [ swap
          [ swap dup calc_lex@1.token_kind 100 i64.cmp -1 =
            [ drop FrameHot.Active unit result@1.Result.Err pair ]
            [ dup calc_lex@1.token_kind 100 -
              [ [ dup eval_text ] dip
                calc_env@1.name_from_token ] dip
              pair result@1.Result.Ok
              [ FrameHot.Active ] dip pair ] if ]
          [ [ drop ] dip FrameHot.Failed
            unit result@1.Result.Err pair ]
          FrameHot.match ]
        [ drop unit result@1.Result.Err pair ]
        TokenTake.match
    ]

    signature make_pending forall<S:stack>
        [ S TokenRun -- S PendingRun ! pure ]
    export make_pending
    def make_pending [
        [ unpair pair Pending.new PendingRun.Ready ]
        [ drop unit PendingRun.Failed ]
        TokenRun.match
    ]

    signature pending_unavailable forall<S:stack>
        [ S Unit -- S Diagnostic ! pure ]
    def pending_unavailable [
        drop 0 0 pair RuntimeFailure.Unsupported
        OtherFailure.Runtime Diagnostic.Other
    ]

    signature pending_binary_args forall<S:stack>
        [ S Pair<Pending,Pair<num@1.Rat,num@1.Rat>>
          -- S Pending num@1.Rat num@1.Rat num@1.Budget ! pure ]
