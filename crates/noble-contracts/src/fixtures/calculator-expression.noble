          swap FrameHot.Active swap ]
        [ FrameHot.Failed unit result@1.Result.Err ]
        FrameHot.match
    ]

    signature compact_diagnostic forall<S:stack>
        [ S Diagnostic -- S CompactDiagnostic ! pure ]
    export compact_diagnostic
    def compact_diagnostic [
        [ [ 0 swap pair ] [ 1 swap pair ] ParseFailure.match ]
          [ [ [ [ 2 swap pair ] [ 3 swap pair ] NameFailure.match ]
              [ [ 4 swap pair ] [ 5 swap pair ] DefinitionFailure.match ]
              ScopeFailure.match ]
            [ [ unpair [ calc_errors@1.numeric_code ] dip pair ]
              [ 6 swap pair ]
              RuntimeFailure.match ]
            OtherFailure.match ]
          Diagnostic.match
        unpair [ IssueTag.new ] dip pair CompactDiagnostic.new
    ]

