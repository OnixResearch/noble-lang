    signature frame_peek_kind forall<S:stack>
        [ S FrameHot -- S FrameHot I64 ! pure ]
    export frame_peek_kind
    def frame_peek_kind [
        [ EvalFrame.into unpair swap
          dup
          [ 0 ] [ drop calc_lex@1.token_kind ] list.case
          [ swap pair EvalFrame.new FrameHot.Active ] dip ]
        [ FrameHot.Failed 0 ]
        FrameHot.match
    ]

    signature frame_hot_source_budget forall<S:stack>
        [ S FrameHot
          -- S FrameHot result@1.Result<Pair<Text,num@1.Budget>,Unit> ! pure ]
    export frame_hot_source_budget
    def frame_hot_source_budget [
        [ dup eval_unpack
          [ drop ] dip
          [ swap drop ] dip
