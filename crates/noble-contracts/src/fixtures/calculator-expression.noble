          dup 0 =
          [ drop ParseFailure.SyntaxError Diagnostic.Parse result@1.Result.Ok ]
          [ dup 1 =
            [ drop ParseFailure.TrailingInput Diagnostic.Parse result@1.Result.Ok ]
            [ dup 2 =
              [ drop NameFailure.UnknownName ScopeFailure.Name
