    def eval_frame [ pair pair pair EvalFrame.new ]

    # Parsing is complete before a frame exists. Ready carries the original
    # Plan and Budget; Failed converts its source-bound ParseFault here.
    signature frame_from_parse forall<S:stack>
        [ S ParseFinish
          -- S FrameRun ! pure ]
    export frame_from_parse
    def frame_from_parse [
        [ unpair [ Plan.into unpair swap ] dip
          [ nil ] dip eval_frame FrameRun.Active ]
        [ parse_fault_diagnostic FrameRun.Failed ]
        ParseFinish.match
    ]


    signature eval_unpack forall<S:stack>
        [ S EvalFrame
          -- S List<Pair<I64,Pair<I64,I64>>> Text
             List<num@1.Rat> num@1.Budget ! pure ]
    def eval_unpack [ EvalFrame.into unpair unpair unpair ]

    # Consume the next program token directly from the one active frame.
    # Its payload leaves on a separate shallow carrier; no alternate copy of
    # EvalFrame is wrapped inside the pending token or on the host.
    signature frame_token_take forall<S:stack>
        [ S FrameHot -- S FrameHot TokenTake ! pure ]
    export frame_token_take
    def frame_token_take [
        [ EvalFrame.into unpair swap
          [ nil swap pair EvalFrame.new FrameHot.Active
            unit TokenTake.Done ]
          [ swap [ swap pair EvalFrame.new FrameHot.Active ] dip
            TokenTake.Ready ]
          list.case ]
        [ FrameHot.Failed unit TokenTake.Done ]
        FrameHot.match
    ]

    # Arithmetic consumes the one active frame and its original token together.
    # The literal path retains FrameHot instead; no second evaluator frame is
    # constructed or retained while an arithmetic Pending owns this one.
    signature frame_token_pending_guest forall<S:stack>
        [ S FrameHot TokenTake -- S TokenRun ! pure ]
    export frame_token_pending_guest
    def frame_token_pending_guest [
        [ swap
          [ swap pair TokenRun.Ready ]
          [ drop drop unit TokenRun.Failed ]
          FrameHot.match ]
        [ drop drop unit TokenRun.Failed ]
        TokenTake.match
    ]

    # Save only the checked original operator's source span, not a duplicate
    # evaluator frame. The Done arm is unreachable after frame_token_take's
    # host-checked readiness; its fallback is still the actual expression
    # Text extent, never a manufactured numeric operand or result.
    signature frame_operator_span_fallback_guest forall<S:stack>
        [ S FrameHot -- S FrameHot Pair<I64,I64> ! pure ]
    def frame_operator_span_fallback_guest [
        [ dup eval_text text.length swap drop 0 swap pair
          swap FrameHot.Active swap ]
        [ dup CompactDiagnostic.into unpair swap drop
          swap FrameHot.Failed swap ]
        FrameHot.match
    ]

    signature frame_operator_span_done_guest forall<S:stack>
        [ S FrameHot TokenTake Unit
          -- S FrameHot TokenTake Pair<I64,I64> ! pure ]
    def frame_operator_span_done_guest [
        drop swap frame_operator_span_fallback_guest rot swap
    ]

    signature frame_operator_span_guest forall<S:stack>
        [ S FrameHot TokenTake
          -- S Pair<I64,I64> FrameHot TokenTake ! pure ]
    export frame_operator_span_guest
    def frame_operator_span_guest [
        dup
        [ calc_lex@1.token_span ]
        [ frame_operator_span_done_guest ]
        TokenTake.match
        rot rot
    ]

    # Peek the next RPN action without exporting a second evaluator frame in
