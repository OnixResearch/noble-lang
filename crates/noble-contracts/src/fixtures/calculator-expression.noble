                  [ dup 5 =
                    [ drop DefinitionFailure.InvalidCall ScopeFailure.Definition
                      OtherFailure.Scope Diagnostic.Other result@1.Result.Ok ]
                    [ dup 6 =
                      [ drop RuntimeFailure.Unsupported
                        OtherFailure.Runtime Diagnostic.Other result@1.Result.Ok ]
                      [ drop drop unit result@1.Result.Err ]
