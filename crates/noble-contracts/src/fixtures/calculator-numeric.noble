    signature pow_mul_add_probe forall<S:stack>
        [ S PowMulActive -- S Pair<PowMulActive,Bool> ! pure ]
    export pow_mul_add_probe
    def pow_mul_add_probe [
        PowMulActive.into unpair
        calc_big@1.big_mul_add_probe unpair
        [ pair PowMulActive.new ] dip pair
    ]

    signature pow_mul_add_keep forall<S:stack>
        [ S PowMulActive -- S PowMulAdded ! pure ]
    export pow_mul_add_keep
    def pow_mul_add_keep [
        PowMulActive.into unpair
        calc_big@1.big_mul_add_keep pair PowMulAdded.new
    ]

    signature pow_mul_add_begin forall<S:stack>
        [ S PowMulActive -- S PowMulAddCursor ! pure ]
    export pow_mul_add_begin
    def pow_mul_add_begin [
        PowMulActive.into unpair
        calc_big@1.big_mul_add_begin pair PowMulAddCursor.new
    ]

    signature pow_mul_add_digit forall<S:stack>
        [ S PowMulAddCursor -- S PowMulAddCursor ! pure ]
    export pow_mul_add_digit
    def pow_mul_add_digit [
        PowMulAddCursor.into unpair
        calc_big@1.big_mul_add_digit pair PowMulAddCursor.new
    ]

    signature pow_mul_add_more forall<S:stack>
        [ S PowMulAddCursor -- S Pair<PowMulAddCursor,Bool> ! pure ]
    export pow_mul_add_more
    def pow_mul_add_more [
        PowMulAddCursor.into unpair
        calc_big@1.big_mul_add_more unpair
        [ pair PowMulAddCursor.new ] dip pair
    ]

    signature pow_mul_add_finish forall<S:stack>
        [ S PowMulAddCursor -- S PowMulAdded ! pure ]
    export pow_mul_add_finish
    def pow_mul_add_finish [
        PowMulAddCursor.into unpair
        calc_big@1.big_mul_add_finish pair PowMulAdded.new
    ]

    # True selects the addition finish; any other OpFirstC stage reports
    # false and is then rejected by op_first_stage_sum_finish_sub.
    signature op_first_stage_sum_route_probe forall<S:stack>
        [ S OpFirstC -- S result@1.Result<Pair<OpFirstC,Bool>,Unit> ! pure ]
    export op_first_stage_sum_route_probe
    def op_first_stage_sum_route_probe [
        dup OpFirstC.into unpair unpair [ drop drop ] dip
        [ drop false ]
        [ [ drop false ]
          [ [ drop true ] [ drop false ] calc_big@1.BigAddRoute.match ]
          case ]
        case
        pair result@1.Result.Ok
    ]

    signature op_first_stage_sum_finish_add forall<S:stack>
        [ S OpFirstC -- S result@1.Result<OpFirstC,Unit> ! pure ]
    export op_first_stage_sum_finish_add
    def op_first_stage_sum_finish_add [
        OpFirstC.into unpair unpair
        # Finish the add with the Budget/scale and partial products parked
        # above it, then rebuild the cursor beneath the outcome.
        [ pair ] dip swap
        [ [ drop unit result@1.Result.Err ]
          [ [ drop unit result@1.Result.Err ]
            [ [ calc_big@1.BigAddRoute.Add calc_big@1.big_add_finish_add ]
              [ drop unit result@1.Result.Err ]
              calc_big@1.BigAddRoute.match ]
            case ]
          case ] dip
        unpair calc_bits@1.rot
        [ dup [ swap cons ] dip
          inl pair pair OpFirstC.new result@1.Result.Ok ]
        [ drop drop drop unit result@1.Result.Err ]
        result@1.Result.match
    ]

    signature op_first_stage_sum_finish_sub forall<S:stack>
        [ S OpFirstC -- S result@1.Result<OpFirstC,Unit> ! pure ]
    export op_first_stage_sum_finish_sub
    def op_first_stage_sum_finish_sub [
        OpFirstC.into unpair unpair
        # As op_first_stage_sum_finish_add, for the subtraction route.
        [ pair ] dip swap
        [ [ drop unit result@1.Result.Err ]
          [ [ drop unit result@1.Result.Err ]
            [ [ drop unit result@1.Result.Err ]
              [ calc_big@1.BigAddRoute.Sub calc_big@1.big_add_finish_sub ]
              calc_big@1.BigAddRoute.match ]
            case ]
          case ] dip
        unpair calc_bits@1.rot
        [ dup [ swap cons ] dip
          inl pair pair OpFirstC.new result@1.Result.Ok ]
        [ drop drop drop unit result@1.Result.Err ]
        result@1.Result.match
    ]
]
