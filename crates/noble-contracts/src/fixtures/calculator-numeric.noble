    signature budget forall<S:stack>
        [ S I64 I64 I64 I64 I64 I64 I64
          -- S result@1.Result<Budget,calc_errors@1.NumericError> ! pure ]
    export budget
    def budget [
        nil cons cons cons cons cons cons cons Budget.new
        dup Budget.into
        true pair
        [ unpair swap
          [ nil swap pair false ]
          [ swap 0 i64.cmp -1 =
            [ swap drop false ] [ swap ] if
            pair true ] list.case ] iterate
        unpair swap drop
        [ result@1.Result.Ok ]
        [ drop unit calc_errors@1.LimitIO.InputBytes
          calc_errors@1.LimitPrimary.IO
          calc_errors@1.LimitCategory.Primary
          calc_errors@1.NumericError.ResourceLimit
          result@1.Result.Err ] if
    ]

    signature budget_nth forall<S:stack> [ S Budget I64 -- S I64 ! pure ]
    def budget_nth [
        swap Budget.into swap pair
        [ unpair dup 0 =
          [ pair false ]
          [ 1 - swap
            [ nil swap pair false ]
            [ swap drop swap pair true ] list.case ] if
        ] iterate
        unpair drop [ 0 ] [ drop ] list.case
    ]

    signature budget_set forall<S:stack> [ S Budget I64 I64 -- S Budget ! pure ]
    def budget_set [
        [ swap ] dip swap Budget.into swap [ swap ] dip pair nil pair pair
        [ unpair swap
          [ nil swap pair false ]
          [ [ [ unpair ] dip [ swap ] dip swap dup unpair
              [ swap ] dip swap
              [ swap 0 = [ swap drop ] [ drop ] if ] dip
              swap [ swap ] dip swap cons swap unpair
              [ 1 - ] dip pair swap pair
            ] dip swap pair true ] list.case
        ] iterate
        unpair swap drop unpair swap drop
        nil pair
        [ unpair swap
          [ nil swap pair false ]
          [ swap [ swap ] dip swap cons pair true ] list.case
        ] iterate
        unpair swap drop Budget.new
    ]

    def charge_at [
        dup 0 i64.cmp -1 =
        [ drop drop drop unit result@1.Result.Err ]
        [ [ pair dup unpair budget_nth ] dip -
          dup 0 i64.cmp -1 =
          [ drop drop unit result@1.Result.Err ]
          [ [ unpair ] dip budget_set result@1.Result.Ok ] if ] if
    ]

    def admit_at [
        dup 0 i64.cmp -1 =
        [ drop drop drop unit result@1.Result.Err ]
        [ [ pair dup unpair budget_nth ] dip -
          dup 0 i64.cmp -1 =
          [ drop drop unit result@1.Result.Err ]
          [ drop unpair drop result@1.Result.Ok ] if ] if
    ]

    signature admit_bits_check forall<S:stack>
        [ S Budget I64 -- S result@1.Result<Budget,Unit> ! pure ]
    export admit_bits_check
    def admit_bits_check [ 2 swap admit_at ]

    signature admit_bits forall<S:stack>
        [ S Budget I64 -- S result@1.Result<Budget,calc_errors@1.NumericError> ! pure ]
    export admit_bits
    def admit_bits [
        2 swap admit_at
        [ result@1.Result.Ok ]
        [ drop unit calc_errors@1.LimitNumeric.IntermediateIntegerBits
          calc_errors@1.LimitPrimary.Numeric
          calc_errors@1.LimitCategory.Primary
          calc_errors@1.NumericError.ResourceLimit result@1.Result.Err ]
        result@1.Result.match
    ]

    signature admit_syntax forall<S:stack>
        [ S Budget I64 -- S result@1.Result<Budget,calc_errors@1.NumericError> ! pure ]
    export admit_syntax
    def admit_syntax [
        3 swap admit_at
        [ result@1.Result.Ok ]
        [ drop unit calc_errors@1.LimitDepth.SyntaxDepth
          calc_errors@1.LimitRemaining.NestedDepth
          calc_errors@1.LimitCategory.Remaining
          calc_errors@1.NumericError.ResourceLimit result@1.Result.Err ]
        result@1.Result.match
    ]

    # Only the callee receives the one-level depth debit. Its other quota
    # consumptions return to the caller; call depth is restored on return.
    signature call_enter forall<S:stack>
        [ S Budget -- S result@1.Result<Budget,calc_errors@1.NumericError> ! pure ]
    export call_enter
    def call_enter [
        4 1 charge_at
        [ result@1.Result.Ok ]
        [ drop unit calc_errors@1.LimitDepth.CallDepth
          calc_errors@1.LimitRemaining.NestedDepth
          calc_errors@1.LimitCategory.Remaining
          calc_errors@1.NumericError.ResourceLimit result@1.Result.Err ]
        result@1.Result.match
    ]

    signature call_leave forall<S:stack>
        [ S Budget Pair<Rat,Budget> -- S Pair<Rat,Budget> ! pure ]
    export call_leave
    def call_leave [
        unpair swap
        [ swap 4 budget_nth 4 swap budget_set ] dip
        swap pair
    ]

    # The parser retains the original sealed Budget and attaches its exact
    # token span to a denial. Use the same nonnegative/index-three gate as
    # admit_syntax; these queries never consume or charge the depth allowance.
    # Splitting them lets the parser compare two I64s rather than carrying
    # its rich state through a Budget admission closure.
    signature syntax_limit forall<S:stack>
        [ S Budget -- S I64 ! pure ]
    export syntax_limit
    def syntax_limit [ 3 budget_nth ]

    signature syntax_allows forall<S:stack>
        [ S I64 I64 -- S Bool ! pure ]
    export syntax_allows
    def syntax_allows [
        dup 0 i64.cmp -1 =
        [ drop drop false ]
        [ i64.cmp -1 = calc_bits@1.bool_not ] if
    ]

    signature charge_work forall<S:stack>
        [ S Budget I64 -- S result@1.Result<Budget,calc_errors@1.NumericError> ! pure ]
    export charge_work
    def charge_work [
        5 swap charge_at
        [ result@1.Result.Ok ]
        [ drop unit calc_errors@1.LimitRemaining.EvaluationWork
          calc_errors@1.LimitCategory.Remaining
          calc_errors@1.NumericError.ResourceLimit result@1.Result.Err ]
        result@1.Result.match
    ]

    # Unary plus is the identity on its original canonical Rat, but still
    # charges exactly one unit of the authenticated remaining Work allowance.
    # Keep the evaluator's original Pending outside these small guest phases.
    signature plus_work_limit forall<S:stack>
        [ S Pair<Rat,Budget>
          -- S Pair<Rat,Pair<Budget,I64>> ! pure ]
    export plus_work_limit
    def plus_work_limit [
        unpair dup 5 budget_nth pair pair
    ]

    signature plus_work_probe forall<S:stack>
        [ S Pair<Rat,Pair<Budget,I64>>
          -- S Pair<Pair<Rat,Pair<Budget,I64>>,Bool> ! pure ]
    export plus_work_probe
    def plus_work_probe [
        dup unpair unpair [ drop drop ] dip
        1 - 0 i64.cmp -1 = pair
    ]

    signature plus_work_admit forall<S:stack>
        [ S Pair<Rat,Pair<Budget,I64>>
          -- S Pair<Rat,Budget> ! pure ]
    export plus_work_admit
    def plus_work_admit [
        unpair unpair 1 - 5 swap budget_set pair
    ]

    # Carry the original certified Budget unchanged until a category-specific
    # check issues a private token for that category's budget update.
    signature input_charge_limit forall<S:stack>
        [ S Budget I64 -- S InputChargeMeasured ! pure ]
    export input_charge_limit
    def input_charge_limit [
        [ dup 0 budget_nth ] dip swap
        pair pair InputChargeMeasured.new
    ]

    signature input_charge_check forall<S:stack>
        [ S InputChargeMeasured
          -- S result@1.Result<InputChargeChecked,calc_errors@1.NumericError> ! pure ]
    export input_charge_check
    def input_charge_check [
        InputChargeMeasured.into unpair unpair swap
        dup 0 i64.cmp -1 =
        [ drop drop drop
          unit calc_errors@1.LimitIO.InputBytes
          calc_errors@1.LimitPrimary.IO
          calc_errors@1.LimitCategory.Primary
          calc_errors@1.NumericError.ResourceLimit result@1.Result.Err ]
        [ - dup 0 i64.cmp -1 =
          [ drop drop
            unit calc_errors@1.LimitIO.InputBytes
            calc_errors@1.LimitPrimary.IO
            calc_errors@1.LimitCategory.Primary
            calc_errors@1.NumericError.ResourceLimit result@1.Result.Err ]
          [ pair InputChargeChecked.new result@1.Result.Ok ] if ] if
    ]

    signature input_charge_commit forall<S:stack>
        [ S InputChargeChecked -- S Budget ! pure ]
    export input_charge_commit
    def input_charge_commit [
        InputChargeChecked.into unpair
        0 swap budget_set
    ]

    signature work_charge_limit forall<S:stack>
        [ S Budget I64 -- S WorkChargeMeasured ! pure ]
    export work_charge_limit
    def work_charge_limit [
        [ dup 5 budget_nth ] dip swap
        pair pair WorkChargeMeasured.new
    ]

    signature work_charge_check forall<S:stack>
        [ S WorkChargeMeasured
          -- S result@1.Result<WorkChargeChecked,calc_errors@1.NumericError> ! pure ]
    export work_charge_check
    def work_charge_check [
        WorkChargeMeasured.into unpair unpair swap
        dup 0 i64.cmp -1 =
        [ drop drop drop
          unit calc_errors@1.LimitRemaining.EvaluationWork
          calc_errors@1.LimitCategory.Remaining
          calc_errors@1.NumericError.ResourceLimit result@1.Result.Err ]
        [ - dup 0 i64.cmp -1 =
          [ drop drop
            unit calc_errors@1.LimitRemaining.EvaluationWork
            calc_errors@1.LimitCategory.Remaining
            calc_errors@1.NumericError.ResourceLimit result@1.Result.Err ]
          [ pair WorkChargeChecked.new result@1.Result.Ok ] if ] if
    ]

    signature work_charge_commit forall<S:stack>
        [ S WorkChargeChecked -- S Budget ! pure ]
    export work_charge_commit
    def work_charge_commit [
        WorkChargeChecked.into unpair
        5 swap budget_set
    ]

    signature charge_output_size forall<S:stack>
        [ S Budget I64 -- S result@1.Result<Budget,calc_errors@1.NumericError> ! pure ]
    export charge_output_size
    def charge_output_size [
        6 swap charge_at
        [ result@1.Result.Ok ]
        [ drop unit calc_errors@1.LimitIO.OutputSize
          calc_errors@1.LimitPrimary.IO
          calc_errors@1.LimitCategory.Primary
          calc_errors@1.NumericError.ResourceLimit result@1.Result.Err ]
        result@1.Result.match
    ]

    signature rat_parts forall<S:stack>
        [ S Rat -- S Pair<calc_big@1.BigInt,calc_big@1.BigInt> ! pure ]
    export rat_parts
    def rat_parts [ Rat.into ]

    signature rat_num forall<S:stack> [ S Rat -- S calc_big@1.BigInt ! pure ]
    def rat_num [ Rat.into unpair drop ]

    signature rat_den forall<S:stack> [ S Rat -- S calc_big@1.BigInt ! pure ]
    def rat_den [ Rat.into unpair swap drop ]

    # PowState contains only powers of one canonical Rat (or its reciprocal).
    # Coprime numerator/denominator remain coprime under products of powers,
    # including the zero base with denominator one. Re-running gcd here would
    # repeat normalization already certified by Rat and the pow domain gate.
    signature reserve forall<S:stack>
        [ S Budget I64 I64
          -- S result@1.Result<Budget,calc_errors@1.NumericError> ! pure ]
    export reserve
    def reserve [
        [ admit_bits ] dip swap
        [ swap charge_work ]
        [ swap drop result@1.Result.Err ]
        result@1.Result.match
    ]

    signature pair_big_total_width forall<S:stack>
        [ S Pair<calc_big@1.BigInt,calc_big@1.BigInt> -- S I64 ! pure ]
    def pair_big_total_width [
        unpair [ calc_big@1.big_width ] dip calc_big@1.big_width +
    ]

    signature rat_total_width forall<S:stack> [ S Rat -- S I64 ! pure ]
    export rat_total_width
    def rat_total_width [
        Rat.into unpair [ calc_big@1.big_width ] dip calc_big@1.big_width +
    ]


    # Carry the exact input width without entering either quota gate. Only the
    # private Bit-admitted token may enter the Work gate; materialization still
    # requires the final GcdReserved token.
    signature gcd_measure forall<S:stack>
        [ S RawRat Budget -- S GcdMeasured ! pure ]
    export gcd_measure
    def gcd_measure [
        [ dup RawRat.into pair_big_total_width ] dip swap
        2 + pair pair GcdMeasured.new
    ]

    signature gcd_bits_limit forall<S:stack>
        [ S GcdMeasured -- S GcdBitsMeasured ! pure ]
    export gcd_bits_limit
    def gcd_bits_limit [
        dup GcdMeasured.into unpair unpair
        drop swap drop 2 budget_nth
        pair GcdBitsMeasured.new
    ]

    # Preserve the exact RawRat, its original Budget, and the measured
    # prospective width while the protected binary-result Pending routes
    # the original Bits quota verdict in separate selected guest steps.
    signature gcd_bits_probe forall<S:stack>
        [ S GcdBitsMeasured -- S Pair<GcdBitsMeasured,Bool> ! pure ]
    export gcd_bits_probe
    def gcd_bits_probe [
        dup GcdBitsMeasured.into unpair
        [ GcdMeasured.into unpair unpair ] dip
        [ dup ] dip swap - 0 i64.cmp -1 =
        [ drop drop drop ] dip pair
    ]

    signature gcd_bits_admit forall<S:stack>
        [ S GcdBitsMeasured -- S GcdBitsAdmitted ! pure ]
    export gcd_bits_admit
    def gcd_bits_admit [
        GcdBitsMeasured.into unpair
        [ GcdMeasured.into unpair unpair ] dip
        drop pair pair GcdBitsAdmitted.new
    ]

    signature gcd_bits_deny forall<S:stack>
