    signature pow_square_begin forall<S:stack>
        [ S PowSquareInput
          -- S result@1.Result<Pair<Rat,PowAccInput>,Unit> ! pure ]
    export pow_square_begin
    def pow_square_begin [
        PowSquareInput.into unpair
        [ dup calc_bits@1.bits_empty ] dip swap
        [ drop drop unit result@1.Result.Err ]
        [ unpair swap
          dup pair calc_bits@1.rot swap pair PowAccInput.new
          pair result@1.Result.Ok ] if
    ]

    # PowState is Pair<bits,Pair<base,acc>>. pow_square_begin retains the
