    signature pow_exponent_length_compare forall<S:stack>
        [ S Pair<PowBoundCompared,Pair<I64,I64>>
          -- S Pair<PowBoundCompared,I64> ! pure ]
    export pow_exponent_length_compare
    def pow_exponent_length_compare [
        unpair unpair i64.cmp pair
    ]

    signature pow_exponent_compare_parts forall<S:stack>
        [ S PowBoundCompared
          -- S Pair<PowBoundCompared,Pair<List<Bool>,List<Bool>>> ! pure ]
    export pow_exponent_compare_parts
    def pow_exponent_compare_parts [
        dup PowBoundCompared.into unpair swap drop pair
    ]

    signature pow_exponent_compare_exp forall<S:stack>
        [ S Pair<PowBoundCompared,Pair<List<Bool>,List<Bool>>>
          -- S Pair<PowBoundCompared,Pair<I64,List<Bool>>> ! pure ]
    export pow_exponent_compare_exp
    def pow_exponent_compare_exp [
        unpair unpair
        [ calc_bits@1.bits_to_i64_positive ] dip
        pair pair
    ]

    signature pow_exponent_compare_bound forall<S:stack>
        [ S Pair<PowBoundCompared,Pair<I64,List<Bool>>>
          -- S Pair<PowBoundCompared,Pair<I64,I64>> ! pure ]
    export pow_exponent_compare_bound
    def pow_exponent_compare_bound [
        unpair unpair
        calc_bits@1.bits_to_i64_positive
        pair pair
    ]

    signature pow_exponent_compare_probe forall<S:stack>
        [ S Pair<PowBoundCompared,Pair<I64,I64>>
          -- S Pair<PowBoundCompared,Bool> ! pure ]
    export pow_exponent_compare_probe
    def pow_exponent_compare_probe [
        unpair unpair i64.cmp 1 = pair
    ]

    signature pow_exponent_route forall<S:stack>
        [ S Pair<PowBoundCompared,Bool>
          -- S Pair<PowBoundCompared,result@1.Result<Unit,Unit>> ! pure ]
    export pow_exponent_route
    def pow_exponent_route [
        unpair [ unit result@1.Result.Err ]
               [ unit result@1.Result.Ok ] if pair
    ]

    signature pow_exponent_admit forall<S:stack>
        [ S PowBoundCompared -- S PowWorkAdmitted ! pure ]
    export pow_exponent_admit
    def pow_exponent_admit [
        PowBoundCompared.into unpair drop
        PowBaseWidth.into PowWorkAdmitted.new
    ]

    signature pow_exponent_deny forall<S:stack>
        [ S Unit -- S calc_errors@1.NumericError ! pure ]
    export pow_exponent_deny
    def pow_exponent_deny [
        drop unit calc_errors@1.LimitNumeric.IntermediateIntegerBits
        calc_errors@1.LimitPrimary.Numeric
        calc_errors@1.LimitCategory.Primary
        calc_errors@1.NumericError.ResourceLimit
    ]

    # Keep the checked exponent and exact base width sealed independently:
    # neither the consumer nor another module may substitute a lower Bits
    # projection before the original quadratic Work reservation.
    signature pow_width_exponent forall<S:stack>
        [ S PowWorkAdmitted -- S PowWidthExponent ! pure ]
    export pow_width_exponent
    def pow_width_exponent [
        dup PowWorkAdmitted.into unpair drop
        PowDomainChecked.into unpair drop
        unpair swap drop rat_num calc_big@1.big_bits calc_bits@1.bits_to_i64_positive
        pair PowWidthExponent.new
    ]

    signature pow_width_base forall<S:stack>
        [ S PowWidthExponent -- S PowWidthBase ! pure ]
    export pow_width_base
    def pow_width_base [
        dup PowWidthExponent.into unpair drop
        PowWorkAdmitted.into unpair swap drop
        pair PowWidthBase.new
    ]

    signature pow_width_measure forall<S:stack>
        [ S PowWidthBase -- S PowWidthMeasured ! pure ]
    export pow_width_measure
    def pow_width_measure [
        PowWidthBase.into unpair
        [ PowWidthExponent.into unpair ] dip
        * 2 + pair PowWidthMeasured.new
    ]

    signature pow_bits_probe forall<S:stack>
        [ S PowWidthMeasured -- S Pair<PowWidthMeasured,Bool> ! pure ]
    export pow_bits_probe
    def pow_bits_probe [
        dup PowWidthMeasured.into unpair
        [ PowWorkAdmitted.into unpair drop
          PowDomainChecked.into unpair swap drop
          2 budget_nth ] dip
        swap i64.cmp 1 = pair
    ]

    signature pow_bits_route forall<S:stack>
        [ S Pair<PowWidthMeasured,Bool>
          -- S Pair<PowWidthMeasured,result@1.Result<Unit,Unit>> ! pure ]
    export pow_bits_route
    def pow_bits_route [
        unpair [ unit result@1.Result.Err ]
               [ unit result@1.Result.Ok ] if pair
    ]

    # The routed Bits proof must actually debit the original guest Budget.
    # Keep the private measured-width certificate while computing the
    # nonnegative remaining allowance; mutate its persistent Budget only in
    # the next bounded submission, instead of inlining two list traversals.
    signature pow_bits_measure_debit forall<S:stack>
        [ S PowWidthMeasured
          -- S Pair<PowWidthAdmitted,Pair<Budget,I64>> ! pure ]
    export pow_bits_measure_debit
    def pow_bits_measure_debit [
        PowWidthMeasured.into PowWidthAdmitted.new
        dup PowWidthAdmitted.into unpair
        [ PowWorkAdmitted.into unpair drop
          PowDomainChecked.into unpair swap drop ] dip
        [ dup 2 budget_nth ] dip -
        pair pair
    ]

    signature pow_bits_commit_debit forall<S:stack>
        [ S Pair<PowWidthAdmitted,Pair<Budget,I64>>
          -- S PowBitsAdmitted ! pure ]
    export pow_bits_commit_debit
    def pow_bits_commit_debit [
        unpair unpair 2 swap budget_set
        pair PowBitsAdmitted.new
    ]

    signature pow_bits_deny forall<S:stack>
        [ S Unit -- S calc_errors@1.NumericError ! pure ]
    export pow_bits_deny
    def pow_bits_deny [
        drop unit calc_errors@1.LimitNumeric.IntermediateIntegerBits
        calc_errors@1.LimitPrimary.Numeric
        calc_errors@1.LimitCategory.Primary
        calc_errors@1.NumericError.ResourceLimit
    ]

    # A bounded exponent guarantees projected width fits I64, but its
    # quadratic Work charge must still be compared quotient-first against
    # the *remaining* guest Work allowance before any multiplication.
    signature pow_work_bounded forall<S:stack>
        [ S PowBitsAdmitted -- S PowWorkBounded ! pure ]
    export pow_work_bounded
    def pow_work_bounded [
        dup PowBitsAdmitted.into unpair drop
        PowWidthAdmitted.into unpair swap drop
        [ dup PowBitsAdmitted.into unpair swap drop
          5 budget_nth ] dip
        swap pair pair PowWorkBounded.new
    ]

    signature pow_work_limit_probe forall<S:stack>
        [ S PowWorkBounded -- S Pair<PowWorkBounded,Bool> ! pure ]
    export pow_work_limit_probe
    def pow_work_limit_probe [
        dup PowWorkBounded.into unpair swap drop unpair
        100 i64.div-rem drop drop
        i64.cmp 1 = pair
    ]

    signature pow_work_square_probe forall<S:stack>
        [ S PowWorkBounded -- S Pair<PowWorkBounded,Bool> ! pure ]
    export pow_work_square_probe
    def pow_work_square_probe [
        dup PowWorkBounded.into unpair swap drop unpair
        [ dup ] dip 100 i64.div-rem drop drop
        swap i64.div-rem drop drop
        i64.cmp 1 = pair
    ]

    signature pow_work_admit forall<S:stack>
        [ S PowWorkBounded -- S PowWorkChecked ! pure ]
    export pow_work_admit
    def pow_work_admit [
        PowWorkBounded.into unpair unpair
        swap dup * 100 * -
        [ dup PowBitsAdmitted.into unpair swap drop ] dip
        pair WorkChargeChecked.new
        pair PowWorkChecked.new
    ]

    signature pow_work_deny forall<S:stack>
        [ S Unit -- S calc_errors@1.NumericError ! pure ]
    export pow_work_deny
    def pow_work_deny [
        drop unit calc_errors@1.LimitRemaining.EvaluationWork
        calc_errors@1.LimitCategory.Remaining
        calc_errors@1.NumericError.ResourceLimit
    ]

    signature pow_work_commit forall<S:stack>
        [ S PowWorkChecked -- S PowReserved ! pure ]
    export pow_work_commit
    def pow_work_commit [
        PowWorkChecked.into unpair
        work_charge_commit
        [ PowBitsAdmitted.into unpair drop
          PowWidthAdmitted.into unpair drop
          PowWorkAdmitted.into unpair drop
          PowDomainChecked.into unpair drop ] dip
        pair PowReserved.new
    ]

    signature pow_materialize forall<S:stack>
        [ S PowReserved -- S Pair<PowState,Budget> ! pure ]
    export pow_materialize
    def pow_materialize [
        PowReserved.into unpair
        [ unpair rat_num dup calc_big@1.big_sign
          swap calc_big@1.big_bits
          [ [ Rat.into unpair swap pair calc_big@1.pair_den_positive Rat.new ] [ ] if ] dip
          swap calc_big@1.big_one calc_big@1.big_one pair Rat.new pair pair PowState.new ] dip
        pair
    ]

    # A bit routes to at most two separate exact products. Private tokens
    # retain the remaining exponent bits, base, and accumulator across guest
    # submissions; only a fully consumed exponent can expose the result.
    signature pow_bit_route forall<S:stack>
        [ S PowState Budget -- S Pair<Sum<Rat,Sum<PowAccInput,PowSquareInput>>,Budget> ! pure ]
    export pow_bit_route
    def pow_bit_route [
        [ PowState.into unpair swap
          [ unpair swap drop inl ]
          [ swap
            [ swap pair PowAccInput.new inl inr ]
            [ swap pair PowSquareInput.new inr inr ] if ]
          list.case ] dip pair
    ]

    # Inspect only the branch tag. Rebuild the same sealed Sum with its
    # original payload and Budget, without duplicating any Rat or cursor.
    signature pow_route_kind forall<S:stack>
        [ S Pair<Sum<Rat,Sum<PowAccInput,PowSquareInput>>,Budget>
          -- S Pair<Pair<Sum<Rat,Sum<PowAccInput,PowSquareInput>>,Budget>,I64> ! pure ]
    export pow_route_kind
    def pow_route_kind [
        unpair
        [ [ inl 0 pair ]
          [ [ inl inr 1 pair ]
            [ inr inr 2 pair ] case ]
          case ] dip
        [ unpair ] dip
        swap [ pair ] dip pair
    ]

    # The route holds sealed signed-product inputs. Each narrow projection
    # independently rejects the other two branches.
    signature pow_route_select_acc forall<S:stack>
        [ S Pair<Sum<Rat,Sum<PowAccInput,PowSquareInput>>,Budget>
          -- S result@1.Result<Pair<PowAccInput,Budget>,Unit> ! pure ]
    export pow_route_select_acc
    def pow_route_select_acc [
        unpair swap
        [ drop drop unit result@1.Result.Err ]
        [ [ swap pair result@1.Result.Ok ]
          [ drop drop unit result@1.Result.Err ] case ]
        case
    ]

    signature pow_route_select_square forall<S:stack>
        [ S Pair<Sum<Rat,Sum<PowAccInput,PowSquareInput>>,Budget>
          -- S result@1.Result<Pair<PowSquareInput,Budget>,Unit> ! pure ]
    export pow_route_select_square
    def pow_route_select_square [
        unpair swap
        [ drop drop unit result@1.Result.Err ]
        [ [ drop drop unit result@1.Result.Err ]
          [ swap pair result@1.Result.Ok ] case ]
        case
    ]

    signature pow_route_select_done forall<S:stack>
        [ S Pair<Sum<Rat,Sum<PowAccInput,PowSquareInput>>,Budget>
          -- S result@1.Result<Pair<Rat,Budget>,Unit> ! pure ]
    export pow_route_select_done
    def pow_route_select_done [
        unpair swap
        [ swap pair result@1.Result.Ok ]
        [ drop drop unit result@1.Result.Err ]
        case
    ]

    # Both products reuse the same sealed signed schoolbook cursor. The
    # context is private: a client cannot substitute an unrelated BigInt
    # product for either accumulator numerator or denominator.
    signature pow_acc_num_begin forall<S:stack>
        [ S PowAccInput -- S PowMulCursor ! pure ]
    export pow_acc_num_begin
    def pow_acc_num_begin [
        PowAccInput.into unpair
        dup unpair [ rat_num ] dip rat_num calc_big@1.big_mul_input
        [ pair PowMulContext.Numerator ] dip
        calc_big@1.big_mul_begin pair PowMulCursor.new
    ]

    signature pow_acc_den_begin forall<S:stack>
        [ S PowAccNumerator -- S PowMulCursor ! pure ]
    export pow_acc_den_begin
    def pow_acc_den_begin [
        PowAccNumerator.into unpair unpair
        [ dup unpair [ rat_den ] dip rat_den calc_big@1.big_mul_input ] dip
        swap
        [ [ unpair drop ] dip pair pair PowMulContext.Denominator ] dip
        calc_big@1.big_mul_begin pair PowMulCursor.new
    ]

    signature pow_mul_classify forall<S:stack>
        [ S PowMulCursor -- S PowMulRouted ! pure ]
    export pow_mul_classify
    def pow_mul_classify [
        PowMulCursor.into unpair
        calc_big@1.big_mul_route pair PowMulRouted.new
    ]

    # Inspect the signed bit-cursor without exposing its two large route
    # branches as one selected output. Both selectors check the sealed route
    # independently rather than trusting the caller's Bool.
    signature pow_mul_probe forall<S:stack>
        [ S PowMulRouted -- S Pair<PowMulRouted,Bool> ! pure ]
    export pow_mul_probe
    def pow_mul_probe [
        dup PowMulRouted.into unpair swap drop
        [ drop false ] [ drop true ] calc_big@1.BigMulRoute.match
        pair
    ]

    signature pow_mul_select_done forall<S:stack>
        [ S PowMulRouted -- S result@1.Result<PowMulDone,Unit> ! pure ]
    export pow_mul_select_done
    def pow_mul_select_done [
        PowMulRouted.into unpair
        [ pair PowMulDone.new result@1.Result.Ok ]
        [ drop drop unit result@1.Result.Err ]
        calc_big@1.BigMulRoute.match
    ]

    signature pow_mul_select_active forall<S:stack>
        [ S PowMulRouted -- S result@1.Result<PowMulActive,Unit> ! pure ]
    export pow_mul_select_active
    def pow_mul_select_active [
        PowMulRouted.into unpair
        [ drop drop unit result@1.Result.Err ]
        [ pair PowMulActive.new result@1.Result.Ok ]
        calc_big@1.BigMulRoute.match
    ]

    signature pow_mul_accumulate forall<S:stack>
        [ S PowMulActive -- S PowMulAdded ! pure ]
    export pow_mul_accumulate
    def pow_mul_accumulate [
        PowMulActive.into unpair
        calc_big@1.big_mul_accumulate pair PowMulAdded.new
    ]

    signature pow_mul_shift forall<S:stack>
        [ S PowMulAdded -- S PowMulCursor ! pure ]
    export pow_mul_shift
    def pow_mul_shift [
        PowMulAdded.into unpair
        calc_big@1.big_mul_shift pair PowMulCursor.new
    ]

    signature pow_mul_finish_numerator forall<S:stack>
        [ S PowMulDone -- S result@1.Result<PowAccNumerator,Unit> ! pure ]
    export pow_mul_finish_numerator
    def pow_mul_finish_numerator [
        PowMulDone.into unpair
        calc_big@1.big_mul_finish swap
        [ unpair
          calc_bits@1.rot pair pair PowAccNumerator.new
          result@1.Result.Ok ]
        [ drop drop unit result@1.Result.Err ]
        PowMulContext.match
    ]

    signature pow_mul_finish_denominator forall<S:stack>
        [ S PowMulDone -- S result@1.Result<PowAccDenominator,Unit> ! pure ]
    export pow_mul_finish_denominator
    def pow_mul_finish_denominator [
        PowMulDone.into unpair
        calc_big@1.big_mul_finish swap
        [ drop drop unit result@1.Result.Err ]
        [ unpair calc_bits@1.rot
          [ unpair ] dip
          pair pair pair PowAccDenominator.new
          result@1.Result.Ok ]
        PowMulContext.match
    ]

    signature pow_acc_finish forall<S:stack>
        [ S PowAccDenominator -- S PowSquareInput ! pure ]
    export pow_acc_finish
    def pow_acc_finish [
        PowAccDenominator.into unpair unpair
        Rat.new
        pair pair PowSquareInput.new
    ]

    # A consumed exponent needs no further squaring. Its terminal route
    # produces PowState; the other route preserves the original sealed input
    # for the already-admitted staged schoolbook base*base product.
    signature pow_square_route forall<S:stack>
        [ S PowSquareInput
          -- S result@1.Result<PowState,PowSquareInput> ! pure ]
    export pow_square_route
    def pow_square_route [
        PowSquareInput.into unpair
        [ dup calc_bits@1.bits_empty ] dip swap
        [ pair PowState.new result@1.Result.Ok ]
        [ pair PowSquareInput.new result@1.Result.Err ] if
    ]

    # Reuse the existing schoolbook multiplication cursor for base*base.
    # Retain the genuine accumulator outside the cursor on the guest stack:
