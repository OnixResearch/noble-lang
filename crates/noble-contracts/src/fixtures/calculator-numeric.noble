    export pow_square_finish
    def pow_square_finish [
        unpair PowSquareInput.into unpair unpair [ drop ] dip
        calc_bits@1.rot pair pair PowState.new
    ]

    # Appended Stage 1 splits. The monolithic pow_mul_accumulate and
