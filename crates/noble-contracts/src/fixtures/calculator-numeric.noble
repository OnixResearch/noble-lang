    # exponent bits as an I64; no fixed exponent or result-width cap exists.
    signature pow_exponent_length_exp forall<S:stack>
        [ S PowBoundCompared -- S Pair<PowBoundCompared,I64> ! pure ]
    export pow_exponent_length_exp
    def pow_exponent_length_exp [
        dup PowBoundCompared.into unpair swap drop unpair drop
        calc_bits@1.bit_count pair
    ]

    signature pow_exponent_length_bound forall<S:stack>
        [ S Pair<PowBoundCompared,I64>
          -- S Pair<PowBoundCompared,Pair<I64,I64>> ! pure ]
    export pow_exponent_length_bound
    def pow_exponent_length_bound [
        unpair
        [ dup PowBoundCompared.into unpair swap drop
          unpair swap drop calc_bits@1.bit_count ] dip
        swap pair pair
    ]

    # A single guest comparison distinguishes strictly shorter exponents
