        [ S Rat Rat Budget -- S Pair<Pair<Rat,Rat>,Budget> ! pure ]
    export pow_input
    def pow_input [ [ pair ] dip pair ]

    # Split exact integral-domain and zero-negative checks into selected
    # guest predicates plus typed routes. Every selector retains the original
    # sealed operand pair and Budget; the host never inspects Rat payloads.
    signature pow_integral_bool forall<S:stack>
        [ S Pair<Pair<Rat,Rat>,Budget>
          -- S Pair<Pair<Pair<Rat,Rat>,Budget>,Bool> ! pure ]
    export pow_integral_bool
    def pow_integral_bool [
        dup unpair drop unpair swap drop
        rat_den calc_big@1.big_mag_one_p pair
    ]

    signature pow_integral_route forall<S:stack>
        [ S Pair<Pair<Pair<Rat,Rat>,Budget>,Bool>
          -- S Pair<Pair<Pair<Rat,Rat>,Budget>,result@1.Result<Unit,Unit>> ! pure ]
    export pow_integral_route
    def pow_integral_route [
        unpair [ unit result@1.Result.Ok ]
               [ unit result@1.Result.Err ] if pair
    ]

    signature pow_integral_admit forall<S:stack>
        [ S Pair<Pair<Rat,Rat>,Budget> -- S PowIntegral ! pure ]
    export pow_integral_admit
    def pow_integral_admit [ PowIntegral.new ]

    signature pow_integral_reject forall<S:stack>
        [ S Unit -- S calc_errors@1.NumericError ! pure ]
    export pow_integral_reject
    def pow_integral_reject [
        drop unit calc_errors@1.DomainExtended.NonIntegerExponent
        calc_errors@1.DomainError.Extended
        calc_errors@1.NumericError.Domain
    ]

    signature pow_zero_sign forall<S:stack>
        [ S PowIntegral -- S Pair<PowIntegral,Bool> ! pure ]
    export pow_zero_sign
    def pow_zero_sign [
        dup PowIntegral.into unpair drop
        unpair swap drop rat_num calc_big@1.big_sign pair
    ]

    signature pow_zero_base forall<S:stack>
        [ S Pair<PowIntegral,Bool> -- S Pair<PowIntegral,Bool> ! pure ]
    export pow_zero_base
    def pow_zero_base [
        unpair
        [ dup PowIntegral.into unpair drop
          unpair drop rat_num calc_big@1.big_zero_p ]
        [ false ] if pair
    ]

    signature pow_zero_route forall<S:stack>
        [ S Pair<PowIntegral,Bool>
          -- S Pair<PowIntegral,result@1.Result<Unit,Unit>> ! pure ]
    export pow_zero_route
    def pow_zero_route [
        unpair [ unit result@1.Result.Err ]
               [ unit result@1.Result.Ok ] if pair
    ]

    signature pow_zero_admit forall<S:stack>
        [ S PowIntegral -- S PowDomainChecked ! pure ]
    export pow_zero_admit
    def pow_zero_admit [ PowIntegral.into PowDomainChecked.new ]

    signature pow_zero_reject forall<S:stack>
        [ S Unit -- S calc_errors@1.NumericError ! pure ]
    export pow_zero_reject
    def pow_zero_reject [
        drop unit calc_errors@1.DomainArithmetic.DivisionByZero
        calc_errors@1.DomainExtended.Arithmetic
        calc_errors@1.DomainError.Extended
        calc_errors@1.NumericError.Domain
    ]

    # The exact base width and the existing Bits allowance determine the
    # largest admissible exponent. Compare the full guest exponent magnitude
    # against that bound *before* converting any exponent bits to signed I64.
    signature pow_base_num forall<S:stack>
        [ S PowDomainChecked -- S PowBaseNum ! pure ]
    export pow_base_num
    def pow_base_num [
        dup PowDomainChecked.into unpair drop unpair drop
        rat_num calc_big@1.big_width pair PowBaseNum.new
    ]

    signature pow_base_den forall<S:stack>
        [ S PowBaseNum -- S PowBaseWidth ! pure ]
    export pow_base_den
    def pow_base_den [
        PowBaseNum.into unpair
        [ dup PowDomainChecked.into unpair drop unpair drop
          rat_den calc_big@1.big_width ] dip
        + pair PowBaseWidth.new
    ]

    signature pow_exponent_bound forall<S:stack>
        [ S PowBaseWidth -- S PowBoundBits ! pure ]
    export pow_exponent_bound
    def pow_exponent_bound [
        dup PowBaseWidth.into unpair
        [ PowDomainChecked.into unpair swap drop 2 budget_nth ] dip
        swap dup 2 i64.cmp -1 =
        [ drop drop 0 ]
        [ 2 - swap i64.div-rem drop drop ] if
        calc_bits@1.bits_from_i64_nonnegative
        pair PowBoundBits.new
    ]

    signature pow_exponent_bits forall<S:stack>
        [ S PowBoundBits -- S PowBoundCompared ! pure ]
    export pow_exponent_bits
    def pow_exponent_bits [
        PowBoundBits.into unpair
        [ dup PowBaseWidth.into unpair drop
          PowDomainChecked.into unpair drop
          unpair swap drop rat_num calc_big@1.big_bits ] dip
        pair pair PowBoundCompared.new
    ]

    # The bound is calculated from a nonnegative signed-I64 Bits allowance
    # and a positive base width, so its bit length fits signed I64. Reject
