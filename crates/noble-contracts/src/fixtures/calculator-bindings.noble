    ]

    signature seen_search_byte forall<S:stack>
        [ S result@1.Result<SeenSearch,Unit> I64
          -- S result@1.Result<SeenSearch,Unit> Bool ! pure ]
    export seen_search_byte
    def seen_search_byte [
        swap dup
        [ [ drop swap drop false ]
          [ unpair swap
            [ drop swap drop false ]
            [ drop pair
              swap [ swap name_pair_byte_eq ] dip swap ]
            list.case ]
          SeenSearch.match ]
        [ drop swap drop false ]
        result@1.Result.match
    ]

    signature seen_search_byte_packed forall<S:stack>
        [ S Pair<result@1.Result<SeenSearch,Unit>,I64>
          -- S result@1.Result<SeenSearch,Unit> Bool ! pure ]
    export seen_search_byte_packed
    def seen_search_byte_packed [ unpair seen_search_byte ]

    signature seen_search_advance forall<S:stack>
        [ S result@1.Result<SeenSearch,Unit> Bool
          -- S result@1.Result<SeenSearch,Unit> Bool ! pure ]
    export seen_search_advance
    def seen_search_advance [
        swap
        [ swap
          [ [ SeenSearch.Done false ]
            [ unpair swap
              [ nil swap pair SeenSearch.Seeking false ]
              [ drop swap drop drop true SeenSearch.Done false ]
              list.case ]
            SeenSearch.match ]
          [ [ SeenSearch.Done false ]
            [ unpair swap
              [ nil swap pair SeenSearch.Seeking false ]
              [ swap drop swap pair SeenSearch.Seeking true ]
              list.case ]
            SeenSearch.match ]
          if
          [ result@1.Result.Ok ] dip ]
        [ drop drop unit result@1.Result.Err false ]
        result@1.Result.match
    ]

    signature seen_search_advance_packed forall<S:stack>
        [ S Pair<result@1.Result<SeenSearch,Unit>,Bool>
          -- S result@1.Result<SeenSearch,Unit> Bool ! pure ]
    export seen_search_advance_packed
    def seen_search_advance_packed [ unpair seen_search_advance ]

    signature seen_search_found forall<S:stack>
        [ S result@1.Result<SeenSearch,Unit>
          -- S result@1.Result<SeenSearch,Unit> Bool ! pure ]
    export seen_search_found
    def seen_search_found [
        dup
        [ [ ] [ drop false ] SeenSearch.match ]
        [ drop false ] result@1.Result.match
    ]

    signature seen_search_finish forall<S:stack>
        [ S result@1.Result<SeenSearch,Unit> -- S Bool ! pure ]
    export seen_search_finish
    def seen_search_finish [
        [ [ ] [ drop false ] SeenSearch.match ]
        [ drop false ] result@1.Result.match
    ]

    signature validation_candidate forall<S:stack>
        [ S Validation
          -- S result@1.Result<Pair<List<Name>,Name>,Unit> ! pure ]
    export validation_candidate
    def validation_candidate [
        [ drop unit result@1.Result.Err ]
        [ unpair
          [ drop unit result@1.Result.Err ]
          [ drop pair result@1.Result.Ok ] list.case ]
        Validation.match
    ]

    signature validation_candidate_present forall<S:stack,A:value>
        [ S result@1.Result<A,Unit>
          -- S result@1.Result<A,Unit> Bool ! pure ]
    export validation_candidate_present
    def validation_candidate_present [
        dup
        [ drop true ]
        [ drop false ]
        result@1.Result.match
    ]

    signature validation_advance forall<S:stack>
        [ S Validation Bool -- S Validation Bool ! pure ]
    export validation_advance
    def validation_advance [
        swap
        [ swap drop Validation.Done false ]
        [ unpair
          [ swap drop drop false 0 0 pair pair Validation.Done false ]
          [ [ pair ] dip rot
            [ drop unpair swap drop name_span true swap pair Validation.Done false ]
            [ swap unpair swap cons swap pair Validation.Pending true ] if ]
          list.case ]
        Validation.match
    ]

]
