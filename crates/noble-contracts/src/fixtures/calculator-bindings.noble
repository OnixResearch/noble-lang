        [ [ drop false ]
          [ unpair swap
            [ drop false ]
            [ drop variable_name name_size swap name_size = ]
            list.case ]
          VariableSearch.match ]
        [ drop false ]
        result@1.Result.match
    ]

    signature variable_lookup_length forall<S:stack>
        [ S result@1.Result<VariableSearch,Unit>
          -- S result@1.Result<VariableSearch,Unit> I64 ! pure ]
    export variable_lookup_length
    def variable_lookup_length [
        dup
        [ [ drop 0 ]
          [ unpair swap drop name_size ]
          VariableSearch.match ]
        [ drop 0 ]
        result@1.Result.match
    ]

    signature variable_lookup_byte forall<S:stack>
        [ S result@1.Result<VariableSearch,Unit> I64
          -- S result@1.Result<VariableSearch,Unit> Bool ! pure ]
    export variable_lookup_byte
    def variable_lookup_byte [
        swap dup
        [ [ drop swap drop false ]
          [ unpair swap
            [ drop swap drop false ]
            [ drop variable_name pair
              swap [ swap name_pair_byte_eq ] dip swap ]
            list.case ]
          VariableSearch.match ]
        [ drop swap drop false ]
        result@1.Result.match
    ]



    signature variable_lookup_advance forall<S:stack>
        [ S result@1.Result<VariableSearch,Unit> Bool
          -- S result@1.Result<VariableSearch,Unit> Bool ! pure ]
    export variable_lookup_advance
    def variable_lookup_advance [
        swap
        [ swap
          [ [ VariableSearch.Found false ]
            [ unpair swap
              [ nil swap pair VariableSearch.Missing false ]
              [ drop swap drop VariableSearch.Found false ]
              list.case ]
            VariableSearch.match ]
          [ [ VariableSearch.Found false ]
            [ unpair swap
              [ nil swap pair VariableSearch.Missing false ]
              [ swap drop swap pair VariableSearch.Missing true ]
              list.case ]
            VariableSearch.match ]
          if
          [ result@1.Result.Ok ] dip ]
        [ drop drop unit result@1.Result.Err false ]
        result@1.Result.match
    ]

    signature variable_lookup_step forall<S:stack>
        [ S result@1.Result<VariableSearch,Unit>
          -- S result@1.Result<VariableSearch,Unit> Bool ! pure ]
    export variable_lookup_step
    def variable_lookup_step [
        [ variable_search_step [ result@1.Result.Ok ] dip ]
        [ result@1.Result.Err false ]
        result@1.Result.match
    ]

    signature variable_lookup_status forall<S:stack>
        [ S result@1.Result<VariableSearch,Unit>
          -- S result@1.Result<VariableSearch,Unit> I64 ! pure ]
    export variable_lookup_status
    def variable_lookup_status [
        dup
        [ [ drop 0 ] [ drop 1 ] VariableSearch.match ]
        [ drop 2 ]
        result@1.Result.match
    ]

    signature variable_lookup_value forall<S:stack>
        [ S result@1.Result<VariableSearch,Unit>
          -- S result@1.Result<num@1.Rat,Unit> ! pure ]
    export variable_lookup_value
    def variable_lookup_value [
        [ [ Variable.into unpair swap drop result@1.Result.Ok ]
          [ drop unit result@1.Result.Err ]
          VariableSearch.match ]
        [ result@1.Result.Err ]
        result@1.Result.match
    ]

    signature variable_lookup_missing forall<S:stack>
        [ S result@1.Result<VariableSearch,Unit>
          -- S result@1.Result<Name,Unit> ! pure ]
    export variable_lookup_missing
