    signature variable_lookup_missing_failure forall<S:stack>
        [ S result@1.Result<Name,Unit>
          -- S result@1.Result<Failure,Unit> ! pure ]
    export variable_lookup_missing_failure
    def variable_lookup_missing_failure [
        [ name_span NameFailure.UnknownName Failure.Name result@1.Result.Ok ]
        [ result@1.Result.Err ]
        result@1.Result.match
    ]

    signature lookup_function forall<S:stack>
        [ S State Name -- S result@1.Result<Function,Failure> ! pure ]
    export lookup_function
    def lookup_function [ [ state_functions ] dip find_function ]

    # The history is newest first. Drop only entries appended after the rank;
    # the remaining list shares the immutable historical suffix.
    signature resolve_variable forall<S:stack>
        [ S List<Variable> List<Name> Name -- S result@1.Result<Binding,Failure> ! pure ]
    export resolve_variable
    def resolve_variable [
        [ dup ] dip dup [ find_parameter ] dip swap
        [ swap drop [ drop ] dip swap drop
          Binding.Parameter result@1.Result.Ok ]
        [ drop [ drop ] dip lookup_variable
          [ Binding.Global result@1.Result.Ok ]
          [ result@1.Result.Err ] result@1.Result.match ] result@1.Result.match
    ]

    signature seen_search_has_next forall<S:stack>
        [ S result@1.Result<SeenSearch,Unit>
          -- S result@1.Result<SeenSearch,Unit> Bool ! pure ]
    export seen_search_has_next
    def seen_search_has_next [
        dup
        [ [ drop false ]
          [ unpair swap
            [ drop false ]
            [ drop drop drop true ] list.case ]
          SeenSearch.match ]
        [ drop false ]
        result@1.Result.match
    ]

    signature seen_search_length forall<S:stack>
        [ S result@1.Result<SeenSearch,Unit>
          -- S result@1.Result<SeenSearch,Unit> I64 ! pure ]
    export seen_search_length
    def seen_search_length [
        dup
        [ [ drop 0 ]
          [ unpair swap drop name_size ]
          SeenSearch.match ]
        [ drop 0 ]
        result@1.Result.match
