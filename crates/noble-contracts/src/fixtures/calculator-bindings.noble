    signature seen_search_size forall<S:stack>
        [ S result@1.Result<SeenSearch,Unit>
          -- S result@1.Result<SeenSearch,Unit> Bool ! pure ]
    export seen_search_size
    def seen_search_size [
        dup
        [ [ drop false ]
          [ unpair swap
            [ drop false ]
            [ drop name_size swap name_size = ]
            list.case ]
          SeenSearch.match ]
        [ drop false ]
