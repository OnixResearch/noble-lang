    signature rot forall<S:stack,A:value,B:value,C:value>
        [ S A B C -- S B C A ! pure ]
    export rot
    def rot [ [ swap ] dip swap ]

    signature unrot forall<S:stack,A:value,B:value,C:value>
        [ S A B C -- S C A B ! pure ]
    export unrot
    def unrot [ swap [ swap ] dip ]

    signature reverse_i64 forall<S:stack> [ S List<I64> -- S List<I64> ! pure ]
    export reverse_i64
    def reverse_i64 [
        nil pair
        [ unpair swap
          [ nil swap pair false ]
          [ swap [ swap ] dip swap cons pair true ] list.case
        ] iterate
        unpair swap drop
    ]

    signature bits_empty forall<S:stack> [ S List<Bool> -- S Bool ! pure ]
    export bits_empty
    def bits_empty [ [ true ] [ drop drop false ] list.case ]

    signature reverse_bits forall<S:stack> [ S List<Bool> -- S List<Bool> ! pure ]
    export reverse_bits
    def reverse_bits [
        nil pair
        [ unpair swap
          [ nil swap pair false ]
          [ swap [ swap ] dip swap cons pair true ] list.case
        ] iterate
        unpair swap drop
    ]

    signature trim_msb_bits forall<S:stack>
        [ S List<Bool> -- S List<Bool> ! pure ]
    def trim_msb_bits [
        [ dup
          [ false ]
          [ swap [ drop false ] [ swap drop true ] if ]
          list.case ] iterate
    ]

    signature trim_bits forall<S:stack> [ S List<Bool> -- S List<Bool> ! pure ]
    export trim_bits
    def trim_bits [
        reverse_bits trim_msb_bits reverse_bits
