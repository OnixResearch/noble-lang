    signature bit_i64 forall<S:stack> [ S Bool -- S I64 ! pure ]
    def bit_i64 [ [ 1 ] [ 0 ] if ]

    signature add_three_bits forall<S:stack>
        [ S Bool Bool Bool -- S Bool Bool ! pure ]
    export add_three_bits
    def add_three_bits [
        bit_i64 swap bit_i64 + swap bit_i64 +
        2 i64.div-rem drop swap 1 = swap 1 = swap
    ]

    signature bool_or forall<S:stack> [ S Bool Bool -- S Bool ! pure ]
    def bool_or [ [ drop true ] [ ] if ]

    signature bool_and forall<S:stack> [ S Bool Bool -- S Bool ! pure ]
    export bool_and
    def bool_and [ [ ] [ drop false ] if ]

    signature bool_not forall<S:stack> [ S Bool -- S Bool ! pure ]
    export bool_not
    def bool_not [ [ false ] [ true ] if ]

    signature bool_equal forall<S:stack> [ S Bool Bool -- S Bool ! pure ]
    export bool_equal
    def bool_equal [ [ ] [ bool_not ] if ]

    signature should_continue_bits forall<S:stack>
        [ S Pair<List<Bool>,List<Bool>> Bool -- S Bool ! pure ]
    export should_continue_bits
    def should_continue_bits [
        [ unpair ] dip rot bits_empty rot bits_empty
