    signature multiply_start forall<S:stack>
        [ S List<Bool> List<Bool> -- S MultiplyCursor ! pure ]
    export multiply_start
    def multiply_start [ swap nil pair pair MultiplyCursor.new ]

    signature multiply_route forall<S:stack>
        [ S MultiplyCursor -- S MultiplyRoute ! pure ]
    export multiply_route
    def multiply_route [
        MultiplyCursor.into unpair swap
        [ unpair swap drop MultiplyDone.new MultiplyRoute.Done ]
        [ pair pair MultiplyActive.new MultiplyRoute.More ] list.case
    ]

    signature multiply_next forall<S:stack>
        [ S MultiplyActive -- S MultiplyCursor ! pure ]
    export multiply_next
    def multiply_next [
