    signature compare_bits forall<S:stack>
        [ S List<Bool> List<Bool> -- S I64 ! pure ]
    export compare_bits
    def compare_bits [
        pair 0 pair
        [ unpair
          [ unpair
            [ [ false nil ] [ ] list.case ] dip
            [ false nil ] [ ] list.case
            [ swap ] dip
            [ [ pair ] dip ] dip pair pair ] dip
          [ unpair ] dip
          [ swap ] dip swap unpair
          [ 1 ] [ 0 ] if swap [ 1 ] [ 0 ] if swap i64.cmp
          dup 0 = [ drop ] [ swap drop ] if
          pair
          dup unpair drop false
          [ unpair ] dip [ swap ] dip swap
          [ true ] [ drop drop false ] list.case
          [ swap ] dip swap
          [ true ] [ drop drop false ] list.case
          [ ] [ drop false ] if
          [ false ] [ true ] if
          [ drop true ] [ ] if
        ] iterate
        unpair swap drop
    ]

    signature subtract_three_bits forall<S:stack>
        [ S Bool Bool Bool -- S Bool Bool ! pure ]
    export subtract_three_bits
    def subtract_three_bits [
        bit_i64 swap bit_i64 rot bit_i64 unrot swap
        [ - ] dip -
        dup 0 i64.cmp -1 =
        [ 2 + true ] [ false ] if
        [ 1 = ] dip
    ]

    signature subtract_bits forall<S:stack>
        [ S List<Bool> List<Bool> -- S List<Bool> ! pure ]
    export subtract_bits
    def subtract_bits [
        pair false nil pair pair
        [ unpair
          [ unpair
            [ [ false nil ] [ ] list.case ] dip
            [ false nil ] [ ] list.case
            [ swap ] dip
            [ [ pair ] dip ] dip pair pair ] dip
          [ unpair ] dip
          [ swap ] dip swap unpair [ swap ] dip swap unpair
          [ [ 1 ] [ 0 ] if
            swap [ 1 ] [ 0 ] if
            [ swap ] dip swap [ 1 ] [ 0 ] if
            swap [ swap ] dip swap
            [ - ] dip -
            dup 0 i64.cmp -1 =
            [ 2 + true ] [ false ] if
            [ 1 = ] dip ] dip
          [ swap ] dip swap swap cons pair
          pair dup unpair unpair drop
          [ unpair ] dip [ swap ] dip swap
          [ true ] [ drop drop false ] list.case
          [ swap ] dip swap
          [ true ] [ drop drop false ] list.case
          [ ] [ drop false ] if
          [ false ] [ true ] if
          [ drop true ] [ ] if
        ] iterate
        unpair swap drop unpair swap drop
        [ dup
          [ false ]
          [ swap [ drop false ] [ swap drop true ] if ]
          list.case ] iterate
        nil pair
        [ unpair swap
          [ nil swap pair false ]
          [ swap [ swap ] dip swap cons pair true ] list.case
        ] iterate
        unpair swap drop
    ]

    signature shift_once forall<S:stack>
        [ S List<Bool> -- S List<Bool> ! pure ]
    export shift_once
    def shift_once [
        dup bits_empty [ drop nil ] [ false swap cons ] if
