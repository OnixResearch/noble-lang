    signature divide_compare forall<S:stack>
        [ S DivideShifted -- S DivideCompared ! pure ]
    export divide_compare
    def divide_compare [
        dup DivideShifted.into unpair swap drop
        unpair unpair drop swap compare_bits
        0 i64.cmp -1 = pair DivideCompared.new
    ]

    signature divide_complete_state forall<S:stack>
        [ S Pair<List<Bool>,Pair<List<Bool>,List<Bool>>> Bool
          -- S Pair<List<Bool>,Pair<List<Bool>,List<Bool>>> ! pure ]
    def divide_complete_state [
        [ unpair ] dip [ unpair ] dip
        [ false swap cons pair pair ]
        [ [ over subtract_bits ] dip true swap cons pair pair ] if
    ]

    signature divide_commit forall<S:stack>
        [ S DivideCompared -- S DivideCursor ! pure ]
    export divide_commit
    def divide_commit [
        DivideCompared.into unpair
        [ DivideShifted.into unpair ] dip
        rot [ divide_complete_state ] dip
        swap pair DivideCursor.new
    ]

    signature divide_finish forall<S:stack>
        [ S DivideDone -- S Pair<List<Bool>,List<Bool>> ! pure ]
    export divide_finish
    def divide_finish [
        DivideDone.into unpair swap [ trim_bits ] dip pair
    ]

    # GCD needs only the remainder; do not allocate discarded quotient bits.
    signature remainder_start forall<S:stack>
        [ S List<Bool> List<Bool> -- S RemainderCursor ! pure ]
    export remainder_start
    def remainder_start [
        [ reverse_bits ] dip
        nil pair pair RemainderCursor.new
    ]

    signature remainder_route forall<S:stack>
        [ S RemainderCursor -- S RemainderRoute ! pure ]
    export remainder_route
    def remainder_route [
        RemainderCursor.into unpair swap
        [ unpair swap drop RemainderDone.new RemainderRoute.Done ]
        [ pair pair RemainderActive.new RemainderRoute.More ] list.case
    ]

    signature remainder_shift forall<S:stack>
        [ S RemainderActive -- S RemainderShifted ! pure ]
    export remainder_shift
    def remainder_shift [
        RemainderActive.into unpair unpair swap
        [ swap unpair ] dip
        shift_in_bit pair pair RemainderShifted.new
    ]

    signature remainder_compare forall<S:stack>
        [ S RemainderShifted -- S RemainderCompared ! pure ]
    export remainder_compare
    def remainder_compare [
        dup RemainderShifted.into unpair swap drop
        unpair swap compare_bits
        0 i64.cmp -1 = pair RemainderCompared.new
    ]

    signature remainder_commit forall<S:stack>
        [ S RemainderCompared -- S RemainderCursor ! pure ]
    export remainder_commit
    def remainder_commit [
        RemainderCompared.into unpair
        [ RemainderShifted.into unpair unpair ] dip
        [ ] [ over subtract_bits ] if
        pair pair RemainderCursor.new
    ]

    # Consume the finite MSB-first dividend directly. Keep the running
    # remainder canonical and never construct discarded quotient bits or
    # descend through four separately named cursor states per source bit.
    signature remainder_run forall<S:stack>
        [ S RemainderCursor -- S RemainderDone ! pure ]
    export remainder_run
    def remainder_run [
        RemainderCursor.into unpair unpair
        pair swap pair
        [ unpair
          [ nil pair false ]
          [ [ swap unpair [ swap ] dip swap
              [ swap ] dip swap
              [ swap dup
                [ true ] [ drop drop false ] list.case
                [ drop [ true nil cons ] [ nil ] if ]
                [ cons ] if ] dip
              [ dup ] dip swap [ dup ] dip swap compare_bits
              0 i64.cmp -1 =
              [ swap ]
              [ [ dup ] dip swap [ dup ] dip swap subtract_bits
                [ swap ] dip swap drop ] if
              pair ] dip
            pair true ] list.case
        ] iterate
        unpair drop unpair swap drop RemainderDone.new
    ]

    signature remainder_finish forall<S:stack>
        [ S RemainderDone -- S List<Bool> ! pure ]
    export remainder_finish
    def remainder_finish [ RemainderDone.into ]

    signature divide_bits_raw forall<S:stack>
        [ S List<Bool> List<Bool>
          -- S Pair<List<Bool>,List<Bool>> ! pure ]
    def divide_bits_raw [
        [ reverse_bits ] dip
        nil nil pair pair pair
        [ unpair swap
          [ nil swap pair false ]
          [ [ division_step ] dip swap pair true ] list.case
        ] iterate
        unpair swap drop unpair swap drop unpair swap pair
    ]

    signature divide_bits forall<S:stack>
        [ S List<Bool> List<Bool>
          -- S Pair<List<Bool>,List<Bool>> ! pure ]
    export divide_bits
    def divide_bits [ divide_bits_raw unpair [ trim_bits ] dip pair ]

    signature remainder_bits forall<S:stack>
        [ S List<Bool> List<Bool> -- S List<Bool> ! pure ]
    def remainder_bits [ divide_bits_raw unpair swap drop ]

    signature gcd_bits forall<S:stack>
        [ S List<Bool> List<Bool> -- S List<Bool> ! pure ]
    export gcd_bits
    def gcd_bits [
        pair
        [ dup unpair bits_empty
          [ drop false ]
          [ drop unpair dup [ remainder_bits ] dip
            swap pair true ] if
        ] iterate
        unpair drop
    ]

    signature bits_from_i64_nonnegative forall<S:stack>
        [ S I64 -- S List<Bool> ! pure ]
    export bits_from_i64_nonnegative
    def bits_from_i64_nonnegative [
        nil pair
        [ unpair swap dup 0 =
          [ swap pair false ]
          [ 2 i64.div-rem drop 1 = rot cons pair true ] if
        ] iterate
        unpair swap drop reverse_bits
    ]

    signature bits_to_i64_positive forall<S:stack>
        [ S List<Bool> -- S I64 ! pure ]
    export bits_to_i64_positive
    def bits_to_i64_positive [
        reverse_bits 0 pair
        [ unpair swap
          [ nil swap pair false ]
          [ [ bit_i64 ] dip rot 2 * rot + pair true ] list.case
        ] iterate
        unpair swap drop
    ]

    signature count_one_bits forall<S:stack>
        [ S List<Bool> -- S I64 ! pure ]
    export count_one_bits
    def count_one_bits [
        0 pair
        [ unpair swap
          [ nil swap pair false ]
          [ [ bit_i64 ] dip [ + ] dip swap pair true ] list.case
        ] iterate
        unpair swap drop
    ]

    signature ten_bits forall<S:stack> [ S -- S List<Bool> ! pure ]
    export ten_bits
    def ten_bits [
        true nil cons false swap cons true swap cons false swap cons
    ]

    signature multiply_ten_bits forall<S:stack>
        [ S List<Bool> -- S List<Bool> ! pure ]
    export multiply_ten_bits
    def multiply_ten_bits [
        dup shift_once swap
        shift_once shift_once shift_once add_bits
    ]

    signature add_decimal_digit forall<S:stack>
        [ S List<Bool> I64 -- S List<Bool> ! pure ]
    export add_decimal_digit
    def add_decimal_digit [
        [ multiply_ten_bits ] dip
        bits_from_i64_nonnegative add_bits
