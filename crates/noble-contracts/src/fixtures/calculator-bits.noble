    signature add_bits forall<S:stack>
        [ S List<Bool> List<Bool> -- S List<Bool> ! pure ]
    export add_bits
    def add_bits [
        pair false nil pair pair
        [ unpair [ pop_two ] dip [ unpair ] dip
          rot unpair rot unpair
          [ add_three_bits ] dip
          rot swap cons pair
          pair dup unpair unpair drop
          should_continue_bits
