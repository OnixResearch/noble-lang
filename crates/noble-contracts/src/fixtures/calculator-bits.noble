    signature multiply_step forall<S:stack>
        [ S Pair<List<Bool>,List<Bool>> Bool
          -- S Pair<List<Bool>,List<Bool>> ! pure ]
    def multiply_step [
        [ dup unpair add_bits
          swap unpair drop shift_once swap pair ]
        [ unpair [ shift_once ] dip pair ] if
    ]

    signature multiply_bits forall<S:stack>
        [ S List<Bool> List<Bool> -- S List<Bool> ! pure ]
    export multiply_bits
    def multiply_bits [
        swap nil pair pair
        [ unpair swap
          [ nil swap pair false ]
          [ [ multiply_step ] dip swap pair true ] list.case
        ] iterate
        unpair swap drop unpair swap drop
    ]

    # The same schoolbook state as multiply_bits, but one certified
