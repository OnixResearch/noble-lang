        [ multiply_step ] dip
        swap pair MultiplyCursor.new
    ]

    signature multiply_add_probe forall<S:stack>
        [ S MultiplyActive -- S Pair<MultiplyActive,Bool> ! pure ]
    export multiply_add_probe
    def multiply_add_probe [
