    signature bool_xor forall<S:stack> [ S Bool Bool -- S Bool ! pure ]
    export bool_xor
    def bool_xor [ [ bool_not ] [ ] if ]

    signature shift_in_bit forall<S:stack>
        [ S List<Bool> Bool -- S List<Bool> ! pure ]
    def shift_in_bit [
        swap dup bits_empty
        [ drop [ true nil cons ] [ nil ] if ]
        [ cons ] if
    ]

    signature over forall<S:stack,A:value,B:value>
        [ S A B -- S A B A ! pure ]
    def over [ [ dup ] dip swap ]

    # Shared long-division digit: preserve the divisor, update only the
    # remainder, and return the quotient bit without allocating a quotient
    # cell when a caller needs only the remainder.
    signature division_digit forall<S:stack>
        [ S List<Bool> List<Bool> Bool
          -- S List<Bool> List<Bool> Bool ! pure ]
    def division_digit [
        rot [ shift_in_bit ] dip
        over over compare_bits
        0 i64.cmp -1 =
        [ swap false ]
        [ over over subtract_bits rot drop true ] if
    ]

    signature division_step forall<S:stack>
        [ S Pair<List<Bool>,Pair<List<Bool>,List<Bool>>> Bool
          -- S Pair<List<Bool>,Pair<List<Bool>,List<Bool>>> ! pure ]
    def division_step [
        [ unpair ] dip [ unpair ] dip [ swap ] dip
        [ swap ] dip swap [ division_digit ] dip
        cons
        rot [ pair ] dip swap pair
    ]

    # A Done token is created only when no dividend bits remain. Neither
    # quotient nor remainder may be extracted early from a live cursor.
    signature divide_start forall<S:stack>
        [ S List<Bool> List<Bool> -- S DivideCursor ! pure ]
    export divide_start
    def divide_start [
        [ reverse_bits ] dip
        nil nil pair pair pair DivideCursor.new
    ]

    signature divide_next forall<S:stack>
        [ S DivideCursor -- S DivideProgress ! pure ]
    export divide_next
    def divide_next [
        DivideCursor.into unpair swap
        [ unpair swap drop DivideDone.new DivideProgress.Done ]
        [ [ division_step ] dip
          swap pair DivideCursor.new DivideProgress.More ] list.case
    ]

    # This authenticated cursor consumes the finite dividend inside one
    # guest invocation. No selected submission is spent per quotient bit.
    signature divide_run forall<S:stack>
        [ S DivideCursor -- S DivideDone ! pure ]
    export divide_run
    def divide_run [
        DivideCursor.into unpair swap pair
        [ unpair
          [ nil pair false ]
          [ [ [ unpair ] dip [ unpair ] dip [ swap ] dip
              [ swap ] dip swap
              [ [ swap ] dip swap
                [ swap dup
                  [ true ] [ drop drop false ] list.case
                  [ drop [ true nil cons ] [ nil ] if ]
                  [ cons ] if ] dip
                [ dup ] dip swap [ dup ] dip swap compare_bits
                0 i64.cmp -1 =
                [ swap false ]
                [ [ dup ] dip swap [ dup ] dip swap subtract_bits
                  [ swap ] dip swap drop true ] if
              ] dip
              cons
              [ swap ] dip swap [ pair ] dip swap pair
            ] dip
            pair true ] list.case
        ] iterate
        unpair drop unpair swap drop DivideDone.new
    ]

    # Keep divisor, shifted remainder, quotient and remaining dividend sealed
    # across selected submissions. A comparison token is the only input to
    # subtraction; only an empty dividend can issue DivideDone.
    signature divide_route forall<S:stack>
        [ S DivideCursor -- S DivideRoute ! pure ]
    export divide_route
    def divide_route [
        DivideCursor.into unpair swap
        [ unpair swap drop DivideDone.new DivideRoute.Done ]
        [ pair pair DivideActive.new DivideRoute.More ] list.case
    ]

    signature divide_shift_state forall<S:stack>
        [ S Pair<List<Bool>,Pair<List<Bool>,List<Bool>>> Bool
          -- S Pair<List<Bool>,Pair<List<Bool>,List<Bool>>> ! pure ]
    def divide_shift_state [
        [ unpair ] dip [ unpair ] dip
        swap [ shift_in_bit ] dip
        pair pair
    ]

    signature divide_shift forall<S:stack>
        [ S DivideActive -- S DivideShifted ! pure ]
    export divide_shift
    def divide_shift [
