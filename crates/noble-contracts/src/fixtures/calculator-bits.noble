    signature bit_count forall<S:stack> [ S List<Bool> -- S I64 ! pure ]
    export bit_count
    def bit_count [
        0 pair
        [ unpair swap
          [ nil swap pair false ]
          [ swap [ swap ] dip drop 1 + pair true ] list.case
        ] iterate
        unpair swap drop
    ]

    signature pop_bit_values forall<S:stack>
        [ S List<Bool> -- S Bool List<Bool> ! pure ]
    def pop_bit_values [ [ false nil ] [ ] list.case ]

    signature pop_two forall<S:stack>
        [ S Pair<List<Bool>,List<Bool>>
          -- S Pair<Pair<Bool,Bool>,Pair<List<Bool>,List<Bool>>> ! pure ]
    export pop_two
    def pop_two [
        unpair [ pop_bit_values ] dip pop_bit_values
