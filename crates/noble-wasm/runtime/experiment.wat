;; Driver protocol: begin, construct, invoke/reflect, inspect, cleanup. No host imports.
(func $publish (param $program i32) (result i32)
 (if (i32.eqz (global.get $failure)) (then
  (if (i32.ne (call $kind (local.get $program)) (i32.const 4))
   (then (call $fail (i32.const 4))))))
 (if (i32.eqz (global.get $failure)) (then
  (if (i32.gt_u (call $n (local.get $program)) (global.get $recipe_limit))
   (then (call $quota (i32.const 2))))
  (if (i32.gt_u (call $w (local.get $program)) (global.get $depth_limit))
   (then (call $quota (i32.const 3))))))
 (if (global.get $failure)
  (then (call $cleanup_internal))
  (else (global.set $observed_program (local.get $program))))
 (global.get $failure))
(func (export "build_static") (param $index i32) (result i32)
 (global.set $phase (i32.const 0))
 (call $publish (call $vocab (local.get $index))))
(func (export "build_capture") (param $capture i64) (param $path i32) (result i32)
 (local $builder i32) (local $result i32) (local $tag i32)
 (global.set $phase (i32.const 0))
 (if (i32.gt_u (local.get $path) (i32.const 4))
  (then (call $fail (i32.const 4)) (return (call $publish (i32.const 0)))))
 ;; 0 add-builder, 1 quote-builder, 2 quote in list, 3 quote in pair, 4 adder in pair.
 (local.set $builder (i32.add (local.get $path) (i32.const 4)))
 (if (i32.eqz (local.get $path)) (then (local.set $builder (i32.const 3))))
 (if (i32.eq (local.get $path) (i32.const 1)) (then (local.set $builder (i32.const 4))))
 (call $push_i64 (local.get $capture))
 (call $enqueue_program (call $vocab (local.get $builder)))
 (call $dispatch)
 (if (global.get $failure) (then (return (call $publish (i32.const 0)))))
 (if (i32.ne (global.get $sp) (i32.const 1))
  (then (call $fail (i32.const 4)) (return (call $publish (i32.const 0)))))
 (local.set $tag (i32.const 4))
 (if (i32.eq (local.get $path) (i32.const 2)) (then (local.set $tag (i32.const 6))))
 (if (i32.ge_u (local.get $path) (i32.const 3)) (then (local.set $tag (i32.const 5))))
 (local.set $result (i32.wrap_i64 (call $pop_kind (local.get $tag))))
 (if (global.get $failure) (then (return (call $publish (i32.const 0)))))
 (if (i32.ge_u (local.get $path) (i32.const 2)) (then (local.set $result (call $a (local.get $result)))))
 (call $publish (local.get $result)))
(func $leaf (param $index i32) (result i32) (call $vocab (i32.and (local.get $index) (i32.const 1))))
(func $frontier_address (param $index i32) (result i32)
 (i32.add (i32.const 8192) (i32.mul (local.get $index) (i32.const 4))))
(func (export "build_tree") (param $shape i32) (param $leaves i32) (result i32)
 (local $at i32) (local $width i32) (local $next i32) (local $root i32) (local $right i32)
 (global.set $phase (i32.const 0))
 (if (i32.or (i32.eqz (local.get $leaves)) (i32.gt_u (local.get $shape) (i32.const 2)))
  (then (call $fail (i32.const 4)) (return (call $publish (i32.const 0)))))
 (if (i32.gt_u (local.get $leaves) (global.get $recipe_limit))
  (then (call $quota (i32.const 2)) (return (call $publish (i32.const 0)))))
 (if (i32.eqz (local.get $shape)) (then
  (local.set $root (call $leaf (i32.const 0))) (local.set $at (i32.const 1))
  (block $left_done (loop $left
   (br_if $left_done (i32.or (global.get $failure) (i32.ge_u (local.get $at) (local.get $leaves))))
   (local.set $root (call $compose (local.get $root) (call $leaf (local.get $at))))
   (local.set $at (i32.add (local.get $at) (i32.const 1))) (br $left)))
  (return (call $publish (local.get $root)))))
 (if (i32.eq (local.get $shape) (i32.const 1)) (then
  (local.set $at (i32.sub (local.get $leaves) (i32.const 1)))
  (local.set $root (call $leaf (local.get $at)))
  (block $right_done (loop $right_loop
   (br_if $right_done (i32.or (global.get $failure) (i32.eqz (local.get $at))))
   (local.set $at (i32.sub (local.get $at) (i32.const 1)))
   (local.set $root (call $compose (call $leaf (local.get $at)) (local.get $root))) (br $right_loop)))
  (return (call $publish (local.get $root)))))
 (loop $fill
  (i32.store (call $frontier_address (local.get $at)) (call $leaf (local.get $at)))
  (local.set $at (i32.add (local.get $at) (i32.const 1)))
  (br_if $fill (i32.lt_u (local.get $at) (local.get $leaves))))
 (local.set $width (local.get $leaves))
 (block $balanced_done (loop $level
  (br_if $balanced_done (i32.or (global.get $failure) (i32.le_u (local.get $width) (i32.const 1))))
  (local.set $at (i32.const 0)) (local.set $next (i32.const 0))
  (block $pairs_done (loop $pairs
   (br_if $pairs_done (i32.or (global.get $failure) (i32.ge_u (local.get $at) (local.get $width))))
   (local.set $root (i32.load (call $frontier_address (local.get $at))))
   (local.set $right (i32.add (local.get $at) (i32.const 1)))
   (if (i32.lt_u (local.get $right) (local.get $width))
    (then (local.set $root (call $compose (local.get $root) (i32.load (call $frontier_address (local.get $right)))))))
   (i32.store (call $frontier_address (local.get $next)) (local.get $root))
   (local.set $next (i32.add (local.get $next) (i32.const 1)))
   (local.set $at (i32.add (local.get $at) (i32.const 2))) (br $pairs)))
  (local.set $width (local.get $next)) (br $level)))
 (call $publish (i32.load (call $frontier_address (i32.const 0)))))
(func $invocation_ready (param $signature i32) (result i32)
 (global.set $phase (i32.const 1))
 (if (global.get $failure) (then (return (i32.const 0))))
 (if (i32.or (i32.eqz (global.get $observed_program)) (i32.or (global.get $sp) (global.get $cp)))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (if (i32.ne (call $y (global.get $observed_program)) (local.get $signature))
  (then (call $fail (i32.const 3)) (return (i32.const 0))))
 (global.set $steps (i32.const 0)) (global.set $continuation_peak (i32.const 0))
 (global.set $operand_peak (i32.const 0)) (global.set $quote_invocations (i32.const 0))
 (i32.const 1))
(func $finish_invocation (result i32)
 (if (global.get $failure) (then (call $cleanup_internal)))
 (global.get $failure))
(func (export "invoke") (param $input i64) (param $has_input i32) (result i32) (local $signature i32)
 (local.set $signature (global.get $sig_empty))
 (if (local.get $has_input) (then (local.set $signature (global.get $sig_i64))))
 (if (i32.gt_u (local.get $has_input) (i32.const 1)) (then (call $fail (i32.const 4))))
 (if (i32.eqz (call $invocation_ready (local.get $signature))) (then (return (call $finish_invocation))))
 (if (local.get $has_input) (then (call $push_i64 (local.get $input))))
 (call $enqueue_program (global.get $observed_program)) (call $dispatch)
 (call $finish_invocation))
(func (export "invoke2") (param $left i64) (param $right i64) (result i32)
 (if (i32.eqz (call $invocation_ready (global.get $sig_i64_i64))) (then (return (call $finish_invocation))))
 (call $push_i64 (local.get $left)) (call $push_i64 (local.get $right))
 (call $enqueue_program (global.get $observed_program)) (call $dispatch)
 (call $finish_invocation))
(func (export "run_list") (param $choice i32) (param $input i64) (result i32)
 (global.set $phase (i32.const 1))
 (if (i32.gt_u (local.get $choice) (i32.const 1))
  (then (call $fail (i32.const 4)) (return (call $finish_invocation))))
 (global.set $observed_program (call $vocab (local.get $choice)))
 (call $push_i64 (local.get $input)) (call $push_ref (global.get $observed_program))
 (call $enqueue_program (call $vocab (i32.const 5))) (call $dispatch)
 (call $finish_invocation))
(func (export "run_continuation") (param $choice i32) (param $input i64) (result i32)
 (global.set $phase (i32.const 1))
 (if (i32.gt_u (local.get $choice) (i32.const 1))
  (then (call $fail (i32.const 4)) (return (call $finish_invocation))))
 (call $push_i64 (local.get $input)) (call $push_ref (call $vocab (local.get $choice)))
 (call $enqueue_program (call $vocab (i32.const 10))) (call $dispatch)
 (call $finish_invocation))
(func (export "result") (param $index i32) (result i64)
 (if (i32.ne (call $slot_kind (local.get $index)) (i32.const 1))
  (then (call $fail (i32.const 4)) (return (i64.const 0))))
 (call $slot_value (local.get $index)))
(func (export "program_depth") (result i32)
 (if (i32.eqz (global.get $observed_program)) (then (return (i32.const 0))))
 (call $w (global.get $observed_program)))
(func (export "program_leaves") (result i32)
 (if (i32.eqz (global.get $observed_program)) (then (return (i32.const 0))))
 (call $n (global.get $observed_program)))
