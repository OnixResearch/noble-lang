;; Opt-in source heap. Handle = (epoch << 12) | (physical_slot - 1),
;; initially epoch=1. The full handle survives retirement in the cell header;
;; exhausted epochs permanently retire that one physical slot rather than wrap.
;; Dedicated sidecar [1052672,1077248) holds u16 incoming, saved and
;; module-global root counts (4096 entries each). Recipe measurement uses
;; [8192,12288); its scratch must never alias live reference counts.
;; [57344,57356) holds live count, free-list head and dispatch guard.
;; Each cell's kind word stores the logical kind in its low byte and the
;; independent ordinary external-root count in its high 24 bits. Saved and
;; module roots have distinct counters so one release cannot consume another.
(func $linear_address (param $h i32) (result i32)
 (if (i32.lt_u (local.get $h) (i32.const 4096)) (then unreachable))
 (i32.add (i32.const 65536)
  (i32.mul (i32.and (local.get $h) (i32.const 4095)) (i32.const 48))))
(func $storage_live_count (result i32) (i32.load (i32.const 57344)))
(func $storage_next_slot (result i32)
 (if (result i32) (i32.load (i32.const 57348))
  (then (i32.load (i32.const 57348)))
  (else (i32.add (global.get $heap_cursor) (i32.const 1)))))
(func $storage_is_live (param $h i32) (result i32) (local $p i32)
 (if (i32.or (i32.lt_u (local.get $h) (i32.const 4096))
             (i32.ge_u (i32.and (local.get $h) (i32.const 4095)) (global.get $heap_cursor)))
  (then (return (i32.const 0))))
 (local.set $p (call $linear_address (local.get $h)))
 (i32.and (i32.eq (i32.load offset=4 (local.get $p)) (local.get $h))
  (i32.le_u (i32.sub (i32.and (i32.load (local.get $p)) (i32.const 255))
                         (i32.const 1)) (i32.const 16))))
(func $linear_live_address (param $h i32) (result i32)
 (if (i32.eqz (call $storage_is_live (local.get $h))) (then unreachable))
 (call $linear_address (local.get $h)))
(func $linear_child (param $child i32) (param $parent i32) (result i32)
 (if (local.get $child) (then (drop (call $linear_live_address (local.get $child)))))
 ;; Cells are published only after their existing children are validated. No
 ;; mutable child edge exists, so reuse of physical slots cannot create cycles.
 (local.get $child))
(func $storage_refs_address (param $slot i32) (result i32)
 (i32.add (i32.const 1052672)
  (i32.mul (i32.sub (local.get $slot) (i32.const 1)) (i32.const 2))))
(func $storage_saved_address (param $slot i32) (result i32)
 (i32.add (i32.const 1060864)
  (i32.mul (i32.sub (local.get $slot) (i32.const 1)) (i32.const 2))))
(func $storage_module_address (param $slot i32) (result i32)
 (i32.add (i32.const 1069056)
  (i32.mul (i32.sub (local.get $slot) (i32.const 1)) (i32.const 2))))
(func $storage_busy (result i32)
 (i32.or (i32.or (global.get $cp) (global.get $rp))
  (i32.load (i32.const 57352))))
(func $storage_slot (param $h i32) (result i32)
 (i32.add (i32.and (local.get $h) (i32.const 4095)) (i32.const 1)))
(func $storage_inc_ref (param $h i32)
 (local $p i32) (local $refs i32)
 (if (i32.eqz (local.get $h)) (then (return)))
 (drop (call $linear_live_address (local.get $h)))
 (local.set $p (call $storage_refs_address (call $storage_slot (local.get $h))))
 (local.set $refs (i32.load16_u (local.get $p)))
 (if (i32.eq (local.get $refs) (i32.const 65535)) (then unreachable))
 (i32.store16 (local.get $p) (i32.add (local.get $refs) (i32.const 1))))
(func $storage_dec_ref (param $h i32) (result i32)
 (local $p i32) (local $refs i32)
 (if (i32.eqz (local.get $h)) (then (return (i32.const 0))))
 (drop (call $linear_live_address (local.get $h)))
 (local.set $p (call $storage_refs_address (call $storage_slot (local.get $h))))
 (local.set $refs (i32.load16_u (local.get $p)))
 (if (i32.eqz (local.get $refs)) (then unreachable))
 (local.set $refs (i32.sub (local.get $refs) (i32.const 1)))
 (i32.store16 (local.get $p) (local.get $refs))
 (if (result i32) (i32.eqz (local.get $refs))
  (then (call $storage_slot (local.get $h))) (else (i32.const 0))))
(func $storage_init
 ;; Live source modules have no start; this initializes only a new private heap.
 (memory.fill (i32.const 65536) (i32.const 0) (i32.const 196608))
 (memory.fill (i32.const 1052672) (i32.const 0) (i32.const 24576))
 (i64.store (i32.const 57344) (i64.const 0))
 (i32.store (i32.const 57352) (i32.const 0)))
(func $storage_ensure (param $slot i32) (result i32)
 (i32.and (i32.le_u (i32.sub (local.get $slot) (i32.const 1)) (i32.const 4095))
  (i32.ge_u (memory.size) (i32.const 4))))
(func $storage_take_slot (result i32)
 (local $slot i32) (local $old i32) (local $next i32) (local $p i32)
 (local.set $slot (call $storage_next_slot))
 (if (i32.gt_u (i32.sub (local.get $slot) (i32.const 1)) (i32.const 4095))
  (then unreachable))
 (local.set $p (i32.add (i32.const 65536)
  (i32.mul (i32.sub (local.get $slot) (i32.const 1)) (i32.const 48))))
 (local.set $old (i32.load offset=4 (local.get $p)))
 (if (i32.load (local.get $p)) (then unreachable))
 (if (i32.load (i32.const 57348))
  (then
   (if (i32.or (i32.ne (i32.and (local.get $old) (i32.const 4095))
                        (i32.sub (local.get $slot) (i32.const 1)))
               (i32.gt_u (local.get $old) (i32.const -4097)))
    (then unreachable))
   (i32.store (i32.const 57348) (i32.load offset=8 (local.get $p)))
   (local.set $next (i32.add (local.get $old) (i32.const 4096))))
  (else
   (if (local.get $old) (then unreachable))
   (global.set $heap_cursor (local.get $slot))
   (local.set $next (i32.add (i32.const 4096)
    (i32.sub (local.get $slot) (i32.const 1))))))
 (i32.store16 (call $storage_refs_address (local.get $slot)) (i32.const 0))
 (i32.store16 (call $storage_saved_address (local.get $slot)) (i32.const 0))
 (i32.store16 (call $storage_module_address (local.get $slot)) (i32.const 0))
 (i32.store (i32.const 57344) (i32.add (call $storage_live_count) (i32.const 1)))
 (local.get $next))
(func $storage_discard (param $h i32)
 (local $slot i32) (local $p i32)
 (local.set $p (call $linear_live_address (local.get $h)))
 (local.set $slot (call $storage_slot (local.get $h)))
 (if (i32.load16_u (call $storage_refs_address (local.get $slot))) (then unreachable))
 (if (i32.or
       (i32.load16_u (call $storage_saved_address (local.get $slot)))
       (i32.load16_u (call $storage_module_address (local.get $slot))))
  (then unreachable))
 ;; Preserve the full old id for the next epoch and invalidate the kind first.
 (i32.store (local.get $p) (i32.const 0))
 (if (i32.le_u (local.get $h) (i32.const -4097))
  (then
   (i32.store offset=8 (local.get $p) (i32.load (i32.const 57348)))
   (i32.store (i32.const 57348) (local.get $slot))))
 (i32.store (i32.const 57344) (i32.sub (call $storage_live_count) (i32.const 1)))
 (global.set $released_total (i64.add (global.get $released_total) (i64.const 48))))
(func $new
 (param $kind i32) (param $payload i64)
 (param $a i32) (param $b i32) (param $c i32)
 (param $x i32) (param $y i32) (param $z i32)
 (param $w i32) (param $n i32) (result i32)
 (local $h i32) (local $p i32)
 (local.set $h (call $reserve))
 (if (i32.eqz (local.get $h)) (then (return (i32.const 0))))
 (local.set $p (call $linear_address (local.get $h)))
 (if (i32.gt_u (i32.sub (local.get $kind) (i32.const 1)) (i32.const 16))
  (then unreachable))
 (local.set $a (call $linear_child (local.get $a) (local.get $h)))
 (local.set $b (call $linear_child (local.get $b) (local.get $h)))
 (local.set $c (call $linear_child (local.get $c) (local.get $h)))
 (call $storage_inc_ref (local.get $a))
 (call $storage_inc_ref (local.get $b))
 (call $storage_inc_ref (local.get $c))
 (i64.store offset=8 (local.get $p) (local.get $payload))
 (i32.store offset=16 (local.get $p) (local.get $a))
 (i32.store offset=20 (local.get $p) (local.get $b))
 (i32.store offset=24 (local.get $p) (local.get $c))
 (i32.store offset=28 (local.get $p) (local.get $x))
 (i32.store offset=32 (local.get $p) (local.get $y))
 (i32.store offset=36 (local.get $p) (local.get $z))
 (i32.store offset=40 (local.get $p) (local.get $w))
 (i32.store offset=44 (local.get $p) (local.get $n))
 (i32.store offset=4 (local.get $p) (local.get $h))
 (i32.store (local.get $p) (local.get $kind))
 (local.get $h))
;; External roots are independently pinned by the host. Graph and runtime
;; roots are accounted by the backend itself, never by a host claim.
(func $storage_retain_target (param $h i32) (result i32)
 (local $p i32) (local $cell i32) (local $kind i32)
 (if (call $storage_busy) (then (return (i32.const 4))))
 (if (i32.eqz (call $storage_is_live (local.get $h))) (then (return (i32.const 4))))
 (local.set $cell (call $linear_address (local.get $h)))
 (local.set $kind (i32.load (local.get $cell)))
 (local.set $p (call $storage_refs_address (call $storage_slot (local.get $h))))
 (if (i32.or (i32.eq (i32.load16_u (local.get $p)) (i32.const 65535))
             (i32.eq (i32.shr_u (local.get $kind) (i32.const 8))
                     (i32.const 16777215)))
  (then (return (i32.const 4))))
 (call $storage_inc_ref (local.get $h))
 (i32.store (local.get $cell) (i32.add (local.get $kind) (i32.const 256)))
 (i32.const 0))
(func $storage_retire_target (param $h i32) (result i32)
 (local $cell i32) (local $kind i32)
 (if (call $storage_busy) (then (return (i32.const 4))))
 (if (i32.eqz (call $storage_is_live (local.get $h))) (then (return (i32.const 4))))
