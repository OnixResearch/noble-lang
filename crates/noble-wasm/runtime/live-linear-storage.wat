;; The work queue uses reflection's traversal scratch only while idle. It does
;; not overwrite stored recipe events or the host-owned sidecar above 1 MiB.
(func $storage_queue (param $at i32) (param $slot i32)
 (if (i32.ge_u (local.get $at) (i32.const 4096)) (then unreachable))
 (i32.store16 (i32.add (i32.const 12288) (i32.mul (local.get $at) (i32.const 2)))
  (i32.sub (local.get $slot) (i32.const 1))))
(func $storage_collect (result i32)
