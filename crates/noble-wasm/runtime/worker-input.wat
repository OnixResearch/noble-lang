;; Only opt-in worker compilations expose host-owned composite injection.
(func (export "host_i64") (param $value i64) (result i32)
 (call $new (i32.const 1) (local.get $value)
  (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)
  (i32.const 0) (i32.const 0) (i32.const 0)))
(func (export "host_bool") (param $value i32) (result i32)
 (if (i32.gt_u (local.get $value) (i32.const 1))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (call $new (i32.const 2) (i64.extend_i32_u (local.get $value))
  (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)
  (i32.const 0) (i32.const 0) (i32.const 0)))
(func (export "host_unit") (result i32)
 (call $new (i32.const 3) (i64.const 0)
  (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)
  (i32.const 0) (i32.const 0) (i32.const 0)))
(func (export "host_text") (param $address i32) (param $length i32) (result i32)
 (if (i64.gt_u
  (i64.add (i64.extend_i32_u (local.get $address)) (i64.extend_i32_u (local.get $length)))
  (i64.shl (i64.extend_i32_u (memory.size)) (i64.const 16)))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (call $text (local.get $address) (local.get $length)))
(func (export "host_pair") (param $left i32) (param $right i32) (result i32)
 (if (i32.eqz (i32.and (call $is_live (local.get $left)) (call $is_live (local.get $right))))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (call $new (i32.const 5) (i64.const 0) (local.get $left) (local.get $right)
  (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
(func (export "host_list_nil") (result i32)
 (call $new (i32.const 7) (i64.const 0)
  (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)
  (i32.const 0) (i32.const 0) (i32.const 0)))
(func (export "host_list_cons") (param $head i32) (param $tail i32) (result i32)
 (if (i32.eqz (i32.and (call $is_live (local.get $head)) (call $is_live (local.get $tail))))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (if (i32.and (i32.ne (call $kind (local.get $tail)) (i32.const 6))
              (i32.ne (call $kind (local.get $tail)) (i32.const 7)))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (call $new (i32.const 6) (i64.const 0) (local.get $head) (local.get $tail)
  (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
(func (export "host_sum") (param $arm i32) (param $payload i32) (result i32)
 (if (i32.or (i32.gt_u (local.get $arm) (i32.const 1))
             (i32.eqz (call $is_live (local.get $payload))))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (call $new (i32.add (i32.const 12) (local.get $arm)) (i64.const 0)
  (local.get $payload) (i32.const 0) (i32.const 0) (i32.const 0)
  (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
(func (export "host_nominal")
 (param $module i64) (param $ordinal i32) (param $arm i32) (param $payload i32)
 (result i32)
 (if (i32.or (i32.gt_u (local.get $arm) (i32.const 2))
             (i32.eqz (call $is_live (local.get $payload))))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (call $new (i32.add (i32.const 12)
   (i32.eq (local.get $arm) (i32.const 2))) (i64.const 0)
  (local.get $payload) (i32.const 0) (i32.const 0)
  (i32.wrap_i64 (local.get $module))
  (i32.wrap_i64 (i64.shr_u (local.get $module) (i64.const 32)))
  (local.get $ordinal) (i32.add (i32.const 1) (i32.ne (local.get $arm) (i32.const 0)))
  (i32.const 0)))
(func (export "host_push") (param $handle i32) (result i32)
 (if (i32.eqz (call $is_live (local.get $handle)))
  (then (call $fail (i32.const 4)) (return (global.get $failure))))
 (call $push_ref (local.get $handle)) (global.get $failure))
