;; Only source-authenticated, pure universal Program cells use this ABI.
;; Descriptors are immutable cells; the separate linear-memory slots are
;; initialized once before a Program can be published or dispatched.
(func $universal_address (param $address i32) (param $length i32) (result i32)
 (if (i32.or (i32.lt_u (local.get $address) (i32.const 262144))
     (i32.gt_u (local.get $address) (i32.const 1048576)))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (if (i32.or (i32.ne (i32.and (local.get $address) (i32.const 3)) (i32.const 0))
     (i32.gt_u (local.get $length) (i32.sub (i32.const 1048576) (local.get $address))))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (i32.const 1))
(func $universal_entry (param $environment i32) (param $entry i32)
 (param $identity i64) (param $definition i32) (result i32)
 (local $descriptor i32) (local $slot i32)
 (if (global.get $failure) (then (return (i32.const 0))))
 (if (i32.eqz (local.get $environment))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (if (i32.or (i32.ne (call $kind (local.get $environment)) (i32.const 4))
     (i32.ne (call $x (local.get $environment)) (local.get $entry)))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (local.set $descriptor (call $a (local.get $environment)))
 (if (i32.eqz (local.get $descriptor))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (if (i32.ne (call $kind (local.get $descriptor)) (i32.const 9))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (if (i32.or (i64.ne (call $payload (local.get $descriptor)) (local.get $identity))
     (i32.ne (call $n (local.get $descriptor)) (local.get $definition)))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (if (i32.ne (call $z (local.get $descriptor)) (global.get $source_epoch_generation))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (local.set $slot (call $w (local.get $descriptor)))
 (if (i32.eqz (call $universal_address (local.get $slot) (i32.const 4)))
  (then (return (i32.const 0))))
 (if (i32.ne (i32.load (local.get $slot)) (local.get $environment))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (i32.const 1))
(func $universal_site (param $environment i32) (param $index i32)
 (param $node i32) (param $action i32)
 (param $identity i64) (param $definition i32) (result i32)
 (local $descriptor i32) (local $base i32) (local $count i32)
 (local $address i32) (local $slot i32)
 (if (global.get $failure) (then (return (i32.const 0))))
 (if (i32.ne (call $kind (local.get $environment)) (i32.const 4))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (local.set $descriptor (call $a (local.get $environment)))
 (if (i32.eqz (local.get $descriptor))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (if (i32.ne (call $kind (local.get $descriptor)) (i32.const 9))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (if (i32.or (i64.ne (call $payload (local.get $descriptor)) (local.get $identity))
     (i32.ne (call $n (local.get $descriptor)) (local.get $definition)))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (if (i32.ne (call $z (local.get $descriptor)) (global.get $source_epoch_generation))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (local.set $slot (call $w (local.get $descriptor)))
 (if (i32.eqz (call $universal_address (local.get $slot) (i32.const 4)))
  (then (return (i32.const 0))))
 (if (i32.ne (i32.load (local.get $slot)) (local.get $environment))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (local.set $base (call $x (local.get $descriptor)))
 (local.set $count (call $y (local.get $descriptor)))
 (if (i32.or (i32.ge_u (local.get $index) (local.get $count))
     (i32.gt_u (local.get $count) (i32.const 4096)))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (if (i32.eqz (call $universal_address (local.get $base)
     (i32.mul (local.get $count) (i32.const 40))))
  (then (return (i32.const 0))))
 (local.set $address (i32.add (local.get $base)
     (i32.mul (local.get $index) (i32.const 40))))
 (if (i32.or (i32.ne (i32.load (local.get $address)) (local.get $node))
     (i32.ne (i32.load offset=4 (local.get $address)) (local.get $action)))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (local.get $address))
(func $universal_target (param $environment i32) (param $index i32)
 (param $node i32) (param $action i32)
 (param $identity i64) (param $definition i32) (result i32)
 (local $site i32) (local $slot i32) (local $target i32) (local $descriptor i32)
 (local.set $site (call $universal_site (local.get $environment)
     (local.get $index) (local.get $node) (local.get $action)
     (local.get $identity) (local.get $definition)))
 (if (global.get $failure) (then (return (i32.const 0))))
 (local.set $slot (i32.load offset=8 (local.get $site)))
 (if (i32.eqz (call $universal_address (local.get $slot) (i32.const 4)))
  (then (return (i32.const 0))))
 (local.set $target (i32.load (local.get $slot)))
 (if (i32.eqz (local.get $target))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (if (i32.ne (call $kind (local.get $target)) (i32.const 4))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (local.set $descriptor (call $a (local.get $target)))
 (if (i32.eqz (local.get $descriptor))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (if (i32.ne (call $kind (local.get $descriptor)) (i32.const 9))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (if (i32.or (i32.ne (call $z (local.get $descriptor)) (global.get $source_epoch_generation))
     (i32.ne (call $w (local.get $descriptor)) (local.get $slot)))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (if (i32.or (i32.ne (call $y (local.get $target))
                       (i32.load offset=12 (local.get $site)))
     (i32.ne (call $z (local.get $target))
                       (i32.load offset=16 (local.get $site))))
  (then (call $fail (i32.const 3)) (return (i32.const 0))))
 (if (i32.or (i64.ne (call $payload (local.get $target))
                          (i64.extend_i32_u (i32.load offset=20 (local.get $site))))
     (i64.ne (call $payload (local.get $descriptor))
                          (i64.load offset=24 (local.get $site))))
  (then (call $fail (i32.const 3)) (return (i32.const 0))))
 (if (i32.or (i32.ne (call $n (local.get $descriptor))
                       (i32.load offset=32 (local.get $site)))
     (i32.ne (call $x (local.get $target))
                       (i32.load offset=36 (local.get $site))))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (local.get $target))
(func $universal_quote (param $environment i32) (param $index i32)
 (param $node i32) (param $identity i64) (param $definition i32)
 (local $site i32)
 (local.set $site (call $universal_site (local.get $environment)
     (local.get $index) (local.get $node) (i32.const 3)
     (local.get $identity) (local.get $definition)))
 (if (global.get $failure) (then (return)))
 (call $op_quote_typed (i32.load offset=12 (local.get $site))
                      (i32.load offset=16 (local.get $site))
                      (i32.load offset=20 (local.get $site))))
(func $universal_program (param $entry i32) (param $input i32) (param $output i32)
 (param $recipe i32) (param $depth i32) (param $leaves i32)
 (param $base i32) (param $count i32) (param $epoch i32)
 (param $slot i32) (param $identity i64) (param $definition i32)
 (result i32) (local $descriptor i32)
 (if (global.get $failure) (then (return (i32.const 0))))
 (if (i32.gt_u (local.get $leaves) (global.get $recipe_limit))
  (then (call $quota (i32.const 2)) (return (i32.const 0))))
 (if (i32.gt_u (local.get $depth) (global.get $depth_limit))
  (then (call $quota (i32.const 3)) (return (i32.const 0))))
 (if (i32.or (i32.ne (local.get $epoch) (global.get $source_epoch_generation))
     (i32.eqz (call $universal_address (local.get $slot) (i32.const 4))))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (if (i32.gt_u (local.get $count) (i32.const 4096))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (if (local.get $count)
  (then (if (i32.eqz (call $universal_address (local.get $base)
     (i32.mul (local.get $count) (i32.const 40))))
    (then (return (i32.const 0))))))
 (local.set $descriptor (call $new (i32.const 9) (local.get $identity)
   (i32.const 0) (i32.const 0) (i32.const 0)
   (local.get $base) (local.get $count) (local.get $epoch)
   (local.get $slot) (local.get $definition)))
 (if (global.get $failure) (then (return (i32.const 0))))
 (call $new (i32.const 4) (i64.const 0)
   (local.get $descriptor) (i32.const 0) (local.get $recipe)
   (local.get $entry) (local.get $input) (local.get $output)
   (local.get $depth) (local.get $leaves)))
(func $universal_bind_slot (param $program i32) (param $slot i32)
 (local $descriptor i32)
 (if (global.get $failure) (then (return)))
 (if (i32.eqz (call $universal_address (local.get $slot) (i32.const 4)))
  (then (return)))
 (if (i32.eqz (local.get $program))
  (then (call $fail (i32.const 4)) (return)))
 (if (i32.ne (call $kind (local.get $program)) (i32.const 4))
  (then (call $fail (i32.const 4)) (return)))
 (local.set $descriptor (call $a (local.get $program)))
 (if (i32.eqz (local.get $descriptor))
  (then (call $fail (i32.const 4)) (return)))
 (if (i32.ne (call $kind (local.get $descriptor)) (i32.const 9))
  (then (call $fail (i32.const 4)) (return)))
 (if (i32.or (i32.ne (call $z (local.get $descriptor)) (global.get $source_epoch_generation))
     (i32.ne (call $w (local.get $descriptor)) (local.get $slot)))
  (then (call $fail (i32.const 4)) (return)))
 (if (i32.ne (i32.load (local.get $slot)) (i32.const 0))
  (then (call $fail (i32.const 4)) (return)))
 (i32.store (local.get $slot) (local.get $program)))
