    core.str.Str.as_bytes (toStr
      ";; [57344,61440) is outside reflection events and source cell arenas.\n(func $type_certificate_reset\n(memory.fill (i32.const 57344) (i32.const 0) (i32.const 4096)))\n(func $type_certificate_address (param $type i32) (param $handle i32) (result i32)\n(i32.add (i32.const 57344)\n(i32.shl (i32.and (i32.xor (local.get $handle)\n(i32.mul (local.get $type) (i32.const 2654435761))) (i32.const 511))\n(i32.const 3))))\n(func $type_certificate_has (param $type i32) (param $handle i32) (result i32)\n(local $address i32)\n(local.set $address (call $type_certificate_address (local.get $type) (local.get $handle)))\n(i32.and (i32.eq (i32.load (local.get $address)) (i32.add (local.get $type) (i32.const 1)))\n(i32.eq (i32.load offset=4 (local.get $address)) (local.get $handle))))\n(func $type_certificate_put (param $type i32) (param $handle i32)\n(local $address i32)\n(local.set $address (call $type_certificate_address (local.get $type) (local.get $handle)))\n(i32.store offset=4 (local.get $address) (local.get $handle))\n(i32.store (local.get $address) (i32.add (local.get $type) (i32.const 1))))\n")
  output.Buffer.append out s

