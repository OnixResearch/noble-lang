    match shape with
    | source.types.Shape.Scalar _ => ok false
    | source.types.Shape.Resource _ => ok false
    | source.types.Shape.Pair _ _ => ok true
    | source.types.Shape.Sum _ _ => ok true
    | source.types.Shape.NominalOpaque _ _ => ok true
    | source.types.Shape.NominalVariant _ _ _ => ok true
    | source.types.Shape.List _ => ok true
    | source.types.Shape.Program _ _ _ => ok false
    | source.types.Shape.Syntax => ok false
    | source.types.Shape.Text => ok false
    | source.types.Shape.Contract => ok false
    | source.types.Shape.Evidence => ok false
    | source.types.Shape.Certified => ok false
  else ok false

