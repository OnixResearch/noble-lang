import NobleFoundation.PackedPermutation

/-!
Generated by the existing schedule_correspondence test target from the actual checked graph,
compiler layout and instruction streams, after binary encode/decode. The source test rejects
artifact-byte or corpus drift. Model validity is kernel checked per artifact; no proof binds
arbitrary Rust execution, host decoding or Rust checker to the Lean model (issue #129).
-/
namespace NobleFoundation.PackedPermutationCorpus
open NobleFoundation.PackedSchedule
open NobleFoundation.PackedPermutation

def nodes : List Node := 
  [.input 0,
   .input 1,
   .constant 0xFFFFFFFFFFFFFFFD,
   .add 0 1,
   .sub 1 0,
   .mul 3 2,
   .mul 4 2,
   .eq 5 6]
def regs : List Nat := [0, 1, 2, 3, 4, 5, 6, 7]
def nodeLayers : List Nat := [0, 0, 0, 1, 1, 2, 2, 3]
def layers : List (Nat × Nat) := [(0, 0), (0, 2), (2, 4), (4, 5)]
def preloads : List Instr := 
  [.setConst 2 0xFFFFFFFFFFFFFFFD,
   .setInput 0 0,
   .setInput 1 1]
def outputs : List Nat := [7, 3]
def outRegs : List Nat := [7, 3]

def canonicalWitness : List Nat := [3, 4, 5, 6, 7]
def canonicalInstrs : List Instr := 
  [.add 3 0 1,
   .sub 4 1 0,
   .mul 5 3 2,
   .mul 6 4 2,
   .eq 7 5 6]

theorem canonical_validated :
    validate nodes regs nodeLayers layers preloads canonicalWitness canonicalInstrs outputs outRegs = true := by
  decide

/-- Every input, with sufficient budget and no cancellation: a theorem about this model. -/
theorem canonical_sound (inputs : Nat → BitVec 64) :
    runOutputs inputs preloads canonicalInstrs outRegs =
      PackedSchedule.referenceOutputs (graph nodes) inputs outputs :=
  accepted_stream_sound nodes regs nodeLayers layers preloads canonicalWitness
    canonicalInstrs outputs outRegs canonical_validated inputs

def firstWitness : List Nat := [4, 3, 5, 6, 7]
def firstInstrs : List Instr := 
  [.sub 4 1 0,
   .add 3 0 1,
