   .eq 7 5 6]

theorem first_validated :
    validate nodes regs nodeLayers layers preloads firstWitness firstInstrs outputs outRegs = true := by
  decide

/-- Every input, with sufficient budget and no cancellation: a theorem about this model. -/
theorem first_sound (inputs : Nat → BitVec 64) :
    runOutputs inputs preloads firstInstrs outRegs =
      PackedSchedule.referenceOutputs (graph nodes) inputs outputs :=
  accepted_stream_sound nodes regs nodeLayers layers preloads firstWitness
    firstInstrs outputs outRegs first_validated inputs

