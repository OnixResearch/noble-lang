    validate nodes regs nodeLayers layers preloads [4, 5, 3, 6, 7] 
  [.sub 4 1 0,
   .mul 5 3 2,
   .add 3 0 1,
   .mul 6 4 2,
   .eq 7 5 6] outputs outRegs = false := by
  decide

