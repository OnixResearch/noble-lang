/-! ### `bitOr`: the candidate the examples alone admitted, refused -/

/-- The program the examples alone admitted, whose refinement found a counterexample. -/
def bitOr_refused : Pair :=
  { left := FirstProjection.ofList [.input 0, .input 1, .constant 0x0000000000000000, .constant 0x0000000000000000, .sub 0 1] 4,
    right := FirstProjection.ofList [.input 0, .input 1, .add 0 1, .mul 0 1, .sub 2 3] 4,
    outputs := [4] }

/-- The counterexample, as exact bits: the kernel decides `refuted` on them. -/
def bitOr_refusedWitness : Nat → BitVec 64 :=
  fun slot => if slot = 0 then 0x0000000000000001 else if slot = 1 then 0x0000000000000001 else 0x0000000000000000

theorem bitOr_refused_witness_refutes :
    refuted bitOr_refused bitOr_refusedWitness = true := by
  decide

/-- **The refused candidate has no certificate**, from its kernel-checked witness. -/
theorem bitOr_refused_not_certifiable :
    ¬ ∀ inputs, agreesOn bitOr_refused inputs :=
  not_certifiable_of_refuted bitOr_refused _ bitOr_refused_witness_refutes

