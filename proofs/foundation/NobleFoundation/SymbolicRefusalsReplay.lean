  ⟨"wrapBoundary", false, [.refuted, .refuted, .refuted, .refuted], .refuted⟩,
  ⟨"boolOutput", true, [.inconclusive, .inconclusive, .inconclusive, .inconclusive], .certified⟩,
  ⟨"repeatedOutputs", false, [.refuted, .refuted, .refuted, .refuted], .refuted⟩,
  ⟨"negation", false, [.refuted, .refuted, .refuted, .refuted], .refuted⟩,
]

/-- The kernel decides that `classify` reproduces every recorded row status from its tuple. -/
theorem receipt_rows_decide :
    (receiptRows.all fun row => classify row.observation == row.status) = true := by
  decide

/-- Every recorded row whose status is `certified` is classified `certified`. -/
theorem certified_rows_decide :
    ((receiptRows.filter fun row => row.status == .certified).all
      fun row => classify row.observation == .certified) = true := by
  decide

/-- Every recorded row whose status is `refuted` is classified `refuted`. -/
theorem refuted_rows_decide :
    ((receiptRows.filter fun row => row.status == .refuted).all
      fun row => classify row.observation == .refuted) = true := by
  decide

/-- Every recorded row whose status is `inconclusive` is classified `inconclusive`. -/
theorem inconclusive_rows_decide :
    ((receiptRows.filter fun row => row.status == .inconclusive).all
      fun row => classify row.observation == .inconclusive) = true := by
  decide

/-- Every recorded row whose status is `unsupported` is classified `unsupported`. -/
theorem unsupported_rows_decide :
    ((receiptRows.filter fun row => row.status == .unsupported).all
      fun row => classify row.observation == .unsupported) = true := by
  decide

/-- The kernel decides that claim aggregation reproduces every recorded claim status. -/
theorem claims_decide :
    (receiptClaims.all fun claim => claimStatus claim.certificate claim.runs == claim.status) = true := by
  decide

/-! ### Seeded mutations of `classify`, killed by named recorded rows -/

/-- Mutation `binding_first` changes `refusal/node budget` (a refused row whose binding is not current). -/
theorem mutation_binding_first_killed :
    classifyBindingFirst ⟨false, false, false, false, false, .notRun⟩ ≠ .unsupported := by
  decide

/-- Mutation `answer_first` changes `certificate/bound receipt, the positive control` (a certified row whose solver did not answer sat). -/
theorem mutation_answer_first_killed :
    classifyAnswerFirst ⟨true, true, true, false, false, .unsat⟩ ≠ .certified := by
  decide

/-- Mutation `encoding_checked` changes `corrupt/subtractionOrder/sub-order/bitwuzla` (a corrupted encoding whose model replayed). -/
theorem mutation_encoding_checked_killed :
    classifyEncodingChecked ⟨true, true, false, true, true, .sat⟩ false ≠ .refuted := by
  decide

/-- Mutation `sat_refutes` changes `witness/narrow value` (a sat answer whose model did not parse). -/
theorem mutation_sat_refutes_killed :
    classifySatRefutes ⟨true, true, false, false, false, .sat⟩ ≠ .inconclusive := by
  decide

/-- Mutation `unsat_certifies` changes `claim/sharedInput/sliced/bitwuzla` (external UNSAT without a certificate). -/
theorem mutation_unsat_certifies_killed :
    classifyUnsatCertifies ⟨true, true, false, false, false, .unsat⟩ ≠ .inconclusive := by
  decide

end NobleFoundation.SymbolicSolver.RefusalsReplay
