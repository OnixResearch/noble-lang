import NobleFoundation.FirstProjection

/-!
# Real packed I64/Bool artifacts, validated by the Lean kernel (issue #43)

Generated by `corpus.rs` from the declarations and streams `Compiled::new` emits; do not edit by
hand. The guarded artifact is generated in `PackedScheduleGuardCorpus.lean`.

For each artifact the kernel decides `validate` (`*_validated`), and `validate_sound` gives the
semantic theorem `*_sound`. Every `*_refused` theorem is a copy of the same artifact with one
obligation broken, and the kernel decides that `validate` refuses it. Every `*_agrees` theorem
states outputs the Rust packed machine computed at an input that the generator checked against the
Rust reference interpreter; the kernel evaluates `run` to the same outputs.

The exporter is untrusted: it claims which node each instruction computes, and a wrong claim is
refused. The packed machine preloads slot and constant tables into registers before the first layer;
those entries are exported as `setInput`/`setConst` at their packed positions. This validates these
artifacts, not the scheduler, Rust executor, host or engine.
-/

namespace NobleFoundation.PackedScheduleCorpus

open NobleFoundation.PackedSchedule

/-- Version of the generated packed-artifact Lean export vocabulary. -/
def packedExportTag : String := "ngraph-packed-export/0"

/-- The register map a finite list denotes. -/
def regOfList (regs : List Nat) (index : Nat) : Nat :=
  regs.getD index 0

/-- The inputs a finite list of slot values denotes. -/
def inputsOf (values : List (BitVec 64)) (slot : Nat) : BitVec 64 :=
  values.getD slot 0

/-! ## `interleaved`: two branches sharing both inputs, a constant, a Bool equality and two outputs -/

def interleavedNodes : List Node :=
  [.input 0,
   .input 1,
   .constant 0xFFFFFFFFFFFFFFFD,
   .add 0 1,
   .sub 1 0,
   .mul 3 2,
   .mul 4 2,
   .eq 5 6]

def interleavedGraph : Graph := FirstProjection.ofList interleavedNodes 7

def interleavedRegs : List Nat := [0, 1, 2, 3, 4, 5, 6, 7]

def interleavedOrder : List Nat := [0, 1, 2, 3, 4, 5, 6, 7]

def interleavedLayers : List (List Nat) := [[0, 1, 2], [3, 4], [5, 6], [7]]

def interleavedFailSuffixMin : List (Option Nat) := [none, none, none, none, none]

def interleavedLayerGuardOrder : List Nat := []

def interleavedInstrs : List Instr :=
  [.setInput 0 0,
   .setInput 1 1,
   .setConst 2 0xFFFFFFFFFFFFFFFD,
   .add 3 0 1,
   .sub 4 1 0,
   .mul 5 3 2,
   .mul 6 4 2,
   .eq 7 5 6]

def interleavedOutputs : List Nat := [7, 3]

def interleavedOutRegs : List Nat := [7, 3]

theorem interleaved_validated :
    validate interleavedGraph (regOfList interleavedRegs) interleavedOrder interleavedInstrs
      interleavedOutputs interleavedOutRegs = true := by
  decide

theorem interleaved_wellFormed : WellFormed interleavedGraph :=
  FirstProjection.ofList_wellFormed interleavedNodes 7 (by decide) (by decide)

/-- The exported stream returns the graph reference at every output, for every input. -/
theorem interleaved_sound (inputs : Nat → BitVec 64) :
    runOutputs inputs interleavedInstrs interleavedOutRegs =
      referenceOutputs interleavedGraph inputs interleavedOutputs :=
  validate_sound interleavedGraph interleaved_wellFormed (regOfList interleavedRegs) interleavedOrder
    interleavedInstrs interleavedOutputs interleavedOutRegs interleaved_validated inputs

/-- Refused: the first addition emitted as a subtraction. -/
theorem interleaved_wrong_operation_refused :
    validate interleavedGraph (regOfList interleavedRegs) interleavedOrder
      [.setInput 0 0,
       .setInput 1 1,
       .setConst 2 0xFFFFFFFFFFFFFFFD,
       .sub 3 0 1,
       .sub 4 1 0,
       .mul 5 3 2,
       .mul 6 4 2,
       .eq 7 5 6]
      interleavedOutputs [7, 3] = false := by
  decide

/-- Refused: the first subtraction's operands swapped. -/
theorem interleaved_swapped_operands_refused :
    validate interleavedGraph (regOfList interleavedRegs) interleavedOrder
      [.setInput 0 0,
       .setInput 1 1,
       .setConst 2 0xFFFFFFFFFFFFFFFD,
       .add 3 0 1,
       .sub 4 0 1,
       .mul 5 3 2,
       .mul 6 4 2,
       .eq 7 5 6]
      interleavedOutputs [7, 3] = false := by
  decide

/-- Refused: two instructions of one layer swapped. -/
theorem interleaved_reordered_within_layer_refused :
    validate interleavedGraph (regOfList interleavedRegs) interleavedOrder
      [.setInput 0 0,
       .setInput 1 1,
       .setConst 2 0xFFFFFFFFFFFFFFFD,
       .sub 4 1 0,
       .add 3 0 1,
       .mul 5 3 2,
       .mul 6 4 2,
       .eq 7 5 6]
      interleavedOutputs [7, 3] = false := by
  decide

/-- Refused: the last instruction dropped. -/
theorem interleaved_dropped_instruction_refused :
    validate interleavedGraph (regOfList interleavedRegs) interleavedOrder
      [.setInput 0 0,
       .setInput 1 1,
       .setConst 2 0xFFFFFFFFFFFFFFFD,
       .add 3 0 1,
       .sub 4 1 0,
       .mul 5 3 2,
       .mul 6 4 2]
      interleavedOutputs [7, 3] = false := by
  decide

/-- Refused: the first two output registers swapped. -/
theorem interleaved_swapped_outputs_refused :
    validate interleavedGraph (regOfList interleavedRegs) interleavedOrder
      [.setInput 0 0,
       .setInput 1 1,
       .setConst 2 0xFFFFFFFFFFFFFFFD,
       .add 3 0 1,
       .sub 4 1 0,
       .mul 5 3 2,
       .mul 6 4 2,
       .eq 7 5 6]
      interleavedOutputs [3, 7] = false := by
  decide

/-- The Rust packed machine, agreeing with its reference interpreter here, computed these
outputs, and the kernel evaluates `run` to the same. -/
theorem interleaved_execution_0_agrees :
    runOutputs (inputsOf [0x0000000000000003, 0x0000000000000008]) interleavedInstrs interleavedOutRegs =
      [some (.boolean false), some (.i64 0x000000000000000B)] := by
  decide

/-- The Rust packed machine, agreeing with its reference interpreter here, computed these
outputs, and the kernel evaluates `run` to the same. -/
theorem interleaved_execution_1_agrees :
    runOutputs (inputsOf [0x0000000000000000, 0x0000000000000000]) interleavedInstrs interleavedOutRegs =
      [some (.boolean true), some (.i64 0x0000000000000000)] := by
  decide

/-- The Rust packed machine, agreeing with its reference interpreter here, computed these
outputs, and the kernel evaluates `run` to the same. -/
theorem interleaved_execution_2_agrees :
    runOutputs (inputsOf [0xFFFFFFFFFFFFFFFF, 0x0000000000000001]) interleavedInstrs interleavedOutRegs =
      [some (.boolean false), some (.i64 0x0000000000000000)] := by
  decide

/-- The Rust packed machine, agreeing with its reference interpreter here, computed these
outputs, and the kernel evaluates `run` to the same. -/
theorem interleaved_execution_3_agrees :
    runOutputs (inputsOf [0x7FFFFFFFFFFFFFFF, 0x8000000000000004]) interleavedInstrs interleavedOutRegs =
      [some (.boolean false), some (.i64 0x0000000000000003)] := by
  decide

/-- The Rust packed machine, agreeing with its reference interpreter here, computed these
outputs, and the kernel evaluates `run` to the same. -/
theorem interleaved_execution_4_agrees :
    runOutputs (inputsOf [0x8000000000000000, 0xFFFFFFFFFFFFFFFF]) interleavedInstrs interleavedOutRegs =
      [some (.boolean true), some (.i64 0x7FFFFFFFFFFFFFFF)] := by
  decide

/-! ## `lateInput`: an input created after an addition it does not feed, moved ahead of it in packed order, and a repeated output -/

def lateInputNodes : List Node :=
  [.input 0,
   .constant 0x0000000000000005,
   .add 0 1,
   .input 1,
   .eq 2 3]

def lateInputGraph : Graph := FirstProjection.ofList lateInputNodes 4

def lateInputRegs : List Nat := [0, 1, 3, 2, 4]

def lateInputOrder : List Nat := [0, 1, 3, 2, 4]

def lateInputLayers : List (List Nat) := [[0, 1, 3], [2], [4]]

def lateInputFailSuffixMin : List (Option Nat) := [none, none, none, none]

def lateInputLayerGuardOrder : List Nat := []

def lateInputInstrs : List Instr :=
  [.setInput 0 0,
   .setConst 1 0x0000000000000005,
   .setInput 2 1,
   .add 3 0 1,
   .eq 4 3 2]

def lateInputOutputs : List Nat := [4, 4]

def lateInputOutRegs : List Nat := [4, 4]

theorem lateInput_validated :
    validate lateInputGraph (regOfList lateInputRegs) lateInputOrder lateInputInstrs
      lateInputOutputs lateInputOutRegs = true := by
  decide

theorem lateInput_wellFormed : WellFormed lateInputGraph :=
  FirstProjection.ofList_wellFormed lateInputNodes 4 (by decide) (by decide)

/-- The exported stream returns the graph reference at every output, for every input. -/
theorem lateInput_sound (inputs : Nat → BitVec 64) :
    runOutputs inputs lateInputInstrs lateInputOutRegs =
      referenceOutputs lateInputGraph inputs lateInputOutputs :=
  validate_sound lateInputGraph lateInput_wellFormed (regOfList lateInputRegs) lateInputOrder
    lateInputInstrs lateInputOutputs lateInputOutRegs lateInput_validated inputs

/-- Refused: the first addition emitted as a subtraction. -/
theorem lateInput_wrong_operation_refused :
    validate lateInputGraph (regOfList lateInputRegs) lateInputOrder
      [.setInput 0 0,
       .setConst 1 0x0000000000000005,
       .setInput 2 1,
       .sub 3 0 1,
       .eq 4 3 2]
      lateInputOutputs [4, 4] = false := by
  decide

/-- Refused: the last instruction dropped. -/
theorem lateInput_dropped_instruction_refused :
    validate lateInputGraph (regOfList lateInputRegs) lateInputOrder
      [.setInput 0 0,
       .setConst 1 0x0000000000000005,
       .setInput 2 1,
       .add 3 0 1]
      lateInputOutputs [4, 4] = false := by
  decide

