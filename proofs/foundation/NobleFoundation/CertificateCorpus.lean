import NobleFoundation.CertificateCodec
import NobleFoundation.FirstProjection

/-!
# The replayable-certificate fixture, kernel-checked at its wire tokens (issue #42)

Generated by `crates/noble-ngraph/tests/cert/corpus.rs` from the fixture `independent_folds` in
`crates/noble-ngraph/tests/cert/differential.rs`, its `cert::emit` derivation and the exact tokens
`cert::encode` wrote; do not edit by hand. `the_corpus_is_the_rust_fixture` fails when the fixture,
the derivation or the envelope changes, until this file is regenerated and the foundation lane
rerun.

For this one fixture the kernel decides:

* `wire_envelope_decodes`: the exact seven-token chunks the Rust encoder wrote decode to the
  modelled derivation under the literal revision and model tokens below;
* `derivation_is_accepted`: the modelled checker accepts the decoded derivation;
* `replay_matches_the_rust_result`: `applyDerivation` produces, node by node, the shapes the Rust
  result graph has;
* `reference_outputs_at_zero` and `reference_outputs_at_boundary`: the model's
  `referenceOutputs` at the Rust graph's declared output slots equal the values the compiled and
  reference evaluators returned (the generator checked both against an independent expectation);
* `stale_model_token_refused` and `stale_revision_token_refused`: the same chunks under the other
  model or revision token decode to nothing, so a transported certificate cannot silently apply to
  a different format or semantic model.

`accepted_endpoint_agreement` is not decided: it instantiates
`Certificate.accepted_endpoint_equivalence` at this fixture, so the model's replay theorem covers
the accepted derivation, and `certGraph_wellFormed` supplies the graph premise through
`FirstProjection.ofList_wellFormed`.

The one trusted translation is reading each Rust node operation as its `Node` term, the output
list as indices and the input values as `inputsOf`. This is kernel agreement and model coverage at
these exact bytes; it is not a proof about `cert.rs`, its encoder or any other graph.
-/

namespace NobleFoundation.Certificate.Corpus

open NobleFoundation.PackedSchedule
open NobleFoundation.Certificate
open NobleFoundation.CertificateCodec

/-- The inputs a finite list of slot values denotes. -/
def inputsOf (values : List (BitVec 64)) (slot : Nat) : BitVec 64 :=
  values.getD slot 0

/-! ## The fixture -/

/-- The original endpoint's nodes, in stored order. -/
def certNodes : List Node :=
  [.input 0,
   .input 1,
   .constant 0x0000000000000003,
   .constant 0x0000000000000005,
   .add 2 3,
   .constant 0x7FFFFFFFFFFFFFFF,
   .constant 0x0000000000000001,
   .add 5 6,
   .mul 0 4,
   .mul 1 6,
   .add 8 7,
   .sub 10 9]

/-- The original endpoint; the single `output` field names the subtraction, and the
full ordered output list is passed to `referenceOutputs` below. -/
def certGraph : Graph := NobleFoundation.FirstProjection.ofList certNodes 11

/-- The emitted derivation, decoded from the chunks below. -/
def certDerivation : Derivation where
  revision := "ngraph-cert/0"
  model := "ngraph-sem/0"
  steps :=
  [⟨0, 4, 2, 3, 0x0000000000000003, 0x0000000000000005, 0x0000000000000008⟩,
   ⟨0, 7, 5, 6, 0x7FFFFFFFFFFFFFFF, 0x0000000000000001, 0x8000000000000000⟩,
   ⟨2, 9, 1, 6, 0x0000000000000001, 0x0000000000000001, 0x0000000000000000⟩]

/-- The exact seven-token chunks `cert::encode` wrote, in wire order. -/
def certChunks : List (List String) :=
  [["0", "4", "2", "3", "3", "5", "8"],
   ["0", "7", "5", "6", "9223372036854775807", "1", "9223372036854775808"],
   ["2", "9", "1", "6", "1", "1", "0"]]

theorem certGraph_wellFormed : WellFormed certGraph :=
  NobleFoundation.FirstProjection.ofList_wellFormed certNodes 11 (by decide) (by decide)

theorem wire_envelope_decodes :
    decode "ngraph-cert/0" "ngraph-sem/0" 3 certChunks = some certDerivation := by
  decide

theorem stale_model_token_refused :
    decode "ngraph-cert/0" "ngraph-sem/1" 3 certChunks = none := by
  decide

theorem stale_revision_token_refused :
    decode "ngraph-cert/1" "ngraph-sem/0" 3 certChunks = none := by
  decide

theorem derivation_is_accepted : accepted certGraph certDerivation = true := by
  decide

/-- The replay's node shapes are the Rust result graph's, node by node. -/
theorem replay_matches_the_rust_result :
    [(applyDerivation certGraph certDerivation).node 0,
     (applyDerivation certGraph certDerivation).node 1,
     (applyDerivation certGraph certDerivation).node 2,
     (applyDerivation certGraph certDerivation).node 3,
     (applyDerivation certGraph certDerivation).node 4,
     (applyDerivation certGraph certDerivation).node 5,
     (applyDerivation certGraph certDerivation).node 6,
     (applyDerivation certGraph certDerivation).node 7,
     (applyDerivation certGraph certDerivation).node 8,
     (applyDerivation certGraph certDerivation).node 9,
     (applyDerivation certGraph certDerivation).node 10,
     (applyDerivation certGraph certDerivation).node 11] =
        [.input 0,
   .input 1,
   .constant 0x0000000000000003,
   .constant 0x0000000000000005,
   .constant 0x0000000000000008,
   .constant 0x7FFFFFFFFFFFFFFF,
   .constant 0x0000000000000001,
   .constant 0x8000000000000000,
   .mul 0 4,
   .mul 1 6,
   .add 8 7,
   .sub 10 9] := by
  decide

/-- The model's reference values at the fixture's declared output slots, repeated slot
included, at the all-zero input. -/
theorem reference_outputs_at_zero :
    referenceOutputs certGraph (inputsOf [0x0000000000000000, 0x0000000000000000]) [2, 3, 5, 10, 11, 11, 9] =
      [some (.i64 0x0000000000000003), some (.i64 0x0000000000000005), some (.i64 0x7FFFFFFFFFFFFFFF), some (.i64 0x8000000000000000), some (.i64 0x8000000000000000), some (.i64 0x8000000000000000), some (.i64 0x0000000000000000)] := by
  decide

/-- The same at a boundary input pair. -/
theorem reference_outputs_at_boundary :
    referenceOutputs certGraph (inputsOf [0xFFFFFFFFFFFFFFFD, 0x0000000000000001]) [2, 3, 5, 10, 11, 11, 9] =
      [some (.i64 0x0000000000000003), some (.i64 0x0000000000000005), some (.i64 0x7FFFFFFFFFFFFFFF), some (.i64 0x7FFFFFFFFFFFFFE8), some (.i64 0x7FFFFFFFFFFFFFE7), some (.i64 0x7FFFFFFFFFFFFFE7), some (.i64 0x0000000000000001)] := by
  decide

/-- The model's replay theorem at this fixture: every node's denotation is preserved. -/
theorem accepted_endpoint_agreement :
    ∀ index, value certGraph (inputsOf [0x0000000000000000, 0x0000000000000000]) index =
      value (applyDerivation certGraph certDerivation) (inputsOf [0x0000000000000000, 0x0000000000000000]) index :=
  accepted_endpoint_equivalence certGraph certGraph_wellFormed certDerivation
    derivation_is_accepted (inputsOf [0x0000000000000000, 0x0000000000000000])

end NobleFoundation.Certificate.Corpus
