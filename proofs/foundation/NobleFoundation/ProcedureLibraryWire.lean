/-!
Lean-generated byte differential for issue #118's immutable procedure subject.
The modeled source chunks have I64/operation nodes, no captures or chunk
dependencies, and the fixed I64/I64 -> I64 empty-effect interface. The model
also writes their actual instantiation bindings, optional provenance fields
and ordered library-dependency closure. The corpus exercises a finite
cross-product; there is no universal Rust/Lean refinement, digest proof,
or #56 certificate correspondence here. `Fixture` uses unrestricted `Nat`
and byte lists rather than bounded Rust u16/u32/i64/fixed arrays, so its
encoding is not injective on all `Fixture` values. Only the generated,
width-correct source cases have Rust counterparts in this lane.
-/
namespace NobleFoundation.ProcedureLibraryWire

private def u16be (value : Nat) : List Nat :=
  [value / 256 % 256, value % 256]

private def u32be (value : Nat) : List Nat :=
  [value / 16777216 % 256, value / 65536 % 256,
   value / 256 % 256, value % 256]

private def u64be (value : Nat) : List Nat :=
  (List.range 8).map (fun index => value / (256 ^ (7 - index)) % 256)

private def i64be (value : Int) : List Nat :=
  u64be ((value % (2 ^ 64)).toNat)

private def ascii (value : String) : List Nat :=
  value.toUTF8.data.toList.map (fun byte => byte.toNat)

private def sizedAscii (value : String) : List Nat :=
  u32be value.utf8ByteSize ++ ascii value

private def nibble (character : Char) : Nat :=
  if character ≤ '9' then character.toNat - '0'.toNat
  else character.toNat - 'a'.toNat + 10

private def hexOctets : List Char → List Nat
  | high :: low :: rest => (16 * nibble high + nibble low) :: hexOctets rest
  | _ => []

private def hex (value : String) : List Nat := hexOctets value.toList

inductive WireNode where
  | i64 (value : Int)
  | operation (tag : Nat) (instantiation : Nat)
  deriving DecidableEq, Repr

private def nodeBytes : WireNode → List Nat
  | .i64 value => [0] ++ i64be value
  | .operation tag instantiation => [3, tag] ++ u16be instantiation

structure WireBinding where
  variable : Nat
  kind : Nat
  ty : Nat
  deriving DecidableEq, Repr

private def bindingBytes (binding : WireBinding) : List Nat :=
  u16be binding.variable ++ [binding.kind, binding.ty]

structure WireLibraryDependency where
  procedureId : List Nat
  chunkId : List Nat
  sourceRevision : List Nat
  deriving DecidableEq, Repr

private def libraryDependencyBytes (dependency : WireLibraryDependency) : List Nat :=
  dependency.procedureId ++ dependency.chunkId ++ dependency.sourceRevision

structure Fixture where
  chunkId : List Nat
  sourceRevision : List Nat
  nodes : List WireNode
  instantiations : List (List WireBinding)
  producerTag : Nat
  toolRevision : Nat
  taskId : Option (List Nat)
  grammarRevision : Option Nat
  libraryDependencies : List WireLibraryDependency
  deriving DecidableEq, Repr

private def chunkBytes (fixture : Fixture) : List Nat :=
  u32be 1 ++ u32be 0 ++ sizedAscii "pure-i64-bool/1" ++
  fixture.chunkId ++ fixture.sourceRevision ++
  u32be 2 ++ [0, 0] ++ u32be 1 ++ [0] ++
  u32be 0 ++ u32be 0 ++ u32be 0 ++
  u32be fixture.instantiations.length ++
  fixture.instantiations.flatMap (fun bindings =>
    u32be bindings.length ++ bindings.flatMap bindingBytes) ++
  u32be fixture.nodes.length ++ fixture.nodes.flatMap nodeBytes ++
  u32be fixture.nodes.length ++ (List.range fixture.nodes.length).flatMap u32be

private def provenanceBytes (fixture : Fixture) : List Nat :=
  [fixture.producerTag] ++ u32be fixture.toolRevision ++
  (match fixture.taskId with
   | none => [0]
   | some bytes => [1] ++ bytes) ++
  (match fixture.grammarRevision with
   | none => [0]
   | some revision => [1] ++ u32be revision)

/-- Experimental immutable-subject bytes in the stated source-chunk subprofile. -/
def encodeFiniteSubject (fixture : Fixture) : List Nat :=
  sizedAscii "noble-procedure-record/1" ++ u32be 1 ++ [1] ++ u32be 0 ++
  chunkBytes fixture ++ provenanceBytes fixture ++
  u32be fixture.libraryDependencies.length ++
  fixture.libraryDependencies.flatMap libraryDependencyBytes

/-- Source id and revision are independently checked against the Rust fixture. -/
def commutedFixture : Fixture := {
  chunkId := hex "caa60f63d1b5a87dcbe7c47e280fe264"
  sourceRevision := hex "14a7ef63e8e0fba64a43cb0366e9fad64078719ca79628397b71a2075f9428ae"
  nodes := [.i64 7, .operation 3 0, .operation 3 0]
  instantiations := [[]]
  producerTag := 1
  toolRevision := 2
  taskId := some (ascii "arithCommuted" ++ List.replicate 19 0)
  grammarRevision := some 0
  libraryDependencies := []
}

/-- A second body and provenance branch of the same finite wire subprofile. -/
def subtractFixture : Fixture := {
  chunkId := hex "0f6040a45e12e5557d47a90ad2240bf7"
  sourceRevision := hex "68d5a576bac0b4baa870aa805949e23c4b96c47e905dc91a6a2b86c5ae36d09a"
  nodes := [.operation 4 0, .i64 7, .operation 3 0]
  instantiations := [[]]
  producerTag := 0
  toolRevision := 1
  taskId := none
  grammarRevision := none
  libraryDependencies := []
}

/-- A five-node source with the same immutable fields as the scaled producer record. -/
def scaledFixture : Fixture := {
  chunkId := hex "b6ad101c2b9d5b60be5e3a5c22745495"
  sourceRevision := hex "ac0599130dc38c64a9fe28a939d0628db5742fd579a6b74e0877d74b234e076c"
  nodes := [.i64 7, .operation 3 0, .i64 5, .operation 5 0, .operation 3 0]
  instantiations := [[]]
  producerTag := 1
  toolRevision := 2
  taskId := some (ascii "arithScaled" ++ List.replicate 21 0)
  grammarRevision := some 0
  libraryDependencies := []
}

/-- The second instantiation contains the Value/I64 binding used by `dup`. -/
def productFixture : Fixture := {
  chunkId := hex "2dfc6cae0d784eee0c640a4d1c184e9f"
  sourceRevision := hex "573fcbbd45df1f51a4bed2fef2291c335f8a52f73668c6369ded0b3e72b0ccec"
  nodes := [.i64 5, .operation 3 0, .operation 0 1, .i64 2,
            .operation 4 0, .operation 5 0, .operation 3 0]
  instantiations := [[], [{ variable := 1, kind := 1, ty := 0 }]]
  producerTag := 1
  toolRevision := 2
  taskId := some (ascii "arithProduct" ++ List.replicate 20 0)
  grammarRevision := some 0
  libraryDependencies := []
}

/-- Real chunk-produced identities from the retained v2 transfer source pool. -/
def subtractDependency : WireLibraryDependency := {
  procedureId := hex "3481165fdd5bc9bdd65713f3d873bbff837992af9bb1275dd853c2b02e76c283"
  chunkId := subtractFixture.chunkId
  sourceRevision := subtractFixture.sourceRevision
}

def commutedDependency : WireLibraryDependency := {
  procedureId := hex "46aac8337fc941b1dd1eaa61bdef5fe90b40176cee5c012089367910df5de5de"
  chunkId := commutedFixture.chunkId
  sourceRevision := commutedFixture.sourceRevision
}

/-- Producer tags 0/1/2 take the Rust Chunk/Synthesis/Composition provenance branches. -/
def withProducer (name : String) (producer : Nat) (fixture : Fixture) : Fixture :=
  if producer = 1 then
    { fixture with producerTag := 1, toolRevision := 2,
      taskId := some (ascii name ++ List.replicate (32 - name.utf8ByteSize) 0),
      grammarRevision := some 0 }
  else
    { fixture with producerTag := producer, toolRevision := 1,
      taskId := none, grammarRevision := none }

/-- Zero, one and two closure entries; order is part of the immutable bytes. -/
def withClosure (count : Nat) (fixture : Fixture) : Fixture :=
  { fixture with libraryDependencies :=
      if count = 0 then [] else if count = 1 then [subtractDependency]
      else [subtractDependency, commutedDependency] }

set_option maxRecDepth 4096 in
theorem commuted_fixture_wire_length :
    (encodeFiniteSubject commutedFixture).length = 227 := by decide

set_option maxRecDepth 4096 in
theorem subtract_fixture_wire_length :
    (encodeFiniteSubject subtractFixture).length = 191 := by decide

set_option maxRecDepth 4096 in
theorem commuted_fixture_encoder_prefix :
    (encodeFiniteSubject commutedFixture).take 4 = [0, 0, 0, 24] := by decide

end NobleFoundation.ProcedureLibraryWire
