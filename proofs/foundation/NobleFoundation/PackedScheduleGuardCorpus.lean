import NobleFoundation.PackedScheduleCorpus
import NobleFoundation.PackedScheduleGuard

/-!
# Guarded packed I64/Bool artifact, validated by the Lean kernel (issue #43)

Generated by `corpus_guard.rs` from the declaration and stream `Compiled::new` emits; do not edit
by hand. `the_guarded_lean_file_is_the_real_emission` fails when the emitted artifact changes.

The kernel decides the guarded validator, its well-formedness premise and suffix-table identity.
`machineObs` reads guard operands from the packed register file; `validate_machineValue_sound`
proves those values match the graph reference. `validate_sound` proves the supplied stream's
observation equals the canonical graph reference; `layeredObs_sound` proves the suffix-aware
packed-layer observation agrees as well. Each refused
mutation changes one obligation, and each concrete execution row was compared with the Rust
reference interpreter before the Lean machine was evaluated.

The export is per artifact. It is not a theorem about the scheduler, Rust executor, host or engine.
-/

namespace NobleFoundation.PackedScheduleCorpus

open NobleFoundation.PackedSchedule

/-! ## `nonLayerSortedGuarded`: a two-guard, non-layer-sorted I64 graph with a canonical-first guard in a later layer -/

def nonLayerSortedGuardedNodes : List NobleFoundation.PackedScheduleGuard.Node :=
  [.input 0,
   .mul 0 0,
   .mul 1 0,
   .guard 2,
   .input 1,
   .constant 0x0000000000000005,
   .add 4 5,
   .guard 6,
   .sub 2 6]

def nonLayerSortedGuardedGraph : NobleFoundation.PackedScheduleGuard.Graph :=
  { count := nonLayerSortedGuardedNodes.length, node := fun index => nonLayerSortedGuardedNodes.getD index (.input 0) }

def nonLayerSortedGuardedRegs : List Nat := [0, 3, 5, 4294967295, 1, 2, 4, 4294967295, 6]

def nonLayerSortedGuardedOrder : List Nat := [0, 4, 5, 1, 6, 2, 7, 3, 8]

def nonLayerSortedGuardedLayers : List (List Nat) := [[0, 4, 5], [1, 6], [2, 7], [3, 8]]

def nonLayerSortedGuardedFailSuffixMin : List (Option Nat) := [some 3, some 3, some 3, some 3, none]

def nonLayerSortedGuardedLayerGuardOrder : List Nat := [7, 3]

def nonLayerSortedGuardedInstrs : List NobleFoundation.PackedScheduleGuard.Instr :=
  [.setInput 0 0,
   .setInput 1 1,
   .setConst 2 0x0000000000000005,
   .mul 3 0 0,
   .add 4 1 2,
   .mul 5 3 0,
   .guard 7,
   .guard 3,
   .sub 6 5 4]

def nonLayerSortedGuardedOutputs : List Nat := [8, 6, 8, 2]

def nonLayerSortedGuardedOutRegs : List Nat := [6, 4, 6, 5]

theorem nonLayerSortedGuarded_validated :
    NobleFoundation.PackedScheduleGuard.validate nonLayerSortedGuardedGraph (regOfList nonLayerSortedGuardedRegs) nonLayerSortedGuardedOrder nonLayerSortedGuardedInstrs nonLayerSortedGuardedOutputs nonLayerSortedGuardedOutRegs = true := by
  decide

theorem nonLayerSortedGuarded_wellFormed : NobleFoundation.PackedScheduleGuard.WellFormed nonLayerSortedGuardedGraph := by
  change NobleFoundation.PackedScheduleGuard.wellFormedBool nonLayerSortedGuardedGraph = true
  decide

theorem nonLayerSortedGuarded_suffix_table_matches :
    (nonLayerSortedGuardedFailSuffixMin.drop 1) =
      (NobleFoundation.PackedScheduleGuard.failSuffixMin
        (nonLayerSortedGuardedLayers.map (NobleFoundation.PackedScheduleGuard.graphGuardLayer nonLayerSortedGuardedGraph
          (regOfList nonLayerSortedGuardedRegs) (fun _ => none)))).take nonLayerSortedGuardedLayers.length := by
  decide

theorem nonLayerSortedGuarded_sound (inputs : Nat → BitVec 64) :
    NobleFoundation.PackedScheduleGuard.machineObs nonLayerSortedGuardedGraph inputs (regOfList nonLayerSortedGuardedRegs)
      nonLayerSortedGuardedOrder nonLayerSortedGuardedInstrs nonLayerSortedGuardedOutRegs =
      NobleFoundation.PackedScheduleGuard.referenceObs nonLayerSortedGuardedGraph inputs nonLayerSortedGuardedOutputs :=
  NobleFoundation.PackedScheduleGuard.validate_sound nonLayerSortedGuardedGraph nonLayerSortedGuarded_wellFormed (regOfList nonLayerSortedGuardedRegs)
    nonLayerSortedGuardedOrder nonLayerSortedGuardedInstrs nonLayerSortedGuardedOutputs nonLayerSortedGuardedOutRegs nonLayerSortedGuarded_validated inputs

theorem nonLayerSortedGuarded_layered_sound (inputs : Nat → BitVec 64) :
    NobleFoundation.PackedScheduleGuard.layeredObs nonLayerSortedGuardedGraph inputs nonLayerSortedGuardedLayers
      (regOfList nonLayerSortedGuardedRegs) nonLayerSortedGuardedInstrs nonLayerSortedGuardedOutRegs =
      NobleFoundation.PackedScheduleGuard.referenceObs nonLayerSortedGuardedGraph inputs nonLayerSortedGuardedOutputs :=
  NobleFoundation.PackedScheduleGuard.layeredObs_sound nonLayerSortedGuardedGraph nonLayerSortedGuarded_wellFormed inputs nonLayerSortedGuardedLayers
    nonLayerSortedGuardedOutputs (regOfList nonLayerSortedGuardedRegs) nonLayerSortedGuardedInstrs nonLayerSortedGuardedOutRegs nonLayerSortedGuarded_validated

