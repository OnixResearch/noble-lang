  { left := FirstProjection.ofList [.input 0, .add 0 0, .add 1 0] 2,
    right := FirstProjection.ofList [.input 0, .constant 0x0000000000000003, .mul 0 1] 2,
    outputs := [2] }

def sharedInputValues : List (List (BitVec 64)) :=
  [[0x0000000000000000],
   [0x0000000000000001],
   [0xFFFFFFFFFFFFFFFF],
   [0x7FFFFFFFFFFFFFFF],
   [0x8000000000000000]]

def sharedInputUniverse : List (Nat → BitVec 64) :=
  sharedInputValues.map inputsOf

theorem sharedInput_first : firstIndex sharedInput sharedInputUniverse = none := by
  decide

/-- The pair agrees on every candidate of the declared universe, and nothing beyond it. -/
theorem sharedInput_agrees : ∀ inputs ∈ sharedInputUniverse, agreesOn sharedInput inputs :=
  firstIndex_none_agrees sharedInput sharedInputUniverse sharedInput_first

