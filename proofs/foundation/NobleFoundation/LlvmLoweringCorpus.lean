import NobleFoundation.LlvmLowering

/-!
# Real graph-to-LLVM artifacts, validated by the Lean kernel (issue #107)

Generated by `crates/noble-ngraph/tests/cert/llvm/corpus.rs` from the modules the emitter renders \
         and the instruction lists the *validator's own parser* reads back out of those bytes; do not edit by hand. `the_lean_corpus_is_the_real_export` fails when either changes, until this file is regenerated and the foundation lane rerun.

For every artifact the kernel decides `validate` (`*_validated`), and `validate_sound` gives the semantic theorem (`*_sound`): the executed function returns the graph reference's value of the selected output for every pair of `BitVec 64` inputs. Every `*_refused` theorem is the same graph with one obligation broken — the parsed instructions are the ones the Rust validator refused for the same bytes — and the kernel decides that `validate` refuses them. Every `*_execution_*_agrees` theorem states the value the Rust interpreter read from the same parsed instructions at named inputs, after the generator checked it against the Rust graph reference, and the kernel evaluates `result` to it; by `*_sound` it is also the graph reference's value.

The exported form is the parser's, not the emitter's. The one trusted translation is that reading: these statements are about the parsed instruction list, and nothing here says the parser, the emitter or the Rust checker corresponds to this model.
-/

namespace NobleFoundation.LlvmLoweringCorpus

open NobleFoundation.LlvmLowering
open NobleFoundation.PackedSchedule
open NobleFoundation.FirstProjection

/-! ## `wrapping`: MIN and MAX constants: `(a0 + i64::MAX) * i64::MIN * a1` wraps at every step -/

def wrappingNodes : List Node :=
  [.input 0,
   .input 1,
   .constant 0x7FFFFFFFFFFFFFFF,
   .constant 0x8000000000000000,
   .add 0 2,
   .mul 3 4,
   .mul 5 1]

def wrappingGraph : Graph := FirstProjection.ofList wrappingNodes 6

def wrappingInstrs : List Instr :=
  [{ dst := 4, opcode := .add, left := .param 0, right := .constant 0x7FFFFFFFFFFFFFFF },
   { dst := 5, opcode := .mul, left := .constant 0x8000000000000000, right := .value 4 },
   { dst := 6, opcode := .mul, left := .value 5, right := .param 1 }]

def wrappingOut : Operand := .value 6

theorem wrapping_validated : validate wrappingGraph wrappingInstrs wrappingOut = true := by
  decide

theorem wrapping_wellFormed : WellFormed wrappingGraph :=
  FirstProjection.ofList_wellFormed wrappingNodes 6 (by decide) (by decide)

/-- The parsed body returns the graph reference's output for every input pair. -/
theorem wrapping_sound (inputs : Nat → BitVec 64) :
    result inputs wrappingInstrs wrappingOut = value wrappingGraph inputs wrappingGraph.output :=
  validate_sound wrappingGraph wrapping_wellFormed wrappingInstrs wrappingOut wrapping_validated inputs

/-- The Rust interpreter, agreeing with the graph reference here, read 0x0000000000000000 at (0x0000000000000000, 0x0000000000000000). -/
theorem wrapping_execution_0_agrees :
    result (inputsOf [0x0000000000000000, 0x0000000000000000]) wrappingInstrs wrappingOut = some (.i64 0x0000000000000000) :=
  by decide

/-- The Rust interpreter, agreeing with the graph reference here, read 0x8000000000000000 at (0x8000000000000000, 0x7FFFFFFFFFFFFFFF). -/
theorem wrapping_execution_1_agrees :
    result (inputsOf [0x8000000000000000, 0x7FFFFFFFFFFFFFFF]) wrappingInstrs wrappingOut = some (.i64 0x8000000000000000) :=
  by decide

