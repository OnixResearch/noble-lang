import NobleM2.SizeChangeCallProgram
import NobleM2.SizeChangeMatrixDecEq
import NobleM2.SizeChangeMatrixPathProduct

/-!
# Bounded size-change closure certificates (issue #101)

A certificate contains the finite set of call-site matrices, a bounded list of closure matrices,
and one site-path for each listed matrix. The checker verifies that the list contains the sites,
is closed under composition, contains no duplicate matrices, and that every entry is the product of
its stated path. Those facts make the list exactly the positive closure: closure induction proves
completeness, and each path proves soundness.

The accepted property is the size-change criterion: each idempotent closure matrix has a strict
diagonal. The bounded model proves this criterion sound for periodic call sequences. Arbitrary-run
soundness is a separate theorem and is not claimed by this module unless proved below.
-/

namespace NobleM2.SizeChange

/-- Maximum parameter count for a size-change certificate. -/
def maxSctMeasures : Nat := 8

/-- Maximum call-site count for a size-change certificate. -/
def maxSctSites : Nat := 256

/-- Maximum distinct closure matrices retained by a size-change certificate. -/
def maxSctClosure : Nat := 256

/-- The positive closure generated by the call-site matrices. -/
inductive MatrixClosure {k n : Nat} (sites : Fin k → MGraph n) : MGraph n → Prop where
  | site (s : Fin k) : MatrixClosure sites (sites s)
  | compose {g h : MGraph n} : MatrixClosure sites g → MatrixClosure sites h →
      MatrixClosure sites (composeMatrix g h)

/-- A closure entry pairs a graph with a non-empty word of call-site indices. -/
structure MatrixClosureEntry (k n : Nat) where
  graph : MGraph n
  path : List (Fin k)
deriving DecidableEq

/-- The matrices listed in a certificate, in retained order. -/
def closureGraphs {k n : Nat} (entries : List (MatrixClosureEntry k n)) : List (MGraph n) :=
  entries.map MatrixClosureEntry.graph

/-- One supplied strict diagonal for an idempotent closure graph. -/
structure MatrixStrictWitness (n : Nat) where
  graph : MGraph n
  measure : Fin n

/-- Every supplied witness is a closure member, is idempotent, and has the named strict edge;
every idempotent closure entry is covered by at least one supplied witness. -/
def closureStrictWitnessesValid {k n : Nat} (entries : List (MatrixClosureEntry k n))
    (witnesses : List (MatrixStrictWitness n)) : Bool :=
  witnesses.all fun witness =>
    decide (witness.graph ∈ closureGraphs entries) &&
      (decide (composeMatrix witness.graph witness.graph = witness.graph) &&
        decide (witness.graph witness.measure witness.measure = .strict)) &&
  entries.all fun entry =>
    if decide (composeMatrix entry.graph entry.graph = entry.graph) then
      witnesses.any fun witness =>
        decide (witness.graph = entry.graph) &&
          decide (witness.graph witness.measure witness.measure = .strict)
    else true

/-- A matrix has a strict diagonal edge. -/
def HasStrictDiagonal {n : Nat} (graph : MGraph n) : Prop :=
  ∃ i, graph i i = .strict

/-- Executable strict-diagonal scan over the finite measure index set. -/
def hasStrictDiagonal {n : Nat} (graph : MGraph n) : Bool :=
  (List.finRange n).any fun measure => decide (graph measure measure = .strict)

/-- The finite scan exactly decides the proposition used by the criterion. -/
theorem hasStrictDiagonal_iff {n : Nat} (graph : MGraph n) :
    hasStrictDiagonal graph = true ↔ HasStrictDiagonal graph := by
  simp [hasStrictDiagonal, HasStrictDiagonal]

/-- Every input site occurs in the retained closure list. -/
def closureSitesPresent {k n : Nat} (sites : Fin k → MGraph n)
    (entries : List (MatrixClosureEntry k n)) : Bool :=
  (List.finRange k).all fun site => decide (sites site ∈ closureGraphs entries)

/-- The retained list is closed under composing any two of its entries. -/
def closureCompositionClosed {k n : Nat} (entries : List (MatrixClosureEntry k n)) : Bool :=
  entries.all fun left =>
    entries.all fun right =>
      decide (composeMatrix left.graph right.graph ∈ closureGraphs entries)

/-- Each retained graph is the product of a non-empty bounded path of input sites. -/
def closurePathsValid {k n : Nat} (sites : Fin k → MGraph n)
    (entries : List (MatrixClosureEntry k n)) : Bool :=
  entries.all fun entry =>
    decide (entry.path ≠ []) &&
      decide (matrixProduct (entry.path.map sites) = entry.graph) &&
      decide (entry.path.length ≤ maxSctClosure)

/-- Each idempotent entry has a checked strict diagonal witness. -/
def closureIdempotentsStrict {k n : Nat} (entries : List (MatrixClosureEntry k n)) : Bool :=
  entries.all fun entry =>
    if decide (composeMatrix entry.graph entry.graph = entry.graph) then
      hasStrictDiagonal entry.graph
    else true

/-- The executable, fail-closed checks for the bounded closure set itself. -/
def closureSetValid {k n : Nat} (sites : Fin k → MGraph n)
    (entries : List (MatrixClosureEntry k n)) : Bool :=
  decide (0 < n) && (decide (n ≤ maxSctMeasures) && (decide (0 < k) &&
    (decide (k ≤ maxSctSites) && (decide (entries.length ≤ maxSctClosure) &&
      (decide ((closureGraphs entries).Nodup) && (closureSitesPresent sites entries &&
        (closureCompositionClosed entries && closurePathsValid sites entries)))))))

/-- A valid closure-set scan exposes each finite, decidable closure obligation. -/
theorem closureSetValid_iff {k n : Nat} (sites : Fin k → MGraph n)
    (entries : List (MatrixClosureEntry k n)) :
    closureSetValid sites entries = true ↔
      0 < n ∧ n ≤ maxSctMeasures ∧ 0 < k ∧ k ≤ maxSctSites ∧
      entries.length ≤ maxSctClosure ∧ (closureGraphs entries).Nodup ∧
      closureSitesPresent sites entries = true ∧ closureCompositionClosed entries = true ∧
      closurePathsValid sites entries = true := by
  simp [closureSetValid, Bool.and_eq_true]

/-- The accepted certificate additionally verifies every idempotent strict-edge witness. -/
def closureCertificateValid {k n : Nat} (sites : Fin k → MGraph n)
    (entries : List (MatrixClosureEntry k n)) : Bool :=
  closureSetValid sites entries && closureIdempotentsStrict entries

/-- A bounded closure set is independently checkable for either acceptance or refusal. -/
structure MatrixClosureSetCertificate (k n : Nat) (sites : Fin k → MGraph n) where
  entries : List (MatrixClosureEntry k n)
  checked : closureSetValid sites entries = true

/-- A finite, exact certificate of the closure and its idempotent witnesses. -/
structure MatrixClosureCertificate (k n : Nat) (sites : Fin k → MGraph n) where
  entries : List (MatrixClosureEntry k n)
  strictWitnesses : List (MatrixStrictWitness n)
  checked : closureCertificateValid sites entries = true
  checkedStrictWitnesses : closureStrictWitnessesValid entries strictWitnesses = true

/-- A successful certificate check provides its finite, decidable validation clauses. -/
theorem closureCertificateValid_iff {k n : Nat} (sites : Fin k → MGraph n)
    (entries : List (MatrixClosureEntry k n)) :
    closureCertificateValid sites entries = true ↔
      0 < n ∧ n ≤ maxSctMeasures ∧ 0 < k ∧ k ≤ maxSctSites ∧
      entries.length ≤ maxSctClosure ∧ (closureGraphs entries).Nodup ∧
      closureSitesPresent sites entries = true ∧ closureCompositionClosed entries = true ∧
      closurePathsValid sites entries = true ∧ closureIdempotentsStrict entries = true := by
  constructor
  · intro checked
    have hparts : closureSetValid sites entries = true ∧
        closureIdempotentsStrict entries = true := by
      unfold closureCertificateValid at checked
      rw [Bool.and_eq_true] at checked
      exact checked
    rcases hparts with ⟨hset, hidempotents⟩
    rw [closureSetValid_iff sites entries] at hset
    exact ⟨hset.1, hset.2.1, hset.2.2.1, hset.2.2.2.1,
      hset.2.2.2.2.1, hset.2.2.2.2.2.1, hset.2.2.2.2.2.2.1,
      hset.2.2.2.2.2.2.2.1, hset.2.2.2.2.2.2.2.2, hidempotents⟩
  · rintro ⟨hn, hmeasures, hk, hsites, hclosure, hunique, hcovered, hclosed, hpaths, hidempotents⟩
    unfold closureCertificateValid
    rw [Bool.and_eq_true]
    constructor
    · exact (closureSetValid_iff sites entries).mpr
        ⟨hn, hmeasures, hk, hsites, hclosure, hunique, hcovered, hclosed, hpaths⟩
    · exact hidempotents

/-- Accepted certificates also carry the independently verified exact closure set. -/
def MatrixClosureCertificate.asSetCertificate {k n : Nat} {sites : Fin k → MGraph n}
    (certificate : MatrixClosureCertificate k n sites) : MatrixClosureSetCertificate k n sites :=
  ⟨certificate.entries, by
    have hparts := (closureCertificateValid_iff sites certificate.entries).mp certificate.checked
    exact (closureSetValid_iff sites certificate.entries).mpr
      ⟨hparts.1, hparts.2.1, hparts.2.2.1, hparts.2.2.2.1, hparts.2.2.2.2.1,
        hparts.2.2.2.2.2.1, hparts.2.2.2.2.2.2.1, hparts.2.2.2.2.2.2.2.1,
        hparts.2.2.2.2.2.2.2.2.1⟩⟩

/-- The check result exposes all finite certificate obligations as propositions. -/
theorem closureCertificate_constraints {k n : Nat} {sites : Fin k → MGraph n}
    (certificate : MatrixClosureCertificate k n sites) :
    0 < n ∧ n ≤ maxSctMeasures ∧ 0 < k ∧ k ≤ maxSctSites ∧
    certificate.entries.length ≤ maxSctClosure ∧
    (closureGraphs certificate.entries).Nodup ∧
    closureSitesPresent sites certificate.entries = true ∧
    closureCompositionClosed certificate.entries = true ∧
    closurePathsValid sites certificate.entries = true ∧
    closureIdempotentsStrict certificate.entries = true :=
  (closureCertificateValid_iff sites certificate.entries).mp certificate.checked

/-- A validated site-coverage scan yields membership for every declared call site. -/
theorem closureSitesPresent_member {k n : Nat} {sites : Fin k → MGraph n}
    {entries : List (MatrixClosureEntry k n)}
    (checked : closureSitesPresent sites entries = true) (site : Fin k) :
    sites site ∈ closureGraphs entries := by
  have h := List.all_eq_true.mp checked site (List.mem_finRange site)
  exact of_decide_eq_true h

/-- A validated pair scan yields closure under composition. -/
theorem closureCompositionClosed_member {k n : Nat}
    {entries : List (MatrixClosureEntry k n)}
    (checked : closureCompositionClosed entries = true)
    (left : MatrixClosureEntry k n) (left_mem : left ∈ entries)
    (right : MatrixClosureEntry k n) (right_mem : right ∈ entries) :
    composeMatrix left.graph right.graph ∈ closureGraphs entries := by
  have hleft := List.all_eq_true.mp checked left left_mem
  have hright := List.all_eq_true.mp hleft right right_mem
  exact of_decide_eq_true hright

/-- A validated path scan exposes the non-empty path and matching product for one entry. -/
theorem closurePathsValid_member {k n : Nat} {sites : Fin k → MGraph n}
    {entries : List (MatrixClosureEntry k n)}
    (checked : closurePathsValid sites entries = true) (entry : MatrixClosureEntry k n)
    (member : entry ∈ entries) : entry.path ≠ [] ∧
      matrixProduct (entry.path.map sites) = entry.graph := by
  have h := List.all_eq_true.mp checked entry member
  rw [Bool.and_eq_true] at h
  rcases h with ⟨hpath, _⟩
  rw [Bool.and_eq_true] at hpath
  rcases hpath with ⟨hnonempty, hproduct⟩
  exact ⟨of_decide_eq_true hnonempty, of_decide_eq_true hproduct⟩

/-- A validated idempotent scan supplies a strict diagonal for each idempotent entry. -/
theorem closureIdempotentsStrict_member {k n : Nat}
    {entries : List (MatrixClosureEntry k n)}
    (checked : closureIdempotentsStrict entries = true) (entry : MatrixClosureEntry k n)
    (member : entry ∈ entries)
    (idempotent : composeMatrix entry.graph entry.graph = entry.graph) :
    HasStrictDiagonal entry.graph := by
  have h := List.all_eq_true.mp checked entry member
  have hidem : decide (composeMatrix entry.graph entry.graph = entry.graph) = true :=
    decide_eq_true_eq.mpr idempotent
  rw [hidem] at h
  obtain ⟨measure, _, hmeasure⟩ := List.any_eq_true.mp h
  exact ⟨measure, of_decide_eq_true hmeasure⟩

/-- The product of a non-empty sequence of site matrices belongs to the generated closure. -/
theorem matrixProduct_sites_mem_closure {k n : Nat} (sites : Fin k → MGraph n) :
    ∀ (path : List (MGraph n)), path ≠ [] →
      (∀ graph, graph ∈ path → ∃ s, graph = sites s) →
      MatrixClosure sites (matrixProduct path)
  | [], hnonempty, _ => by cases hnonempty rfl
  | [graph], _, hsites => by
      obtain ⟨s, hs⟩ := hsites graph (by simp)
      rw [matrixProduct_singleton, hs]
      exact MatrixClosure.site s
  | graph :: next :: rest, _, hsites => by
      have hhead := hsites graph (by simp)
      have htail : ∀ value, value ∈ next :: rest → ∃ s, value = sites s := by
        intro value hvalue
        exact hsites value (by simp [hvalue])
      have hrest := matrixProduct_sites_mem_closure sites (next :: rest) (by simp) htail
      rw [matrixProduct] at hrest ⊢
      obtain ⟨s, rfl⟩ := hhead
      exact MatrixClosure.compose (MatrixClosure.site s) hrest

/-- Every generated closure graph occurs in a closed certificate list. -/
theorem closure_subset_certificate {k n : Nat} {sites : Fin k → MGraph n}
    (certificate : MatrixClosureSetCertificate k n sites) :
    ∀ graph, MatrixClosure sites graph → graph ∈ closureGraphs certificate.entries := by
  intro graph member
  rcases (closureSetValid_iff sites certificate.entries).mp certificate.checked with
    ⟨_, _, _, _, _, _, hsites, hclosed, _⟩
  induction member with
  | site s =>
      exact closureSitesPresent_member hsites s
  | compose _ _ left right =>
      obtain ⟨leftEntry, hleft, rfl⟩ := List.mem_map.mp left
      obtain ⟨rightEntry, hright, rfl⟩ := List.mem_map.mp right
      exact closureCompositionClosed_member hclosed leftEntry hleft rightEntry hright

/-- Every listed graph is a genuine composition of call-site matrices. -/
theorem certificate_subset_closure {k n : Nat} {sites : Fin k → MGraph n}
    (certificate : MatrixClosureSetCertificate k n sites) :
    ∀ graph, graph ∈ closureGraphs certificate.entries → MatrixClosure sites graph := by
  intro graph member
  obtain ⟨entry, hentry, heq⟩ := List.mem_map.mp member
  subst graph
  rcases (closureSetValid_iff sites certificate.entries).mp certificate.checked with
    ⟨_, _, _, _, _, _, _, _, hpaths⟩
  obtain ⟨hnonempty, hproduct⟩ := closurePathsValid_member hpaths entry hentry
  have hmapped : entry.path.map sites ≠ [] := by
    cases hpath : entry.path with
    | nil => exact False.elim (hnonempty hpath)
    | cons _ _ => simp
  have hpath := matrixProduct_sites_mem_closure sites (entry.path.map sites)
    hmapped
    (by
      intro matrix hmatrix
      obtain ⟨index, hindex, rfl⟩ := List.mem_map.mp hmatrix
      exact ⟨index, rfl⟩)
  rw [hproduct] at hpath
  exact hpath

/-- The certificate list is exactly the inductively generated positive closure. -/
theorem certificate_exact {k n : Nat} {sites : Fin k → MGraph n}
    (certificate : MatrixClosureSetCertificate k n sites) (graph : MGraph n) :
    MatrixClosure sites graph ↔ graph ∈ closureGraphs certificate.entries := by
  constructor
  · exact closure_subset_certificate certificate graph
  · exact certificate_subset_closure certificate graph

/-- A closed certificate proves the criterion for every generated closure matrix. -/
theorem certificate_closure_criterion {k n : Nat} {sites : Fin k → MGraph n}
    (certificate : MatrixClosureCertificate k n sites) {graph : MGraph n}
    (member : MatrixClosure sites graph)
    (idempotent : composeMatrix graph graph = graph) : HasStrictDiagonal graph := by
  have hlisted := closure_subset_certificate certificate.asSetCertificate graph member
  obtain ⟨entry, hentry, heq⟩ := List.mem_map.mp hlisted
  rcases closureCertificate_constraints certificate with
    ⟨_, _, _, _, _, _, _, _, _, hidempotents⟩
  rw [← heq] at idempotent ⊢
  exact closureIdempotentsStrict_member hidempotents entry hentry idempotent

/-- A refused closure carries an exact idempotent graph with no strict diagonal. -/
structure MatrixIdempotentRefusal {k n : Nat} {sites : Fin k → MGraph n}
    (certificate : MatrixClosureSetCertificate k n sites) where
  entry : MatrixClosureEntry k n
  member : entry ∈ certificate.entries
  idempotent : composeMatrix entry.graph entry.graph = entry.graph
  noStrictDiagonal : hasStrictDiagonal entry.graph = false

/-- The checked refusal scan excludes every strict diagonal. -/
theorem refusal_no_strict_diagonal {k n : Nat} {sites : Fin k → MGraph n}
    {certificate : MatrixClosureSetCertificate k n sites}
    (witness : MatrixIdempotentRefusal certificate) :
    ¬ HasStrictDiagonal witness.entry.graph := by
  intro hstrict
  have htrue : hasStrictDiagonal witness.entry.graph = true :=
    (hasStrictDiagonal_iff witness.entry.graph).mpr hstrict
  rw [witness.noStrictDiagonal] at htrue
  cases htrue

/-- A refusal witness is a genuine call-graph closure matrix, not a fabricated relation. -/
theorem refusal_graph_in_closure {k n : Nat} {sites : Fin k → MGraph n}
    {certificate : MatrixClosureSetCertificate k n sites}
    (witness : MatrixIdempotentRefusal certificate) :
    MatrixClosure sites witness.entry.graph := by
  apply certificate_subset_closure certificate
  exact List.mem_map.mpr ⟨witness.entry, witness.member, rfl⟩

/-- A model call sequence chooses one checked site at every step and satisfies its matrix. -/
structure MatrixSiteRun {k n : Nat} (sites : Fin k → MGraph n) where
  site : Nat → Fin k
  state : Nat → Fin n → Nat
  satisfies : ∀ t, MatrixSatisfies (sites (site t)) (state t) (state (t + 1))

/-- The matrix at one step of a site run. -/
def MatrixSiteRun.step {k n : Nat} {sites : Fin k → MGraph n}
    (run : MatrixSiteRun sites) (t : Nat) : MGraph n := sites (run.site t)

/-- Every member of a finite site-run prefix is one of its declared site matrices. -/
theorem stepList_sites {k n : Nat} (sites : Fin k → MGraph n) (choose : Nat → Fin k) :
    ∀ (fuel start : Nat) (graph : MGraph n),
      graph ∈ stepList (fun t => sites (choose t)) fuel start →
        ∃ s, graph = sites s := by
  intro fuel
  induction fuel with
  | zero => intro start graph member; simp [stepList] at member
  | succ fuel ih =>
      intro start graph member
      simp only [stepList, List.mem_cons] at member
      rcases member with head | rest
      · exact ⟨choose start, head⟩
      · exact ih (start + 1) graph rest

/-- A periodic call sequence whose period product is idempotent cannot run forever when its
certificate satisfies the strict-diagonal criterion. -/
theorem periodic_site_run_terminates {k n : Nat} {sites : Fin k → MGraph n}
    (certificate : MatrixClosureCertificate k n sites) (run : MatrixSiteRun sites)
    {period : Nat} (period_positive : 0 < period)
    (site_periodic : ∀ t, run.site (t + period) = run.site t)
    (product_idempotent :
      composeMatrix (pathMatrix period run.step 0) (pathMatrix period run.step 0) =
        pathMatrix period run.step 0) : False := by
  have hclosure : MatrixClosure sites (pathMatrix period run.step 0) := by
    rw [← matrixProduct_stepList]
    apply matrixProduct_sites_mem_closure sites (stepList run.step period 0)
    · cases period with
      | zero => omega
      | succ p => simp [stepList]
    · intro graph hgraph
      change graph ∈ stepList (fun t => sites (run.site t)) period 0 at hgraph
      obtain ⟨site, hsite⟩ := stepList_sites sites run.site period 0 graph
        hgraph
      exact ⟨site, hsite⟩
  obtain ⟨measure, hstrict⟩ := certificate_closure_criterion certificate hclosure product_idempotent
  exact periodic_cycle_terminates (step := run.step) (by
      intro t
      change sites (run.site (t + period)) = sites (run.site t)
      rw [site_periodic t])
    (by simpa [MatrixSiteRun.step] using hstrict) run.state (fun t => run.satisfies t)

/-! ## Argument permutation needs composition -/

/-- One recursive call swaps two parameters and strictly decreases the first. -/
def permutationSite : MGraph 2 := fun old new =>
  if old = 0 ∧ new = 1 then .strict
  else if old = 1 ∧ new = 0 then .same
  else .unknown

/-- The one-site recursive family used by the permutation fixture. -/
def permutationSites : Fin 1 → MGraph 2 := fun _ => permutationSite

/-- The second and third powers of the permuting recursive call. -/
def permutationSquare : MGraph 2 := composeMatrix permutationSite permutationSite
def permutationCube : MGraph 2 := composeMatrix permutationSquare permutationSite

/-- A closure list with one shortest site path for each distinct product. -/
def permutationClosureEntries : List (MatrixClosureEntry 1 2) :=
  [ ⟨permutationSite, [0]⟩
  , ⟨permutationSquare, [0, 0]⟩
  , ⟨permutationCube, [0, 0, 0]⟩
  ]

theorem permutationClosure_entries_nodup :
    (closureGraphs permutationClosureEntries).Nodup := by
  decide

theorem permutationClosure_sites_present :
    closureSitesPresent permutationSites permutationClosureEntries = true := by
  decide

theorem permutationClosure_composition_closed :
    closureCompositionClosed permutationClosureEntries = true := by
  decide

theorem permutationClosure_paths_valid :
    closurePathsValid permutationSites permutationClosureEntries = true := by
  decide

theorem permutationClosure_idempotents_strict :
    closureIdempotentsStrict permutationClosureEntries = true := by
  decide

def permutationClosureStrictWitnesses : List (MatrixStrictWitness 2) :=
  [⟨permutationSquare, 0⟩]

/-- The bounded checker accepts the permuting call's exact finite closure certificate. -/
def permutationClosureCertificate : MatrixClosureCertificate 1 2 permutationSites :=
  ⟨permutationClosureEntries, permutationClosureStrictWitnesses,
    (closureCertificateValid_iff permutationSites permutationClosureEntries).mpr
      ⟨by decide, by decide, by decide, by decide, by decide,
        permutationClosure_entries_nodup, permutationClosure_sites_present,
        permutationClosure_composition_closed, permutationClosure_paths_valid,
        permutationClosure_idempotents_strict⟩,
    by decide⟩

/-- The square is idempotent, so its strict diagonal is a checked closure witness. -/
theorem permutationSquare_idempotent :
    composeMatrix permutationSquare permutationSquare = permutationSquare := by
  decide

/-- The closure criterion accepts the argument-permuting recursive call. -/
theorem permutation_closure_has_strict_diagonal :
    HasStrictDiagonal permutationSquare := by
  exact certificate_closure_criterion permutationClosureCertificate
    (MatrixClosure.compose (MatrixClosure.site 0) (MatrixClosure.site 0))
    permutationSquare_idempotent

/-! ## Refusal witnesses identify an idempotent non-decreasing cycle -/

/-- An identity-like recursive call has no strict diagonal. -/
def sameSite : MGraph 1 := fun _ _ => .same
def sameSites : Fin 1 → MGraph 1 := fun _ => sameSite
def sameClosureEntries : List (MatrixClosureEntry 1 1) := [⟨sameSite, [0]⟩]

/-- The retained singleton is a complete bounded closure set, even though it is refused. -/
def sameClosureSetCertificate : MatrixClosureSetCertificate 1 1 sameSites :=
  ⟨sameClosureEntries, by decide⟩

/-- The refusal names the exact idempotent path and proves it has no strict self-edge. -/
def sameSiteRefusal : MatrixIdempotentRefusal sameClosureSetCertificate :=
  ⟨⟨sameSite, [0]⟩, by decide, by decide, by decide⟩

theorem sameSiteRefusal_graph_is_real_closure :
    MatrixClosure sameSites sameSiteRefusal.entry.graph :=
  refusal_graph_in_closure sameSiteRefusal

theorem sameSiteRefusal_has_no_strict_diagonal :
    ¬ HasStrictDiagonal sameSiteRefusal.entry.graph :=
  refusal_no_strict_diagonal sameSiteRefusal

end NobleM2.SizeChange
