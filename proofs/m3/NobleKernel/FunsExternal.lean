@[rust_fun "alloc::boxed::{core::fmt::Debug<Box<@T>>}::fmt"]
def Box.Insts.CoreFmtDebug.fmt {T : Type} (_A : Type)
  (inst : core.fmt.Debug T) (value : T) (formatter : core.fmt.Formatter) :
