/-- No port of a rule of addition has an index above two. -/
theorem xsys_ports : xsys.PortsLe 2 := by
  intro α β R h
  cases α <;> cases β <;>
    first
      | (cases h; done)
      | (rw [← Option.some.inj h]
         intro x hx
         refine ⟨?_, fun y hy => ?_⟩
         · revert x
           decide
         · revert y
           revert x
           decide)

/-- No port of a segment of `12 + 12` has an index above two. -/
theorem sum12_ports : (sum 12 12).PortsLe 2 := by
  show ∀ e ∈ (sum 12 12).wires, e.1.2 ≤ 2 ∧ e.2.2 ≤ 2
  decide +kernel

/-- **The names of a net numbered below `b` are numbers of one cell, below
`b`.** -/
theorem Below.sizes {X : XNet Arith} {b : Nat} (hb : Below X b)
    (hsym : ∀ {p q : Port}, X.toNet.link p q → X.toNet.link q p) :
    X.NamesLe 1 ∧ X.top ≤ b := by
  have hA : ∀ e ∈ X.agents, X.toNet.Used e.1 := fun e he => .inl ⟨e.2, he⟩
  have hW1 : ∀ e ∈ X.wires, X.toNet.Used e.1.1 := fun e he => .inr (.inl ⟨e.1.2, e.2, he⟩)
  have hW2 : ∀ e ∈ X.wires, X.toNet.Used e.2.1 := fun e he =>
    .inr (.inl ⟨e.2.2, e.1, hsym (p := e.1) (q := e.2) he⟩)
  have hF : ∀ p ∈ X.free, X.toNet.Used p.1 := fun p hp => .inr (.inr ⟨p.2, hp⟩)
  have len : ∀ i, X.toNet.Used i → i.length ≤ 1 := by
    intro i hi
    obtain ⟨j, -, rfl⟩ := hb i hi
    exact Nat.le_refl 1
  refine ⟨⟨fun e he => len _ (hA e he), fun e he => ⟨len _ (hW1 e he), len _ (hW2 e he)⟩⟩, ?_⟩
  refine foldr_max_le _ _ (fun x hx => ?_)
  obtain ⟨k, hk, rfl⟩ := List.mem_map.1 hx
  obtain ⟨j, hj, hkj⟩ := List.mem_flatten.1 hk
  have hU : X.toNet.Used j := by
    have hj' : j ∈ X.agents.map (·.1) ++ X.wires.map (·.1.1) ++ X.wires.map (·.2.1) ++
        X.free.map (·.1) := hj
    rcases List.mem_append.1 hj' with h | h
    · rcases List.mem_append.1 h with h | h
      · rcases List.mem_append.1 h with h | h
        · obtain ⟨e, he, rfl⟩ := List.mem_map.1 h
          exact hA e he
        · obtain ⟨e, he, rfl⟩ := List.mem_map.1 h
          exact hW1 e he
      · obtain ⟨e, he, rfl⟩ := List.mem_map.1 h
        exact hW2 e he
    · obtain ⟨p, hp, rfl⟩ := List.mem_map.1 h
      exact hF p hp
  obtain ⟨j', hj', rfl⟩ := hb j hU
  have e : k = j' := List.mem_singleton.1 hkj
  show k + 1 ≤ b
  omega

/-- A successor put on a port makes no index above one. -/
theorem push_ports {X : XNet Arith} {P : Nat} (hX : X.PortsLe P) {p : Port} (hp : p.2 ≤ P)
    (h1 : 1 ≤ P) (u : Id) : (push X p u).PortsLe P := by
  unfold push
  cases hq : assoc p X.wires with
  | none => exact hX
  | some q =>
    have hq' : q.2 ≤ P := (hX _ (assoc_mem hq)).2
    intro e he
    have he' : e ∈ (p, (u, 0)) :: ((u, 0), p) :: ((u, 1), q) :: (q, (u, 1)) ::
        X.wires.filter (fun e => decide (e.1 ≠ p ∧ e.1 ≠ q)) := he
    rcases List.mem_cons.1 he' with rfl | he'
    · exact ⟨hp, Nat.zero_le _⟩
    rcases List.mem_cons.1 he' with rfl | he'
    · exact ⟨Nat.zero_le _, hp⟩
    rcases List.mem_cons.1 he' with rfl | he'
    · exact ⟨h1, hq'⟩
    rcases List.mem_cons.1 he' with rfl | he'
    · exact ⟨hq', h1⟩
    · exact hX e (List.mem_filter.1 he').1

theorem base_ports : base.PortsLe 2 := by
  show ∀ e ∈ base.wires, e.1.2 ≤ 2 ∧ e.2.2 ≤ 2
  decide

theorem sumSnd_ports : ∀ n, (sumSnd n).PortsLe 2
  | 0 => base_ports
  | n + 1 => push_ports (sumSnd_ports n) (Nat.le_succ 1) (Nat.le_succ 1) _

/-- **No port of a net for a sum has an index above two.** -/
theorem sum_ports : ∀ m n, (sum m n).PortsLe 2
  | 0, n => sumSnd_ports n
  | m + 1, n => push_ports (sum_ports m n) (Nat.zero_le 2) (Nat.le_succ 1) _

/-- The bound on the actions of an addition that are not rests. -/
def sumWork (m n nt : Nat) : Nat := (nt + m + 1) * (33 * m + 11 * n + 49) + 11 * (m + 1)

/-- **Addition, numbered, in bounded time**, in closed form, with
everything counted and whatever the schedule. -/
theorem sum_ztime (m n : Nat) {nt : Nat} (hnt : 0 < nt) (σ : Nat → Nat) (i : Nat) :
    (ZMach.init (sum m n) nt).ftime xsys σ i ≤
      sumWork m n nt * (15 + 84 * lg (15 * m + 5 * n + 19)) := by
  have g := good_sum m n
  obtain ⟨N', hs, hn', -⟩ := add_correct g.config
  obtain ⟨hL, -⟩ := Below.sizes g.below g.ok.1.symm
  have h := ZMach.ftime_bound (xs := xsys) g.ok.1 (sum_nodup m n) hnt xsys_bounded hL hs hn'
    σ i
  refine Nat.le_trans h (Nat.mul_le_mul ?_ ?_)
  · have h₁ := Nat.mul_le_mul_left (nt + m + 1) (sum_passBound_le m n)
    show (nt + m + 1) * (sum m n).passBound (m + 1) 2 8 + (m + 1) * (2 + 8 + 1) ≤
      (nt + m + 1) * (33 * m + 11 * n + 49) + 11 * (m + 1)
    omega
  · have ha := sum_agents_length_le m n
    have hw := sum_wires_length_le m n
    have hl := lg_mono (show (sum m n).agents.length + 2 * (m + 1) +
      ((sum m n).wires.length + 8 * (m + 1)) ≤ 15 * m + 5 * n + 19 by omega)
    show 2 + 8 + 5 + 4 * ((max 1 1 + 6) * (3 * lg ((sum m n).agents.length + 2 * (m + 1) +
      ((sum m n).wires.length + 8 * (m + 1))))) ≤ _
    rw [Nat.max_self]
    omega

/-- **Addition, numbered, in a bounded number of bits**, in closed form
and whatever the schedule: the bound on the count, times three times the
bits of a key.  A key has a port index of at most two, and one cell that
fits in the word of the first factor. -/
theorem sum_btime (m n : Nat) {nt : Nat} (hnt : 0 < nt) (σ : Nat → Nat) (i : Nat) :
    (ZMach.init (sum m n) nt).btime xsys σ i ≤
      3 * ((lg (5 * m + 2 * n + 13 + sumWork m n nt) + 5) *
        (sumWork m n nt * (15 + 84 * lg (15 * m + 5 * n + 19)))) := by
  have g := good_sum m n
  obtain ⟨N', hs, hn', -⟩ := add_correct g.config
  obtain ⟨hL, htop⟩ := Below.sizes g.below g.ok.1.symm
  have ha := sum_agents_length_le m n
  have hw := sum_wires_length_le m n
  have h₁ := Nat.mul_le_mul_left (nt + m + 1) (sum_passBound_le m n)
  have hwork : (nt + (m + 1)) * (sum m n).passBound (m + 1) 2 8 + (m + 1) * (2 + 8 + 1) ≤
      sumWork m n nt := by
    show (nt + m + 1) * (sum m n).passBound (m + 1) 2 8 + (m + 1) * (2 + 8 + 1) ≤
      (nt + m + 1) * (33 * m + 11 * n + 49) + 11 * (m + 1)
    omega
  have hpow := lt_pow_lg (5 * m + 2 * n + 13 + sumWork m n nt)
  have hW : (sum m n).top + 3 * (m + 1 + 1) <
      2 ^ lg (5 * m + 2 * n + 13 + sumWork m n nt) := by omega
  have hW' : (sum m n).agents.length + ((nt + (m + 1)) * (sum m n).passBound (m + 1) 2 8 +
      (m + 1) * (2 + 8 + 1)) < 2 ^ lg (5 * m + 2 * n + 13 + sumWork m n nt) := by omega
  have h := ZMach.btime_bound (xs := xsys) g.ok.1 (sum_nodup m n) xsys_span xsys_ports
    (sum_ports m n) hnt xsys_bounded hL hs hn' σ hW hW' i
  refine Nat.le_trans h (Nat.mul_le_mul_left 3 (Nat.mul_le_mul ?_ (Nat.mul_le_mul hwork ?_)))
  · have e1 : lg 2 = 3 := by decide
    rw [Nat.max_self, Nat.one_mul, e1]
    omega
  · have hl := lg_mono (show (sum m n).agents.length + 2 * (m + 1) +
      ((sum m n).wires.length + 8 * (m + 1)) ≤ 15 * m + 5 * n + 19 by omega)
    show 2 + 8 + 5 + 4 * ((max 1 1 + 6) * (3 * lg ((sum m n).agents.length + 2 * (m + 1) +
      ((sum m n).wires.length + 8 * (m + 1))))) ≤ _
    rw [Nat.max_self]
    omega

/-- `12 + 12` on one thread, numbered, however it is scheduled: the bound
on the count is 7,028,955.  The run takes 10,999. -/
example : ∀ (σ : Nat → Nat) (i : Nat),
    (ZMach.init (sum 12 12) 1).ftime xsys σ i ≤ 7028955 :=
  fun σ => sum_ztime 12 12 (by decide) σ

/-- In bits the bound is 421,737,300.  The run takes 28,984. -/
example : ∀ (σ : Nat → Nat) (i : Nat),
    (ZMach.init (sum 12 12) 1).btime xsys σ i ≤ 421737300 :=
  fun σ => sum_btime 12 12 (by decide) σ

/-- `2 + 3` on three threads, numbered, however they are scheduled: the
bounds are 632,727 counted and 30,370,896 bits.  Scheduled in turn the run
takes 2,126 and 4,220. -/
example : ∀ (σ : Nat → Nat) (i : Nat),
    (ZMach.init (sum 2 3) 3).ftime xsys σ i ≤ 632727 ∧
      (ZMach.init (sum 2 3) 3).btime xsys σ i ≤ 30370896 :=
  fun σ i => ⟨sum_ztime 2 3 (by decide) σ i, sum_btime 2 3 (by decide) σ i⟩

/-- The actions one thread takes to add `m` and `n`, as the runs show. -/
def soloWork (m n : Nat) : Nat := if m = 0 then 6 * n + 13 else 22 * m + 3 * n + 13

/-- **One thread adds in `22 * m + 3 * n + 13` actions, on every size
computed.**  For all `m` and `n` below nine the run of a single thread on
the net for `m + n` is at rest after exactly that many actions, none of
them a rest (`6 * n + 13` when `m` is zero).  This is a computation, size
by size; it is not a proof for every size. -/
theorem solo_work_checked : ∀ m, m < 9 → ∀ n, n < 9 →
    ((XMach.init (sum m n) 1).trace xsys (fun _ => 0) (soloWork m n)).1.resting = true ∧
      (XMach.init (sum m n) 1).work xsys (fun _ => 0) (soloWork m n) = soloWork m n := by
  decide +kernel

/-- **A run whose work is known has its count bounded by it.**  When one
thread on the net for `m + n` is at rest after `B` actions of which `w`
are not rests, the time with everything counted is at most `w` times the
cost of an action. -/
theorem ztime_of_work (m n : Nat) {B w : Nat}
    (hr : ((XMach.init (sum m n) 1).trace xsys (fun _ => 0) B).1.resting = true)
    (hw : (XMach.init (sum m n) 1).work xsys (fun _ => 0) B = w) (i : Nat) :
    (ZMach.init (sum m n) 1).ftime xsys (fun _ => 0) i ≤
      w * (15 + 84 * lg (15 * m + 5 * n + 19)) := by
  have g := good_sum m n
  obtain ⟨N', hs, hn', -⟩ := add_correct g.config
  obtain ⟨hL, -⟩ := Below.sizes g.below g.ok.1.symm
  have hwi : (XMach.init (sum m n) 1).work xsys (fun _ => 0) i ≤ w := by
    by_cases h : i ≤ B
    · have h' := XMach.work_mono (xs := xsys) (fun _ => 0) (XMach.init (sum m n) 1) h
      rw [hw] at h'
      exact h'
    · obtain ⟨d, rfl⟩ : ∃ d, i = B + d := ⟨i - B, by omega⟩
      rw [XMach.work_rest (xs := xsys) (fun _ => 0) hr d, hw]
      exact Nat.le_refl _
  have h := ZMach.ftime_le_work (xs := xsys) g.ok.1 (sum_nodup m n) (Nat.succ_pos 0)
    xsys_bounded hL hs hn' (fun _ => 0) i
  have ha := sum_agents_length_le m n
  have hwl := sum_wires_length_le m n
  have hl := lg_mono (show (sum m n).agents.length + 2 * (m + 1) +
    ((sum m n).wires.length + 8 * (m + 1)) ≤ 15 * m + 5 * n + 19 by omega)
  have hc : 2 + 8 + 5 + 4 * ((max 1 1 + 6) * (3 * lg ((sum m n).agents.length + 2 * (m + 1) +
      ((sum m n).wires.length + 8 * (m + 1))))) ≤ 15 + 84 * lg (15 * m + 5 * n + 19) := by
    rw [Nat.max_self]
    omega
  rw [Nat.mul_comm w]
  exact Nat.le_trans h (Nat.mul_le_mul hc hwi)

/-- The same in bits: at most three times the bits of a key for each unit
counted. -/
theorem btime_of_work (m n : Nat) {B w : Nat}
    (hr : ((XMach.init (sum m n) 1).trace xsys (fun _ => 0) B).1.resting = true)
    (hw : (XMach.init (sum m n) 1).work xsys (fun _ => 0) B = w) (i : Nat) :
    (ZMach.init (sum m n) 1).btime xsys (fun _ => 0) i ≤
      3 * ((lg (5 * m + 2 * n + 13 + sumWork m n 1) + 5) *
        (w * (15 + 84 * lg (15 * m + 5 * n + 19)))) := by
  have g := good_sum m n
  obtain ⟨N', hs, hn', -⟩ := add_correct g.config
  obtain ⟨hL, htop⟩ := Below.sizes g.below g.ok.1.symm
  have ha := sum_agents_length_le m n
  have h₁ := Nat.mul_le_mul_left (1 + m + 1) (sum_passBound_le m n)
  have hwork : (1 + (m + 1)) * (sum m n).passBound (m + 1) 2 8 + (m + 1) * (2 + 8 + 1) ≤
      sumWork m n 1 := by
    show (1 + m + 1) * (sum m n).passBound (m + 1) 2 8 + (m + 1) * (2 + 8 + 1) ≤
      (1 + m + 1) * (33 * m + 11 * n + 49) + 11 * (m + 1)
    omega
  have hpow := lt_pow_lg (5 * m + 2 * n + 13 + sumWork m n 1)
  have hW : (sum m n).top + 3 * (m + 1 + 1) <
      2 ^ lg (5 * m + 2 * n + 13 + sumWork m n 1) := by omega
  have hW' : (sum m n).agents.length + ((1 + (m + 1)) * (sum m n).passBound (m + 1) 2 8 +
      (m + 1) * (2 + 8 + 1)) < 2 ^ lg (5 * m + 2 * n + 13 + sumWork m n 1) := by omega
  have h := ZMach.btime_le_ftime (xs := xsys) g.ok.1 (sum_nodup m n) xsys_span xsys_ports
    (sum_ports m n) (Nat.succ_pos 0) xsys_bounded hL hs hn' (fun _ => 0) hW hW' i
  refine Nat.le_trans h (Nat.mul_le_mul_left 3
    (Nat.mul_le_mul ?_ (ztime_of_work m n hr hw i)))
  have e1 : lg 2 = 3 := by decide
  rw [Nat.max_self, Nat.one_mul, e1]
  omega

/-- **On every size computed, one thread adds within the linear law times
the cost of an action**, counted and in bits. -/
theorem solo_ztime {m n : Nat} (hm : m < 9) (hn : n < 9) (i : Nat) :
    (ZMach.init (sum m n) 1).ftime xsys (fun _ => 0) i ≤
      soloWork m n * (15 + 84 * lg (15 * m + 5 * n + 19)) :=
  ztime_of_work m n (solo_work_checked m hm n hn).1 (solo_work_checked m hm n hn).2 i

theorem solo_btime {m n : Nat} (hm : m < 9) (hn : n < 9) (i : Nat) :
    (ZMach.init (sum m n) 1).btime xsys (fun _ => 0) i ≤
      3 * ((lg (5 * m + 2 * n + 13 + sumWork m n 1) + 5) *
        (soloWork m n * (15 + 84 * lg (15 * m + 5 * n + 19)))) :=
  btime_of_work m n (solo_work_checked m hm n hn).1 (solo_work_checked m hm n hn).2 i

/-- `12 + 12` on one thread: its 313 actions bound the count by 267,615
and the bits by 16,056,900, where the bounds for every schedule are
7,028,955 and 421,737,300.  The run takes 10,999 and 28,984. -/
theorem sum12_solo : ∀ i,
    (ZMach.init (sum 12 12) 1).ftime xsys (fun _ => 0) i ≤ 267615 ∧
      (ZMach.init (sum 12 12) 1).btime xsys (fun _ => 0) i ≤ 16056900 := by
  have hr : ((XMach.init (sum 12 12) 1).trace xsys (fun _ => 0) 320).1.resting = true := by
    decide +kernel
  exact fun i => ⟨ztime_of_work 12 12 hr sum12_work.1 i, btime_of_work 12 12 hr sum12_work.1 i⟩

/-- Where the chain of the first argument goes on: the successor numbered
`t`, or the zero at its end. -/
def below (n t : Nat) : Id := if n + 4 ≤ t then [t] else [2]

/-- **The chain of the first argument.**  The successors numbered from
`n + 4` to `hi` are agents of the memory, and the only segment at the
auxiliary port of each goes to the principal port of the one below. -/
structure Chain (n : Nat) (X : XNet Arith) (hi : Nat) : Prop where
  live : ∀ t, n + 4 ≤ t → t ≤ hi → assoc [t] X.agents = some .succ
  seg : ∀ t, n + 4 ≤ t → t ≤ hi → ∀ q, (([t], 1), q) ∈ X.wires ↔ q = (below n (t - 1), 0)

/-- **The memory before the first round**: the successor numbered `hi + 1`
is first in the list of agents and faces the adder. -/
structure Start (n : Nat) (X : XNet Arith) (hi : Nat) : Prop where
  head : ∃ rest, X.agents = ([hi + 1], .succ) :: rest
  top : n + 4 ≤ hi + 1
  adder : assoc [1] X.agents = some .add
  first : ∀ q, (([hi + 1], 0), q) ∈ X.wires ↔ q = ([1], 0)
  chain : Chain n X (hi + 1)
  fresh : ∀ t, n + 4 ≤ t → t ≤ hi + 1 → ∀ k q, (([0, t], k), q) ∉ X.wires

/-- **The memory before a later round**: the adder made in the last round
is first in the list of agents, and its principal port is one point away
from the next agent of the chain. -/
structure Steady (n : Nat) (X : XNet Arith) (hi : Nat) : Prop where
  head : ∃ rest, X.agents = ([0, hi + 1], .add) :: rest
  first : ∀ q, (([0, hi + 1], 0), q) ∈ X.wires ↔ q = ([hi + 1], 1)
  mid : ∀ q, (([hi + 1], 1), q) ∈ X.wires ↔ q = ([0, hi + 1], 0) ∨ q = (below n hi, 0)
  chain : Chain n X hi
  fresh : ∀ t, n + 4 ≤ t → t ≤ hi → ∀ k q, (([0, t], k), q) ∉ X.wires

/-- What the rounds need of the segments that a step between the adder `a`
and the successor `s` writes. -/
structure StepLinks (a s : Id) (L : List (Port × Port)) : Prop where
  adder : ∀ q, ((0 :: s, 0), q) ∈ L ↔ q = (s, 1)
  succ : ∀ q, ((s, 1), q) ∈ L ↔ q = (0 :: s, 0)
  names : ∀ e ∈ L, e.1.1 = a ∨ e.1.1 = s ∨ e.1.1 = 0 :: s ∨ e.1.1 = 0 :: a

theorem newLinks_add (a s : Id) : addSucc.toX.newLinks ar a s .add .succ =
    [((a, 1), (0 :: s, 1)), ((a, 2), (0 :: a, 0)), ((s, 1), (0 :: s, 0)),
     ((0 :: a, 0), (a, 2)), ((0 :: a, 1), (0 :: s, 2)), ((0 :: s, 0), (s, 1)),
     ((0 :: s, 1), (a, 1)), ((0 :: s, 2), (0 :: a, 1))] := rfl

theorem newLinks_swap (s a : Id) : addSucc.swap.toX.newLinks ar s a .succ .add =
    [((s, 1), (0 :: s, 0)), ((a, 1), (0 :: s, 1)), ((a, 2), (0 :: a, 0)),
     ((0 :: a, 0), (a, 2)), ((0 :: a, 1), (0 :: s, 2)), ((0 :: s, 0), (s, 1)),
     ((0 :: s, 1), (a, 1)), ((0 :: s, 2), (0 :: a, 1))] := rfl

theorem newAgents_add {a s : Id} (h : a ≠ s) :
    addSucc.toX.newAgents a s = [(0 :: a, .succ), (0 :: s, .add)] :=
  dedupFst_pair (x := (0 :: a, Arith.succ)) (y := (0 :: s, Arith.add))
    (fun e => h (List.cons.inj e).2)

theorem newAgents_swap {a s : Id} (h : a ≠ s) :
    addSucc.swap.toX.newAgents s a = [(0 :: a, .succ), (0 :: s, .add)] :=
  dedupFst_pair (x := (0 :: a, Arith.succ)) (y := (0 :: s, Arith.add))
    (fun e => h (List.cons.inj e).2)

theorem stepLinks_add {a s : Id} (h1 : a ≠ s) (h2 : s ≠ 0 :: a) :
    StepLinks a s (addSucc.toX.newLinks ar a s .add .succ) := by
  have hs : s ≠ 0 :: s := fun e => List.cons_ne_self 0 s e.symm
  rw [newLinks_add]
  refine ⟨fun q => ?_, fun q => ?_, fun e he => ?_⟩
  · simp [h1.symm, hs.symm]
  · simp [h1.symm, h2, hs]
  · simp only [List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp

theorem stepLinks_swap {a s : Id} (h1 : a ≠ s) (h2 : s ≠ 0 :: a) :
    StepLinks a s (addSucc.swap.toX.newLinks ar s a .succ .add) := by
  have hs : s ≠ 0 :: s := fun e => List.cons_ne_self 0 s e.symm
  rw [newLinks_swap]
  refine ⟨fun q => ?_, fun q => ?_, fun e he => ?_⟩
  · simp [h1.symm, hs.symm]
  · simp [h1.symm, h2, hs]
  · simp only [List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp

theorem below_pos {n t : Nat} (h : n + 4 ≤ t) : below n t = [t] := by
  unfold below
  rw [ite_pos' h]

/-- **After a step the memory is ready for the next round.**  When the
adder `a` and the successor numbered `h + 1` have fired, the new adder
`[0, h + 1]` is first in the list of agents, one point away from the next
agent of the chain, and the rest of the chain is as it was. -/
theorem steady_of_step {n : Nat} {X X' : XNet Arith} {a : Id} {h : Nat}
    {L : List (Port × Port)} (SL : StepLinks a [h + 1] L)
    (hW : ∀ e, e ∈ X'.wires ↔ e ∈ L ∨ e ∈ X.wires)
    (hHead : ∃ rest, X'.agents = ([0, h + 1], .add) :: rest)
    (hLive : ∀ t, n + 4 ≤ t → t ≤ h → assoc [t] X'.agents = assoc [t] X.agents)
    (ha1 : ∀ t, n + 4 ≤ t → a ≠ [t]) (ha2 : ∀ t, n + 4 ≤ t → t ≤ h → a ≠ [0, t])
    (ch : Chain n X (h + 1))
    (fr : ∀ t, n + 4 ≤ t → t ≤ h + 1 → ∀ k q, (([0, t], k), q) ∉ X.wires)
    (hn : n + 4 ≤ h + 1) : Steady n X' h := by
  have hname : ∀ t, n + 4 ≤ t → t ≤ h → ∀ k q, ((([t], k), q) : Port × Port) ∉ L := by
    intro t ht1 ht2 k q hm
    rcases SL.names _ hm with e | e | e | e
    · exact ha1 t ht1 e.symm
    · have e' : ([t] : Id) = [h + 1] := e
      injection e' with e1
      omega
    · have e' : ([t] : Id) = [0, h + 1] := e
      injection e' with _ e2
      cases e2
    · have e' : ([t] : Id) = 0 :: a := e
      injection e' with e1
      omega
  have hfresh : ∀ t, n + 4 ≤ t → t ≤ h → ∀ k q, ((([0, t], k), q) : Port × Port) ∉ L := by
    intro t ht1 ht2 k q hm
    rcases SL.names _ hm with e | e | e | e
    · exact ha2 t ht1 ht2 e.symm
    · have e' : ([0, t] : Id) = [h + 1] := e
      injection e' with _ e2
      cases e2
    · have e' : ([0, t] : Id) = [0, h + 1] := e
      injection e' with _ e2
      injection e2 with e3
      omega
    · have e' : ([0, t] : Id) = 0 :: a := e
      injection e' with _ e2
      exact ha1 t ht1 e2.symm
  refine ⟨hHead, fun q => ?_, fun q => ?_, ⟨fun t ht1 ht2 => ?_, fun t ht1 ht2 q => ?_⟩,
    fun t ht1 ht2 k q hm => ?_⟩
  · constructor
    · intro hm
      rcases (hW _).1 hm with hl | hx
      · exact (SL.adder q).1 hl
      · exact absurd hx (fr (h + 1) hn (Nat.le_refl _) 0 q)
    · intro e
      exact (hW _).2 (.inl ((SL.adder q).2 e))
  · have hseg := ch.seg (h + 1) hn (Nat.le_refl _) q
    rw [Nat.add_sub_cancel] at hseg
    constructor
    · intro hm
      rcases (hW _).1 hm with hl | hx
      · exact .inl ((SL.succ q).1 hl)
      · exact .inr (hseg.1 hx)
    · rintro (e | e)
      · exact (hW _).2 (.inl ((SL.succ q).2 e))
      · exact (hW _).2 (.inr (hseg.2 e))
  · rw [hLive t ht1 ht2]
    exact ch.live t ht1 (by omega)
  · have hseg := ch.seg t ht1 (by omega) q
    constructor
    · intro hm
      rcases (hW _).1 hm with hl | hx
      · exact absurd hl (hname t ht1 ht2 1 q)
      · exact hseg.1 hx
    · intro e
      exact (hW _).2 (.inr (hseg.2 e))
  · rcases (hW _).1 hm with hl | hx
    · exact hfresh t ht1 ht2 k q hl
    · exact fr t ht1 (by omega) k q hx

/-- **A later round of an addition, counted.**  The single thread takes the
adder, follows two segments to the next successor of the chain, claims,
writes two agents and eight segments, and is at a fresh start on a memory
ready for the next round: seventeen actions, none a rest. -/
theorem Steady.round {n : Nat} {X : XNet Arith} {h : Nat} (st : Steady n X (h + 1))
    (hn : n + 4 ≤ h + 1) :
    ∃ X', Works xsys X ⟨X.agents, .idle⟩ X' ⟨X'.agents, .idle⟩ 1 17 ∧ Steady n X' h := by
  obtain ⟨rest, hA⟩ := st.head
  have hb : below n (h + 1) = [h + 1] := below_pos hn
  have hne : ([0, h + 1 + 1] : Id) ≠ [h + 1] := fun e => by
    injection e with _ e2
    cases e2
  have h₁ : assoc [0, h + 1 + 1] X.agents = some .add := by
    rw [hA]
    show (if ([0, h + 1 + 1] : Id) = [0, h + 1 + 1] then some Arith.add
      else assoc _ rest) = _
    rw [ite_pos' rfl]
  have h₂ : assoc (([0, h + 1 + 1], 0) : Port) X.wires = some ([h + 1 + 1], 1) :=
    assoc_eq_of_unique ((st.first _).2 rfl) (fun q' hq => (st.first q').1 hq)
  have h₂' : nextSeg X.wires ([h + 1 + 1], 1) ([0, h + 1 + 1], 0) = some ([h + 1], 0) := by
    refine nextSeg_some ((st.mid _).2 (.inr (by rw [hb]))) (fun e => ?_) (fun q hq hqp => ?_)
    · injection e with e1 _
      injection e1 with _ e2
      cases e2
    · rcases (st.mid q).1 hq with e | e
      · exact absurd e hqp
      · rw [e, hb]
  have h₃ : assoc [h + 1] X.agents = some .succ := st.chain.live (h + 1) hn (Nat.le_refl _)
  have h₄ : assoc [h + 1] (X.takeAgent [0, h + 1 + 1]).agents = some .succ := by
    show assoc [h + 1] (X.agents.filter fun e => decide (e.1 ≠ [0, h + 1 + 1])) = _
    rw [assoc_filter_ne, ite_neg' hne]
    exact h₃
  have hR : xsys.rule .add .succ = some addSucc.toX := rfl
  have w := Works.claim_via (xs := xsys) (c := ([h + 1 + 1], 1)) rest h₁ h₂ rfl h₂' h₃ hne h₄ hR
  rw [← hA] at w
  have eA := newAgents_add (a := [0, h + 1 + 1]) (s := [h + 1]) hne
  have eK : 6 + ((addSucc.toX.newAgents [0, h + 1 + 1] [h + 1]).length +
      (addSucc.toX.newLinks xsys.sys.ar [0, h + 1 + 1] [h + 1] .add .succ).length + 1) =
      17 := by
    rw [eA]
    rfl
  rw [eK] at w
  refine ⟨_, w, ?_⟩
  have SL := stepLinks_add (a := [0, h + 1 + 1]) (s := [h + 1]) hne
    (fun e => by injection e with _ e2; cases e2)
  refine steady_of_step SL (fun e => XNet.mem_step_wires X _ _ _ _ e) ?_ ?_ ?_ ?_ st.chain
    st.fresh hn
  · rw [eA, XNet.step_agents]
    exact ⟨_, rfl⟩
  · intro t ht1 ht2
    have n1 : ¬ ([0, h + 1] : Id) = [t] := fun e => by injection e with _ e2; cases e2
    have n2 : ¬ ([0, 0, h + 1 + 1] : Id) = [t] := fun e => by injection e with _ e2; cases e2
    have n3 : ¬ ([h + 1] : Id) = [t] := fun e => by injection e with e1; omega
    have n4 : ¬ ([0, h + 1 + 1] : Id) = [t] := fun e => by injection e with _ e2; cases e2
    rw [eA, XNet.step_agents]
    show (if ([0, h + 1] : Id) = [t] then some Arith.add
      else if ([0, 0, h + 1 + 1] : Id) = [t] then some Arith.succ
      else assoc [t] ((X.agents.filter fun e => decide (e.1 ≠ [0, h + 1 + 1])).filter
        fun e => decide (e.1 ≠ [h + 1]))) = _
    rw [ite_neg' n1, ite_neg' n2, assoc_filter_ne, ite_neg' n3, assoc_filter_ne, ite_neg' n4]
  · intro t _ e
    injection e with _ e2
    cases e2
  · intro t _ ht2 e
    injection e with _ e2
    injection e2 with e3
    omega

/-- **The first round of an addition, counted.**  The single thread takes
the successor that faces the adder, claims, writes, and is at a fresh
start on a memory ready for the later rounds: sixteen actions, none a
rest. -/
theorem Start.round {n : Nat} {X : XNet Arith} {hi : Nat} (st : Start n X hi) :
    ∃ X', Works xsys X ⟨X.agents, .idle⟩ X' ⟨X'.agents, .idle⟩ 1 16 ∧ Steady n X' hi := by
  obtain ⟨rest, hA⟩ := st.head
  have ht := st.top
  have hne : ([hi + 1] : Id) ≠ [1] := fun e => by
    injection e with e1
    omega
  have hne' : ([1] : Id) ≠ [hi + 1] := fun e => hne e.symm
  have h₁ : assoc [hi + 1] X.agents = some .succ := by
    rw [hA]
    show (if ([hi + 1] : Id) = [hi + 1] then some Arith.succ else assoc _ rest) = _
    rw [ite_pos' rfl]
  have h₂ : assoc (([hi + 1], 0) : Port) X.wires = some ([1], 0) :=
    assoc_eq_of_unique ((st.first _).2 rfl) (fun q' hq => (st.first q').1 hq)
  have h₄ : assoc [1] (X.takeAgent [hi + 1]).agents = some .add := by
    show assoc [1] (X.agents.filter fun e => decide (e.1 ≠ [hi + 1])) = _
    rw [assoc_filter_ne, ite_neg' hne]
    exact st.adder
  have hR : xsys.rule .succ .add = some addSucc.swap.toX := rfl
  have w := Works.claim_direct (xs := xsys) rest h₁ h₂ st.adder hne h₄ hR
  rw [← hA] at w
  have eA := newAgents_swap (a := [1]) (s := [hi + 1]) hne'
  have eK : 5 + ((addSucc.swap.toX.newAgents [hi + 1] [1]).length +
      (addSucc.swap.toX.newLinks xsys.sys.ar [hi + 1] [1] .succ .add).length + 1) = 16 := by
    rw [eA]
    rfl
  rw [eK] at w
  refine ⟨_, w, ?_⟩
  have SL := stepLinks_swap (a := [1]) (s := [hi + 1]) hne'
    (fun e => by injection e with _ e2; cases e2)
  refine steady_of_step SL (fun e => XNet.mem_step_wires X _ _ _ _ e) ?_ ?_ ?_ ?_ st.chain
    st.fresh ht
  · rw [eA, XNet.step_agents]
    exact ⟨_, rfl⟩
  · intro t ht1 ht2
    have n1 : ¬ ([0, hi + 1] : Id) = [t] := fun e => by injection e with _ e2; cases e2
    have n2 : ¬ ([0, 1] : Id) = [t] := fun e => by injection e with _ e2; cases e2
    have n3 : ¬ ([1] : Id) = [t] := fun e => by injection e with e1; omega
    have n4 : ¬ ([hi + 1] : Id) = [t] := fun e => by injection e with e1; omega
    rw [eA, XNet.step_agents]
    show (if ([0, hi + 1] : Id) = [t] then some Arith.add
      else if ([0, 1] : Id) = [t] then some Arith.succ
      else assoc [t] ((X.agents.filter fun e => decide (e.1 ≠ [hi + 1])).filter
        fun e => decide (e.1 ≠ [1]))) = _
    rw [ite_neg' n1, ite_neg' n2, assoc_filter_ne, ite_neg' n3, assoc_filter_ne, ite_neg' n4]
  · intro t ht1 e
    injection e with e1
    omega
  · intro t _ _ e
    injection e with _ e2
    cases e2

/-- **The later rounds, one after the other**: `d` rounds of seventeen
actions each take the chain of the first argument down to its end. -/
theorem Steady.rounds {n : Nat} : ∀ (d : Nat) {X : XNet Arith}, Steady n X (n + 3 + d) →
    ∃ X', Works xsys X ⟨X.agents, .idle⟩ X' ⟨X'.agents, .idle⟩ d (17 * d) ∧
      Steady n X' (n + 3)
  | 0, X, st => ⟨X, .refl _ _, st⟩
  | d + 1, X, st => by
    obtain ⟨X₁, w₁, st₁⟩ := Steady.round (h := n + 3 + d) st (by omega)
    obtain ⟨X', w, st'⟩ := Steady.rounds d st₁
    refine ⟨X', ?_, st'⟩
    have w' := w₁.trans w
    have e1 : 1 + d = d + 1 := by omega
    have e2 : 17 + 17 * d = 17 * (d + 1) := by omega
    rw [e1, e2] at w'
    exact w'

/-- **All the rounds on the successors of the first argument, counted.**
From a memory in which `d + 1` successors are left, the single thread
claims each in turn, in `16 + 17 * d` actions, none of them a rest. -/
theorem Start.rounds {n d : Nat} {X : XNet Arith} (st : Start n X (n + 3 + d)) :
    ∃ X', Works xsys X ⟨X.agents, .idle⟩ X' ⟨X'.agents, .idle⟩ (d + 1) (16 + 17 * d) ∧
      Steady n X' (n + 3) := by
  obtain ⟨X₁, w₁, st₁⟩ := st.round
  obtain ⟨X', w, st'⟩ := Steady.rounds d st₁
  refine ⟨X', ?_, st'⟩
  have w' := w₁.trans w
  have e1 : 1 + d = d + 1 := by omega
  rw [e1] at w'
  exact w'

theorem push_some {X : XNet Arith} {p q : Port} (u : Id) (h : assoc p X.wires = some q) :
    push X p u = X.insert1 u .succ p q := by
  unfold push
  rw [h]

/-- What a successor put on the principal port of the adder does to the
segments. -/
theorem push_princ {X : XNet Arith} {u b : Id} (hu1 : u ≠ [1]) (hb1 : b ≠ [1]) (hbu : b ≠ u)
    (hfresh : ∀ k q, (((u, k), q) : Port × Port) ∉ X.wires) :
    (∀ q', ((([1], 0), q') : Port × Port) ∈ (X.insert1 u .succ ([1], 0) (b, 0)).wires ↔
        q' = (u, 0)) ∧
      (∀ q', (((u, 0), q') : Port × Port) ∈ (X.insert1 u .succ ([1], 0) (b, 0)).wires ↔
        q' = ([1], 0)) ∧
      (∀ q', (((u, 1), q') : Port × Port) ∈ (X.insert1 u .succ ([1], 0) (b, 0)).wires ↔
        q' = (b, 0)) ∧
      ∀ i q', i ≠ u → ((((i, 1), q') : Port × Port) ∈
        (X.insert1 u .succ ([1], 0) (b, 0)).wires ↔ ((i, 1), q') ∈ X.wires) := by
  have hu1' := hu1.symm
  have hb1' := hb1.symm
  have hbu' := hbu.symm
  refine ⟨fun q' => ?_, fun q' => ?_, fun q' => ?_, fun i q' hi => ?_⟩
  · rw [mem_insert1_wires]
    simp [*]
  · have h0 := hfresh 0 q'
    rw [mem_insert1_wires]
    simp [*]
  · have h1 := hfresh 1 q'
    rw [mem_insert1_wires]
    simp [*]
  · have hi' := hi.symm
    rw [mem_insert1_wires]
    simp [*]

theorem below_cases (n t : Nat) :
    (below n t = [t] ∧ n + 4 ≤ t) ∨ (below n t = [2] ∧ t < n + 4) := by
  unfold below
  by_cases h : n + 4 ≤ t
  · rw [ite_pos' h]
    exact .inl ⟨rfl, h⟩
  · rw [ite_neg' h]
    exact .inr ⟨rfl, by omega⟩

/-- In the net for `0 + n` the adder is an agent and its principal port
faces the zero numbered two. -/
theorem sumSnd_facts : ∀ n, assoc [1] (sumSnd n).agents = some .add ∧
    ∀ q, ((([1], 0), q) : Port × Port) ∈ (sumSnd n).wires ↔ q = ([2], 0)
  | 0 => by
    have hall : ∀ e ∈ base.wires, e.1 = ([1], 0) → e.2 = ([2], 0) := by decide
    have hmem : ((([1], 0), ([2], 0)) : Port × Port) ∈ base.wires := by decide
    refine ⟨by decide, fun q => ⟨fun h => hall _ h rfl, fun e => ?_⟩⟩
    rw [e]
    exact hmem
  | n + 1 => by
    obtain ⟨ad, pr⟩ := sumSnd_facts n
    have hu : ([n + 4] : Id) ≠ [1] := fun e => by
      injection e with e1
      omega
    cases hq : assoc (([1], 1) : Port) (sumSnd n).wires with
    | none =>
      have e : sumSnd (n + 1) = sumSnd n := by
        show push (sumSnd n) ([1], 1) [n + 4] = sumSnd n
        unfold push
        rw [hq]
      rw [e]
      exact ⟨ad, pr⟩
    | some q' =>
      have e : sumSnd (n + 1) = (sumSnd n).insert1 [n + 4] .succ ([1], 1) q' :=
        push_some [n + 4] hq
      have hs : (q', (([1], 1) : Port)) ∈ (sumSnd n).wires :=
        (good_sumSnd n).ok.1.symm (assoc_mem hq)
      have hq' : q' ≠ ([1], 0) := by
        intro e'
        rw [e'] at hs
        have h2 := (pr _).1 hs
        injection h2 with h3 _
        injection h3 with h4
        omega
      have hq'' := hq'.symm
      have hu' := hu.symm
      rw [e]
      refine ⟨?_, fun q => ?_⟩
      · show (if ([n + 4] : Id) = [1] then some Arith.succ
          else assoc [1] (sumSnd n).agents) = _
        rw [ite_neg' hu]
        exact ad
      · rw [mem_insert1_wires]
        simp [*]

/-- **The net for `m + n`, as the first round finds it.**  The adder is
an agent, its principal port faces the top of the chain of the first
argument, and the chain is in place. -/
structure Init (m n : Nat) (X : XNet Arith) : Prop where
  adder : assoc [1] X.agents = some .add
  princ : ∀ q, ((([1], 0), q) : Port × Port) ∈ X.wires ↔ q = (below n (m + n + 3), 0)
  chain : Chain n X (m + n + 3)

theorem init_sum : ∀ m n, Init m n (sum m n) ∧
    (1 ≤ m → (∃ rest, (sum m n).agents = ([m + n + 3], .succ) :: rest) ∧
      ∀ q, ((([m + n + 3], 0), q) : Port × Port) ∈ (sum m n).wires ↔ q = ([1], 0))
  | 0, n => by
    obtain ⟨ad, pr⟩ := sumSnd_facts n
    have e : below n (0 + n + 3) = [2] := by
      unfold below
      rw [ite_neg' (by omega)]
    refine ⟨⟨ad, fun q => ?_, ⟨fun t h1 h2 => absurd h2 (by omega),
      fun t h1 h2 => absurd h2 (by omega)⟩⟩, fun h => absurd h (by omega)⟩
    rw [e]
    exact pr q
  | m + 1, n => by
    obtain ⟨I, -⟩ := init_sum m n
    have hassoc : assoc (([1], 0) : Port) (sum m n).wires = some (below n (m + n + 3), 0) :=
      assoc_eq_of_unique ((I.princ _).2 rfl) (fun q' hq => (I.princ q').1 hq)
    have e : sum (m + 1) n =
        (sum m n).insert1 [m + n + 4] .succ ([1], 0) (below n (m + n + 3), 0) :=
      push_some [m + n + 4] hassoc
    have hu1 : ([m + n + 4] : Id) ≠ [1] := fun e => by
      injection e with e1
      omega
    have hb1 : below n (m + n + 3) ≠ [1] := by
      rcases below_cases n (m + n + 3) with ⟨hb, -⟩ | ⟨hb, -⟩ <;> rw [hb] <;> intro e' <;>
        injection e' with e1 <;> omega
    have hbu : below n (m + n + 3) ≠ [m + n + 4] := by
      rcases below_cases n (m + n + 3) with ⟨hb, -⟩ | ⟨hb, -⟩ <;> rw [hb] <;> intro e' <;>
        injection e' with e1 <;> omega
    have hfresh : ∀ k q, ((([m + n + 4], k), q) : Port × Port) ∉ (sum m n).wires := by
      intro k q hm
      obtain ⟨j, hj, ej⟩ := (good_sum m n).below [m + n + 4] (.inr (.inl ⟨k, q, hm⟩))
      injection ej with e1
      omega
    obtain ⟨F1, F2, F3, F4⟩ := push_princ hu1 hb1 hbu hfresh
    have e2 : m + 1 + n + 3 = m + n + 4 := by omega
    rw [e, e2]
    have hch : Chain n ((sum m n).insert1 [m + n + 4] .succ ([1], 0)
        (below n (m + n + 3), 0)) (m + n + 4) := by
      refine ⟨fun t h1 h2 => ?_, fun t h1 h2 q' => ?_⟩
      · show (if ([m + n + 4] : Id) = [t] then some Arith.succ
          else assoc [t] (sum m n).agents) = _
        by_cases ht : t = m + n + 4
        · rw [ite_pos' (by rw [ht])]
        · rw [ite_neg' (fun e' => ht (by injection e' with e1; omega))]
          exact I.chain.live t h1 (by omega)
      · by_cases ht : t = m + n + 4
        · have e3 : t - 1 = m + n + 3 := by omega
          rw [e3, ht]
          exact F3 q'
        · rw [F4 [t] q' (fun e' => ht (by injection e' with e1))]
          exact I.chain.seg t h1 (by omega) q'
    have hch' : Chain n ((sum m n).insert1 [m + n + 4] .succ ([1], 0)
        (below n (m + n + 3), 0)) (m + 1 + n + 3) := by
      rw [e2]
      exact hch
    refine ⟨⟨?_, fun q => ?_, hch'⟩, fun _ => ⟨⟨_, rfl⟩, F2⟩⟩
    · show (if ([m + n + 4] : Id) = [1] then some Arith.succ
        else assoc [1] (sum m n).agents) = _
      rw [ite_neg' hu1]
      exact I.adder
    · rw [e2, below_pos (t := m + n + 4) (by omega)]
      exact F1 q

/-- **The net for `(m + 1) + n` is ready for the first round.** -/
theorem start_sum (m n : Nat) : Start n (sum (m + 1) n) (m + n + 3) := by
  obtain ⟨I, h⟩ := init_sum (m + 1) n
  obtain ⟨hd, fst⟩ := h (Nat.succ_pos m)
  have e : m + 1 + n + 3 = m + n + 3 + 1 := by omega
  rw [e] at hd fst
  have ch := I.chain
  rw [e] at ch
  refine ⟨hd, by omega, I.adder, fst, ch, fun t _ _ k q hm => ?_⟩
  obtain ⟨j, -, ej⟩ := (good_sum (m + 1) n).below [0, t] (.inr (.inl ⟨k, q, hm⟩))
  injection ej with _ e2
  cases e2

/-- **One thread adds in linear time, for every size.**  On the net for
`(m + 1) + n` the single thread makes its `m + 1` claims on successors in
`16 + 17 * m` actions, and the rest of the run, one more claim and the
last pass, is bounded by the general bound on a net that is one step from
its normal form. -/
theorem solo_work_succ (m n : Nat) (i : Nat) :
    (XMach.init (sum (m + 1) n) 1).work xsys (fun _ => 0) i ≤ 83 * m + 22 * n + 235 := by
  have st := start_sum m n
  have e : m + n + 3 = n + 3 + m := by omega
  rw [e] at st
  obtain ⟨X', w, -⟩ := st.rounds
  have g := good_sum (m + 1) n
  have hX := g.ok.1
  have hnd := sum_nodup (m + 1) n
  obtain ⟨N', hs, hn', -⟩ := add_correct g.config
  have hK : (XMach.init (sum (m + 1) n) 1).trace xsys (fun _ => 0) (16 + 17 * m) =
      (XMach.init X' 1, m + 1) := by
    rw [XMach.init_one, XMach.init_one]
    exact w.trace.1
  -- the memory after the rounds is one step from the normal form
  have run : MRun xsys.sys ((XMach.init (sum (m + 1) n) 1).trace xsys (fun _ => 0)
      (16 + 17 * m)).2 (Mach.init (sum (m + 1) n).toNet)
      ((XMach.init (sum (m + 1) n) 1).trace xsys (fun _ => 0) (16 + 17 * m)).1.toMach := by
    have h := XMach.trace_run xsys (fun _ => 0) (XMach.init (sum (m + 1) n) 1) (16 + 17 * m)
    rw [XMach.init_toMach] at h
    exact h
  rw [hK] at run
  have run' : MRun xsys.sys (m + 1) (Mach.init (sum (m + 1) n).toNet)
      (Mach.init X'.toNet) := by
    have h : MRun xsys.sys (m + 1) (Mach.init (sum (m + 1) n).toNet)
        (XMach.init X' 1).toMach := run
    rw [XMach.init_toMach] at h
    exact h
  have sts : Steps (Step xsys.sys) (m + 1) (sum (m + 1) n).toNet X'.toNet :=
    run'.quiet hX (Mach.init_quiet _)
  obtain ⟨-, rest⟩ := reduction_bounded hX hs hn' sts
  have e1 : m + 1 + 1 - (m + 1) = 1 := by omega
  rw [e1] at rest
  have hX' : X'.toNet.WF xsys.sys.ar := Steps.wf hX sts
  -- no two agents of one name
  have live := XMach.trace_live (xs := xsys) (fun _ => 0)
    (XMach.init_live hX Nat.zero_lt_one)
  have nd : ∀ j, (((XMach.init (sum (m + 1) n) 1).trace xsys (fun _ => 0) j).1.mem.agents.map
      Prod.fst).Nodup := by
    intro j
    induction j with
    | zero => exact hnd
    | succ j ih => exact XMach.step_nodup (live j) ih 0
  have hnd' : (X'.agents.map Prod.fst).Nodup := by
    have h := nd (16 + 17 * m)
    rw [hK] at h
    exact h
  -- the sizes of the memory after the rounds
  obtain ⟨Φ, -, hΦ⟩ := XMach.work_measure hX hnd Nat.zero_lt_one xsys_bounded hs hn'
    (fun _ => 0)
  have hA' : X'.agents.length ≤ (sum (m + 1) n).agents.length + 2 * (m + 1 + 1) := by
    have h := (hΦ (16 + 17 * m)).1
    rw [hK] at h
    exact h
  have hW' : X'.wires.length ≤ (sum (m + 1) n).wires.length + 8 * (m + 1 + 1) := by
    have h := XMach.wires_le (xs := xsys) hX Nat.zero_lt_one xsys_bounded hs hn'
      (fun _ => 0) (16 + 17 * m)
    rw [hK] at h
    exact h
  have ha := sum_agents_length_le (m + 1) n
  have hwl := sum_wires_length_le (m + 1) n
  -- the rest of the run
  have tail : ∀ j, (XMach.init X' 1).work xsys (fun _ => 0) j ≤ 66 * m + 22 * n + 219 := by
    intro j
    have h := XMach.work_le hX' hnd' Nat.zero_lt_one xsys_bounded rest hn' (fun _ => 0) j
    have hp : X'.passBound 1 2 8 = 7 * (X'.agents.length + 2 * 1) + (X'.wires.length + 8 * 1) :=
      rfl
    rw [hp] at h
    omega
  -- the work up to the fresh start is the count of the rounds
  have hwK : ∀ j, (XMach.init (sum (m + 1) n) 1).work xsys (fun _ => 0) (16 + 17 * m + j) =
      16 + 17 * m + (XMach.init X' 1).work xsys (fun _ => 0) j := by
    intro j
    rw [XMach.init_one, XMach.init_one]
    exact w.work j
  by_cases hi : i ≤ 16 + 17 * m
  · have h := XMach.work_mono (xs := xsys) (fun _ => 0) (XMach.init (sum (m + 1) n) 1) hi
    have h0 : (XMach.init (sum (m + 1) n) 1).work xsys (fun _ => 0) (16 + 17 * m) =
        16 + 17 * m + (XMach.init X' 1).work xsys (fun _ => 0) 0 := hwK 0
    have t0 := tail 0
    rw [h0] at h
    omega
  · obtain ⟨j, rfl⟩ : ∃ j, i = 16 + 17 * m + j := ⟨i - (16 + 17 * m), by omega⟩
    have t := tail j
    rw [hwK j]
    omega

/-- **One thread adds `m` and `n` in at most `83 * m + 22 * n + 152`
actions**, for every `m` and `n`.  The runs computed take
`22 * m + 3 * n + 13`. -/
theorem solo_work_le (m n : Nat) (i : Nat) :
    (XMach.init (sum m n) 1).work xsys (fun _ => 0) i ≤ 83 * m + 22 * n + 152 := by
  cases m with
  | zero =>
    have g := good_sum 0 n
    obtain ⟨N', hs, hn', -⟩ := add_correct g.config
    have h := XMach.work_le g.ok.1 (sum_nodup 0 n) Nat.zero_lt_one xsys_bounded hs hn'
      (fun _ => 0) i
    have ha := sum_agents_length_le 0 n
    have hw := sum_wires_length_le 0 n
    have hp : (sum 0 n).passBound (0 + 1) 2 8 =
        7 * ((sum 0 n).agents.length + 2 * (0 + 1)) + ((sum 0 n).wires.length + 8 * (0 + 1)) :=
      rfl
    rw [hp] at h
    omega
  | succ m =>
    have h := solo_work_succ m n i
    omega

/-- **One thread adds, numbered, in a count that is linear but for a
logarithm**, for every `m` and `n`: the linear bound on its work times
the cost of an action. -/
theorem solo_ztime_le (m n : Nat) (i : Nat) :
    (ZMach.init (sum m n) 1).ftime xsys (fun _ => 0) i ≤
      (83 * m + 22 * n + 152) * (15 + 84 * lg (15 * m + 5 * n + 19)) := by
  have g := good_sum m n
  obtain ⟨N', hs, hn', -⟩ := add_correct g.config
  obtain ⟨hL, -⟩ := Below.sizes g.below g.ok.1.symm
  have hwi := solo_work_le m n i
  have h := ZMach.ftime_le_work (xs := xsys) g.ok.1 (sum_nodup m n) Nat.zero_lt_one
    xsys_bounded hL hs hn' (fun _ => 0) i
  have ha := sum_agents_length_le m n
  have hwl := sum_wires_length_le m n
  have hl := lg_mono (show (sum m n).agents.length + 2 * (m + 1) +
    ((sum m n).wires.length + 8 * (m + 1)) ≤ 15 * m + 5 * n + 19 by omega)
  have hc : 2 + 8 + 5 + 4 * ((max 1 1 + 6) * (3 * lg ((sum m n).agents.length + 2 * (m + 1) +
      ((sum m n).wires.length + 8 * (m + 1))))) ≤ 15 + 84 * lg (15 * m + 5 * n + 19) := by
    rw [Nat.max_self]
    omega
  rw [Nat.mul_comm (83 * m + 22 * n + 152)]
  exact Nat.le_trans h (Nat.mul_le_mul hc hwi)

/-- The same in bits. -/
theorem solo_btime_le (m n : Nat) (i : Nat) :
    (ZMach.init (sum m n) 1).btime xsys (fun _ => 0) i ≤
      3 * ((lg (5 * m + 2 * n + 13 + sumWork m n 1) + 5) *
        ((83 * m + 22 * n + 152) * (15 + 84 * lg (15 * m + 5 * n + 19)))) := by
  have g := good_sum m n
  obtain ⟨N', hs, hn', -⟩ := add_correct g.config
  obtain ⟨hL, htop⟩ := Below.sizes g.below g.ok.1.symm
  have ha := sum_agents_length_le m n
  have h₁ := Nat.mul_le_mul_left (1 + m + 1) (sum_passBound_le m n)
  have hwork : (1 + (m + 1)) * (sum m n).passBound (m + 1) 2 8 + (m + 1) * (2 + 8 + 1) ≤
      sumWork m n 1 := by
    show (1 + m + 1) * (sum m n).passBound (m + 1) 2 8 + (m + 1) * (2 + 8 + 1) ≤
      (1 + m + 1) * (33 * m + 11 * n + 49) + 11 * (m + 1)
    omega
  have hpow := lt_pow_lg (5 * m + 2 * n + 13 + sumWork m n 1)
  have hW : (sum m n).top + 3 * (m + 1 + 1) <
      2 ^ lg (5 * m + 2 * n + 13 + sumWork m n 1) := by omega
  have hW' : (sum m n).agents.length + ((1 + (m + 1)) * (sum m n).passBound (m + 1) 2 8 +
      (m + 1) * (2 + 8 + 1)) < 2 ^ lg (5 * m + 2 * n + 13 + sumWork m n 1) := by omega
  have h := ZMach.btime_le_ftime (xs := xsys) g.ok.1 (sum_nodup m n) xsys_span xsys_ports
    (sum_ports m n) Nat.zero_lt_one xsys_bounded hL hs hn' (fun _ => 0) hW hW' i
  refine Nat.le_trans h (Nat.mul_le_mul_left 3
    (Nat.mul_le_mul ?_ (solo_ztime_le m n i)))
  have e1 : lg 2 = 3 := by decide
  rw [Nat.max_self, Nat.one_mul, e1]
  omega

/-- `12 + 12` on one thread, from the bound for every size: at most 1,412
actions that are not rests, 1,207,260 counted and 72,435,600 bits.  The
run takes 313, 10,999 and 28,984. -/
example : ∀ i : Nat,
    (XMach.init (sum 12 12) 1).work xsys (fun _ => 0) i ≤ 1412 ∧
      (ZMach.init (sum 12 12) 1).ftime xsys (fun _ => 0) i ≤ 1207260 ∧
      (ZMach.init (sum 12 12) 1).btime xsys (fun _ => 0) i ≤ 72435600 :=
  fun i => ⟨solo_work_le 12 12 i, solo_ztime_le 12 12 i, solo_btime_le 12 12 i⟩


local macro "ports_differ" : tactic =>
  `(tactic| first | (intro e; simp at e; done) | (intro e; simp at e; omega))

/-- The memory after the first round: the successor `s` has fired with the
adder `a`. -/
def stepS (X : XNet Arith) (s a : Id) : XNet Arith :=
  (((X.takeAgent s).takeAgent a).putAgents (addSucc.swap.toX.newAgents s a)).putLinks
    (addSucc.swap.toX.newLinks xsys.sys.ar s a .succ .add)

/-- The memory after a later round: the adder `a` has fired with the
successor `s`. -/
def stepA (X : XNet Arith) (a s : Id) : XNet Arith :=
  (((X.takeAgent a).takeAgent s).putAgents (addSucc.toX.newAgents a s)).putLinks
    (addSucc.toX.newLinks xsys.sys.ar a s .add .succ)

/-- The memory after the last round: the adder `a` has fired with the zero
`z`. -/
def stepZ (X : XNet Arith) (a z : Id) : XNet Arith :=
  (((X.takeAgent a).takeAgent z).putAgents (addZero.toX.newAgents a z)).putLinks
    (addZero.toX.newLinks xsys.sys.ar a z .add .zero)

theorem newLinks_zero (a z : Id) : addZero.toX.newLinks ar a z .add .zero =
    [((a, 1), (a, 2)), ((a, 2), (a, 1))] := rfl

theorem newAgents_zero (a z : Id) : addZero.toX.newAgents a z = [] := rfl

/-- **The first round, with the memory it leaves**: sixteen actions,
charged thirty-three operations. -/
theorem Start.round_exact {n : Nat} {X : XNet Arith} {hi : Nat} (st : Start n X hi) :
    Opers xsys X ⟨X.agents, .idle⟩ (stepS X [hi + 1] [1])
        ⟨(stepS X [hi + 1] [1]).agents, .idle⟩ 1 16 33 ∧
      Steady n (stepS X [hi + 1] [1]) hi := by
  obtain ⟨rest, hA⟩ := st.head
  have ht := st.top
  have hne : ([hi + 1] : Id) ≠ [1] := fun e => by
    injection e with e1
    omega
  have hne' : ([1] : Id) ≠ [hi + 1] := fun e => hne e.symm
  have h₁ : assoc [hi + 1] X.agents = some .succ := by
    rw [hA]
    show (if ([hi + 1] : Id) = [hi + 1] then some Arith.succ else assoc _ rest) = _
    rw [ite_pos' rfl]
  have h₂ : assoc (([hi + 1], 0) : Port) X.wires = some ([1], 0) :=
    assoc_eq_of_unique ((st.first _).2 rfl) (fun q' hq => (st.first q').1 hq)
  have h₄ : assoc [1] (X.takeAgent [hi + 1]).agents = some .add := by
    show assoc [1] (X.agents.filter fun e => decide (e.1 ≠ [hi + 1])) = _
    rw [assoc_filter_ne, ite_neg' hne]
    exact st.adder
  have hR : xsys.rule .succ .add = some addSucc.swap.toX := rfl
  have w := Opers.claim_direct (xs := xsys) rest h₁ h₂ st.adder hne h₄ hR
  rw [← hA] at w
  have eA := newAgents_swap (a := [1]) (s := [hi + 1]) hne'
  have eK : 5 + ((addSucc.swap.toX.newAgents [hi + 1] [1]).length +
      (addSucc.swap.toX.newLinks xsys.sys.ar [hi + 1] [1] .succ .add).length + 1) = 16 := by
    rw [eA]
    rfl
  have eW : 13 + 2 * ((addSucc.swap.toX.newAgents [hi + 1] [1]).length +
      (addSucc.swap.toX.newLinks xsys.sys.ar [hi + 1] [1] .succ .add).length) = 33 := by
    rw [eA]
    rfl
  rw [eK, eW] at w
  refine ⟨w, ?_⟩
  unfold stepS
  have SL := stepLinks_swap (a := [1]) (s := [hi + 1]) hne'
    (fun e => by injection e with _ e2; cases e2)
  refine steady_of_step SL (fun e => XNet.mem_step_wires X _ _ _ _ e) ?_ ?_ ?_ ?_ st.chain
    st.fresh ht
  · rw [eA, XNet.step_agents]
    exact ⟨_, rfl⟩
  · intro t ht1 ht2
    have n1 : ¬ ([0, hi + 1] : Id) = [t] := fun e => by injection e with _ e2; cases e2
    have n2 : ¬ ([0, 1] : Id) = [t] := fun e => by injection e with _ e2; cases e2
    have n3 : ¬ ([1] : Id) = [t] := fun e => by injection e with e1; omega
    have n4 : ¬ ([hi + 1] : Id) = [t] := fun e => by injection e with e1; omega
    rw [eA, XNet.step_agents]
    show (if ([0, hi + 1] : Id) = [t] then some Arith.add
      else if ([0, 1] : Id) = [t] then some Arith.succ
      else assoc [t] ((X.agents.filter fun e => decide (e.1 ≠ [hi + 1])).filter
        fun e => decide (e.1 ≠ [1]))) = _
    rw [ite_neg' n1, ite_neg' n2, assoc_filter_ne, ite_neg' n3, assoc_filter_ne, ite_neg' n4]
  · intro t ht1 e
    injection e with e1
    omega
  · intro t _ _ e
    injection e with _ e2
    cases e2

/-- **A later round, with the memory it leaves**: seventeen actions,
charged thirty-five operations. -/
theorem Steady.round_exact {n : Nat} {X : XNet Arith} {h : Nat} (st : Steady n X (h + 1))
    (hn : n + 4 ≤ h + 1) :
    Opers xsys X ⟨X.agents, .idle⟩ (stepA X [0, h + 1 + 1] [h + 1])
        ⟨(stepA X [0, h + 1 + 1] [h + 1]).agents, .idle⟩ 1 17 35 ∧
      Steady n (stepA X [0, h + 1 + 1] [h + 1]) h := by
  obtain ⟨rest, hA⟩ := st.head
  have hb : below n (h + 1) = [h + 1] := below_pos hn
  have hne : ([0, h + 1 + 1] : Id) ≠ [h + 1] := fun e => by
    injection e with _ e2
    cases e2
  have h₁ : assoc [0, h + 1 + 1] X.agents = some .add := by
    rw [hA]
    show (if ([0, h + 1 + 1] : Id) = [0, h + 1 + 1] then some Arith.add
      else assoc _ rest) = _
    rw [ite_pos' rfl]
  have h₂ : assoc (([0, h + 1 + 1], 0) : Port) X.wires = some ([h + 1 + 1], 1) :=
    assoc_eq_of_unique ((st.first _).2 rfl) (fun q' hq => (st.first q').1 hq)
  have h₂' : nextSeg X.wires ([h + 1 + 1], 1) ([0, h + 1 + 1], 0) = some ([h + 1], 0) := by
    refine nextSeg_some ((st.mid _).2 (.inr (by rw [hb]))) (fun e => ?_) (fun q hq hqp => ?_)
    · injection e with e1 _
      injection e1 with _ e2
      cases e2
    · rcases (st.mid q).1 hq with e | e
      · exact absurd e hqp
      · rw [e, hb]
  have h₃ : assoc [h + 1] X.agents = some .succ := st.chain.live (h + 1) hn (Nat.le_refl _)
  have h₄ : assoc [h + 1] (X.takeAgent [0, h + 1 + 1]).agents = some .succ := by
    show assoc [h + 1] (X.agents.filter fun e => decide (e.1 ≠ [0, h + 1 + 1])) = _
    rw [assoc_filter_ne, ite_neg' hne]
    exact h₃
  have hR : xsys.rule .add .succ = some addSucc.toX := rfl
  have w := Opers.claim_via (xs := xsys) (c := ([h + 1 + 1], 1)) rest h₁ h₂ rfl h₂' h₃ hne h₄ hR
  rw [← hA] at w
  have eA := newAgents_add (a := [0, h + 1 + 1]) (s := [h + 1]) hne
  have eK : 6 + ((addSucc.toX.newAgents [0, h + 1 + 1] [h + 1]).length +
      (addSucc.toX.newLinks xsys.sys.ar [0, h + 1 + 1] [h + 1] .add .succ).length + 1) =
      17 := by
    rw [eA]
    rfl
  have eW : 15 + 2 * ((addSucc.toX.newAgents [0, h + 1 + 1] [h + 1]).length +
      (addSucc.toX.newLinks xsys.sys.ar [0, h + 1 + 1] [h + 1] .add .succ).length) = 35 := by
    rw [eA]
    rfl
  rw [eK, eW] at w
  refine ⟨w, ?_⟩
  unfold stepA
  have SL := stepLinks_add (a := [0, h + 1 + 1]) (s := [h + 1]) hne
    (fun e => by injection e with _ e2; cases e2)
  refine steady_of_step SL (fun e => XNet.mem_step_wires X _ _ _ _ e) ?_ ?_ ?_ ?_ st.chain
    st.fresh hn
  · rw [eA, XNet.step_agents]
    exact ⟨_, rfl⟩
  · intro t ht1 ht2
    have n1 : ¬ ([0, h + 1] : Id) = [t] := fun e => by injection e with _ e2; cases e2
    have n2 : ¬ ([0, 0, h + 1 + 1] : Id) = [t] := fun e => by injection e with _ e2; cases e2
    have n3 : ¬ ([h + 1] : Id) = [t] := fun e => by injection e with e1; omega
    have n4 : ¬ ([0, h + 1 + 1] : Id) = [t] := fun e => by injection e with _ e2; cases e2
    rw [eA, XNet.step_agents]
    show (if ([0, h + 1] : Id) = [t] then some Arith.add
      else if ([0, 0, h + 1 + 1] : Id) = [t] then some Arith.succ
      else assoc [t] ((X.agents.filter fun e => decide (e.1 ≠ [0, h + 1 + 1])).filter
        fun e => decide (e.1 ≠ [h + 1]))) = _
    rw [ite_neg' n1, ite_neg' n2, assoc_filter_ne, ite_neg' n3, assoc_filter_ne, ite_neg' n4]
  · intro t _ e
    injection e with _ e2
    cases e2
  · intro t _ ht2 e
    injection e with _ e2
    injection e2 with e3
    omega

/-- **The last round**: the adder fires with the zero at the end of the
chain, in nine actions charged nineteen operations, and writes two
segments. -/
theorem Steady.zero_round {n : Nat} {X : XNet Arith} (st : Steady n X (n + 3))
    (hz : assoc [2] X.agents = some .zero) :
    Opers xsys X ⟨X.agents, .idle⟩ (stepZ X [0, n + 3 + 1] [2])
      ⟨(stepZ X [0, n + 3 + 1] [2]).agents, .idle⟩ 1 9 19 := by
  obtain ⟨rest, hA⟩ := st.head
  have hb : below n (n + 3) = [2] := by
    unfold below
    rw [ite_neg' (by omega)]
  have hne : ([0, n + 3 + 1] : Id) ≠ [2] := fun e => by
    injection e with _ e2
    cases e2
  have h₁ : assoc [0, n + 3 + 1] X.agents = some .add := by
    rw [hA]
    show (if ([0, n + 3 + 1] : Id) = [0, n + 3 + 1] then some Arith.add
      else assoc _ rest) = _
    rw [ite_pos' rfl]
  have h₂ : assoc (([0, n + 3 + 1], 0) : Port) X.wires = some ([n + 3 + 1], 1) :=
    assoc_eq_of_unique ((st.first _).2 rfl) (fun q' hq => (st.first q').1 hq)
  have h₂' : nextSeg X.wires ([n + 3 + 1], 1) ([0, n + 3 + 1], 0) = some ([2], 0) := by
    refine nextSeg_some ((st.mid _).2 (.inr (by rw [hb]))) (fun e => ?_) (fun q hq hqp => ?_)
    · injection e with e1 _
      injection e1 with _ e2
      cases e2
    · rcases (st.mid q).1 hq with e | e
      · exact absurd e hqp
      · rw [e, hb]
  have h₄ : assoc [2] (X.takeAgent [0, n + 3 + 1]).agents = some .zero := by
    show assoc [2] (X.agents.filter fun e => decide (e.1 ≠ [0, n + 3 + 1])) = _
    rw [assoc_filter_ne, ite_neg' hne]
    exact hz
  have hR : xsys.rule .add .zero = some addZero.toX := rfl
  have w := Opers.claim_via (xs := xsys) (c := ([n + 3 + 1], 1)) rest h₁ h₂ rfl h₂' hz hne h₄ hR
  rw [← hA] at w
  exact w

/-- The segments the first round writes: the successor `[T]` meets the
adder `[1]`. -/
def linksS (T : Nat) : List (Port × Port) :=
  addSucc.swap.toX.newLinks ar [T] [1] .succ .add

/-- The segments a later round writes: the adder `[0, t + 1]` meets the
successor `[t]`. -/
def linksA (t : Nat) : List (Port × Port) :=
  addSucc.toX.newLinks ar [0, t + 1] [t] .add .succ

/-- The segments the last round writes: the adder `[0, t]` meets the zero. -/
def linksZ (t : Nat) : List (Port × Port) :=
  addZero.toX.newLinks ar [0, t] [2] .add .zero

theorem mem_linksS (T : Nat) (p q : Port) : ((p, q) : Port × Port) ∈ linksS T ↔
    p = ([T], 1) ∧ q = ([0, T], 0) ∨ p = ([1], 1) ∧ q = ([0, T], 1) ∨
    p = ([1], 2) ∧ q = ([0, 1], 0) ∨ p = ([0, 1], 0) ∧ q = ([1], 2) ∨
    p = ([0, 1], 1) ∧ q = ([0, T], 2) ∨ p = ([0, T], 0) ∧ q = ([T], 1) ∨
    p = ([0, T], 1) ∧ q = ([1], 1) ∨ p = ([0, T], 2) ∧ q = ([0, 1], 1) := by
  unfold linksS
  rw [newLinks_swap]
  simp only [List.mem_cons, Prod.mk.injEq, List.mem_nil_iff, or_false]

theorem mem_linksA (t : Nat) (p q : Port) : ((p, q) : Port × Port) ∈ linksA t ↔
    p = ([0, t + 1], 1) ∧ q = ([0, t], 1) ∨ p = ([0, t + 1], 2) ∧ q = ([0, 0, t + 1], 0) ∨
    p = ([t], 1) ∧ q = ([0, t], 0) ∨ p = ([0, 0, t + 1], 0) ∧ q = ([0, t + 1], 2) ∨
    p = ([0, 0, t + 1], 1) ∧ q = ([0, t], 2) ∨ p = ([0, t], 0) ∧ q = ([t], 1) ∨
    p = ([0, t], 1) ∧ q = ([0, t + 1], 1) ∨ p = ([0, t], 2) ∧ q = ([0, 0, t + 1], 1) := by
  unfold linksA
  rw [newLinks_add]
  simp only [List.mem_cons, Prod.mk.injEq, List.mem_nil_iff, or_false]

theorem mem_linksZ (t : Nat) (p q : Port) : ((p, q) : Port × Port) ∈ linksZ t ↔
    p = ([0, t], 1) ∧ q = ([0, t], 2) ∨ p = ([0, t], 2) ∧ q = ([0, t], 1) := by
  unfold linksZ
  rw [newLinks_zero]
  simp only [List.mem_cons, Prod.mk.injEq, List.mem_nil_iff, or_false]

/-- **The second argument and the result wire**, as the rounds leave
them: the segments at the ports of the second chain, of the second
argument of the first adder and of its result. -/
structure Snd (n : Nat) (X : XNet Arith) : Prop where
  one : ∀ q, ((([1], 1), q) : Port × Port) ∈ X.wires ↔ q = ([n + 3], 0)
  top : ∀ q, ((([n + 3], 0), q) : Port × Port) ∈ X.wires ↔ q = ([1], 1)
  up : ∀ j, 3 ≤ j → j ≤ n + 2 → ∀ q,
    ((([j], 0), q) : Port × Port) ∈ X.wires ↔ q = ([j + 1], 1)
  down : ∀ j, 3 ≤ j → j ≤ n + 2 → ∀ q,
    ((([j + 1], 1), q) : Port × Port) ∈ X.wires ↔ q = ([j], 0)
  res : ∀ q, ((([1], 2), q) : Port × Port) ∈ X.wires ↔ q = ([0], 0)
  out : ∀ q, ((([0], 0), q) : Port × Port) ∈ X.wires ↔ q = ([1], 2)

theorem base_port (p q0 : Port) (hall : ∀ e ∈ base.wires, e.1 = p → e.2 = q0)
    (hmem : ((p, q0) : Port × Port) ∈ base.wires) (q : Port) :
    ((p, q) : Port × Port) ∈ base.wires ↔ q = q0 :=
  ⟨fun h => hall _ h rfl, fun e => by rw [e]; exact hmem⟩

theorem snd_sumSnd : ∀ n, Snd n (sumSnd n)
  | 0 =>
    ⟨base_port _ _ (by decide) (by decide), base_port _ _ (by decide) (by decide),
      fun j h1 h2 => absurd h2 (by omega), fun j h1 h2 => absurd h2 (by omega),
      base_port _ _ (by decide) (by decide), base_port _ _ (by decide) (by decide)⟩
  | n + 1 => by
    have S := snd_sumSnd n
    have hassoc : assoc (([1], 1) : Port) (sumSnd n).wires = some ([n + 3], 0) :=
      assoc_eq_of_unique ((S.one _).2 rfl) (fun q' hq => (S.one q').1 hq)
    have e : sumSnd (n + 1) = (sumSnd n).insert1 [n + 4] .succ ([1], 1) ([n + 3], 0) :=
      push_some [n + 4] hassoc
    have hfresh : ∀ k q, ((([n + 4], k), q) : Port × Port) ∉ (sumSnd n).wires := by
      intro k q hm
      obtain ⟨j, hj, ej⟩ := (good_sumSnd n).below [n + 4] (.inr (.inl ⟨k, q, hm⟩))
      injection ej with e1
      omega
    obtain ⟨N1, N2, N3, N4⟩ := insert1_new (sumSnd n) [n + 4] .succ ([1], 1) ([n + 3], 0)
      (by ports_differ) (by ports_differ) (by ports_differ) hfresh
    rw [e]
    refine ⟨fun q => N1 q, fun q => N2 q, fun j h1 h2 q => ?_, fun j h1 h2 q => ?_,
      fun q => ?_, fun q => ?_⟩
    · by_cases hj : j = n + 3
      · rw [hj]
        exact N4 q
      · rw [insert1_frame (sumSnd n) [n + 4] .succ ([1], 1) ([n + 3], 0) ([j], 0)
          (by ports_differ) (by ports_differ) (by ports_differ)]
        exact S.up j h1 (by omega) q
    · by_cases hj : j = n + 3
      · rw [hj]
        exact N3 q
      · rw [insert1_frame (sumSnd n) [n + 4] .succ ([1], 1) ([n + 3], 0) ([j + 1], 1)
          (by ports_differ) (by ports_differ) (by ports_differ)]
        exact S.down j h1 (by omega) q
    · rw [insert1_frame (sumSnd n) [n + 4] .succ ([1], 1) ([n + 3], 0) ([1], 2)
        (by ports_differ) (by ports_differ) (by ports_differ)]
      exact S.res q
    · rw [insert1_frame (sumSnd n) [n + 4] .succ ([1], 1) ([n + 3], 0) ([0], 0)
        (by ports_differ) (by ports_differ) (by ports_differ)]
      exact S.out q

theorem Snd.insert {n : Nat} {X : XNet Arith} (S : Snd n X) {u : Nat} {b : Id}
    (hu : n + 4 ≤ u) (hb : b = [2] ∨ ∃ t, n + 4 ≤ t ∧ b = [t]) :
    Snd n (X.insert1 [u] .succ ([1], 0) (b, 0)) := by
  have hb' : ∀ j, (j ≤ 1 ∨ 3 ≤ j) → j ≤ n + 3 → ([j], 0) ≠ ((b, 0) : Port) := by
    intro j h1 h2 e
    injection e with e1 _
    rcases hb with hb | ⟨t, ht, hb⟩
    · rw [hb] at e1
      injection e1 with e2
      omega
    · rw [hb] at e1
      injection e1 with e2
      omega
  refine ⟨fun q => ?_, fun q => ?_, fun j h1 h2 q => ?_, fun j h1 h2 q => ?_,
    fun q => ?_, fun q => ?_⟩
  · rw [insert1_frame X [u] .succ ([1], 0) (b, 0) ([1], 1)
      (by ports_differ) (by ports_differ) (by ports_differ)]
    exact S.one q
  · rw [insert1_frame X [u] .succ ([1], 0) (b, 0) ([n + 3], 0)
      (by ports_differ) (hb' (n + 3) (by omega) (by omega)) (by ports_differ)]
    exact S.top q
  · rw [insert1_frame X [u] .succ ([1], 0) (b, 0) ([j], 0)
      (by ports_differ) (hb' j (by omega) (by omega)) (by ports_differ)]
    exact S.up j h1 h2 q
  · rw [insert1_frame X [u] .succ ([1], 0) (b, 0) ([j + 1], 1)
      (by ports_differ) (by ports_differ) (by ports_differ)]
    exact S.down j h1 h2 q
  · rw [insert1_frame X [u] .succ ([1], 0) (b, 0) ([1], 2)
      (by ports_differ) (by ports_differ) (by ports_differ)]
    exact S.res q
  · rw [insert1_frame X [u] .succ ([1], 0) (b, 0) ([0], 0)
      (by ports_differ) (hb' 0 (by omega) (by omega)) (by ports_differ)]
    exact S.out q

theorem sum_push (m n : Nat) : sum (m + 1) n =
    (sum m n).insert1 [m + n + 4] .succ ([1], 0) (below n (m + n + 3), 0) := by
  have I := (init_sum m n).1
  exact push_some [m + n + 4]
    (assoc_eq_of_unique ((I.princ _).2 rfl) (fun q' hq => (I.princ q').1 hq))

/-- **The second argument is in place in the net for `m + n`.** -/
theorem snd_sum : ∀ m n, Snd n (sum m n)
  | 0, n => snd_sumSnd n
  | m + 1, n => by
    rw [sum_push]
    refine (snd_sum m n).insert (by omega) ?_
    rcases below_cases n (m + n + 3) with ⟨hb, hle⟩ | ⟨hb, -⟩
    · exact .inr ⟨_, hle, hb⟩
    · exact .inl hb

/-- The successors of the second argument, the newest first. -/
def sndL : Nat → List (Id × Arith)
  | 0 => []
  | n + 1 => ([n + 4], .succ) :: sndL n

/-- The successors of the first argument that are left, the top first. -/
def chainL (n : Nat) : Nat → List (Id × Arith)
  | 0 => []
  | r + 1 => ([n + 3 + r + 1], .succ) :: chainL n r

/-- The successors of the result, the newest first. -/
def resL : Nat → Nat → List (Id × Arith)
  | _, 0 => [([0, 1], .succ)]
  | h, d + 1 => ([0, 0, h + 2], .succ) :: resL (h + 1) d

/-- The second argument and the zero of the first, in the order of the
list of agents. -/
def tailA (n : Nat) : List (Id × Arith) := sndL n ++ [([2], .zero), ([3], .zero)]

theorem mem_sndL : ∀ {n : Nat} {e : Id × Arith}, e ∈ sndL n →
    e.2 = .succ ∧ ∃ j, 4 ≤ j ∧ j ≤ n + 3 ∧ e.1 = [j]
  | 0, _, h => by cases h
  | n + 1, e, h => by
    rcases List.mem_cons.1 h with rfl | h'
    · exact ⟨rfl, n + 4, by omega, by omega, rfl⟩
    · obtain ⟨h1, j, h2, h3, h4⟩ := mem_sndL h'
      exact ⟨h1, j, h2, by omega, h4⟩

theorem mem_chainL {n : Nat} : ∀ {r : Nat} {e : Id × Arith}, e ∈ chainL n r →
    e.2 = .succ ∧ ∃ j, n + 4 ≤ j ∧ j ≤ n + 3 + r ∧ e.1 = [j]
  | 0, _, h => by cases h
  | r + 1, e, h => by
    rcases List.mem_cons.1 h with rfl | h'
    · exact ⟨rfl, n + 3 + r + 1, by omega, by omega, rfl⟩
    · obtain ⟨h1, j, h2, h3, h4⟩ := mem_chainL h'
      exact ⟨h1, j, h2, by omega, h4⟩

theorem mem_resL : ∀ {d h : Nat} {e : Id × Arith}, e ∈ resL h d →
    e.2 = .succ ∧ (e.1 = [0, 1] ∨ ∃ x, h + 2 ≤ x ∧ x ≤ h + d + 1 ∧ e.1 = [0, 0, x])
  | 0, h, e, hm => by
    rcases List.mem_cons.1 hm with rfl | h'
    · exact ⟨rfl, .inl rfl⟩
    · cases h'
  | d + 1, h, e, hm => by
    rcases List.mem_cons.1 hm with rfl | h'
    · exact ⟨rfl, .inr ⟨h + 2, by omega, by omega, rfl⟩⟩
    · obtain ⟨h1, h2⟩ := mem_resL h'
      refine ⟨h1, ?_⟩
      rcases h2 with h2 | ⟨x, h3, h4, h5⟩
      · exact .inl h2
      · exact .inr ⟨x, by omega, by omega, h5⟩

theorem mem_tailA {n : Nat} {e : Id × Arith} (h : e ∈ tailA n) :
    ∃ j, 2 ≤ j ∧ j ≤ n + 3 ∧ e.1 = [j] := by
  rcases List.mem_append.1 h with h | h
  · obtain ⟨-, j, h1, h2, h3⟩ := mem_sndL h
    exact ⟨j, by omega, h2, h3⟩
  · rcases List.mem_cons.1 h with rfl | h
    · exact ⟨2, by omega, by omega, rfl⟩
    · rcases List.mem_cons.1 h with rfl | h
      · exact ⟨3, by omega, by omega, rfl⟩
      · cases h

/-- The names of the agents that are not results: one number each. -/
theorem mem_rest {n r : Nat} {e : Id × Arith} (h : e ∈ chainL n r ++ tailA n) :
    ∃ j, 2 ≤ j ∧ j ≤ n + 3 + r ∧ e.1 = [j] := by
  rcases List.mem_append.1 h with h | h
  · obtain ⟨-, j, h1, h2, h3⟩ := mem_chainL h
    exact ⟨j, by omega, h2, h3⟩
  · obtain ⟨j, h1, h2, h3⟩ := mem_tailA h
    exact ⟨j, h1, by omega, h3⟩

theorem sumSnd_agents : ∀ n, (sumSnd n).agents = sndL n ++ base.agents
  | 0 => rfl
  | n + 1 => by
    have S := snd_sumSnd n
    have hassoc : assoc (([1], 1) : Port) (sumSnd n).wires = some ([n + 3], 0) :=
      assoc_eq_of_unique ((S.one _).2 rfl) (fun q' hq => (S.one q').1 hq)
    have e : sumSnd (n + 1) = (sumSnd n).insert1 [n + 4] .succ ([1], 1) ([n + 3], 0) :=
      push_some [n + 4] hassoc
    rw [e]
    show ([n + 4], Arith.succ) :: (sumSnd n).agents = ([n + 4], Arith.succ) :: (sndL n ++ _)
    rw [sumSnd_agents n]

/-- **The agents of the net for `m + n`, in order.** -/
theorem sum_agents : ∀ m n, (sum m n).agents = chainL n m ++ (sndL n ++ base.agents)
  | 0, n => sumSnd_agents n
  | m + 1, n => by
    have e : m + n + 4 = n + 3 + m + 1 := by omega
    rw [sum_push]
    show ([m + n + 4], Arith.succ) :: (sum m n).agents =
      ([n + 3 + m + 1], Arith.succ) :: (chainL n m ++ (sndL n ++ base.agents))
    rw [sum_agents m n, e]

/-- **The memory in the middle of the run**, after the first round and
`d` later ones, with `r` successors of the first argument left: the
agents in order, and the segments as those of the net at the start and
those each round wrote. -/
structure Hist (n : Nat) (X0 X : XNet Arith) (T r d : Nat) : Prop where
  top : T = n + 3 + r + d + 1
  agents : X.agents =
    ([0, n + 3 + r + 1], .add) :: (resL (n + 3 + r) d ++ (chainL n r ++ tailA n))
  wires : ∀ e, e ∈ X.wires ↔
    e ∈ X0.wires ∨ e ∈ linksS T ∨ ∃ t, n + 3 + r < t ∧ t < T ∧ e ∈ linksA t

theorem res_ne_single {d h : Nat} {e : Id × Arith} (he : e ∈ resL h d) (t : Nat) :
    e.1 ≠ [t] := by
  intro e'
  rcases (mem_resL he).2 with h1 | ⟨x, -, -, h1⟩ <;> rw [h1] at e' <;>
    injection e' with _ e2 <;> cases e2

theorem res_ne_adder {d h : Nat} {e : Id × Arith} (he : e ∈ resL h d) (t : Nat) (ht : t ≠ 1) :
    e.1 ≠ [0, t] := by
  intro e'
  rcases (mem_resL he).2 with h1 | ⟨x, -, -, h1⟩
  · rw [h1] at e'
    injection e' with _ e2
    injection e2 with e3
    omega
  · rw [h1] at e'
    injection e' with _ e2
    injection e2 with e3 e4
    cases e4

theorem rest_ne_adder {n r : Nat} {e : Id × Arith} (he : e ∈ chainL n r ++ tailA n)
    (t : Nat) : e.1 ≠ [0, t] := by
  intro e'
  obtain ⟨j, -, -, h1⟩ := mem_rest he
  rw [h1] at e'
  injection e' with _ e2
  cases e2

/-- **After the first round.** -/
theorem hist_start {n r : Nat} {X0 : XNet Arith}
    (hA : X0.agents = chainL n (r + 1) ++ (sndL n ++ base.agents)) :
    Hist n X0 (stepS X0 [n + 3 + r + 1] [1]) (n + 3 + r + 1) r 0 := by
  have hne' : ([1] : Id) ≠ [n + 3 + r + 1] := fun e => by
    injection e with e1
    omega
  refine ⟨rfl, ?_, fun e => ?_⟩
  · have f1 : (chainL n (r + 1) ++ (sndL n ++ base.agents)).filter
        (fun e => decide (e.1 ≠ [n + 3 + r + 1])) = chainL n r ++ (sndL n ++ base.agents) := by
      show ((([n + 3 + r + 1], Arith.succ) :: (chainL n r ++ (sndL n ++ base.agents))).filter
        (fun e => decide (e.1 ≠ [n + 3 + r + 1]))) = _
      rw [List.filter_cons_of_neg (by simp)]
      refine filter_keep fun e he e' => ?_
      rcases List.mem_append.1 he with h | h
      · obtain ⟨-, j, -, h2, h3⟩ := mem_chainL h
        rw [h3] at e'
        injection e' with e1
        omega
      · rcases List.mem_append.1 h with h | h
        · obtain ⟨-, j, -, h2, h3⟩ := mem_sndL h
          rw [h3] at e'
          injection e' with e1
          omega
        · have hall : ∀ x ∈ base.agents, x.1 = [1] ∨ x.1 = [2] ∨ x.1 = [3] := by decide
          rcases hall e h with h3 | h3 | h3 <;> rw [h3] at e' <;> injection e' with e1 <;>
            omega
    have f2 : (chainL n r ++ (sndL n ++ base.agents)).filter
        (fun e => decide (e.1 ≠ [1])) = chainL n r ++ tailA n := by
      rw [List.filter_append, List.filter_append]
      have k1 : (chainL n r).filter (fun e => decide (e.1 ≠ [1])) = chainL n r :=
        filter_keep fun e he e' => by
          obtain ⟨-, j, h1, -, h3⟩ := mem_chainL he
          rw [h3] at e'
          injection e' with e1
          omega
      have k2 : (sndL n).filter (fun e => decide (e.1 ≠ [1])) = sndL n :=
        filter_keep fun e he e' => by
          obtain ⟨-, j, h1, -, h3⟩ := mem_sndL he
          rw [h3] at e'
          injection e' with e1
          omega
      rw [k1, k2]
      rfl
    unfold stepS
    rw [newAgents_swap hne', XNet.step_agents, hA, f1, f2]
    rfl
  · unfold stepS
    rw [XNet.mem_step_wires]
    show e ∈ linksS (n + 3 + r + 1) ∨ e ∈ X0.wires ↔ _
    constructor
    · rintro (h | h)
      · exact .inr (.inl h)
      · exact .inl h
    · rintro (h | h | ⟨t, h1, h2, -⟩)
      · exact .inr h
      · exact .inl h
      · omega

/-- **A later round keeps the description.** -/
theorem Hist.step {n : Nat} {X0 X : XNet Arith} {T r d : Nat} (H : Hist n X0 X T (r + 1) d) :
    Hist n X0 (stepA X [0, n + 3 + r + 1 + 1] [n + 3 + r + 1]) T r (d + 1) := by
  have hne : ([0, n + 3 + r + 1 + 1] : Id) ≠ [n + 3 + r + 1] := fun e => by
    injection e with _ e2
    cases e2
  have hT := H.top
  refine ⟨by omega, ?_, fun e => ?_⟩
  · have f1 : ((([0, n + 3 + r + 1 + 1], Arith.add) ::
        (resL (n + 3 + r + 1) d ++ (chainL n (r + 1) ++ tailA n))).filter
        (fun e => decide (e.1 ≠ [0, n + 3 + r + 1 + 1]))) =
        resL (n + 3 + r + 1) d ++ (chainL n (r + 1) ++ tailA n) := by
      rw [List.filter_cons_of_neg (by simp)]
      refine filter_keep fun e he => ?_
      rcases List.mem_append.1 he with h | h
      · exact res_ne_adder h _ (by omega)
      · exact rest_ne_adder h _
    have f2 : (resL (n + 3 + r + 1) d ++ (chainL n (r + 1) ++ tailA n)).filter
        (fun e => decide (e.1 ≠ [n + 3 + r + 1])) =
        resL (n + 3 + r + 1) d ++ (chainL n r ++ tailA n) := by
      rw [List.filter_append, filter_keep (fun e he => res_ne_single he _)]
      show _ ++ ((([n + 3 + r + 1], Arith.succ) :: (chainL n r ++ tailA n)).filter
        (fun e => decide (e.1 ≠ [n + 3 + r + 1]))) = _
      have k : (chainL n r ++ tailA n).filter (fun e => decide (e.1 ≠ [n + 3 + r + 1])) =
          chainL n r ++ tailA n :=
        filter_keep fun e he e' => by
          obtain ⟨j, -, h2, h3⟩ := mem_rest he
          rw [h3] at e'
          injection e' with e1
          omega
      rw [List.filter_cons_of_neg (by simp), k]
    have hA : X.agents = ([0, n + 3 + r + 1 + 1], Arith.add) ::
        (resL (n + 3 + r + 1) d ++ (chainL n (r + 1) ++ tailA n)) := H.agents
    unfold stepA
    rw [newAgents_add hne, XNet.step_agents, hA, f1, f2]
    rfl
  · unfold stepA
    rw [XNet.mem_step_wires, H.wires]
    show e ∈ linksA (n + 3 + r + 1) ∨ _ ↔ _
    constructor
    · rintro (h | h | h | ⟨t, h1, h2, h3⟩)
      · exact .inr (.inr ⟨n + 3 + r + 1, by omega, by omega, h⟩)
      · exact .inl h
      · exact .inr (.inl h)
      · exact .inr (.inr ⟨t, by omega, h2, h3⟩)
    · rintro (h | h | ⟨t, h1, h2, h3⟩)
      · exact .inr (.inl h)
      · exact .inr (.inr (.inl h))
      · by_cases ht : t = n + 3 + r + 1
        · rw [ht] at h3
          exact .inl h3
        · exact .inr (.inr (.inr ⟨t, by omega, h2, h3⟩))

/-- **The memory at the end of the rounds**: the agents in order, the
successors of the result and then the second argument, and the segments
as those of the net at the start and those each round wrote. -/
structure Final (n : Nat) (X0 X : XNet Arith) (T d : Nat) : Prop where
  top : T = n + 3 + d + 1
  agents : X.agents = resL (n + 3) d ++ (sndL n ++ [([3], .zero)])
  wires : ∀ e, e ∈ X.wires ↔ e ∈ X0.wires ∨ e ∈ linksS T ∨
    (∃ t, n + 3 < t ∧ t < T ∧ e ∈ linksA t) ∨ e ∈ linksZ (n + 3 + 1)

/-- **The last round leaves the final description.** -/
theorem Hist.final {n : Nat} {X0 X : XNet Arith} {T d : Nat} (H : Hist n X0 X T 0 d) :
    Final n X0 (stepZ X [0, n + 3 + 1] [2]) T d := by
  have hT := H.top
  refine ⟨by omega, ?_, fun e => ?_⟩
  · have hA : X.agents = ([0, n + 3 + 1], Arith.add) :: (resL (n + 3) d ++ tailA n) := H.agents
    have f1 : ((([0, n + 3 + 1], Arith.add) :: (resL (n + 3) d ++ tailA n)).filter
        (fun e => decide (e.1 ≠ [0, n + 3 + 1]))) = resL (n + 3) d ++ tailA n := by
      rw [List.filter_cons_of_neg (by simp)]
      refine filter_keep fun e he => ?_
      rcases List.mem_append.1 he with h | h
      · exact res_ne_adder h _ (by omega)
      · intro e'
        obtain ⟨j, -, -, h3⟩ := mem_tailA h
        rw [h3] at e'
        injection e' with _ e2
        cases e2
    have f2 : (resL (n + 3) d ++ tailA n).filter (fun e => decide (e.1 ≠ [2])) =
        resL (n + 3) d ++ (sndL n ++ [([3], Arith.zero)]) := by
      rw [List.filter_append, filter_keep (fun e he => res_ne_single he _)]
      show _ ++ (List.filter (fun e : Id × Arith => decide (e.1 ≠ [2]))
        (sndL n ++ [([2], Arith.zero), ([3], Arith.zero)])) = _
      have k : (sndL n).filter (fun e => decide (e.1 ≠ [2])) = sndL n :=
        filter_keep fun e he e' => by
          obtain ⟨-, j, h1, -, h3⟩ := mem_sndL he
          rw [h3] at e'
          injection e' with e1
          omega
      rw [List.filter_append, k]
      rfl
    unfold stepZ
    rw [XNet.putLinks_agents]
    show ((X.agents.filter (fun e => decide (e.1 ≠ [0, n + 3 + 1]))).filter
      (fun e => decide (e.1 ≠ [2]))) = _
    rw [hA, f1, f2]
  · unfold stepZ
    rw [XNet.mem_step_wires, H.wires]
    show e ∈ linksZ (n + 3 + 1) ∨ _ ↔ _
    constructor
    · rintro (h | h | h | ⟨t, h1, h2, h3⟩)
      · exact .inr (.inr (.inr h))
      · exact .inl h
      · exact .inr (.inl h)
      · exact .inr (.inr (.inl ⟨t, by omega, h2, h3⟩))
    · rintro (h | h | ⟨t, h1, h2, h3⟩ | h)
      · exact .inr (.inl h)
      · exact .inr (.inr (.inl h))
      · exact .inr (.inr (.inr ⟨t, by omega, h2, h3⟩))
      · exact .inl h

/-- The later rounds, with the description carried along. -/
theorem Steady.rounds_hist {n : Nat} {X0 : XNet Arith} {T : Nat} :
    ∀ (r : Nat) {X : XNet Arith} {d : Nat}, Steady n X (n + 3 + r) → Hist n X0 X T r d →
      ∃ X', Opers xsys X ⟨X.agents, .idle⟩ X' ⟨X'.agents, .idle⟩ r (17 * r) (35 * r) ∧
        Steady n X' (n + 3) ∧ Hist n X0 X' T 0 (d + r)
  | 0, X, d, st, H => ⟨X, .refl _ _, st, H⟩
  | r + 1, X, d, st, H => by
    have st' : Steady n X (n + 3 + r + 1) := st
    obtain ⟨w, st1⟩ := Steady.round_exact st' (by omega)
    obtain ⟨X', w', st2, H2⟩ := Steady.rounds_hist r st1 H.step
    refine ⟨X', ?_, st2, ?_⟩
    · have w2 := w.trans w'
      have e1 : 1 + r = r + 1 := by omega
      have e2 : 17 + 17 * r = 17 * (r + 1) := by omega
      have e3 : 35 + 35 * r = 35 * (r + 1) := by omega
      rw [e1, e2, e3] at w2
      exact w2
    · have e : d + 1 + r = d + (r + 1) := by omega
      rw [← e]
      exact H2

/-- **All the rounds of one thread on the net for `(m + 1) + n`**: `m + 2`
claims in `17 * m + 25` actions, charged `35 * m + 52` operations, and
the memory they leave. -/
theorem solo_rounds (m n : Nat) : ∃ Xf,
    Opers xsys (sum (m + 1) n) ⟨(sum (m + 1) n).agents, .idle⟩ Xf ⟨Xf.agents, .idle⟩
      (m + 2) (17 * m + 25) (35 * m + 52) ∧
      Final n (sum (m + 1) n) Xf (n + 3 + m + 1) m := by
  have st0 : Start n (sum (m + 1) n) (n + 3 + m) := by
    have h := start_sum m n
    have e : m + n + 3 = n + 3 + m := by omega
    rw [e] at h
    exact h
  obtain ⟨w0, st1⟩ := Start.round_exact st0
  have H0 : Hist n (sum (m + 1) n) (stepS (sum (m + 1) n) [n + 3 + m + 1] [1])
      (n + 3 + m + 1) m 0 := hist_start (sum_agents (m + 1) n)
  obtain ⟨X', w1, st2, H1⟩ := Steady.rounds_hist m st1 H0
  have hA : X'.agents = ([0, n + 3 + 1], Arith.add) :: (resL (n + 3) (0 + m) ++ tailA n) :=
    H1.agents
  have hz : assoc [2] X'.agents = some .zero := by
    rw [hA]
    show (if ([0, n + 3 + 1] : Id) = [2] then some Arith.add
      else assoc [2] (resL (n + 3) (0 + m) ++ (sndL n ++ [([2], Arith.zero), ([3], .zero)]))) = _
    rw [ite_neg' (fun e => by injection e with _ e2; cases e2),
      assoc_append_skip _ (fun e he => res_ne_single he 2),
      assoc_append_skip _ (fun e he e' => by
        obtain ⟨-, j, h1, -, h3⟩ := mem_sndL he
        rw [h3] at e'
        injection e' with e1
        omega)]
    rfl
  have w2 := Steady.zero_round st2 hz
  have F := H1.final
  have e0 : 0 + m = m := by omega
  rw [e0] at F
  refine ⟨_, ?_, F⟩
  have w := (w0.trans w1).trans w2
  have e1 : 1 + m + 1 = m + 2 := by omega
  have e2 : 16 + 17 * m + 9 = 17 * m + 25 := by omega
  have e3 : 33 + 35 * m + 19 = 35 * m + 52 := by omega
  rw [e1, e2, e3] at w
  exact w

theorem linksS_single (T j k : Nat) (q : Port) : ((([j], k), q) : Port × Port) ∈ linksS T ↔
    j = T ∧ k = 1 ∧ q = ([0, T], 0) ∨ j = 1 ∧ k = 1 ∧ q = ([0, T], 1) ∨
      j = 1 ∧ k = 2 ∧ q = ([0, 1], 0) := by
  simp [mem_linksS, and_assoc]

theorem linksS_adder (T x k : Nat) (q : Port) : ((([0, x], k), q) : Port × Port) ∈ linksS T ↔
    x = 1 ∧ k = 0 ∧ q = ([1], 2) ∨ x = 1 ∧ k = 1 ∧ q = ([0, T], 2) ∨
      x = T ∧ k = 0 ∧ q = ([T], 1) ∨ x = T ∧ k = 1 ∧ q = ([1], 1) ∨
      x = T ∧ k = 2 ∧ q = ([0, 1], 1) := by
  simp [mem_linksS, and_assoc]

theorem linksS_res (T x k : Nat) (q : Port) :
    ((([0, 0, x], k), q) : Port × Port) ∉ linksS T := by
  simp [mem_linksS]

theorem linksA_single (t j k : Nat) (q : Port) : ((([j], k), q) : Port × Port) ∈ linksA t ↔
    j = t ∧ k = 1 ∧ q = ([0, t], 0) := by
  simp [mem_linksA, and_assoc]

theorem linksA_adder (t x k : Nat) (q : Port) : ((([0, x], k), q) : Port × Port) ∈ linksA t ↔
    x = t + 1 ∧ k = 1 ∧ q = ([0, t], 1) ∨ x = t + 1 ∧ k = 2 ∧ q = ([0, 0, t + 1], 0) ∨
      x = t ∧ k = 0 ∧ q = ([t], 1) ∨ x = t ∧ k = 1 ∧ q = ([0, t + 1], 1) ∨
      x = t ∧ k = 2 ∧ q = ([0, 0, t + 1], 1) := by
  simp [mem_linksA, and_assoc]

theorem linksA_res (t x k : Nat) (q : Port) : ((([0, 0, x], k), q) : Port × Port) ∈ linksA t ↔
    x = t + 1 ∧ k = 0 ∧ q = ([0, t + 1], 2) ∨ x = t + 1 ∧ k = 1 ∧ q = ([0, t], 2) := by
  simp [mem_linksA, and_assoc]

theorem linksZ_single (t j k : Nat) (q : Port) :
    ((([j], k), q) : Port × Port) ∉ linksZ t := by
  simp [mem_linksZ]

theorem linksZ_adder (t x k : Nat) (q : Port) : ((([0, x], k), q) : Port × Port) ∈ linksZ t ↔
    x = t ∧ k = 1 ∧ q = ([0, t], 2) ∨ x = t ∧ k = 2 ∧ q = ([0, t], 1) := by
  simp [mem_linksZ, and_assoc]

theorem linksZ_res (t x k : Nat) (q : Port) :
    ((([0, 0, x], k), q) : Port × Port) ∉ linksZ t := by
  simp [mem_linksZ]

section FinalFacts

variable {n d T : Nat} {X0 X : XNet Arith}

/-- The segments at a port of an agent of the net at the start, at the
end of the rounds. -/
theorem Final.single (F : Final n X0 X T d) (j k : Nat) (q : Port) :
    ((([j], k), q) : Port × Port) ∈ X.wires ↔ ((([j], k), q) : Port × Port) ∈ X0.wires ∨
      j = T ∧ k = 1 ∧ q = ([0, T], 0) ∨ j = 1 ∧ k = 1 ∧ q = ([0, T], 1) ∨
      j = 1 ∧ k = 2 ∧ q = ([0, 1], 0) ∨ n + 3 < j ∧ j < T ∧ k = 1 ∧ q = ([0, j], 0) := by
  rw [F.wires, linksS_single]
  constructor
  · rintro (h | (h | h | h) | ⟨t, h1, h2, h⟩ | h)
    · exact .inl h
    · exact .inr (.inl h)
    · exact .inr (.inr (.inl h))
    · exact .inr (.inr (.inr (.inl h)))
    · rw [linksA_single] at h
      obtain ⟨rfl, hk, hq⟩ := h
      exact .inr (.inr (.inr (.inr ⟨h1, h2, hk, hq⟩)))
    · exact absurd h (linksZ_single _ _ _ _)
  · rintro (h | h | h | h | ⟨h1, h2, hk, hq⟩)
    · exact .inl h
    · exact .inr (.inl (.inl h))
    · exact .inr (.inl (.inr (.inl h)))
    · exact .inr (.inl (.inr (.inr h)))
    · exact .inr (.inr (.inl ⟨j, h1, h2, (linksA_single _ _ _ _).2 ⟨rfl, hk, hq⟩⟩))

/-- The rounds leave the principal ports of the old agents, and the ports
of the second chain, as they were. -/
theorem Final.old (F : Final n X0 X T d) {j k : Nat} (h : k = 0 ∨ k = 1 ∧ 1 < j ∧ j ≤ n + 3)
    (q : Port) :
    ((([j], k), q) : Port × Port) ∈ X.wires ↔ ((([j], k), q) : Port × Port) ∈ X0.wires := by
  have hT := F.top
  rw [F.single]
  constructor
  · rintro (h' | ⟨h1, h2, -⟩ | ⟨h1, h2, -⟩ | ⟨h1, h2, -⟩ | ⟨h1, h2, h3, -⟩)
    · exact h'
    all_goals omega
  · exact .inl

/-- The segments at a port of an agent the rounds made are those the
rounds wrote. -/
theorem Final.fresh (F : Final n X0 X T d)
    (hfr : ∀ (i : Id) (k : Nat) (q : Port), (((i, k), q) : Port × Port) ∈ X0.wires →
      ∃ j, i = [j])
    {i : Id} (hi : ∀ j, i ≠ [j]) (k : Nat) (q : Port) :
    (((i, k), q) : Port × Port) ∈ X.wires ↔ (((i, k), q) : Port × Port) ∈ linksS T ∨
      (∃ t, n + 3 < t ∧ t < T ∧ (((i, k), q) : Port × Port) ∈ linksA t) ∨
      (((i, k), q) : Port × Port) ∈ linksZ (n + 3 + 1) := by
  rw [F.wires]
  constructor
  · rintro (h | h)
    · obtain ⟨j, ej⟩ := hfr i k q h
      exact absurd ej (hi j)
    · exact h
  · exact .inr

theorem Final.one_one (F : Final n X0 X T d) (S : Snd n X0) (q : Port) :
    ((([1], 1), q) : Port × Port) ∈ X.wires ↔ q = ([n + 3], 0) ∨ q = ([0, T], 1) := by
  have hT := F.top
  rw [F.single, S.one]
  constructor
  · rintro (h | ⟨h1, -, -⟩ | ⟨-, -, h⟩ | ⟨-, h1, -⟩ | ⟨h1, -, -, -⟩)
    · exact .inl h
    · omega
    · exact .inr h
    · omega
    · omega
  · rintro (h | h)
    · exact .inl h
    · exact .inr (.inr (.inl ⟨rfl, rfl, h⟩))

theorem Final.one_two (F : Final n X0 X T d) (S : Snd n X0) (q : Port) :
    ((([1], 2), q) : Port × Port) ∈ X.wires ↔ q = ([0], 0) ∨ q = ([0, 1], 0) := by
  have hT := F.top
  rw [F.single, S.res]
  constructor
  · rintro (h | ⟨h1, -, -⟩ | ⟨-, h1, -⟩ | ⟨-, -, h⟩ | ⟨h1, -, -, -⟩)
    · exact .inl h
    · omega
    · omega
    · exact .inr h
    · omega
  · rintro (h | h)
    · exact .inl h
    · exact .inr (.inr (.inr (.inl ⟨rfl, rfl, h⟩)))

theorem Final.out (F : Final n X0 X T d) (S : Snd n X0) (q : Port) :
    ((([0], 0), q) : Port × Port) ∈ X.wires ↔ q = ([1], 2) := by
  rw [F.old (.inl rfl), S.out]

theorem Final.top_snd (F : Final n X0 X T d) (S : Snd n X0) (q : Port) :
    ((([n + 3], 0), q) : Port × Port) ∈ X.wires ↔ q = ([1], 1) := by
  rw [F.old (.inl rfl), S.top]

theorem Final.up (F : Final n X0 X T d) (S : Snd n X0) {j : Nat} (h1 : 3 ≤ j)
    (h2 : j ≤ n + 2) (q : Port) :
    ((([j], 0), q) : Port × Port) ∈ X.wires ↔ q = ([j + 1], 1) := by
  rw [F.old (.inl rfl), S.up j h1 h2]

theorem Final.down (F : Final n X0 X T d) (S : Snd n X0) {j : Nat} (h1 : 3 ≤ j)
    (h2 : j ≤ n + 2) (q : Port) :
    ((([j + 1], 1), q) : Port × Port) ∈ X.wires ↔ q = ([j], 0) := by
  rw [F.old (.inr ⟨rfl, by omega, by omega⟩), S.down j h1 h2]

/-- The segments at the second argument of an adder the rounds made: to
the adder before it, or to the second argument of the first, and to the
adder after it, or, for the last, round to its own result. -/
theorem Final.adder_one (F : Final n X0 X T d)
    (hfr : ∀ (i : Id) (k : Nat) (q : Port), (((i, k), q) : Port × Port) ∈ X0.wires →
      ∃ j, i = [j])
    {x : Nat} (hx : n + 3 < x) (hx' : x ≤ T) (q : Port) :
    ((([0, x], 1), q) : Port × Port) ∈ X.wires ↔
      x = T ∧ q = ([1], 1) ∨ (n + 3 + 1 < x ∧ ∃ t, x = t + 1 ∧ q = ([0, t], 1)) ∨
      x < T ∧ q = ([0, x + 1], 1) ∨ x = n + 3 + 1 ∧ q = ([0, x], 2) := by
  rw [F.fresh hfr (fun j e => by injection e with _ e2; cases e2)]
  constructor
  · rintro (h | ⟨t, h1, h2, h⟩ | h)
    · rw [linksS_adder] at h
      rcases h with ⟨-, h, -⟩ | ⟨h, -, -⟩ | ⟨-, h, -⟩ | ⟨h, -, hq⟩ | ⟨-, h, -⟩
      · omega
      · omega
      · omega
      · exact .inl ⟨h, hq⟩
      · omega
    · rw [linksA_adder] at h
      rcases h with ⟨h, -, hq⟩ | ⟨-, h, -⟩ | ⟨-, h, -⟩ | ⟨h, -, hq⟩ | ⟨-, h, -⟩
      · exact .inr (.inl ⟨by omega, t, h, hq⟩)
      · omega
      · omega
      · subst h
        exact .inr (.inr (.inl ⟨h2, hq⟩))
      · omega
    · rw [linksZ_adder] at h
      rcases h with ⟨h, -, hq⟩ | ⟨-, h, -⟩
      · subst h
        exact .inr (.inr (.inr ⟨rfl, hq⟩))
      · omega
  · rintro (⟨h, hq⟩ | ⟨h, t, ht, hq⟩ | ⟨h, hq⟩ | ⟨h, hq⟩)
    · exact .inl ((linksS_adder _ _ _ _).2 (.inr (.inr (.inr (.inl ⟨h, rfl, hq⟩)))))
    · exact .inr (.inl ⟨t, by omega, by omega, (linksA_adder _ _ _ _).2 (.inl ⟨ht, rfl, hq⟩)⟩)
    · exact .inr (.inl ⟨x, hx, h,
        (linksA_adder _ _ _ _).2 (.inr (.inr (.inr (.inl ⟨rfl, rfl, hq⟩))))⟩)
    · subst h
      exact .inr (.inr ((linksZ_adder _ _ _ _).2 (.inl ⟨rfl, rfl, hq⟩)))

/-- The segments at the result of an adder the rounds made: to the
successor it made, or, for the last, round to its own second argument,
and to the argument of the successor the adder before it made. -/
theorem Final.adder_two (F : Final n X0 X T d)
    (hfr : ∀ (i : Id) (k : Nat) (q : Port), (((i, k), q) : Port × Port) ∈ X0.wires →
      ∃ j, i = [j])
    {x : Nat} (hx : n + 3 < x) (hx' : x ≤ T) (q : Port) :
    ((([0, x], 2), q) : Port × Port) ∈ X.wires ↔
      x = T ∧ q = ([0, 1], 1) ∨ x < T ∧ q = ([0, 0, x + 1], 1) ∨
      n + 3 + 1 < x ∧ q = ([0, 0, x], 0) ∨ x = n + 3 + 1 ∧ q = ([0, x], 1) := by
  rw [F.fresh hfr (fun j e => by injection e with _ e2; cases e2)]
  constructor
  · rintro (h | ⟨t, h1, h2, h⟩ | h)
    · rw [linksS_adder] at h
      rcases h with ⟨-, h, -⟩ | ⟨-, h, -⟩ | ⟨-, h, -⟩ | ⟨-, h, -⟩ | ⟨h, -, hq⟩
      · omega
      · omega
      · omega
      · omega
      · exact .inl ⟨h, hq⟩
    · rw [linksA_adder] at h
      rcases h with ⟨-, h, -⟩ | ⟨h, -, hq⟩ | ⟨-, h, -⟩ | ⟨-, h, -⟩ | ⟨h, -, hq⟩
      · omega
      · subst h
        exact .inr (.inr (.inl ⟨by omega, hq⟩))
      · omega
      · omega
      · subst h
        exact .inr (.inl ⟨h2, hq⟩)
    · rw [linksZ_adder] at h
      rcases h with ⟨-, h, -⟩ | ⟨h, -, hq⟩
      · omega
      · subst h
        exact .inr (.inr (.inr ⟨rfl, hq⟩))
  · rintro (⟨h, hq⟩ | ⟨h, hq⟩ | ⟨h, hq⟩ | ⟨h, hq⟩)
    · exact .inl ((linksS_adder _ _ _ _).2 (.inr (.inr (.inr (.inr ⟨h, rfl, hq⟩)))))
    · exact .inr (.inl ⟨x, hx, h,
        (linksA_adder _ _ _ _).2 (.inr (.inr (.inr (.inr ⟨rfl, rfl, hq⟩))))⟩)
    · obtain ⟨t, rfl⟩ : ∃ t, x = t + 1 := ⟨x - 1, by omega⟩
      exact .inr (.inl ⟨t, by omega, by omega,
        (linksA_adder _ _ _ _).2 (.inr (.inl ⟨rfl, rfl, hq⟩))⟩)
    · subst h
      exact .inr (.inr ((linksZ_adder _ _ _ _).2 (.inr ⟨rfl, rfl, hq⟩)))

theorem Final.res_zero (F : Final n X0 X T d)
    (hfr : ∀ (i : Id) (k : Nat) (q : Port), (((i, k), q) : Port × Port) ∈ X0.wires →
      ∃ j, i = [j])
    {t : Nat} (h1 : n + 3 < t) (h2 : t < T) (q : Port) :
    ((([0, 0, t + 1], 0), q) : Port × Port) ∈ X.wires ↔ q = ([0, t + 1], 2) := by
  rw [F.fresh hfr (fun j e => by injection e with _ e2; cases e2)]
  constructor
  · rintro (h | ⟨t', -, -, h⟩ | h)
    · exact absurd h (linksS_res _ _ _ _)
    · rw [linksA_res] at h
      rcases h with ⟨h, -, hq⟩ | ⟨-, h, -⟩
      · have e : t' = t := by omega
        subst e
        exact hq
      · omega
    · exact absurd h (linksZ_res _ _ _ _)
  · intro hq
    exact .inr (.inl ⟨t, h1, h2, (linksA_res _ _ _ _).2 (.inl ⟨rfl, rfl, hq⟩)⟩)

theorem Final.res_one (F : Final n X0 X T d)
    (hfr : ∀ (i : Id) (k : Nat) (q : Port), (((i, k), q) : Port × Port) ∈ X0.wires →
      ∃ j, i = [j])
    {t : Nat} (h1 : n + 3 < t) (h2 : t < T) (q : Port) :
    ((([0, 0, t + 1], 1), q) : Port × Port) ∈ X.wires ↔ q = ([0, t], 2) := by
  rw [F.fresh hfr (fun j e => by injection e with _ e2; cases e2)]
  constructor
  · rintro (h | ⟨t', -, -, h⟩ | h)
    · exact absurd h (linksS_res _ _ _ _)
    · rw [linksA_res] at h
      rcases h with ⟨-, h, -⟩ | ⟨h, -, hq⟩
      · omega
      · have e : t' = t := by omega
        subst e
        exact hq
    · exact absurd h (linksZ_res _ _ _ _)
  · intro hq
    exact .inr (.inl ⟨t, h1, h2, (linksA_res _ _ _ _).2 (.inr ⟨rfl, rfl, hq⟩)⟩)

theorem Final.first_zero (F : Final n X0 X T d)
    (hfr : ∀ (i : Id) (k : Nat) (q : Port), (((i, k), q) : Port × Port) ∈ X0.wires →
      ∃ j, i = [j]) (q : Port) :
    ((([0, 1], 0), q) : Port × Port) ∈ X.wires ↔ q = ([1], 2) := by
  have hT := F.top
  rw [F.fresh hfr (fun j e => by injection e with _ e2; cases e2)]
  constructor
  · rintro (h | ⟨t, h1, h2, h⟩ | h)
    · rw [linksS_adder] at h
      rcases h with ⟨-, -, hq⟩ | ⟨-, h, -⟩ | ⟨h, -, -⟩ | ⟨h, -, -⟩ | ⟨h, -, -⟩
      · exact hq
      all_goals omega
    · rw [linksA_adder] at h
      rcases h with ⟨h, -, -⟩ | ⟨h, -, -⟩ | ⟨h, -, -⟩ | ⟨h, -, -⟩ | ⟨h, -, -⟩ <;> omega
    · rw [linksZ_adder] at h
      rcases h with ⟨h, -, -⟩ | ⟨h, -, -⟩ <;> omega
  · intro hq
    exact .inl ((linksS_adder _ _ _ _).2 (.inl ⟨rfl, rfl, hq⟩))

theorem Final.first_one (F : Final n X0 X T d)
    (hfr : ∀ (i : Id) (k : Nat) (q : Port), (((i, k), q) : Port × Port) ∈ X0.wires →
      ∃ j, i = [j]) (q : Port) :
    ((([0, 1], 1), q) : Port × Port) ∈ X.wires ↔ q = ([0, T], 2) := by
  have hT := F.top
  rw [F.fresh hfr (fun j e => by injection e with _ e2; cases e2)]
  constructor
  · rintro (h | ⟨t, h1, h2, h⟩ | h)
    · rw [linksS_adder] at h
      rcases h with ⟨-, h, -⟩ | ⟨-, -, hq⟩ | ⟨h, -, -⟩ | ⟨h, -, -⟩ | ⟨h, -, -⟩
      · omega
      · exact hq
      all_goals omega
    · rw [linksA_adder] at h
      rcases h with ⟨h, -, -⟩ | ⟨h, -, -⟩ | ⟨h, -, -⟩ | ⟨h, -, -⟩ | ⟨h, -, -⟩ <;> omega
    · rw [linksZ_adder] at h
      rcases h with ⟨h, -, -⟩ | ⟨h, -, -⟩ <;> omega
  · intro hq
    exact .inl ((linksS_adder _ _ _ _).2 (.inr (.inl ⟨rfl, rfl, hq⟩)))

theorem final_sym {e : Id × Arith}
    (he : e ∈ resL (n + 3) d ++ (sndL n ++ [([3], .zero)])) :
    e.2 = if e.1 = [3] then .zero else .succ := by
  rcases List.mem_append.1 he with h | h
  · rw [ite_neg' (res_ne_single h 3)]
    exact (mem_resL h).1
  · rcases List.mem_append.1 h with h | h
    · obtain ⟨h1, j, h2, -, h3⟩ := mem_sndL h
      rw [ite_neg' (fun e' => by rw [h3] at e'; injection e' with e1; omega)]
      exact h1
    · rcases List.mem_cons.1 h with rfl | h
      · rfl
      · cases h

/-- Every entry of the list of agents at the end is an agent of the
memory, under its own symbol. -/
theorem Final.agent (F : Final n X0 X T d) {e : Id × Arith} (he : e ∈ X.agents) :
    assoc e.1 X.agents = some e.2 := by
  refine assoc_eq_of_unique he (fun γ hγ => ?_)
  rw [F.agents] at he hγ
  have h1 := final_sym he
  have h2 := final_sym hγ
  exact h2.trans h1.symm

theorem Final.no_zero (F : Final n X0 X T d) : assoc [0] X.agents = none := by
  rw [F.agents]
  refine assoc_none_of_forall fun e he e' => ?_
  rcases List.mem_append.1 he with h | h
  · exact res_ne_single h 0 e'
  · rcases List.mem_append.1 h with h | h
    · obtain ⟨-, j, h2, -, h3⟩ := mem_sndL h
      rw [h3] at e'
      injection e' with e1
      omega
    · rcases List.mem_cons.1 h with rfl | h
      · exact absurd e' (by decide)
      · cases h

/-- **From the result of an adder a thread goes one segment on and
stops.** -/
theorem Final.dead_two (F : Final n X0 X T d)
    (hfr : ∀ (i : Id) (k : Nat) (q : Port), (((i, k), q) : Port × Port) ∈ X0.wires →
      ∃ j, i = [j])
    {x : Nat} (hx : n + 3 < x) (hx' : x ≤ T) {p : Port}
    (hp : p = ([0, 0, x], 0) ∧ n + 3 + 1 < x ∨ p = ([0, x], 1) ∧ x = n + 3 + 1) :
    X.Dead p ([0, x], 2) 2 := by
  have W := F.adder_two hfr hx hx'
  have key : ∀ q, ((([0, x], 2), q) : Port × Port) ∈ X.wires → q ≠ p →
      x = T ∧ q = ([0, 1], 1) ∨ x < T ∧ q = ([0, 0, x + 1], 1) := by
    intro q hq hqp
    rcases (W q).1 hq with h | h | ⟨h, hq'⟩ | ⟨h, hq'⟩
    · exact .inl h
    · exact .inr h
    · rcases hp with ⟨hp, -⟩ | ⟨-, hp⟩
      · exact absurd (hq'.trans hp.symm) hqp
      · omega
    · rcases hp with ⟨-, hp⟩ | ⟨hp, -⟩
      · omega
      · exact absurd (hq'.trans hp.symm) hqp
  by_cases hxT : x = T
  · have hn : nextSeg X.wires ([0, x], 2) p = some ([0, 1], 1) := by
      refine nextSeg_some ((W _).2 (.inl ⟨hxT, rfl⟩)) ?_ (fun q hq hqp => ?_)
      · rcases hp with ⟨hp, -⟩ | ⟨hp, -⟩ <;> rw [hp] <;> ports_differ
      · rcases key q hq hqp with ⟨-, h⟩ | ⟨h, -⟩
        · exact h
        · omega
    have hs : nextSeg X.wires ([0, 1], 1) ([0, x], 2) = none :=
      nextSeg_none fun q hq => by
        rw [(F.first_one hfr q).1 hq, hxT]
    exact .step rfl hn (.stop rfl hs)
  · have hlt : x < T := by omega
    have hn : nextSeg X.wires ([0, x], 2) p = some ([0, 0, x + 1], 1) := by
      refine nextSeg_some ((W _).2 (.inr (.inl ⟨hlt, rfl⟩))) ?_ (fun q hq hqp => ?_)
      · rcases hp with ⟨hp, -⟩ | ⟨hp, -⟩ <;> rw [hp] <;> ports_differ
      · rcases key q hq hqp with ⟨h, -⟩ | ⟨-, h⟩
        · exact absurd h hxT
        · exact h
    have hs : nextSeg X.wires ([0, 0, x + 1], 1) ([0, x], 2) = none :=
      nextSeg_none fun q hq => (F.res_one hfr hx hlt q).1 hq
    exact .step rfl hn (.stop rfl hs)

/-- **The walk down the adders.**  From the second argument of the adder
numbered `n + 4 + i` a thread passes the `i` adders below it, turns at
the last one to its result, goes one segment on and stops. -/
theorem Final.dead_adder (F : Final n X0 X T d)
    (hfr : ∀ (i : Id) (k : Nat) (q : Port), (((i, k), q) : Port × Port) ∈ X0.wires →
      ∃ j, i = [j]) :
    ∀ i, n + 3 + 1 + i ≤ T →
      X.Dead (if n + 3 + 1 + i = T then ([1], 1) else ([0, n + 3 + 1 + i + 1], 1))
        ([0, n + 3 + 1 + i], 1) (i + 3)
  | 0, hi => by
    have hi' : n + 3 + 1 ≤ T := hi
    have W := F.adder_one hfr (x := n + 3 + 1) (by omega) hi'
    have hn : nextSeg X.wires ([0, n + 3 + 1], 1)
        (if n + 3 + 1 = T then ([1], 1) else ([0, n + 3 + 1 + 1], 1)) =
        some ([0, n + 3 + 1], 2) := by
      refine nextSeg_some ((W _).2 (.inr (.inr (.inr ⟨rfl, rfl⟩)))) ?_ (fun q hq hqp => ?_)
      · by_cases h : n + 3 + 1 = T
        · rw [ite_pos' h]
          ports_differ
        · rw [ite_neg' h]
          ports_differ
      · rcases (W q).1 hq with ⟨h, hq'⟩ | ⟨h, -⟩ | ⟨h, hq'⟩ | ⟨-, hq'⟩
        · rw [ite_pos' h] at hqp
          exact absurd hq' hqp
        · omega
        · rw [ite_neg' (by omega)] at hqp
          exact absurd hq' hqp
        · exact hq'
    show X.Dead (if n + 3 + 1 = T then ([1], 1) else ([0, n + 3 + 1 + 1], 1))
      ([0, n + 3 + 1], 1) (2 + 1)
    exact .step rfl hn (F.dead_two hfr (by omega) hi' (.inr ⟨rfl, rfl⟩))
  | i + 1, hi => by
    have hi' : n + 3 + 1 + i + 1 ≤ T := hi
    have W := F.adder_one hfr (x := n + 3 + 1 + i + 1) (by omega) hi'
    have ih := Final.dead_adder F hfr i (by omega)
    rw [ite_neg' (by omega)] at ih
    have hn : nextSeg X.wires ([0, n + 3 + 1 + i + 1], 1)
        (if n + 3 + 1 + i + 1 = T then ([1], 1) else ([0, n + 3 + 1 + i + 1 + 1], 1)) =
        some ([0, n + 3 + 1 + i], 1) := by
      refine nextSeg_some ((W _).2 (.inr (.inl ⟨by omega, n + 3 + 1 + i, rfl, rfl⟩))) ?_
        (fun q hq hqp => ?_)
      · by_cases h : n + 3 + 1 + i + 1 = T
        · rw [ite_pos' h]
          ports_differ
        · rw [ite_neg' h]
          ports_differ
      · rcases (W q).1 hq with ⟨h, hq'⟩ | ⟨-, t, ht, hq'⟩ | ⟨h, hq'⟩ | ⟨h, -⟩
        · rw [ite_pos' h] at hqp
          exact absurd hq' hqp
        · have e : t = n + 3 + 1 + i := by omega
          rw [e] at hq'
          exact hq'
        · rw [ite_neg' (by omega)] at hqp
          exact absurd hq' hqp
        · omega
    show X.Dead (if n + 3 + 1 + i + 1 = T then ([1], 1) else ([0, n + 3 + 1 + i + 1 + 1], 1))
      ([0, n + 3 + 1 + i + 1], 1) (i + 3 + 1)
    exact .step rfl hn ih

/-- **The walk from the top of the second argument**: to the first
adder, down all the adders the rounds made, and on to the stop. -/
theorem Final.dead_top (F : Final n X0 X T d) (S : Snd n X0)
    (hfr : ∀ (i : Id) (k : Nat) (q : Port), (((i, k), q) : Port × Port) ∈ X0.wires →
      ∃ j, i = [j]) :
    X.Dead ([n + 3], 0) ([1], 1) (d + 3 + 1) := by
  have hT := F.top
  have W := F.one_one S
  have hn : nextSeg X.wires ([1], 1) ([n + 3], 0) = some ([0, T], 1) := by
    refine nextSeg_some ((W _).2 (.inr rfl)) (by ports_differ) (fun q hq hqp => ?_)
    rcases (W q).1 hq with h | h
    · exact absurd h hqp
    · exact h
  have hd := F.dead_adder hfr d (by omega)
  have e : n + 3 + 1 + d = T := by omega
  rw [ite_pos' e, e] at hd
  exact .step rfl hn hd

/-- The pass over the successors of the result: four actions each,
charged nine operations. -/
theorem Final.pass_res (F : Final n X0 X T d) (S : Snd n X0)
    (hfr : ∀ (i : Id) (k : Nat) (q : Port), (((i, k), q) : Port × Port) ∈ X0.wires →
      ∃ j, i = [j])
    (rest : List (Id × Arith)) : ∀ (d' h : Nat), n + 3 ≤ h → h + d' + 1 = T →
      (∀ e ∈ resL h d', e ∈ X.agents) →
      Opers xsys X ⟨resL h d' ++ rest, .idle⟩ X ⟨rest, .idle⟩ 0 (4 * (d' + 1)) (9 * (d' + 1))
  | 0, h, _, _, hm => by
    have h₁ : assoc [0, 1] X.agents = some Arith.succ := F.agent (hm _ List.mem_cons_self)
    have h₂ : assoc (([0, 1], 0) : Port) X.wires = some ([1], 2) :=
      assoc_eq_of_unique ((F.first_zero hfr _).2 rfl) (fun q' hq => (F.first_zero hfr q').1 hq)
    have W := F.one_two S
    have hn : nextSeg X.wires ([1], 2) ([0, 1], 0) = some ([0], 0) := by
      refine nextSeg_some ((W _).2 (.inl rfl)) (by ports_differ) (fun q hq hqp => ?_)
      rcases (W q).1 hq with h | h
      · exact h
      · exact absurd h hqp
    have hs : nextSeg X.wires ([0], 0) ([1], 2) = none :=
      nextSeg_none fun q hq => (F.out S q).1 hq
    have hd : X.Dead ([0, 1], 0) ([1], 2) 2 :=
      .step rfl hn (.stop ((ite_pos' rfl).trans F.no_zero) hs)
    exact Opers.dead (xs := xsys) (e := ([0, 1], Arith.succ)) (k := 2) rest h₁ h₂ hd
  | d' + 1, h, hh, hT', hm => by
    have hx1 : n + 3 < h + 1 := by omega
    have hx2 : h + 1 < T := by omega
    have h₁ : assoc [0, 0, h + 2] X.agents = some Arith.succ :=
      F.agent (hm _ List.mem_cons_self)
    have h₂ : assoc (([0, 0, h + 2], 0) : Port) X.wires = some ([0, h + 2], 2) :=
      assoc_eq_of_unique ((F.res_zero hfr hx1 hx2 _).2 rfl)
        (fun q' hq => (F.res_zero hfr hx1 hx2 q').1 hq)
    have hd : X.Dead ([0, 0, h + 2], 0) ([0, h + 2], 2) 2 :=
      F.dead_two hfr (x := h + 2) (by omega) (by omega) (.inl ⟨rfl, by omega⟩)
    have w₁ : Opers xsys X ⟨([0, 0, h + 2], Arith.succ) :: (resL (h + 1) d' ++ rest), .idle⟩ X
        ⟨resL (h + 1) d' ++ rest, .idle⟩ 0 4 9 :=
      Opers.dead (xs := xsys) (e := ([0, 0, h + 2], Arith.succ)) (k := 2) _ h₁ h₂ hd
    have w₂ := Final.pass_res F S hfr rest d' (h + 1) (by omega) (by omega)
      (fun e he => hm e (List.mem_cons_of_mem _ he))
    have w := w₁.trans w₂
    have e1 : 4 + 4 * (d' + 1) = 4 * (d' + 1 + 1) := by omega
    have e2 : 9 + 9 * (d' + 1) = 9 * (d' + 1 + 1) := by omega
    rw [e1, e2] at w
    exact w

theorem sndL_length : ∀ n, (sndL n).length = n
  | 0 => rfl
  | n + 1 => congrArg Nat.succ (sndL_length n)

/-- The second argument at the end: its top entry, and below it entries
that a thread gives up on at once. -/
theorem snd_split (n : Nat) : ∃ (γ : Arith) (low : List (Id × Arith)),
    sndL n ++ [([3], Arith.zero)] = ([n + 3], γ) :: low ∧ low.length = n ∧
      ∀ e ∈ low, ∃ j, 3 ≤ j ∧ j ≤ n + 2 ∧ e.1 = [j] := by
  cases n with
  | zero => exact ⟨.zero, [], rfl, rfl, fun e he => absurd he List.not_mem_nil⟩
  | succ n =>
    refine ⟨.succ, sndL n ++ [([3], Arith.zero)], rfl, ?_, fun e he => ?_⟩
    · rw [List.length_append, sndL_length]
      rfl
    · rcases List.mem_append.1 he with h | h
      · obtain ⟨-, j, h1, h2, h3⟩ := mem_sndL h
        exact ⟨j, by omega, by omega, h3⟩
      · rcases List.mem_cons.1 h with rfl | h
        · exact ⟨3, by omega, by omega, rfl⟩
        · cases h

theorem Final.inert (F : Final n X0 X T d) (S : Snd n X0) {e : Id × Arith}
    (he : e ∈ X.agents) {j : Nat} (h1 : 3 ≤ j) (h2 : j ≤ n + 2) (hj : e.1 = [j]) :
    X.Inert e := by
  refine ⟨F.agent he, ([j + 1], 1), ?_, rfl, ?_⟩
  · rw [hj]
    exact assoc_eq_of_unique ((F.up S h1 h2 _).2 rfl) (fun q' hq => (F.up S h1 h2 q').1 hq)
  · rw [hj]
    exact nextSeg_none fun q hq => (F.down S h1 h2 q).1 hq

/-- **The last pass, entry by entry.**  Four actions for each successor
of the result, `d + 6` for the top of the second argument, three for each
entry below it; nothing is written.  The pass is charged
`11 * d + 7 * n + 22` operations. -/
theorem Final.pass (F : Final n X0 X T d) (S : Snd n X0)
    (hfr : ∀ (i : Id) (k : Nat) (q : Port), (((i, k), q) : Port × Port) ∈ X0.wires →
      ∃ j, i = [j]) :
    Opers xsys X ⟨X.agents, .idle⟩ X ⟨[], .idle⟩ 0 (5 * d + 3 * n + 10)
      (11 * d + 7 * n + 22) := by
  have hT := F.top
  obtain ⟨γ, low, hsplit, hlen, hlow⟩ := snd_split n
  have hA : X.agents = resL (n + 3) d ++ (([n + 3], γ) :: low) := by
    rw [F.agents, hsplit]
  have hmem : ∀ e ∈ ([n + 3], γ) :: low, e ∈ X.agents := fun e he => by
    rw [hA]
    exact List.mem_append_right _ he
  have w₁ := F.pass_res S hfr (([n + 3], γ) :: low) d (n + 3) (Nat.le_refl _) (by omega)
    (fun e he => by
      rw [hA]
      exact List.mem_append_left _ he)
  have h₁ : assoc [n + 3] X.agents = some γ := F.agent (hmem _ List.mem_cons_self)
  have h₂ : assoc (([n + 3], 0) : Port) X.wires = some ([1], 1) :=
    assoc_eq_of_unique ((F.top_snd S _).2 rfl) (fun q' hq => (F.top_snd S q').1 hq)
  have w₂ : Opers xsys X ⟨([n + 3], γ) :: low, .idle⟩ X ⟨low, .idle⟩ 0 (d + 3 + 1 + 2)
      (2 * (d + 3 + 1) + 5) :=
    Opers.dead (xs := xsys) (e := ([n + 3], γ)) _ h₁ h₂ (F.dead_top S hfr)
  have w₃ := Opers.inert_pass (xs := xsys) (X := X) [] low (fun e he => by
    obtain ⟨j, h1, h2, h3⟩ := hlow e he
    exact F.inert S (hmem e (List.mem_cons_of_mem _ he)) h1 h2 h3)
  rw [List.append_nil, hlen] at w₃
  have w := (w₁.trans w₂).trans w₃
  have e : 4 * (d + 1) + (d + 3 + 1 + 2) + 3 * n = 5 * d + 3 * n + 10 := by omega
  have e' : 9 * (d + 1) + (2 * (d + 3 + 1) + 5) + 7 * n = 11 * d + 7 * n + 22 := by omega
  rw [e, e'] at w
  rw [hA]
  exact w

end FinalFacts

theorem sum_fresh (m n : Nat) (i : Id) (k : Nat) (q : Port)
    (h : (((i, k), q) : Port × Port) ∈ (sum m n).wires) : ∃ j, i = [j] := by
  obtain ⟨j, -, ej⟩ := (good_sum m n).below i (.inr (.inl ⟨k, q, h⟩))
  exact ⟨j, ej⟩

/-- **The whole run of one thread on the net for `(m + 1) + n`**, action
by action: `m + 2` claims, and `22 * (m + 1) + 3 * n + 13` actions to the
empty list, charged `46 * (m + 1) + 7 * n + 28` operations. -/
theorem solo_run_succ (m n : Nat) : ∃ Xf,
    Opers xsys (sum (m + 1) n) ⟨(sum (m + 1) n).agents, .idle⟩ Xf ⟨[], .idle⟩ (m + 2)
      (22 * (m + 1) + 3 * n + 13) (46 * (m + 1) + 7 * n + 28) := by
  obtain ⟨Xf, w, F⟩ := solo_rounds m n
  have p := F.pass (snd_sum (m + 1) n) (sum_fresh (m + 1) n)
  have w' := w.trans p
  have e : 17 * m + 25 + (5 * m + 3 * n + 10) = 22 * (m + 1) + 3 * n + 13 := by omega
  have e' : 35 * m + 52 + (11 * m + 7 * n + 22) = 46 * (m + 1) + 7 * n + 28 := by omega
  rw [e, e', Nat.add_zero] at w'
  exact ⟨Xf, w'⟩

theorem zero0_single (j k : Nat) (q : Port) :
    ((([j], k), q) : Port × Port) ∈ addZero.toX.newLinks ar [1] [2] .add .zero ↔
      j = 1 ∧ k = 1 ∧ q = ([1], 2) ∨ j = 1 ∧ k = 2 ∧ q = ([1], 1) := by
  rw [newLinks_zero]
  simp [and_assoc]

/-- **The memory after the only round of `0 + n`**: the second argument
and its zero, and the two segments the round wrote. -/
structure Final0 (n : Nat) (X0 X : XNet Arith) : Prop where
  agents : X.agents = sndL n ++ [([3], .zero)]
  wires : ∀ e, e ∈ X.wires ↔
    e ∈ addZero.toX.newLinks ar [1] [2] .add .zero ∨ e ∈ X0.wires

theorem final0_sumSnd (n : Nat) : Final0 n (sumSnd n) (stepZ (sumSnd n) [1] [2]) := by
  refine ⟨?_, fun e => ?_⟩
  · have k1 : (sndL n).filter (fun e => decide (e.1 ≠ [1])) = sndL n :=
      filter_keep fun e he e' => by
        obtain ⟨-, j, h1, -, h3⟩ := mem_sndL he
        rw [h3] at e'
        injection e' with e1
        omega
    have k2 : (sndL n).filter (fun e => decide (e.1 ≠ [2])) = sndL n :=
      filter_keep fun e he e' => by
        obtain ⟨-, j, h1, -, h3⟩ := mem_sndL he
        rw [h3] at e'
        injection e' with e1
        omega
    unfold stepZ
    rw [XNet.putLinks_agents]
    show (((sumSnd n).agents.filter (fun e => decide (e.1 ≠ [1]))).filter
      (fun e => decide (e.1 ≠ [2]))) = _
    rw [sumSnd_agents, List.filter_append, List.filter_append, k1, k2]
    rfl
  · unfold stepZ
    exact XNet.mem_step_wires _ _ _ _ _ e

section Final0Facts

variable {n : Nat} {X0 X : XNet Arith}

theorem Final0.old (F : Final0 n X0 X) {j k : Nat} (h : j ≠ 1 ∨ k = 0) (q : Port) :
    ((([j], k), q) : Port × Port) ∈ X.wires ↔ ((([j], k), q) : Port × Port) ∈ X0.wires := by
  rw [F.wires, zero0_single]
  constructor
  · rintro ((⟨h1, h2, -⟩ | ⟨h1, h2, -⟩) | h')
    · omega
    · omega
    · exact h'
  · exact .inr

theorem Final0.one_one (F : Final0 n X0 X) (S : Snd n X0) (q : Port) :
    ((([1], 1), q) : Port × Port) ∈ X.wires ↔ q = ([1], 2) ∨ q = ([n + 3], 0) := by
  rw [F.wires, zero0_single, S.one]
  constructor
  · rintro ((⟨-, -, h⟩ | ⟨-, h, -⟩) | h)
    · exact .inl h
    · omega
    · exact .inr h
  · rintro (h | h)
    · exact .inl (.inl ⟨rfl, rfl, h⟩)
    · exact .inr h

theorem Final0.one_two (F : Final0 n X0 X) (S : Snd n X0) (q : Port) :
    ((([1], 2), q) : Port × Port) ∈ X.wires ↔ q = ([1], 1) ∨ q = ([0], 0) := by
  rw [F.wires, zero0_single, S.res]
  constructor
  · rintro ((⟨-, h, -⟩ | ⟨-, -, h⟩) | h)
    · omega
    · exact .inl h
    · exact .inr h
  · rintro (h | h)
    · exact .inl (.inr ⟨rfl, rfl, h⟩)
    · exact .inr h

theorem Final0.agent (F : Final0 n X0 X) {e : Id × Arith} (he : e ∈ X.agents) :
    assoc e.1 X.agents = some e.2 := by
  refine assoc_eq_of_unique he (fun γ hγ => ?_)
  rw [F.agents] at he hγ
  have h1 := final_sym (n := n) (d := 0) (List.mem_append_right _ he)
  have h2 := final_sym (n := n) (d := 0) (List.mem_append_right _ hγ)
  exact h2.trans h1.symm

theorem Final0.no_zero (F : Final0 n X0 X) : assoc [0] X.agents = none := by
  rw [F.agents]
  refine assoc_none_of_forall fun e he e' => ?_
  rcases List.mem_append.1 he with h | h
  · obtain ⟨-, j, h2, -, h3⟩ := mem_sndL h
    rw [h3] at e'
    injection e' with e1
    omega
  · rcases List.mem_cons.1 h with rfl | h
    · exact absurd e' (by decide)
    · cases h

/-- **The last pass of `0 + n`**: five actions for the top of the second
argument, which a thread follows round the adder that is gone and out to
the result, and three for each entry below it. -/
theorem Final0.pass (F : Final0 n X0 X) (S : Snd n X0) :
    Opers xsys X ⟨X.agents, .idle⟩ X ⟨[], .idle⟩ 0 (3 * n + 5) (7 * n + 11) := by
  obtain ⟨γ, low, hsplit, hlen, hlow⟩ := snd_split n
  have hA : X.agents = ([n + 3], γ) :: low := by
    rw [F.agents, hsplit]
  have hmem : ∀ e ∈ ([n + 3], γ) :: low, e ∈ X.agents := fun e he => by
    rw [hA]
    exact he
  have h₁ : assoc [n + 3] X.agents = some γ := F.agent (hmem _ List.mem_cons_self)
  have h₂ : assoc (([n + 3], 0) : Port) X.wires = some ([1], 1) := by
    refine assoc_eq_of_unique ?_ (fun q' hq => ?_)
    · rw [F.old (.inr rfl)]
      exact (S.top _).2 rfl
    · rw [F.old (.inr rfl)] at hq
      exact (S.top q').1 hq
  have W1 := F.one_one S
  have W2 := F.one_two S
  have hn1 : nextSeg X.wires ([1], 1) ([n + 3], 0) = some ([1], 2) := by
    refine nextSeg_some ((W1 _).2 (.inl rfl)) (by ports_differ) (fun q hq hqp => ?_)
    rcases (W1 q).1 hq with h | h
    · exact h
    · exact absurd h hqp
  have hn2 : nextSeg X.wires ([1], 2) ([1], 1) = some ([0], 0) := by
    refine nextSeg_some ((W2 _).2 (.inr rfl)) (by ports_differ) (fun q hq hqp => ?_)
    rcases (W2 q).1 hq with h | h
    · exact absurd h hqp
    · exact h
  have hs : nextSeg X.wires ([0], 0) ([1], 2) = none :=
    nextSeg_none fun q hq => by
      rw [F.old (.inr rfl)] at hq
      exact (S.out q).1 hq
  have hd : X.Dead ([n + 3], 0) ([1], 1) 3 :=
    .step rfl hn1 (.step rfl hn2 (.stop ((ite_pos' rfl).trans F.no_zero) hs))
  have w₂ : Opers xsys X ⟨([n + 3], γ) :: low, .idle⟩ X ⟨low, .idle⟩ 0 5 11 :=
    Opers.dead (xs := xsys) (e := ([n + 3], γ)) (k := 3) _ h₁ h₂ hd
  have w₃ := Opers.inert_pass (xs := xsys) (X := X) [] low (fun e he => by
    obtain ⟨j, h1, h2, h3⟩ := hlow e he
    refine ⟨F.agent (hmem e (List.mem_cons_of_mem _ he)), ([j + 1], 1), ?_, rfl, ?_⟩
    · rw [h3]
      refine assoc_eq_of_unique ?_ (fun q' hq => ?_)
      · rw [F.old (.inr rfl)]
        exact (S.up j h1 h2 _).2 rfl
      · rw [F.old (.inr rfl)] at hq
        exact (S.up j h1 h2 q').1 hq
    · rw [h3]
      refine nextSeg_none fun q hq => ?_
      rw [F.old (.inl (by omega))] at hq
      exact (S.down j h1 h2 q).1 hq)
  rw [List.append_nil, hlen] at w₃
  have w := w₂.trans w₃
  have e : 5 + 3 * n = 3 * n + 5 := by omega
  have e' : 11 + 7 * n = 7 * n + 11 := by omega
  rw [e, e'] at w
  rw [hA]
  exact w

end Final0Facts

/-- In the net for `0 + n` a thread gives up at once on every successor
of the second argument. -/
theorem sumSnd_inert (n : Nat) {e : Id × Arith} (he : e ∈ sndL n) : (sumSnd n).Inert e := by
  have S := snd_sumSnd n
  obtain ⟨-, j, h1, h2, h3⟩ := mem_sndL he
  have hin : e ∈ (sumSnd n).agents := by
    rw [sumSnd_agents]
    exact List.mem_append_left _ he
  refine ⟨assoc_of_nodup (sumSnd_nodup n) hin, ?_⟩
  by_cases hj : j = n + 3
  · refine ⟨([1], 1), ?_, rfl, ?_⟩
    · rw [h3, hj]
      exact assoc_eq_of_unique ((S.top _).2 rfl) (fun q' hq => (S.top q').1 hq)
    · rw [h3, hj]
      exact nextSeg_none fun q hq => (S.one q).1 hq
  · refine ⟨([j + 1], 1), ?_, rfl, ?_⟩
    · rw [h3]
      exact assoc_eq_of_unique ((S.up j (by omega) (by omega) _).2 rfl)
        (fun q' hq => (S.up j (by omega) (by omega) q').1 hq)
    · rw [h3]
      exact nextSeg_none fun q hq => (S.down j (by omega) (by omega) q).1 hq

/-- **The whole run of one thread on the net for `0 + n`**: a pass over
the second argument, the one claim, and the last pass, `6 * n + 13`
actions in all, charged `14 * n + 28` operations. -/
theorem solo_run_zero (n : Nat) : ∃ Xf,
    Opers xsys (sum 0 n) ⟨(sum 0 n).agents, .idle⟩ Xf ⟨[], .idle⟩ 1 (6 * n + 13)
      (14 * n + 28) := by
  show ∃ Xf, Opers xsys (sumSnd n) ⟨(sumSnd n).agents, .idle⟩ Xf ⟨[], .idle⟩ 1 (6 * n + 13)
    (14 * n + 28)
  have S := snd_sumSnd n
  obtain ⟨ad, pr⟩ := sumSnd_facts n
  have hA := sumSnd_agents n
  have w₁ : Opers xsys (sumSnd n) ⟨sndL n ++ base.agents, .idle⟩ (sumSnd n)
      ⟨base.agents, .idle⟩ 0 (3 * (sndL n).length) (7 * (sndL n).length) :=
    Opers.inert_pass (xs := xsys) base.agents (sndL n) (fun e he => sumSnd_inert n he)
  rw [sndL_length] at w₁
  have h₂ : assoc (([1], 0) : Port) (sumSnd n).wires = some ([2], 0) :=
    assoc_eq_of_unique ((pr _).2 rfl) (fun q' hq => (pr q').1 hq)
  have hz : (([2], Arith.zero) : Id × Arith) ∈ (sumSnd n).agents := by
    rw [hA]
    exact List.mem_append_right _ (by decide)
  have h₃ : assoc [2] (sumSnd n).agents = some .zero := assoc_of_nodup (sumSnd_nodup n) hz
  have hne : ([1] : Id) ≠ [2] := by decide
  have h₄ : assoc [2] ((sumSnd n).takeAgent [1]).agents = some .zero := by
    show assoc [2] ((sumSnd n).agents.filter fun e => decide (e.1 ≠ [1])) = _
    rw [assoc_filter_ne, ite_neg' hne]
    exact h₃
  have hR : xsys.rule .add .zero = some addZero.toX := rfl
  have w₂ : Opers xsys (sumSnd n) ⟨base.agents, .idle⟩ (stepZ (sumSnd n) [1] [2])
      ⟨(stepZ (sumSnd n) [1] [2]).agents, .idle⟩ 1 8 17 :=
    Opers.claim_direct (xs := xsys) [([2], Arith.zero), ([3], Arith.zero)] ad h₂ h₃ hne h₄ hR
  have w₃ := (final0_sumSnd n).pass S
  have w := (w₁.trans w₂).trans w₃
  have e : 3 * n + 8 + (3 * n + 5) = 6 * n + 13 := by omega
  have e' : 7 * n + 17 + (7 * n + 11) = 14 * n + 28 := by omega
  rw [e, e'] at w
  rw [hA]
  exact ⟨_, w⟩

/-- The operations on maps that one thread is charged to add `m` and
`n`. -/
def soloOps (m n : Nat) : Nat := if m = 0 then 14 * n + 28 else 46 * m + 7 * n + 28

/-- **The whole run of one thread on the net for `m + n`**, action by
action, to the empty list, with the operations it is charged. -/
theorem solo_run (m n : Nat) : ∃ Xf c,
    Opers xsys (sum m n) ⟨(sum m n).agents, .idle⟩ Xf ⟨[], .idle⟩ c (soloWork m n)
      (soloOps m n) := by
  cases m with
  | zero =>
    obtain ⟨Xf, w⟩ := solo_run_zero n
    exact ⟨Xf, 1, w⟩
  | succ m =>
    obtain ⟨Xf, w⟩ := solo_run_succ m n
    have e : soloWork (m + 1) n = 22 * (m + 1) + 3 * n + 13 := by
      unfold soloWork
      rw [ite_neg' (Nat.succ_ne_zero m)]
    have e' : soloOps (m + 1) n = 46 * (m + 1) + 7 * n + 28 := by
      unfold soloOps
      rw [ite_neg' (Nat.succ_ne_zero m)]
    rw [e, e']
    exact ⟨Xf, m + 2, w⟩

/-- **One thread adds in exactly `22 * m + 3 * n + 13` actions, for every
size** (`6 * n + 13` when `m` is zero).  On the net for `m + n` the run of
a single thread is at rest after that many actions and not before, and
none of them is a rest. -/
theorem solo_work (m n : Nat) :
    ((XMach.init (sum m n) 1).trace xsys (fun _ => 0) (soloWork m n)).1.resting = true ∧
      (XMach.init (sum m n) 1).work xsys (fun _ => 0) (soloWork m n) = soloWork m n ∧
      ∀ i, i < soloWork m n →
        ¬ ((XMach.init (sum m n) 1).trace xsys (fun _ => 0) i).1.resting = true := by
  obtain ⟨Xf, c, r⟩ := solo_run m n
  have w := r.works
  obtain ⟨t1, t2⟩ := w.trace
  have h := w.work 0
  rw [XMach.init_one]
  refine ⟨?_, h, t2⟩
  rw [t1]
  rfl

/-- The work of one thread on an addition never passes the law. -/
theorem solo_work_all (m n : Nat) (i : Nat) :
    (XMach.init (sum m n) 1).work xsys (fun _ => 0) i ≤ soloWork m n := by
  obtain ⟨hr, hw, -⟩ := solo_work m n
  by_cases h : i ≤ soloWork m n
  · have h' := XMach.work_mono (xs := xsys) (fun _ => 0) (XMach.init (sum m n) 1) h
    rw [hw] at h'
    exact h'
  · obtain ⟨d, rfl⟩ : ∃ d, i = soloWork m n + d := ⟨i - soloWork m n, by omega⟩
    rw [XMach.work_rest (fun _ => 0) hr d, hw]
    exact Nat.le_refl _

/-- **One thread adds `m` and `n` charged `46 * m + 7 * n + 28`
operations on maps, for every size** (`14 * n + 28` when `m` is zero):
that many when it comes to rest, and never more. -/
theorem solo_ops (m n : Nat) :
    (XMach.init (sum m n) 1).tally XThread.ops xsys (fun _ => 0) (soloWork m n) =
        soloOps m n ∧
      ∀ i, (XMach.init (sum m n) 1).tally XThread.ops xsys (fun _ => 0) i ≤ soloOps m n := by
  obtain ⟨Xf, c, r⟩ := solo_run m n
  rw [XMach.init_one]
  exact r.total

/-- **One thread adds, numbered, in fifteen for each action and the depth
of the trees for each operation, for every size.** -/
theorem solo_ztime_ops (m n : Nat) (i : Nat) :
    (ZMach.init (sum m n) 1).ftime xsys (fun _ => 0) i ≤
      15 * soloWork m n + 21 * lg (15 * m + 5 * n + 19) * soloOps m n := by
  have g := good_sum m n
  obtain ⟨N', hs, hn', -⟩ := add_correct g.config
  obtain ⟨hL, -⟩ := Below.sizes g.below g.ok.1.symm
  have h := ZMach.ftime_le_ops (xs := xsys) g.ok.1 (sum_nodup m n) Nat.zero_lt_one
    xsys_bounded hL hs hn' (fun _ => 0) i
  have hwi := solo_work_all m n i
  have hoi := (solo_ops m n).2 i
  have ha := sum_agents_length_le m n
  have hwl := sum_wires_length_le m n
  have hl := lg_mono (show (sum m n).agents.length + 2 * (m + 1) +
    ((sum m n).wires.length + 8 * (m + 1)) ≤ 15 * m + 5 * n + 19 by omega)
  have hc : (max 1 1 + 6) * (3 * lg ((sum m n).agents.length + 2 * (m + 1) +
      ((sum m n).wires.length + 8 * (m + 1)))) ≤ 21 * lg (15 * m + 5 * n + 19) := by
    rw [Nat.max_self]
    omega
  exact Nat.le_trans h (Nat.add_le_add (Nat.mul_le_mul_left _ hwi) (Nat.mul_le_mul hc hoi))

/-- **The count is at least the work**: once one thread has added `m` and
`n`, the numbered program has taken at least `22 * m + 3 * n + 13`. -/
theorem solo_ztime_ge (m n : Nat) {i : Nat} (hi : soloWork m n ≤ i) :
    soloWork m n ≤ (ZMach.init (sum m n) 1).ftime xsys (fun _ => 0) i := by
  obtain ⟨hr, hw, -⟩ := solo_work m n
  obtain ⟨d, rfl⟩ : ∃ d, i = soloWork m n + d := ⟨i - soloWork m n, by omega⟩
  have h := ZMach.work_le_ftime (xs := xsys) (good_sum m n).ok.1 (sum_nodup m n)
    Nat.zero_lt_one (fun _ => 0) (soloWork m n + d)
  rw [XMach.work_rest (fun _ => 0) hr d, hw] at h
  exact h

/-- **A run whose count is bounded has its bits bounded**: at most three
times the bits of a key for each unit counted. -/
theorem btime_of_ftime (m n : Nat) {F : Nat}
    (hF : ∀ i, (ZMach.init (sum m n) 1).ftime xsys (fun _ => 0) i ≤ F) (i : Nat) :
    (ZMach.init (sum m n) 1).btime xsys (fun _ => 0) i ≤
      3 * ((lg (5 * m + 2 * n + 13 + sumWork m n 1) + 5) * F) := by
  have g := good_sum m n
  obtain ⟨N', hs, hn', -⟩ := add_correct g.config
  obtain ⟨hL, htop⟩ := Below.sizes g.below g.ok.1.symm
  have ha := sum_agents_length_le m n
  have h₁ := Nat.mul_le_mul_left (1 + m + 1) (sum_passBound_le m n)
  have hwork : (1 + (m + 1)) * (sum m n).passBound (m + 1) 2 8 + (m + 1) * (2 + 8 + 1) ≤
      sumWork m n 1 := by
    show (1 + m + 1) * (sum m n).passBound (m + 1) 2 8 + (m + 1) * (2 + 8 + 1) ≤
      (1 + m + 1) * (33 * m + 11 * n + 49) + 11 * (m + 1)
    omega
  have hpow := lt_pow_lg (5 * m + 2 * n + 13 + sumWork m n 1)
  have hW : (sum m n).top + 3 * (m + 1 + 1) <
      2 ^ lg (5 * m + 2 * n + 13 + sumWork m n 1) := by omega
  have hW' : (sum m n).agents.length + ((1 + (m + 1)) * (sum m n).passBound (m + 1) 2 8 +
      (m + 1) * (2 + 8 + 1)) < 2 ^ lg (5 * m + 2 * n + 13 + sumWork m n 1) := by omega
  have h := ZMach.btime_le_ftime (xs := xsys) g.ok.1 (sum_nodup m n) xsys_span xsys_ports
    (sum_ports m n) (Nat.succ_pos 0) xsys_bounded hL hs hn' (fun _ => 0) hW hW' i
  refine Nat.le_trans h (Nat.mul_le_mul_left 3 (Nat.mul_le_mul ?_ (hF i)))
  have e1 : lg 2 = 3 := by decide
  rw [Nat.max_self, Nat.one_mul, e1]
  omega

/-- The same in bits. -/
theorem solo_btime_ops (m n : Nat) (i : Nat) :
    (ZMach.init (sum m n) 1).btime xsys (fun _ => 0) i ≤
      3 * ((lg (5 * m + 2 * n + 13 + sumWork m n 1) + 5) *
        (15 * soloWork m n + 21 * lg (15 * m + 5 * n + 19) * soloOps m n)) :=
  btime_of_ftime m n (solo_ztime_ops m n) i

/-- `1000 + 1000` on one thread: exactly 25,013 actions, charged 53,028
operations; so at least 25,013 counted once it rests, and at most
18,192,603, and at most 1,746,489,888 bits. -/
example : (XMach.init (sum 1000 1000) 1).work xsys (fun _ => 0) 25013 = 25013 ∧
    (XMach.init (sum 1000 1000) 1).tally XThread.ops xsys (fun _ => 0) 25013 = 53028 ∧
    ∀ i, (25013 ≤ i → 25013 ≤ (ZMach.init (sum 1000 1000) 1).ftime xsys (fun _ => 0) i) ∧
      (ZMach.init (sum 1000 1000) 1).ftime xsys (fun _ => 0) i ≤ 18192603 ∧
      (ZMach.init (sum 1000 1000) 1).btime xsys (fun _ => 0) i ≤ 1746489888 := by
  have e : soloWork 1000 1000 = 25013 := by decide
  have eo : soloOps 1000 1000 = 53028 := by decide
  have h := (solo_work 1000 1000).2.1
  have ho := (solo_ops 1000 1000).1
  rw [e] at h ho
  rw [eo] at ho
  refine ⟨h, ho, fun i => ⟨fun hi => ?_, ?_, ?_⟩⟩
  · have h0 := solo_ztime_ge 1000 1000 (i := i) (by rw [e]; exact hi)
    rw [e] at h0
    exact h0
  · have h1 := solo_ztime_ops 1000 1000 i
    have e1 : 15 * soloWork 1000 1000 +
        21 * lg (15 * 1000 + 5 * 1000 + 19) * soloOps 1000 1000 = 18192603 := by
      decide +kernel
    rw [e1] at h1
    exact h1
  · have h2 := solo_btime_ops 1000 1000 i
    have e2 : 3 * ((lg (5 * 1000 + 2 * 1000 + 13 + sumWork 1000 1000 1) + 5) *
        (15 * soloWork 1000 1000 +
          21 * lg (15 * 1000 + 5 * 1000 + 19) * soloOps 1000 1000)) = 1746489888 := by
      decide +kernel
    rw [e2] at h2
    exact h2

/-- `12 + 12` on one thread: 313 actions charged 664 operations, so at
most 144,135 counted and 8,648,100 bits, where four operations for every
action gave 267,615 and 16,056,900.  The run takes 10,999 and 28,984. -/
example : ∀ i, (ZMach.init (sum 12 12) 1).ftime xsys (fun _ => 0) i ≤ 144135 ∧
    (ZMach.init (sum 12 12) 1).btime xsys (fun _ => 0) i ≤ 8648100 := by
  intro i
  have h1 := solo_ztime_ops 12 12 i
  have h2 := solo_btime_ops 12 12 i
  have e1 : 15 * soloWork 12 12 + 21 * lg (15 * 12 + 5 * 12 + 19) * soloOps 12 12 =
      144135 := by decide +kernel
  have e2 : 3 * ((lg (5 * 12 + 2 * 12 + 13 + sumWork 12 12 1) + 5) *
      (15 * soloWork 12 12 + 21 * lg (15 * 12 + 5 * 12 + 19) * soloOps 12 12)) =
      8648100 := by decide +kernel
  rw [e1] at h1
  rw [e2] at h2
  exact ⟨h1, h2⟩

end Arith

/-! ## Example: a run as long as the bound allows

One symbol `ε` without auxiliary ports, and one rule: two `ε` facing each
other leave nothing.  The net `Eps.net k n` has `k` agents on free ports,
listed first, and `n` active pairs.  One thread alone passes the `k` agents
before it finds a pair, once for every pair and once more at the end, so it
takes `(n + 1) * (3 * k) + 6 * n` actions, exactly.  The bound of
`XMach.solo_bound` for this net is `(n + 1) * (9 * k + 16 * n) + n + 1`. -/

/-- A list made of one piece for each number below `k`, the last one
first. -/
def gen {A : Type} (f : Nat → List A) : Nat → List A
  | 0 => []
  | k + 1 => f k ++ gen f k

theorem mem_gen {A : Type} {f : Nat → List A} {x : A} :
    ∀ {k : Nat}, x ∈ gen f k ↔ ∃ j, j < k ∧ x ∈ f j
  | 0 => ⟨fun h => absurd h List.not_mem_nil, fun ⟨j, hj, _⟩ => absurd hj (Nat.not_lt_zero j)⟩
  | k + 1 => by
    show x ∈ f k ++ gen f k ↔ _
    rw [List.mem_append, mem_gen (k := k)]
    constructor
    · rintro (h | ⟨j, hj, h⟩)
      · exact ⟨k, Nat.lt_succ_self k, h⟩
      · exact ⟨j, Nat.lt_succ_of_lt hj, h⟩
    · rintro ⟨j, hj, h⟩
      rcases Nat.lt_or_eq_of_le (Nat.le_of_lt_succ hj) with h' | h'
      · exact .inr ⟨j, h', h⟩
      · rw [h'] at h
        exact .inl h

theorem length_gen {A : Type} {f : Nat → List A} {c : Nat} (h : ∀ j, (f j).length = c) :
    ∀ k, (gen f k).length = c * k
  | 0 => rfl
  | k + 1 => by
    show (f k ++ gen f k).length = c * (k + 1)
    rw [List.length_append, h, length_gen h k, Nat.mul_add, Nat.mul_one, Nat.add_comm]

theorem map_gen {A B : Type} (g : A → B) (f : Nat → List A) :
    ∀ k, (gen f k).map g = gen (fun j => (f j).map g) k
  | 0 => rfl
  | k + 1 => by
    show (f k ++ gen f k).map g = (f k).map g ++ gen (fun j => (f j).map g) k
    rw [List.map_append, map_gen g f k]

theorem nodup_gen {A : Type} {f : Nat → List A} (h₁ : ∀ j, (f j).Nodup)
    (h₂ : ∀ i j x, x ∈ f i → x ∈ f j → i = j) : ∀ k, (gen f k).Nodup
  | 0 => List.nodup_nil
  | k + 1 => by
    show (f k ++ gen f k).Nodup
    refine List.nodup_append.2 ⟨h₁ k, nodup_gen h₁ h₂ k, fun a ha b hb e => ?_⟩
    obtain ⟨j, hj, hb'⟩ := mem_gen.1 hb
    rw [← e] at hb'
    have := h₂ k j a ha hb'
    omega

theorem filter_ne {A B : Type} [DecidableEq A] {l : List (A × B)} {a : A}
    (h : ∀ e, e ∈ l → e.1 ≠ a) : l.filter (fun e => decide (e.1 ≠ a)) = l :=
  List.filter_eq_self.2 fun e he => decide_eq_true (h e he)

theorem filter_ne_cons_same {A B : Type} [DecidableEq A] (a : A) (b : B) (l : List (A × B)) :
    ((a, b) :: l).filter (fun e => decide (e.1 ≠ a)) = l.filter (fun e => decide (e.1 ≠ a)) :=
  List.filter_cons_of_neg (by simp)

theorem filter_ne_cons_other {A B : Type} [DecidableEq A] {a a' : A} {b : B}
    {l : List (A × B)} (h : a' ≠ a) :
    ((a', b) :: l).filter (fun e => decide (e.1 ≠ a)) =
      (a', b) :: l.filter (fun e => decide (e.1 ≠ a)) :=
  List.filter_cons_of_pos (by simpa using h)

/-- A single symbol. -/
inductive Eps
  | ε
  deriving DecidableEq, Repr

namespace Eps

/-- It has no auxiliary port. -/
def ar : Eps → Nat := fun _ => 0

/-- `ε ⋈ ε`: the empty net. -/
def data : SysData Eps := ⟨ar, [((ε, ε), RuleData.ofWires [] [])]⟩

/-- The system, by evaluation of the check. -/
def xsys : XSys Eps := data.toXSys (by decide)

/-- Its rule writes nothing. -/
theorem xsys_bounded : xsys.Bounded 0 0 := by
  intro α β R h
  cases α
  cases β
  rw [← Option.some.inj h]
  decide

/-- `k` agents, each to be wired to a free port of its own. -/
def lone (k : Nat) : List (Id × Eps) := gen (fun j => [([j, 0], ε)]) k

def loneFree (k : Nat) : List Port := gen (fun j => [([j, 1], 0)]) k

def loneWires (k : Nat) : List (Port × Port) :=
  gen (fun j => [(([j, 0], 0), ([j, 1], 0)), (([j, 1], 0), ([j, 0], 0))]) k

/-- `m` pairs of agents, each to be wired to its partner. -/
def pairs (m : Nat) : List (Id × Eps) := gen (fun j => [([j, 2], ε), ([j, 3], ε)]) m

def pairWires (m : Nat) : List (Port × Port) :=
  gen (fun j => [(([j, 2], 0), ([j, 3], 0)), (([j, 3], 0), ([j, 2], 0))]) m

/-- The memory when `m` of the `n` pairs are left.  The segments of the
pairs that are gone are still there. -/
def mem (k n m : Nat) : XNet Eps :=
  ⟨lone k ++ pairs m, loneFree k, loneWires k ++ pairWires n⟩

/-- `k` agents on free ports, listed first, and `n` active pairs. -/
def net (k n : Nat) : XNet Eps := mem k n n

theorem mem_lone {k : Nat} {e : Id × Eps} : e ∈ lone k ↔ ∃ j, j < k ∧ e = ([j, 0], ε) := by
  unfold lone
  rw [mem_gen]
  exact exists_congr fun j => and_congr Iff.rfl List.mem_singleton

theorem mem_loneFree {k : Nat} {p : Port} : p ∈ loneFree k ↔ ∃ j, j < k ∧ p = ([j, 1], 0) := by
  unfold loneFree
  rw [mem_gen]
  exact exists_congr fun j => and_congr Iff.rfl List.mem_singleton

theorem mem_loneWires {k : Nat} {w : Port × Port} :
    w ∈ loneWires k ↔ ∃ j, j < k ∧
      (w = (([j, 0], 0), ([j, 1], 0)) ∨ w = (([j, 1], 0), ([j, 0], 0))) := by
  unfold loneWires
  rw [mem_gen]
  exact exists_congr fun j => and_congr Iff.rfl (by rw [List.mem_cons, List.mem_singleton])

theorem mem_pairs {m : Nat} {e : Id × Eps} :
    e ∈ pairs m ↔ ∃ j, j < m ∧ (e = ([j, 2], ε) ∨ e = ([j, 3], ε)) := by
  unfold pairs
  rw [mem_gen]
  exact exists_congr fun j => and_congr Iff.rfl (by rw [List.mem_cons, List.mem_singleton])

theorem mem_pairWires {m : Nat} {w : Port × Port} :
    w ∈ pairWires m ↔ ∃ j, j < m ∧
      (w = (([j, 2], 0), ([j, 3], 0)) ∨ w = (([j, 3], 0), ([j, 2], 0))) := by
  unfold pairWires
  rw [mem_gen]
  exact exists_congr fun j => and_congr Iff.rfl (by rw [List.mem_cons, List.mem_singleton])

theorem lone_length (k : Nat) : (lone k).length = k := by
  have h := length_gen (f := fun j => [(([j, 0] : Id), ε)]) (c := 1) (fun _ => rfl) k
  rw [Nat.one_mul] at h
  exact h

/-- An agent on a free port is given up on: its segment leads to a port
that is not a port of an agent. -/
theorem inert (k n m : Nat) {e : Id × Eps} (he : e ∈ lone k) : (mem k n m).Inert e := by
  obtain ⟨j, hj, rfl⟩ := mem_lone.1 he
  have hw : ∀ q', ((([j, 0] : Id), 0), q') ∈ (mem k n m).wires → q' = (([j, 1] : Id), 0) := by
    intro q' h
    rcases List.mem_append.1 h with h | h
    · obtain ⟨j', -, h | h⟩ := mem_loneWires.1 h
      · simp at h
        obtain ⟨rfl, rfl⟩ := h
        rfl
      · simp at h
    · obtain ⟨j', -, h | h⟩ := mem_pairWires.1 h
      · simp at h
      · simp at h
  have hw' : ∀ q', ((([j, 1] : Id), 0), q') ∈ (mem k n m).wires → q' = (([j, 0] : Id), 0) := by
    intro q' h
    rcases List.mem_append.1 h with h | h
    · obtain ⟨j', -, h | h⟩ := mem_loneWires.1 h
      · simp at h
      · simp at h
        obtain ⟨rfl, rfl⟩ := h
        rfl
    · obtain ⟨j', -, h | h⟩ := mem_pairWires.1 h
      · simp at h
      · simp at h
  refine ⟨assoc_eq_of_unique (List.mem_append_left _ he) fun q' _ => by cases q'; rfl,
    ([j, 1], 0),
    assoc_eq_of_unique (List.mem_append_left _ (mem_loneWires.2 ⟨j, hj, .inl rfl⟩)) hw, ?_,
    nextSeg_none hw'⟩
  show (if (0 : Nat) = 0 then assoc [j, 1] (mem k n m).agents else none) = none
  rw [ite_pos' rfl]
  cases h : assoc [j, 1] (mem k n m).agents with
  | none => rfl
  | some v =>
    rcases List.mem_append.1 (assoc_mem h) with h' | h'
    · obtain ⟨j', -, e⟩ := mem_lone.1 h'
      simp at e
    · obtain ⟨j', -, e | e⟩ := mem_pairs.1 h'
      · simp at e
      · simp at e

/-- A thread at the first of the pairs claims it, in six actions, and is
left with one pair fewer. -/
theorem annihilate (k n m : Nat) (hm : m < n) :
    Works xsys (mem k n (m + 1)) ⟨pairs (m + 1), .idle⟩ (mem k n m)
      ⟨(mem k n m).agents, .idle⟩ 1 6 := by
  have ha : (([m, 2] : Id), ε) ∈ (mem k n (m + 1)).agents :=
    List.mem_append_right _ (mem_pairs.2 ⟨m, Nat.lt_succ_self m, .inl rfl⟩)
  have hb : (([m, 3] : Id), ε) ∈ (mem k n (m + 1)).agents :=
    List.mem_append_right _ (mem_pairs.2 ⟨m, Nat.lt_succ_self m, .inr rfl⟩)
  have hne : ([m, 2] : Id) ≠ [m, 3] := by simp
  have hw : ∀ q', ((([m, 2] : Id), 0), q') ∈ (mem k n (m + 1)).wires →
      q' = (([m, 3] : Id), 0) := by
    intro q' h
    rcases List.mem_append.1 h with h | h
    · obtain ⟨j', -, h | h⟩ := mem_loneWires.1 h
      · simp at h
      · simp at h
    · obtain ⟨j', -, h | h⟩ := mem_pairWires.1 h
      · simp at h
        obtain ⟨rfl, rfl⟩ := h
        rfl
      · simp at h
  have hl : ∀ e, e ∈ lone k → e.1 ≠ [m, 2] ∧ e.1 ≠ [m, 3] := by
    intro e he
    obtain ⟨j, -, rfl⟩ := mem_lone.1 he
    simp
  have hp : ∀ e, e ∈ pairs m → e.1 ≠ [m, 2] ∧ e.1 ≠ [m, 3] := by
    intro e he
    obtain ⟨j, hj, rfl | rfl⟩ := mem_pairs.1 he
    · constructor
      · intro h
        simp at h
        omega
      · intro h
        simp at h
    · constructor
      · intro h
        simp at h
      · intro h
        simp at h
        omega
  have htake : ((mem k n (m + 1)).takeAgent [m, 2]).takeAgent [m, 3] = mem k n m := by
    have e1 : (lone k ++ pairs (m + 1)).filter (fun e => decide (e.1 ≠ [m, 2])) =
        lone k ++ (([m, 3], ε) :: pairs m) := by
      show (lone k ++ (([m, 2], ε) :: ([m, 3], ε) :: pairs m)).filter _ = _
      rw [List.filter_append, filter_ne fun e he => (hl e he).1, filter_ne_cons_same,
        filter_ne_cons_other (Ne.symm hne), filter_ne fun e he => (hp e he).1]
    have e2 : (lone k ++ (([m, 3], ε) :: pairs m)).filter (fun e => decide (e.1 ≠ [m, 3])) =
        lone k ++ pairs m := by
      rw [List.filter_append, filter_ne fun e he => (hl e he).2, filter_ne_cons_same,
        filter_ne fun e he => (hp e he).2]
    show (⟨((lone k ++ pairs (m + 1)).filter fun e => decide (e.1 ≠ [m, 2])).filter
        fun e => decide (e.1 ≠ [m, 3]), loneFree k, loneWires k ++ pairWires n⟩ : XNet Eps) =
      ⟨lone k ++ pairs m, loneFree k, loneWires k ++ pairWires n⟩
    rw [e1, e2]
  have w := Works.annihilate (xs := xsys) (X := mem k n (m + 1)) (a := [m, 2]) (b := [m, 3])
    (α := ε) (β := ε) (R := (RuleData.ofWires [] []).toX) (([m, 3], ε) :: pairs m)
    (assoc_eq_of_unique ha fun q' _ => by cases q'; rfl)
    (assoc_eq_of_unique (List.mem_append_right _ (mem_pairWires.2 ⟨m, hm, .inl rfl⟩)) hw)
    (assoc_eq_of_unique hb fun q' _ => by cases q'; rfl) hne
    (assoc_eq_of_unique (XNet.mem_takeAgent.2 ⟨hb, Ne.symm hne⟩) fun q' _ => by cases q'; rfl)
    rfl rfl rfl
  rw [htake] at w
  exact w

/-- **The run of one thread, counted**: with `m` pairs left, it passes the
`k` agents on free ports and claims a pair, `m` times, and passes them once
more. -/
theorem runs (k n : Nat) : ∀ m, m ≤ n →
    Works xsys (mem k n m) ⟨(mem k n m).agents, .idle⟩ (mem k n 0) ⟨[], .idle⟩ m
      (m * (3 * k + 6) + 3 * k)
  | 0, _ => by
    have w := Works.inert_pass (xs := xsys) (X := mem k n 0) [] (lone k)
      fun e he => inert k n 0 he
    rw [lone_length] at w
    have e : 0 * (3 * k + 6) + 3 * k = 3 * k := by omega
    rw [e]
    exact w
  | m + 1, h => by
    have w₁ := Works.inert_pass (xs := xsys) (X := mem k n (m + 1)) (pairs (m + 1)) (lone k)
      fun e he => inert k n (m + 1) he
    rw [lone_length] at w₁
    have w := (w₁.trans (annihilate k n m (by omega))).trans (runs k n m (by omega))
    have e₁ : 0 + 1 + m = m + 1 := by omega
    have e₂ : 3 * k + 6 + (m * (3 * k + 6) + 3 * k) = (m + 1) * (3 * k + 6) + 3 * k := by
      rw [Nat.add_mul, Nat.one_mul]
      omega
    rw [e₁, e₂] at w
    exact w

theorem agent_iff {k n : Nat} {i : Id} {α : Eps} :
    (net k n).toNet.agent i α ↔
      (∃ j, j < k ∧ i = [j, 0]) ∨ ∃ j, j < n ∧ (i = [j, 2] ∨ i = [j, 3]) := by
  show (i, α) ∈ lone k ++ pairs n ↔ _
  rw [List.mem_append, mem_lone, mem_pairs]
  cases α
  constructor
  · rintro (⟨j, hj, h⟩ | ⟨j, hj, h | h⟩)
    · exact .inl ⟨j, hj, (Prod.mk.inj h).1⟩
    · exact .inr ⟨j, hj, .inl (Prod.mk.inj h).1⟩
    · exact .inr ⟨j, hj, .inr (Prod.mk.inj h).1⟩
  · rintro (⟨j, hj, rfl⟩ | ⟨j, hj, rfl | rfl⟩)
    · exact .inl ⟨j, hj, rfl⟩
    · exact .inr ⟨j, hj, .inl rfl⟩
    · exact .inr ⟨j, hj, .inr rfl⟩

theorem link_iff {k n : Nat} {p q : Port} :
    (net k n).toNet.link p q ↔
      (∃ j, j < k ∧ ((p = ([j, 0], 0) ∧ q = ([j, 1], 0)) ∨
        (p = ([j, 1], 0) ∧ q = ([j, 0], 0)))) ∨
      ∃ j, j < n ∧ ((p = ([j, 2], 0) ∧ q = ([j, 3], 0)) ∨
        (p = ([j, 3], 0) ∧ q = ([j, 2], 0))) := by
  show (p, q) ∈ loneWires k ++ pairWires n ↔ _
  rw [List.mem_append, mem_loneWires, mem_pairWires]
  simp only [Prod.mk.injEq]

theorem free_iff {k n : Nat} {p : Port} :
    (net k n).toNet.free p ↔ ∃ j, j < k ∧ p = ([j, 1], 0) :=
  mem_loneFree

theorem used_len {k n : Nat} {i : Id} (h : (net k n).toNet.Used i) : i.length = 2 := by
  rcases h with ⟨γ, hg⟩ | ⟨x, q, hl⟩ | ⟨x, hf⟩
  · rcases agent_iff.1 hg with ⟨j, -, rfl⟩ | ⟨j, -, rfl | rfl⟩ <;> rfl
  · rcases link_iff.1 hl with ⟨j, -, ⟨e, -⟩ | ⟨e, -⟩⟩ | ⟨j, -, ⟨e, -⟩ | ⟨e, -⟩⟩ <;>
      (rw [(Prod.mk.inj e).1]; rfl)
  · obtain ⟨j, -, e⟩ := free_iff.1 hf
    rw [(Prod.mk.inj e).1]
    rfl

/-- The net is a valid input: its segments match its ends in pairs. -/
theorem net_matching (k n : Nat) : (net k n).toNet.Matching ar := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro i α β _ _
    cases α
    cases β
    rfl
  · intro p q h
    rcases link_iff.1 h with ⟨j, hj, ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩⟩ | ⟨j, hj, ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩⟩
    · exact link_iff.2 (.inl ⟨j, hj, .inr ⟨rfl, rfl⟩⟩)
    · exact link_iff.2 (.inl ⟨j, hj, .inl ⟨rfl, rfl⟩⟩)
    · exact link_iff.2 (.inr ⟨j, hj, .inr ⟨rfl, rfl⟩⟩)
    · exact link_iff.2 (.inr ⟨j, hj, .inl ⟨rfl, rfl⟩⟩)
  · intro p h
    rcases link_iff.1 h with ⟨j, -, ⟨rfl, e⟩ | ⟨rfl, e⟩⟩ | ⟨j, -, ⟨rfl, e⟩ | ⟨rfl, e⟩⟩ <;>
      simp at e
  · intro p q q' h h'
    rcases link_iff.1 h with ⟨j, -, ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩⟩ | ⟨j, -, ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩⟩ <;>
      rcases link_iff.1 h' with
        ⟨j', -, ⟨e, rfl⟩ | ⟨e, rfl⟩⟩ | ⟨j', -, ⟨e, rfl⟩ | ⟨e, rfl⟩⟩ <;>
      simp at e <;> simp [e]
  · intro p q h
    rcases link_iff.1 h with ⟨j, hj, ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩⟩ | ⟨j, hj, ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩⟩
    · exact .inr ⟨ε, agent_iff.2 (.inl ⟨j, hj, rfl⟩), Nat.le_refl _⟩
    · exact .inl (free_iff.2 ⟨j, hj, rfl⟩)
    · exact .inr ⟨ε, agent_iff.2 (.inr ⟨j, hj, .inl rfl⟩), Nat.le_refl _⟩
    · exact .inr ⟨ε, agent_iff.2 (.inr ⟨j, hj, .inr rfl⟩), Nat.le_refl _⟩
  · intro p h
    rcases h with hf | ⟨γ, hag, hle⟩
    · obtain ⟨j, hj, rfl⟩ := free_iff.1 hf
      exact ⟨([j, 0], 0), link_iff.2 (.inl ⟨j, hj, .inr ⟨rfl, rfl⟩⟩)⟩
    · obtain ⟨i, x⟩ := p
      have hag' : (net k n).toNet.agent i γ := hag
      have hle' : x ≤ 0 := hle
      have hx : x = 0 := by omega
      subst hx
      rcases agent_iff.1 hag' with ⟨j, hj, rfl⟩ | ⟨j, hj, rfl | rfl⟩
      · exact ⟨([j, 1], 0), link_iff.2 (.inl ⟨j, hj, .inl ⟨rfl, rfl⟩⟩)⟩
      · exact ⟨([j, 3], 0), link_iff.2 (.inr ⟨j, hj, .inl ⟨rfl, rfl⟩⟩)⟩
      · exact ⟨([j, 2], 0), link_iff.2 (.inr ⟨j, hj, .inr ⟨rfl, rfl⟩⟩)⟩
  · intro i x α hf hag
    obtain ⟨j, -, e⟩ := free_iff.1 hf
    have ei : i = [j, 1] := (Prod.mk.inj e).1
    subst ei
    rcases agent_iff.1 hag with ⟨j', -, e'⟩ | ⟨j', -, e' | e'⟩ <;> simp at e'
  · intro a α l hag hu
    have ha : a.length = 2 := by
      rcases agent_iff.1 hag with ⟨j, -, rfl⟩ | ⟨j, -, rfl | rfl⟩ <;> rfl
    have hl := used_len hu
    rw [List.length_append, ha] at hl
    exact List.eq_nil_of_length_eq_zero (by omega)

/-- The net is well formed. -/
theorem net_wf (k n : Nat) : (net k n).toNet.WF ar :=
  (XNet.ok_iff_matching.2 (net_matching k n)).1

/-- No agent is listed twice. -/
theorem net_nodup (k n : Nat) : ((net k n).agents.map Prod.fst).Nodup := by
  show ((lone k ++ pairs n).map Prod.fst).Nodup
  rw [List.map_append]
  refine List.nodup_append.2 ⟨?_, ?_, fun a ha b hb e => ?_⟩
  · unfold lone
    rw [map_gen]
    refine nodup_gen (fun j => List.nodup_cons.2 ⟨List.not_mem_nil, List.nodup_nil⟩)
      (fun i j x hi hj => ?_) k
    have e₁ : x = [i, 0] := List.mem_singleton.1 hi
    have e₂ : x = [j, 0] := List.mem_singleton.1 hj
    rw [e₁] at e₂
    exact List.head_eq_of_cons_eq e₂
  · unfold pairs
    rw [map_gen]
    refine nodup_gen (fun j => ?_) (fun i j x hi hj => ?_) n
    · show ([[j, 2], [j, 3]] : List Id).Nodup
      simp
    · have hi' : x = [i, 2] ∨ x = [i, 3] := by
        rcases List.mem_cons.1 hi with h | h
        · exact .inl h
        · exact .inr (List.mem_singleton.1 h)
      have hj' : x = [j, 2] ∨ x = [j, 3] := by
        rcases List.mem_cons.1 hj with h | h
        · exact .inl h
        · exact .inr (List.mem_singleton.1 h)
      rcases hi' with rfl | rfl <;> rcases hj' with h | h <;>
        exact List.head_eq_of_cons_eq h
  · obtain ⟨e₁, h₁, rfl⟩ := List.mem_map.1 ha
    obtain ⟨e₂, h₂, rfl⟩ := List.mem_map.1 hb
    obtain ⟨j, -, rfl⟩ := mem_lone.1 h₁
    obtain ⟨j', -, rfl | rfl⟩ := mem_pairs.1 h₂ <;> simp at e

theorem net_agents_length (k n : Nat) : (net k n).agents.length = k + 2 * n := by
  show (lone k ++ pairs n).length = _
  have h := length_gen (f := fun j => [(([j, 2] : Id), ε), ([j, 3], ε)]) (c := 2)
    (fun _ => rfl) n
  rw [List.length_append, lone_length]
  show k + (gen (fun j => [(([j, 2] : Id), ε), ([j, 3], ε)]) n).length = _
  omega

theorem net_wires_length (k n : Nat) : (net k n).wires.length = 2 * k + 2 * n := by
  show (loneWires k ++ pairWires n).length = _
  have h₁ := length_gen
    (f := fun j => [((([j, 0] : Id), 0), (([j, 1] : Id), 0)), (([j, 1], 0), ([j, 0], 0))])
    (c := 2) (fun _ => rfl) k
  have h₂ := length_gen
    (f := fun j => [((([j, 2] : Id), 0), (([j, 3] : Id), 0)), (([j, 3], 0), ([j, 2], 0))])
    (c := 2) (fun _ => rfl) n
  rw [List.length_append]
  show (gen (fun j => [((([j, 0] : Id), 0), (([j, 1] : Id), 0)), (([j, 1], 0), ([j, 0], 0))])
      k).length +
    (gen (fun j => [((([j, 2] : Id), 0), (([j, 3] : Id), 0)), (([j, 3], 0), ([j, 2], 0))])
      n).length = _
  omega

/-- The bound for one pass on this net: nine actions for each agent on a
free port and sixteen for each pair. -/
theorem net_passBound (k n : Nat) : (net k n).passBound n 0 0 = 9 * k + 16 * n := by
  show 7 * ((net k n).agents.length + 0 * n) + ((net k n).wires.length + 0 * n) = _
  rw [net_agents_length, net_wires_length]
  omega

/-- **One thread alone takes `(n + 1) * (3 * k) + 6 * n` actions, exactly**:
after that many it is at rest with all `n` pairs claimed, and after any
smaller number it is not at rest. -/
theorem solo_exact (k n : Nat) :
    (XMach.init (net k n) 1).trace xsys (fun _ => 0) ((n + 1) * (3 * k) + 6 * n) =
        (⟨mem k n 0, [⟨[], .idle⟩]⟩, n) ∧
      ∀ i, i < (n + 1) * (3 * k) + 6 * n →
        ¬ ((XMach.init (net k n) 1).trace xsys (fun _ => 0) i).1.resting = true := by
  have w := (runs k n n (Nat.le_refl n)).trace
  have e : n * (3 * k + 6) + 3 * k = (n + 1) * (3 * k) + 6 * n := by
    rw [Nat.mul_add, Nat.add_mul, Nat.one_mul]
    omega
  rw [e] at w
  rw [XMach.init_one]
  exact w

/-- **The bound against the run.**  On the net with `k` agents on free
ports and `n` active pairs, the bound of `XMach.solo_bound` puts one thread
at rest after `(n + 1) * (9 * k + 16 * n) + n + 1` actions, and it is not at
rest before `(n + 1) * (3 * k) + 6 * n`. -/
theorem solo_tight (k n : Nat) :
    (∀ i, (n + 1) * (9 * k + 16 * n) + n + 1 ≤ i →
        ((XMach.init (net k n) 1).trace xsys (fun _ => 0) i).1.resting = true) ∧
      ∀ i, i < (n + 1) * (3 * k) + 6 * n →
        ¬ ((XMach.init (net k n) 1).trace xsys (fun _ => 0) i).1.resting = true := by
  obtain ⟨hL, hlow⟩ := solo_exact k n
  have hX : (net k n).toNet.WF xsys.sys.ar := net_wf k n
  have live := XMach.trace_live (xs := xsys) (fun _ => 0)
    (XMach.init_live hX (Nat.succ_pos 0))
  have hrest : ((XMach.init (net k n) 1).trace xsys (fun _ => 0)
      ((n + 1) * (3 * k) + 6 * n)).1.resting = true := by
    rw [hL]
    rfl
  have hc : ((XMach.init (net k n) 1).trace xsys (fun _ => 0)
      ((n + 1) * (3 * k) + 6 * n)).2 = n := by rw [hL]
  obtain ⟨hq, hnorm⟩ := (live _).rest hrest
  have run := XMach.trace_run xsys (fun _ => 0) (XMach.init (net k n) 1)
    ((n + 1) * (3 * k) + 6 * n)
  rw [XMach.init_toMach, hc] at run
  obtain ⟨hs, -⟩ := run.final hX hq hnorm
  have hb := XMach.solo_bound (xs := xsys) hX (net_nodup k n) xsys_bounded hs hnorm
  refine ⟨fun i hi => (hb i ?_).1, hlow⟩
  rw [net_passBound]
  omega

/-- With at least as many agents on free ports as pairs, the bound is at
most nine times the length of the run, plus one.  As the number of agents
on free ports grows the ratio tends to three. -/
theorem bound_le (k n : Nat) (h : n ≤ k) :
    (n + 1) * (9 * k + 16 * n) + n + 1 ≤ 9 * ((n + 1) * (3 * k) + 6 * n) + 1 := by
  have h1 : (n + 1) * (16 * n) ≤ (n + 1) * (16 * k) := Nat.mul_le_mul_left _ (by omega)
  have e1 : (n + 1) * (9 * k + 16 * n) = (n + 1) * (9 * k) + (n + 1) * (16 * n) :=
    Nat.mul_add _ _ _
  have e2 : (n + 1) * (9 * k) = 9 * ((n + 1) * k) := Nat.mul_left_comm _ _ _
  have e3 : (n + 1) * (16 * k) = 16 * ((n + 1) * k) := Nat.mul_left_comm _ _ _
  have e4 : (n + 1) * (3 * k) = 3 * ((n + 1) * k) := Nat.mul_left_comm _ _ _
  rw [e3] at h1
  rw [e1, e2, e4]
  omega

/-- The net with no pair is in normal form. -/
theorem net_normal (k : Nat) : Normal (Step xsys.sys) (net k 0).toNet := by
  obtain ⟨hL, -⟩ := solo_exact k 0
  have hX : (net k 0).toNet.WF xsys.sys.ar := net_wf k 0
  have live := XMach.trace_live (xs := xsys) (fun _ => 0)
    (XMach.init_live hX (Nat.succ_pos 0))
  have hrest : ((XMach.init (net k 0) 1).trace xsys (fun _ => 0)
      ((0 + 1) * (3 * k) + 6 * 0)).1.resting = true := by
    rw [hL]
    rfl
  have hn := ((live _).rest hrest).2
  rw [hL] at hn
  exact hn

/-- On the net with no pair, a thread that starts anywhere in the list
passes every agent without writing. -/
theorem reads (k nt : Nat) :
    ∀ T, T ∈ (XMach.init (net k 0) nt).ths → T.Reads xsys (net k 0) := by
  intro T hT
  obtain ⟨t, -, rfl⟩ := List.mem_map.1 hT
  have hin : ∀ e, e ∈ (net k 0).agents.drop t ++ (net k 0).agents.take t →
      (net k 0).Inert e := by
    intro e he
    have he' : e ∈ (net k 0).agents := by
      rcases List.mem_append.1 he with h | h
      · exact List.mem_of_mem_drop h
      · exact List.mem_of_mem_take h
    rcases List.mem_append.1 he' with h | h
    · exact inert k 0 0 h
    · exact absurd h List.not_mem_nil
  have st := Stays.inert_pass (xs := xsys) (X := net k 0) [] _ hin
  rw [List.append_nil] at st
  exact (st.after rfl).1

/-- **The window against the run.**  On the net with `k` agents on free
ports and nothing to reduce, one thread alone is at rest after `3 * k`
actions (`solo_exact`).  With two threads and the schedule that gives the
first every `F`-th action, which is fair with window `F`, the bound of
`XMach.fair_bound` puts them at rest after `F * (9 * k + 1)` actions, and
they are not at rest after `F * (3 * k) - F` actions or fewer: the window
multiplies the work of a thread. -/
theorem window_tight (k F : Nat) (hF : 2 ≤ F) :
    (∀ u, u < 2 → ∀ i, ∃ j, i ≤ j ∧ j < i + F ∧ starve F j = u) ∧
      (∀ i, F * (9 * k + 1) ≤ i →
        ((XMach.init (net k 0) 2).trace xsys (starve F) i).1.resting = true) ∧
      ∀ i, i + F ≤ F * (3 * k) →
        ¬ ((XMach.init (net k 0) 2).trace xsys (starve F) i).1.resting = true := by
  have hX : (net k 0).toNet.WF xsys.sys.ar := net_wf k 0
  refine ⟨starve_fair hF, fun i hi => ?_, ?_⟩
  · have hb := XMach.fair_bound (xs := xsys) hX (net_nodup k 0) (nt := 2) (by decide)
      xsys_bounded (.refl _) (net_normal k) (starve F) (starve_fair hF) i
    refine (hb ?_).1
    rw [net_passBound]
    have e : (0 + 1) * (9 * k + 16 * 0) + 0 * (0 + 0 + 1) + 1 = 9 * k + 1 := by omega
    rw [e]
    exact hi
  · have h0 := XMach.init_thread (net k 0) (nt := 2) (u := 0) (by decide)
    have st := Stays.inert_pass (xs := xsys) (X := net k 0) []
      ((net k 0).agents.drop 0 ++ (net k 0).agents.take 0) fun e he => by
        have he' : e ∈ lone k ++ pairs 0 ++ [] := he
        rw [List.append_nil] at he'
        rcases List.mem_append.1 he' with h | h
        · exact inert k 0 0 h
        · exact absurd h List.not_mem_nil
    rw [List.append_nil] at st
    have hl : ((net k 0).agents.drop 0 ++ (net k 0).agents.take 0).length = k := by
      show (lone k ++ pairs 0 ++ []).length = k
      rw [List.append_nil, List.length_append, lone_length]
      rfl
    rw [hl] at st
    exact XMach.starved (xs := xsys) (starve F) (reads k 2) h0 st (by omega) (starve_sparse F)

/-- **The window against the run, for any number of threads.**  The same
with `nt` threads, as many as the window has room for: under a schedule
that gives each of them an action in every `F`, the bound puts them at rest
after `F * (9 * k + 1)` actions, and they are not at rest after
`F * (3 * k) - F` actions or fewer. -/
theorem window_many (k nt F : Nat) (hnt : 0 < nt) (hF : nt ≤ F) :
    (∀ u, u < nt → ∀ i, ∃ j, i ≤ j ∧ j < i + F ∧ starveAmong nt F j = u) ∧
      (∀ i, F * (9 * k + 1) ≤ i →
        ((XMach.init (net k 0) nt).trace xsys (starveAmong nt F) i).1.resting = true) ∧
      ∀ i, i + F ≤ F * (3 * k) →
        ¬ ((XMach.init (net k 0) nt).trace xsys (starveAmong nt F) i).1.resting = true := by
  have hX : (net k 0).toNet.WF xsys.sys.ar := net_wf k 0
  refine ⟨starveAmong_fair hF, fun i hi => ?_, ?_⟩
  · have hb := XMach.fair_bound (xs := xsys) hX (net_nodup k 0) hnt
      xsys_bounded (.refl _) (net_normal k) (starveAmong nt F) (starveAmong_fair hF) i
    refine (hb ?_).1
    rw [net_passBound]
    have e : (0 + 1) * (9 * k + 16 * 0) + 0 * (0 + 0 + 1) + 1 = 9 * k + 1 := by omega
    rw [e]
    exact hi
  · have h0 := XMach.init_thread (net k 0) (nt := nt) (u := 0) hnt
    have st := Stays.inert_pass (xs := xsys) (X := net k 0) []
      ((net k 0).agents.drop 0 ++ (net k 0).agents.take 0) fun e he => by
        have he' : e ∈ lone k ++ pairs 0 ++ [] := he
        rw [List.append_nil] at he'
        rcases List.mem_append.1 he' with h | h
        · exact inert k 0 0 h
        · exact absurd h List.not_mem_nil
    rw [List.append_nil] at st
    have hl : ((net k 0).agents.drop 0 ++ (net k 0).agents.take 0).length = k := by
      show (lone k ++ pairs 0 ++ []).length = k
      rw [List.append_nil, List.length_append, lone_length]
      rfl
    rw [hl] at st
    exact XMach.starved (xs := xsys) (starveAmong nt F) (reads k nt) h0 st (by omega)
      (starveAmong_sparse nt F)

/-- The segment at the principal port of an agent on a free port leads to
that port. -/
theorem lone_wire {k n m j : Nat} {q : Port}
    (h : ((([j, 0] : Id), 0), q) ∈ (mem k n m).wires) : q = (([j, 1] : Id), 0) := by
  rcases List.mem_append.1 h with h | h
  · obtain ⟨j', -, h | h⟩ := mem_loneWires.1 h
    · simp at h
      obtain ⟨rfl, rfl⟩ := h
      rfl
    · simp at h
  · obtain ⟨j', -, h | h⟩ := mem_pairWires.1 h
    · simp at h
    · simp at h

/-- On the net with no pair, the pass of a thread that starts anywhere in
the list takes `3 * k` actions and costs a look at every cell of the memory
for each agent. -/
theorem pass_spent (k nt : Nat) : ∀ T, T ∈ (XMach.init (net k 0) nt).ths →
    ∃ j, (∀ j', j' < j → T.after xsys (net k 0) j' ≠ ⟨[], .idle⟩) ∧
      k * (3 * k + 3) ≤ T.spent xsys (net k 0) j := by
  intro T hT
  obtain ⟨t, -, rfl⟩ := List.mem_map.1 hT
  have hin : ∀ e, e ∈ (net k 0).agents.drop t ++ (net k 0).agents.take t →
      (net k 0).Inert e ∧ ∀ q, assoc (e.1, 0) (net k 0).wires = some q → q.2 = 0 := by
    intro e he
    have he' : e ∈ (net k 0).agents := by
      rcases List.mem_append.1 he with h | h
      · exact List.mem_of_mem_drop h
      · exact List.mem_of_mem_take h
    rcases List.mem_append.1 he' with h | h
    · refine ⟨inert k 0 0 h, fun q hq => ?_⟩
      obtain ⟨j, -, rfl⟩ := mem_lone.1 h
      rw [lone_wire (assoc_mem hq)]
    · exact absurd h List.not_mem_nil
  have st := Stays.inert_pass (xs := xsys) (X := net k 0) [] _ fun e he => (hin e he).1
  have sp := XThread.spent_inert_pass (xs := xsys) (X := net k 0) [] _ hin
  rw [List.append_nil] at st sp
  have hl : ((net k 0).agents.drop t ++ (net k 0).agents.take t).length = k := by
    have h := net_agents_length k 0
    rw [List.length_append, List.length_drop, List.length_take]
    omega
  rw [hl] at st
  rw [hl, net_agents_length, net_wires_length] at sp
  have e : 3 + (k + 2 * 0) + (2 * k + 2 * 0) = 3 * k + 3 := by omega
  rw [e] at sp
  exact ⟨3 * k, (st.after rfl).2.1, sp⟩

/-- **The bound on the time against the run.**  On the net with `k` agents
on free ports and nothing to reduce, with any number of threads and any
schedule, the bound of `XMach.time_bound` is `nt * (9 * k) * (4 * k + 1)`,
and by the time the program is at rest it has taken `nt * (k * (3 * k + 3))`
or more: every thread reads the whole memory once for each agent. -/
theorem time_tight (k nt : Nat) (hnt : 0 < nt) (σ : Nat → Nat) :
    (∀ i, (XMach.init (net k 0) nt).time xsys σ i ≤ nt * (9 * k) * (4 * k + 1)) ∧
      ∀ i, ((XMach.init (net k 0) nt).trace xsys σ i).1.resting = true →
        nt * (k * (3 * k + 3)) ≤ (XMach.init (net k 0) nt).time xsys σ i := by
  have hX : (net k 0).toNet.WF xsys.sys.ar := net_wf k 0
  constructor
  · intro i
    have h := XMach.time_bound (xs := xsys) hX (net_nodup k 0) hnt xsys_bounded (.refl _)
      (net_normal k) σ i
    rw [net_passBound, net_agents_length, net_wires_length] at h
    have e₁ : (nt + 0) * (9 * k + 16 * 0) + 0 * (0 + 0 + 1) = nt * (9 * k) := rfl
    have e₂ : 2 * (k + 2 * 0 + 0 * 0) + (2 * k + 2 * 0 + 0 * 0) + 0 + 0 + 1 = 4 * k + 1 := by
      omega
    rw [e₁, e₂] at h
    exact h
  · intro i hr
    have hl : (XMach.init (net k 0) nt).ths.length = nt := by
      show ((List.range nt).map _).length = nt
      rw [List.length_map, List.length_range]
    have h := XMach.time_ge_rest (xs := xsys) σ (reads k nt) (pass_spent k nt) i hr
    rw [hl] at h
    exact h

/-- The bound is at most twelve times that time. -/
theorem time_bound_le (k nt : Nat) :
    nt * (9 * k) * (4 * k + 1) ≤ 12 * (nt * (k * (3 * k + 3))) := by
  have h : 9 * k * (4 * k + 1) ≤ 12 * (k * (3 * k + 3)) := by
    have e₁ : 9 * k * (4 * k + 1) = k * (36 * k + 9) := by
      have e : 9 * (4 * k + 1) = 36 * k + 9 := by omega
      rw [Nat.mul_comm 9 k, Nat.mul_assoc, e]
    have e₂ : 12 * (k * (3 * k + 3)) = k * (36 * k + 36) := by
      have e : 12 * (3 * k + 3) = 36 * k + 36 := by omega
      rw [Nat.mul_left_comm, e]
    rw [e₁, e₂]
    exact Nat.mul_le_mul_left k (by omega)
  rw [Nat.mul_assoc, Nat.mul_left_comm 12 nt]
  exact Nat.mul_le_mul_left nt h

/-- On the net with no pair, the pass of a thread takes `3 * k` actions,
which cost seven for each agent on the indexed memory, or more. -/
theorem pass_least (k nt : Nat) : ∀ T, T ∈ (XMach.init (net k 0) nt).ths →
    ∃ j, (∀ j', j' < j → T.after xsys (net k 0) j' ≠ ⟨[], .idle⟩) ∧
      7 * k ≤ T.tally XThread.least xsys (net k 0) j := by
  intro T hT
  obtain ⟨t, -, rfl⟩ := List.mem_map.1 hT
  have hin : ∀ e, e ∈ (net k 0).agents.drop t ++ (net k 0).agents.take t →
      (net k 0).Inert e := by
    intro e he
    have he' : e ∈ (net k 0).agents := by
      rcases List.mem_append.1 he with h | h
      · exact List.mem_of_mem_drop h
      · exact List.mem_of_mem_take h
    rcases List.mem_append.1 he' with h | h
    · exact inert k 0 0 h
    · exact absurd h List.not_mem_nil
  have st := Stays.inert_pass (xs := xsys) (X := net k 0) [] _ hin
  have sp := XThread.least_inert_pass (xs := xsys) (X := net k 0) [] _ hin
  rw [List.append_nil] at st sp
  have hl : ((net k 0).agents.drop t ++ (net k 0).agents.take t).length = k := by
    have h := net_agents_length k 0
    rw [List.length_append, List.length_drop, List.length_take]
    omega
  rw [hl] at st sp
  exact ⟨3 * k, (st.after rfl).2.1, sp⟩

/-- **The bound on the indexed time against the run.**  On the net with
`k` agents on free ports and nothing to reduce, with any number of threads
and any schedule, the bound of `IMach.time_bound` is `nt * (63 * k) + k`,
and by the time the program is at rest it has taken `nt * (7 * k)` or
more: the time is linear in the net, where on lists it is quadratic. -/
theorem itime_tight (k nt : Nat) (hnt : 0 < nt) (σ : Nat → Nat) :
    (∀ i, (IMach.init (net k 0) nt).time xsys σ i ≤ nt * (63 * k) + k) ∧
      ∀ i, ((XMach.init (net k 0) nt).trace xsys σ i).1.resting = true →
        nt * (7 * k) ≤ (IMach.init (net k 0) nt).time xsys σ i := by
  have hX : (net k 0).toNet.WF xsys.sys.ar := net_wf k 0
  constructor
  · intro i
    have h := IMach.time_bound (xs := xsys) hX (net_nodup k 0) hnt xsys_bounded (.refl _)
      (net_normal k) σ i
    rw [net_passBound, net_agents_length] at h
    have e₁ : ((nt + 0) * (9 * k + 16 * 0) + 0 * (0 + 0 + 1)) * (0 + 0 + 7) =
        nt * (63 * k) := by
      show nt * (9 * k) * 7 = nt * (63 * k)
      have e : 9 * k * 7 = 63 * k := by omega
      rw [Nat.mul_assoc, e]
    have e₂ : (2 * 0 + 1) * (k + 2 * 0 + 0 * 0) = k := by
      show 1 * k = k
      exact Nat.one_mul k
    rw [e₁, e₂] at h
    exact h
  · intro i hr
    have hl : (XMach.init (net k 0) nt).ths.length = nt := by
      show ((List.range nt).map _).length = nt
      rw [List.length_map, List.length_range]
    have h := XMach.tally_ge_rest (xs := xsys) XThread.least σ (reads k nt)
      (pass_least k nt) i hr
    rw [hl] at h
    exact Nat.le_trans h (IMach.time_ge_least hX (net_nodup k 0) hnt σ i)

/-- The bound is at most ten times that time. -/
theorem itime_bound_le (k nt : Nat) (hnt : 0 < nt) :
    nt * (63 * k) + k ≤ 10 * (nt * (7 * k)) := by
  have hk : k ≤ nt * k := Nat.le_mul_of_pos_left k hnt
  have e₁ : nt * (63 * k) = 63 * (nt * k) := Nat.mul_left_comm nt 63 k
  have e₂ : nt * (7 * k) = 7 * (nt * k) := Nat.mul_left_comm nt 7 k
  rw [e₁, e₂]
  omega

/-- **What the index gains where there is nothing to reduce.**  On `k`
agents on free ports, with any number of threads under any schedule, by
the time the program is at rest lists have taken `(3 * k + 3) / 64` times
as long as the indexed memory, or more: the gain grows with the net. -/
theorem index_gain (k nt : Nat) (hnt : 0 < nt) (σ : Nat → Nat) (i : Nat)
    (hr : ((XMach.init (net k 0) nt).trace xsys σ i).1.resting = true) :
    (3 * k + 3) * (IMach.init (net k 0) nt).time xsys σ i ≤
      64 * (XMach.init (net k 0) nt).time xsys σ i := by
  have h₁ := (itime_tight k nt hnt σ).1 i
  have h₂ := (time_tight k nt hnt σ).2 i hr
  have hk : k ≤ nt * k := Nat.le_mul_of_pos_left k hnt
  have h₃ : (IMach.init (net k 0) nt).time xsys σ i ≤ 64 * (nt * k) := by
    have e : nt * (63 * k) = 63 * (nt * k) := Nat.mul_left_comm nt 63 k
    omega
  have h₄ := Nat.mul_le_mul_left (3 * k + 3) h₃
  have e : (3 * k + 3) * (64 * (nt * k)) = 64 * (nt * (k * (3 * k + 3))) := by
    rw [Nat.mul_left_comm (3 * k + 3) 64, Nat.mul_left_comm (3 * k + 3) nt,
      Nat.mul_comm (3 * k + 3) k]
  rw [e] at h₄
  exact Nat.le_trans h₄ (Nat.mul_le_mul_left 64 h₂)

end Eps

/-! ## Example: a run in which the window multiplies every pass

One symbol `c` with one auxiliary port, and one rule: two `c` facing each
other leave a segment between their auxiliary ports.  The net
`Chain.net k n` has `k` agents that lead nowhere, listed first, and `n`
pairs in a chain.  Only the first pair is active; when a pair fires, the
segment it leaves joins the principal ports of the next pair, through the
auxiliary ports of the pair that is gone.  So the pairs are found one at a
time, each after a pass over the `k` agents. -/

/-- A list made of one piece for each of `r` numbers from `s` on, the first
one first. -/
def asc {A : Type} (f : Nat → List A) : Nat → Nat → List A
  | _, 0 => []
  | s, r + 1 => f s ++ asc f (s + 1) r

theorem mem_asc {A : Type} {f : Nat → List A} {x : A} :
    ∀ {r s : Nat}, x ∈ asc f s r ↔ ∃ j, s ≤ j ∧ j < s + r ∧ x ∈ f j
  | 0, s => ⟨fun h => absurd h List.not_mem_nil, fun ⟨j, h₁, h₂, _⟩ => by omega⟩
  | r + 1, s => by
    show x ∈ f s ++ asc f (s + 1) r ↔ _
    rw [List.mem_append, mem_asc (r := r)]
    constructor
    · rintro (h | ⟨j, h₁, h₂, h⟩)
      · exact ⟨s, Nat.le_refl s, by omega, h⟩
      · exact ⟨j, by omega, by omega, h⟩
    · rintro ⟨j, h₁, h₂, h⟩
      rcases Nat.lt_or_eq_of_le h₁ with h' | h'
      · exact .inr ⟨j, by omega, by omega, h⟩
      · rw [← h'] at h
        exact .inl h

theorem length_asc {A : Type} {f : Nat → List A} {c : Nat} (h : ∀ j, (f j).length = c) :
    ∀ r s, (asc f s r).length = c * r
  | 0, _ => rfl
  | r + 1, s => by
    show (f s ++ asc f (s + 1) r).length = c * (r + 1)
    rw [List.length_append, h, length_asc h r (s + 1), Nat.mul_add, Nat.mul_one, Nat.add_comm]

theorem map_asc {A B : Type} (g : A → B) (f : Nat → List A) :
    ∀ r s, (asc f s r).map g = asc (fun j => (f j).map g) s r
  | 0, _ => rfl
  | r + 1, s => by
    show (f s ++ asc f (s + 1) r).map g = (f s).map g ++ asc (fun j => (f j).map g) (s + 1) r
    rw [List.map_append, map_asc g f r (s + 1)]

theorem nodup_asc {A : Type} {f : Nat → List A} (h₁ : ∀ j, (f j).Nodup)
    (h₂ : ∀ i j x, x ∈ f i → x ∈ f j → i = j) : ∀ r s, (asc f s r).Nodup
  | 0, _ => List.nodup_nil
  | r + 1, s => by
    show (f s ++ asc f (s + 1) r).Nodup
    refine List.nodup_append.2 ⟨h₁ s, nodup_asc h₁ h₂ r (s + 1), fun a ha b hb e => ?_⟩
    obtain ⟨j, hj, -, hb'⟩ := mem_asc.1 hb
    rw [← e] at hb'
    have := h₂ s j a ha hb'
    omega

/-- A list made of one piece for each of `r` numbers from `s` on, the last
one first. -/
def desc {A : Type} (f : Nat → List A) : Nat → Nat → List A
  | _, 0 => []
  | s, r + 1 => desc f (s + 1) r ++ f s

/-- The pieces of `asc`, in another order. -/
theorem desc_perm {A : Type} (f : Nat → List A) : ∀ r s, (desc f s r).Perm (asc f s r)
  | 0, _ => List.Perm.refl _
  | r + 1, s => by
    show (desc f (s + 1) r ++ f s).Perm (f s ++ asc f (s + 1) r)
    exact List.perm_append_comm.trans (List.Perm.append_left (f s) (desc_perm f r (s + 1)))

/-- A single symbol. -/
inductive Chain
  | c
  deriving DecidableEq, Repr

namespace Chain

/-- It has one auxiliary port. -/
def ar : Chain → Nat := fun _ => 1

/-- `c ⋈ c`: a segment between the two auxiliary ports. -/
def data : SysData Chain :=
  ⟨ar, [((c, c), RuleData.ofWires [] [(.ifc false 0, .ifc true 0)])]⟩

/-- The system, by evaluation of the check. -/
def xsys : XSys Chain := data.toXSys (by decide)

/-- Its rule writes no agent and two segments, one in each direction. -/
theorem xsys_bounded : xsys.Bounded 0 2 := by
  intro α β R h
  cases α
  cases β
  rw [← Option.some.inj h]
  decide

/-- The right-hand side of the rule. -/
def rhs : XRhs Chain := (RuleData.ofWires [] [(.ifc false 0, .ifc true 0)]).toX

theorem rule_cc : xsys.rule c c = some rhs := rfl

theorem rhs_agents (a b : Id) : rhs.newAgents a b = [] := rfl

theorem rhs_links (a b : Id) :
    rhs.newLinks xsys.sys.ar a b c c = [((a, 1), (b, 1)), ((b, 1), (a, 1))] := rfl

/-- `k` agents, each to be wired to two free ports of its own. -/
def lone (k : Nat) : List (Id × Chain) := gen (fun j => [([j, 0], c)]) k

def loneFree (k : Nat) : List Port := gen (fun j => [([j, 1], 0), ([j, 2], 0)]) k

def loneWires (k : Nat) : List (Port × Port) :=
  gen (fun j => [(([j, 0], 0), ([j, 1], 0)), (([j, 1], 0), ([j, 0], 0)),
    (([j, 0], 1), ([j, 2], 0)), (([j, 2], 0), ([j, 0], 1))]) k

/-- The pairs from number `s` on, `r` of them. -/
def pairsFrom (s r : Nat) : List (Id × Chain) := asc (fun j => [([j, 3], c), ([j, 4], c)]) s r

/-- The segment that makes the first pair active. -/
def headWires : List (Port × Port) := [(([0, 3], 0), ([0, 4], 0)), (([0, 4], 0), ([0, 3], 0))]

/-- From the auxiliary port of each agent of a pair, a segment to the
principal port of the agent of the next pair on the same side; after the
last pair, to a free port. -/
def chainWires (n : Nat) : List (Port × Port) :=
  gen (fun j => [(([j, 3], 1), ([j + 1, 3], 0)), (([j + 1, 3], 0), ([j, 3], 1)),
    (([j, 4], 1), ([j + 1, 4], 0)), (([j + 1, 4], 0), ([j, 4], 1))]) n

/-- The segments written by the first `w` firings, the last one first. -/
def written (w : Nat) : List (Port × Port) :=
  gen (fun j => [(([j, 4], 1), ([j, 3], 1)), (([j, 3], 1), ([j, 4], 1))]) w

def wires (k n w : Nat) : List (Port × Port) :=
  written w ++ (loneWires k ++ (headWires ++ chainWires n))

/-- A memory of a run on `k` agents that lead nowhere and `n` pairs: `w`
pairs have had their segment written, and the pairs from `s` on, `r` of
them, are still in memory. -/
def st (k n w s r : Nat) : XNet Chain :=
  ⟨lone k ++ pairsFrom s r, loneFree k ++ [([n, 3], 0), ([n, 4], 0)], wires k n w⟩

/-- `k` agents that lead nowhere, listed first, and a chain of `n` pairs. -/
def net (k n : Nat) : XNet Chain := st k n 0 0 n

theorem mem_lone {k : Nat} {e : Id × Chain} : e ∈ lone k ↔ ∃ j, j < k ∧ e = ([j, 0], c) := by
  unfold lone
  rw [mem_gen]
  exact exists_congr fun j => and_congr Iff.rfl List.mem_singleton

theorem lone_length (k : Nat) : (lone k).length = k := by
  have h := length_gen (f := fun j => [(([j, 0] : Id), c)]) (c := 1) (fun _ => rfl) k
  rw [Nat.one_mul] at h
  exact h

theorem mem_pairsFrom {s r : Nat} {e : Id × Chain} :
    e ∈ pairsFrom s r ↔ ∃ j, s ≤ j ∧ j < s + r ∧ (e = ([j, 3], c) ∨ e = ([j, 4], c)) := by
  unfold pairsFrom
  rw [mem_asc]
  exact exists_congr fun j => and_congr Iff.rfl (and_congr Iff.rfl
    (by rw [List.mem_cons, List.mem_singleton]))

theorem pairsFrom_length (s r : Nat) : (pairsFrom s r).length = 2 * r :=
  length_asc (f := fun j => [(([j, 3] : Id), c), ([j, 4], c)]) (fun _ => rfl) r s

theorem mem_wires {k n w : Nat} {p q : Port} :
    (p, q) ∈ wires k n w ↔
      (∃ j, j < w ∧ ((p, q) = (([j, 4], 1), ([j, 3], 1)) ∨
        (p, q) = (([j, 3], 1), ([j, 4], 1)))) ∨
      (∃ j, j < k ∧ ((p, q) = (([j, 0], 0), ([j, 1], 0)) ∨
        (p, q) = (([j, 1], 0), ([j, 0], 0)) ∨ (p, q) = (([j, 0], 1), ([j, 2], 0)) ∨
        (p, q) = (([j, 2], 0), ([j, 0], 1)))) ∨
      (p, q) = (([0, 3], 0), ([0, 4], 0)) ∨ (p, q) = (([0, 4], 0), ([0, 3], 0)) ∨
      ∃ j, j < n ∧ ((p, q) = (([j, 3], 1), ([j + 1, 3], 0)) ∨
        (p, q) = (([j + 1, 3], 0), ([j, 3], 1)) ∨ (p, q) = (([j, 4], 1), ([j + 1, 4], 0)) ∨
        (p, q) = (([j + 1, 4], 0), ([j, 4], 1))) := by
  unfold wires written loneWires headWires chainWires
  simp only [List.mem_append, mem_gen, List.mem_cons, List.not_mem_nil, or_false, or_assoc]

theorem assoc_some {A : Type} [DecidableEq A] {i : A} {l : List (A × Chain)}
    (h : (i, c) ∈ l) : assoc i l = some c :=
  assoc_eq_of_unique h fun q' _ => by cases q'; rfl

/-! Where the segments lead. -/

theorem wire_lone {k n w j : Nat} {q' : Port}
    (h : ((([j, 0] : Id), 0), q') ∈ wires k n w) : q' = ([j, 1], 0) := by
  rcases mem_wires.1 h with ⟨j', hj', h | h⟩ | ⟨j', hj', h | h | h | h⟩ | h | h |
      ⟨j', hj', h | h | h | h⟩ <;>
    first
      | (simp at h; obtain ⟨rfl, rfl⟩ := h; rfl)
      | simp at h

theorem wire_loneFree {k n w j : Nat} {q' : Port}
    (h : ((([j, 1] : Id), 0), q') ∈ wires k n w) : q' = ([j, 0], 0) := by
  rcases mem_wires.1 h with ⟨j', hj', h | h⟩ | ⟨j', hj', h | h | h | h⟩ | h | h |
      ⟨j', hj', h | h | h | h⟩ <;>
    first
      | (simp at h; obtain ⟨rfl, rfl⟩ := h; rfl)
      | simp at h

theorem wire_head {k n w : Nat} {q' : Port}
    (h : ((([0, 3] : Id), 0), q') ∈ wires k n w) : q' = ([0, 4], 0) := by
  rcases mem_wires.1 h with ⟨j', hj', h | h⟩ | ⟨j', hj', h | h | h | h⟩ | h | h |
      ⟨j', hj', h | h | h | h⟩ <;>
    first
      | (simp at h; rw [h])
      | simp at h

theorem wire_x {k n w j : Nat} {q' : Port}
    (h : ((([j + 1, 3] : Id), 0), q') ∈ wires k n w) : q' = ([j, 3], 1) := by
  rcases mem_wires.1 h with ⟨j', hj', h | h⟩ | ⟨j', hj', h | h | h | h⟩ | h | h |
      ⟨j', hj', h | h | h | h⟩ <;>
    first
      | (simp at h; obtain ⟨rfl, rfl⟩ := h; rfl)
      | simp at h

theorem wire_y {k n w j : Nat} {q' : Port}
    (h : ((([j + 1, 4] : Id), 0), q') ∈ wires k n w) : q' = ([j, 4], 1) := by
  rcases mem_wires.1 h with ⟨j', hj', h | h⟩ | ⟨j', hj', h | h | h | h⟩ | h | h |
      ⟨j', hj', h | h | h | h⟩ <;>
    first
      | (simp at h; obtain ⟨rfl, rfl⟩ := h; rfl)
      | simp at h

/-- From the auxiliary port of an agent on the first side: back to the next
pair, or, once the pair has fired, across to the other side. -/
theorem wire_x_aux {k n w j : Nat} {q' : Port}
    (h : ((([j, 3] : Id), 1), q') ∈ wires k n w) :
    q' = ([j + 1, 3], 0) ∨ (j < w ∧ q' = ([j, 4], 1)) := by
  rcases mem_wires.1 h with ⟨j', hj', h | h⟩ | ⟨j', hj', h | h | h | h⟩ | h | h |
      ⟨j', hj', h | h | h | h⟩ <;>
    first
      | (simp at h; obtain ⟨rfl, rfl⟩ := h; exact .inl rfl)
      | (simp at h; obtain ⟨rfl, rfl⟩ := h; exact .inr ⟨hj', rfl⟩)
      | simp at h

theorem wire_y_aux {k n w j : Nat} {q' : Port}
    (h : ((([j, 4] : Id), 1), q') ∈ wires k n w) :
    q' = ([j + 1, 4], 0) ∨ (j < w ∧ q' = ([j, 3], 1)) := by
  rcases mem_wires.1 h with ⟨j', hj', h | h⟩ | ⟨j', hj', h | h | h | h⟩ | h | h |
      ⟨j', hj', h | h | h | h⟩ <;>
    first
      | (simp at h; obtain ⟨rfl, rfl⟩ := h; exact .inl rfl)
      | (simp at h; obtain ⟨rfl, rfl⟩ := h; exact .inr ⟨hj', rfl⟩)
      | simp at h

/-! Which agents are in memory. -/

theorem agent_lone {k n w s r j : Nat} (hj : j < k) :
    assoc [j, 0] (st k n w s r).agents = some c :=
  assoc_some (List.mem_append_left _ (mem_lone.2 ⟨j, hj, rfl⟩))

theorem agent_x {k n w s r j : Nat} (h₁ : s ≤ j) (h₂ : j < s + r) :
    assoc [j, 3] (st k n w s r).agents = some c :=
  assoc_some (List.mem_append_right _ (mem_pairsFrom.2 ⟨j, h₁, h₂, .inl rfl⟩))

theorem agent_y {k n w s r j : Nat} (h₁ : s ≤ j) (h₂ : j < s + r) :
    assoc [j, 4] (st k n w s r).agents = some c :=
  assoc_some (List.mem_append_right _ (mem_pairsFrom.2 ⟨j, h₁, h₂, .inr rfl⟩))

/-- A name with last number `1` is not the name of an agent. -/
theorem agent_none {k n w s r j : Nat} : assoc [j, 1] (st k n w s r).agents = none := by
  cases h : assoc [j, 1] (st k n w s r).agents with
  | none => rfl
  | some v =>
    rcases List.mem_append.1 (assoc_mem h) with h' | h'
    · obtain ⟨j', -, e⟩ := mem_lone.1 h'
      simp at e
    · obtain ⟨j', -, -, e | e⟩ := mem_pairsFrom.1 h'
      · simp at e
      · simp at e

/-- A pair below the first one left is gone. -/
theorem agent_gone {k n w s r j : Nat} (hj : j < s) (x : Nat) (hx : 3 ≤ x) (v : Chain) :
    ¬ assoc [j, x] (st k n w s r).agents = some v := by
  intro h
  rcases List.mem_append.1 (assoc_mem h) with h' | h'
  · obtain ⟨j', -, e⟩ := mem_lone.1 h'
    simp at e
    omega
  · obtain ⟨j', h₁, -, e | e⟩ := mem_pairsFrom.1 h'
    · simp at e
      omega
    · simp at e
      omega

/-! Which agents lead nowhere. -/

theorem inert_lone {k n w s r j : Nat} (hj : j < k) : (st k n w s r).Inert ([j, 0], c) := by
  refine ⟨agent_lone hj, ([j, 1], 0), ?_, ?_, nextSeg_none fun q hq => wire_loneFree hq⟩
  · refine assoc_eq_of_unique ?_ fun q' hq' => wire_lone hq'
    exact mem_wires.2 (.inr (.inl ⟨j, hj, .inl rfl⟩))
  · show (if (0 : Nat) = 0 then assoc [j, 1] (st k n w s r).agents else none) = none
    rw [ite_pos' rfl]
    exact agent_none

/-- An agent of a pair is given up on as long as the pair before it has not
had its segment written. -/
theorem inert_x {k n w s r j : Nat} (hw : w ≤ j) (h₁ : s ≤ j + 1) (h₂ : j + 1 < s + r)
    (hn : j < n) : (st k n w s r).Inert ([j + 1, 3], c) := by
  refine ⟨agent_x h₁ h₂, ([j, 3], 1), ?_, ite_neg' (by simp), nextSeg_none fun q hq => ?_⟩
  · refine assoc_eq_of_unique ?_ fun q' hq' => wire_x hq'
    exact mem_wires.2 (.inr (.inr (.inr (.inr ⟨j, hn, .inr (.inl rfl)⟩))))
  · rcases wire_x_aux hq with h | ⟨h, -⟩
    · exact h
    · omega

theorem inert_y {k n w s r j : Nat} (hw : w ≤ j) (h₁ : s ≤ j + 1) (h₂ : j + 1 < s + r)
    (hn : j < n) : (st k n w s r).Inert ([j + 1, 4], c) := by
  refine ⟨agent_y h₁ h₂, ([j, 4], 1), ?_, ite_neg' (by simp), nextSeg_none fun q hq => ?_⟩
  · refine assoc_eq_of_unique ?_ fun q' hq' => wire_y hq'
    exact mem_wires.2 (.inr (.inr (.inr (.inr ⟨j, hn, .inr (.inr (.inr rfl))⟩))))
  · rcases wire_y_aux hq with h | ⟨h, -⟩
    · exact h
    · omega

/-- A thread passes the agents that lead nowhere in three actions each,
without writing. -/
theorem pass (k n w s r : Nat) (rest : List (Id × Chain)) :
    Stays xsys (st k n w s r) ⟨lone k ++ rest, .idle⟩ ⟨rest, .idle⟩ (3 * k) := by
  have h := Stays.inert_pass (xs := xsys) (X := st k n w s r) rest (lone k) fun e he => by
    obtain ⟨j, hj, rfl⟩ := mem_lone.1 he
    exact inert_lone hj
  rw [lone_length] at h
  exact h

/-! The actions of a thread on a pair. -/

/-- Taking the two agents of the first pair left leaves the rest. -/
theorem take_pair (k n w s r : Nat) :
    ((st k n w s (r + 1)).takeAgent [s, 3]).takeAgent [s, 4] = st k n w (s + 1) r := by
  have hl : ∀ e, e ∈ lone k → e.1 ≠ [s, 3] ∧ e.1 ≠ [s, 4] := by
    intro e he
    obtain ⟨j, -, rfl⟩ := mem_lone.1 he
    simp
  have hp : ∀ e, e ∈ pairsFrom (s + 1) r → e.1 ≠ [s, 3] ∧ e.1 ≠ [s, 4] := by
    intro e he
    obtain ⟨j, hj, -, rfl | rfl⟩ := mem_pairsFrom.1 he
    · constructor
      · intro h
        simp at h
        omega
      · intro h
        simp at h
    · constructor
      · intro h
        simp at h
      · intro h
        simp at h
        omega
  have hne : ([s, 4] : Id) ≠ [s, 3] := by simp
  have e1 : (lone k ++ pairsFrom s (r + 1)).filter (fun e => decide (e.1 ≠ [s, 3])) =
      lone k ++ (([s, 4], c) :: pairsFrom (s + 1) r) := by
    show (lone k ++ (([s, 3], c) :: ([s, 4], c) :: pairsFrom (s + 1) r)).filter _ = _
    rw [List.filter_append, filter_ne fun e he => (hl e he).1, filter_ne_cons_same,
      filter_ne_cons_other hne, filter_ne fun e he => (hp e he).1]
  have e2 : (lone k ++ (([s, 4], c) :: pairsFrom (s + 1) r)).filter
      (fun e => decide (e.1 ≠ [s, 4])) = lone k ++ pairsFrom (s + 1) r := by
    rw [List.filter_append, filter_ne fun e he => (hl e he).2, filter_ne_cons_same,
      filter_ne fun e he => (hp e he).2]
  show (⟨((lone k ++ pairsFrom s (r + 1)).filter fun e => decide (e.1 ≠ [s, 3])).filter
      fun e => decide (e.1 ≠ [s, 4]), loneFree k ++ [([n, 3], 0), ([n, 4], 0)],
      wires k n w⟩ : XNet Chain) =
    ⟨lone k ++ pairsFrom (s + 1) r, loneFree k ++ [([n, 3], 0), ([n, 4], 0)], wires k n w⟩
  rw [e1, e2]

/-- A thread that has found a pair takes its two agents, in two actions,
and has two segments to write. -/
theorem take (k n w s r : Nat) (rest : List (Id × Chain)) :
    Works xsys (st k n w s (r + 1)) ⟨rest, .ready [s, 3] [s, 4] c c⟩ (st k n w (s + 1) r)
      ⟨rest, .write [] [(([s, 3], 1), ([s, 4], 1)), (([s, 4], 1), ([s, 3], 1))]⟩ 1 2 := by
  have hne : ([s, 3] : Id) ≠ [s, 4] := by simp
  have ha : assoc [s, 3] (st k n w s (r + 1)).agents = some c :=
    agent_x (Nat.le_refl s) (by omega)
  have hb : (([s, 4] : Id), c) ∈ ((st k n w s (r + 1)).takeAgent [s, 3]).agents :=
    XNet.mem_takeAgent.2 ⟨List.mem_append_right _
      (mem_pairsFrom.2 ⟨s, Nat.le_refl s, by omega, .inr rfl⟩), Ne.symm hne⟩
  have s₁ : XMach.act xsys (st k n w s (r + 1)) ⟨rest, .ready [s, 3] [s, 4] c c⟩ =
      ((st k n w s (r + 1)).takeAgent [s, 3], ⟨rest, .half [s, 3] [s, 4] c c⟩, 0) :=
    XMach.act_ready ha
  have s₂ := XMach.act_half (xs := xsys) (X := (st k n w s (r + 1)).takeAgent [s, 3])
    (todo := rest) (a := [s, 3]) (b := [s, 4]) (α := c) (β := c) (R := rhs)
    (by rw [ite_pos' ⟨assoc_some hb, hne⟩]; exact rule_cc)
  rw [rhs_agents, rhs_links, take_pair] at s₂
  exact .step (c₁ := 0) (c := 1) (k := 1) (fun h => by cases h) s₁
    (.step (c₁ := 1) (c := 0) (k := 0) (fun h => by cases h) s₂ (.refl _ _))

/-- It writes them and takes a fresh list of agents, in three actions. -/
theorem writes (k n w r : Nat) (rest : List (Id × Chain)) :
    Works xsys (st k n w (w + 1) r)
      ⟨rest, .write [] [(([w, 3], 1), ([w, 4], 1)), (([w, 4], 1), ([w, 3], 1))]⟩
      (st k n (w + 1) (w + 1) r) ⟨(st k n (w + 1) (w + 1) r).agents, .idle⟩ 0 3 := by
  have s₁ : XMach.act xsys (st k n w (w + 1) r)
      ⟨rest, .write [] [(([w, 3], 1), ([w, 4], 1)), (([w, 4], 1), ([w, 3], 1))]⟩ =
      ((st k n w (w + 1) r).putLink ([w, 3], 1) ([w, 4], 1),
        ⟨rest, .write [] [(([w, 4], 1), ([w, 3], 1))]⟩, 0) := rfl
  have s₂ : XMach.act xsys ((st k n w (w + 1) r).putLink ([w, 3], 1) ([w, 4], 1))
      ⟨rest, .write [] [(([w, 4], 1), ([w, 3], 1))]⟩ =
      (st k n (w + 1) (w + 1) r, ⟨rest, .write [] []⟩, 0) := rfl
  have s₃ : XMach.act xsys (st k n (w + 1) (w + 1) r) ⟨rest, .write [] []⟩ =
      (st k n (w + 1) (w + 1) r, ⟨(st k n (w + 1) (w + 1) r).agents, .idle⟩, 0) := rfl
  exact .step (c₁ := 0) (c := 0) (k := 2) (fun h => by cases h) s₁
    (.step (c₁ := 0) (c := 0) (k := 1) (fun h => by cases h) s₂
      (.step (c₁ := 0) (c := 0) (k := 0) (fun h => by cases h) s₃ (.refl _ _)))

/-- The first pair: the two agents face each other, and a thread at the
first of them has both after five actions. -/
theorem fire0 (k n r : Nat) :
    Works xsys (st k n 0 0 (r + 1)) ⟨pairsFrom 0 (r + 1), .idle⟩ (st k n 0 1 r)
      ⟨([0, 4], c) :: pairsFrom 1 r,
        .write [] [(([0, 3], 1), ([0, 4], 1)), (([0, 4], 1), ([0, 3], 1))]⟩ 1 5 := by
  have ha : assoc [0, 3] (st k n 0 0 (r + 1)).agents = some c :=
    agent_x (Nat.le_refl 0) (by omega)
  have hb : assoc [0, 4] (st k n 0 0 (r + 1)).agents = some c :=
    agent_y (Nat.le_refl 0) (by omega)
  have hwire : assoc (([0, 3] : Id), 0) (st k n 0 0 (r + 1)).wires = some ([0, 4], 0) :=
    assoc_eq_of_unique (mem_wires.2 (.inr (.inr (.inl rfl)))) fun q' hq' => wire_head hq'
  have s₁ : Stays xsys (st k n 0 0 (r + 1))
      ⟨([0, 3], c) :: (([0, 4], c) :: pairsFrom 1 r), .idle⟩
      ⟨([0, 4], c) :: pairsFrom 1 r, .ready [0, 3] [0, 4] c c⟩ 3 :=
    .step (k := 2) (fun h => by cases h) (XMach.act_idle_pos ha)
      (.step (k := 1) (fun h => by cases h) (XMach.act_look hwire)
        (.step (k := 0) (fun h => by cases h)
          (XMach.act_seek_found (c := ([0, 4], 0))
            (by
              show (if (0 : Nat) = 0 then assoc [0, 4] (st k n 0 0 (r + 1)).agents
                else none) = some c
              rw [ite_pos' rfl]
              exact hb)
            ⟨by simp, by rw [rule_cc]; rfl⟩) (.refl _)))
  exact s₁.works.trans (take k n 0 0 r _)

/-- A later pair: the wire from the first agent runs through the auxiliary
ports of the pair before it and the segment that pair left, and a thread
has both agents after seven actions. -/
theorem fireS (k n j r : Nat) (hj : j < n) :
    Works xsys (st k n (j + 1) (j + 1) (r + 1)) ⟨pairsFrom (j + 1) (r + 1), .idle⟩
      (st k n (j + 1) (j + 2) r)
      ⟨([j + 1, 4], c) :: pairsFrom (j + 2) r,
        .write [] [(([j + 1, 3], 1), ([j + 1, 4], 1)), (([j + 1, 4], 1), ([j + 1, 3], 1))]⟩
      1 7 := by
  have ha : assoc [j + 1, 3] (st k n (j + 1) (j + 1) (r + 1)).agents = some c :=
    agent_x (Nat.le_refl _) (by omega)
  have hb : assoc [j + 1, 4] (st k n (j + 1) (j + 1) (r + 1)).agents = some c :=
    agent_y (Nat.le_refl _) (by omega)
  have hwire : assoc (([j + 1, 3] : Id), 0) (st k n (j + 1) (j + 1) (r + 1)).wires =
      some ([j, 3], 1) :=
    assoc_eq_of_unique (mem_wires.2 (.inr (.inr (.inr (.inr ⟨j, hj, .inr (.inl rfl)⟩)))))
      fun q' hq' => wire_x hq'
  have hn₁ : nextSeg (st k n (j + 1) (j + 1) (r + 1)).wires ([j, 3], 1) ([j + 1, 3], 0) =
      some ([j, 4], 1) :=
    nextSeg_some (mem_wires.2 (.inl ⟨j, Nat.lt_succ_self j, .inr rfl⟩)) (by simp)
      fun q hq hne => by
        rcases wire_x_aux hq with h | ⟨-, h⟩
        · exact absurd h hne
        · exact h
  have hn₂ : nextSeg (st k n (j + 1) (j + 1) (r + 1)).wires ([j, 4], 1) ([j, 3], 1) =
      some ([j + 1, 4], 0) :=
    nextSeg_some
      (mem_wires.2 (.inr (.inr (.inr (.inr ⟨j, hj, .inr (.inr (.inl rfl))⟩))))) (by simp)
      fun q hq hne => by
        rcases wire_y_aux hq with h | ⟨-, h⟩
        · exact h
        · exact absurd h hne
  have s₁ : Stays xsys (st k n (j + 1) (j + 1) (r + 1))
      ⟨([j + 1, 3], c) :: (([j + 1, 4], c) :: pairsFrom (j + 2) r), .idle⟩
      ⟨([j + 1, 4], c) :: pairsFrom (j + 2) r, .ready [j + 1, 3] [j + 1, 4] c c⟩ 5 :=
    .step (k := 4) (fun h => by cases h) (XMach.act_idle_pos ha)
      (.step (k := 3) (fun h => by cases h) (XMach.act_look hwire)
        (.step (k := 2) (fun h => by cases h)
          (XMach.act_seek_next (c := ([j, 3], 1)) (ite_neg' (by simp)) hn₁)
          (.step (k := 1) (fun h => by cases h)
            (XMach.act_seek_next (c := ([j, 4], 1)) (ite_neg' (by simp)) hn₂)
            (.step (k := 0) (fun h => by cases h)
              (XMach.act_seek_found (c := ([j + 1, 4], 0))
                (by
                  show (if (0 : Nat) = 0 then
                    assoc [j + 1, 4] (st k n (j + 1) (j + 1) (r + 1)).agents else none) = some c
                  rw [ite_pos' rfl]
                  exact hb)
                ⟨by simp, by rw [rule_cc]; rfl⟩) (.refl _)))))
  exact s₁.works.trans (take k n (j + 1) (j + 1) r _)

/-! The run of one thread. -/

/-- From the second pair on: a pass over the agents that lead nowhere and
ten actions for each pair, and one more pass at the end. -/
theorem runsS (k n : Nat) : ∀ (r j : Nat), j + 1 + r ≤ n →
    Works xsys (st k n (j + 1) (j + 1) r) ⟨(st k n (j + 1) (j + 1) r).agents, .idle⟩
      (st k n (j + 1 + r) (j + 1 + r) 0) ⟨[], .idle⟩ r ((r + 1) * (3 * k) + 10 * r)
  | 0, j, _ => by
    have w := (pass k n (j + 1) (j + 1) 0 []).works
    have e : (0 + 1) * (3 * k) + 10 * 0 = 3 * k := by omega
    rw [e]
    exact w
  | r + 1, j, h => by
    have w₁ := (pass k n (j + 1) (j + 1) (r + 1) (pairsFrom (j + 1) (r + 1))).works
    have w₂ := fireS k n j r (by omega)
    have w₃ := writes k n (j + 1) r (([j + 1, 4], c) :: pairsFrom (j + 2) r)
    have w₄ := runsS k n r (j + 1) (by omega)
    have w := ((w₁.trans w₂).trans w₃).trans w₄
    have e₀ : j + 1 + 1 + r = j + 1 + (r + 1) := by omega
    have e₁ : 0 + 1 + 0 + r = r + 1 := by omega
    have e₂ : 3 * k + 7 + 3 + ((r + 1) * (3 * k) + 10 * r) =
        (r + 1 + 1) * (3 * k) + 10 * (r + 1) := by
      rw [Nat.add_mul (r + 1) 1 (3 * k), Nat.one_mul]
      omega
    rw [e₀, e₁, e₂] at w
    exact w

/-- A thread that has taken the first pair and has its segments to write
goes on alone to the end. -/
theorem paused (k n r : Nat) (h : r + 1 ≤ n) (rest : List (Id × Chain)) :
    Works xsys (st k n 0 1 r)
      ⟨rest, .write [] [(([0, 3], 1), ([0, 4], 1)), (([0, 4], 1), ([0, 3], 1))]⟩
      (st k n (r + 1) (r + 1) 0) ⟨[], .idle⟩ r (3 + ((r + 1) * (3 * k) + 10 * r)) := by
  have w := (writes k n 0 r rest).trans (runsS k n r 0 (by omega))
  have e₀ : 0 + 1 + r = r + 1 := by omega
  have e₁ : 0 + r = r := by omega
  rw [e₀, e₁] at w
  exact w

/-- **The run of one thread on the chain, counted.** -/
theorem runs0 (k n r : Nat) (h : r + 1 ≤ n) :
    Works xsys (st k n 0 0 (r + 1)) ⟨(st k n 0 0 (r + 1)).agents, .idle⟩
      (st k n (r + 1) (r + 1) 0) ⟨[], .idle⟩ (r + 1)
      (3 * k + 8 + ((r + 1) * (3 * k) + 10 * r)) := by
  have w₁ := (pass k n 0 0 (r + 1) (pairsFrom 0 (r + 1))).works
  have w := (w₁.trans (fire0 k n r)).trans (paused k n r h _)
  have e₁ : 0 + 1 + r = r + 1 := by omega
  have e₂ : 3 * k + 5 + (3 + ((r + 1) * (3 * k) + 10 * r)) =
      3 * k + 8 + ((r + 1) * (3 * k) + 10 * r) := by omega
  rw [e₁, e₂] at w
  exact w

/-- With the first pair taken and nothing written yet, a second thread
finds nothing: the agents of the first pair are gone, and every other agent
leads nowhere. -/
theorem idle_pass (k n r : Nat) (h : r + 1 ≤ n) :
    Stays xsys (st (k + 1) n 0 1 r)
      ⟨lone k ++ (pairsFrom 0 (r + 1) ++ [([k, 0], c)]), .idle⟩ ⟨[], .idle⟩
      (3 * k + 2 + 6 * r + 3) := by
  have s₁ := Stays.inert_pass (xs := xsys) (X := st (k + 1) n 0 1 r)
    (pairsFrom 0 (r + 1) ++ [([k, 0], c)]) (lone k) fun e he => by
      obtain ⟨j, hj, rfl⟩ := mem_lone.1 he
      exact inert_lone (by omega)
  rw [lone_length] at s₁
  have s₂ : Stays xsys (st (k + 1) n 0 1 r)
      ⟨([0, 3], c) :: (([0, 4], c) :: (pairsFrom 1 r ++ [([k, 0], c)])), .idle⟩
      ⟨([0, 4], c) :: (pairsFrom 1 r ++ [([k, 0], c)]), .idle⟩ 1 :=
    Stays.absent _ (agent_gone (by omega) 3 (by omega) c)
  have s₃ : Stays xsys (st (k + 1) n 0 1 r)
      ⟨([0, 4], c) :: (pairsFrom 1 r ++ [([k, 0], c)]), .idle⟩
      ⟨pairsFrom 1 r ++ [([k, 0], c)], .idle⟩ 1 :=
    Stays.absent _ (agent_gone (by omega) 4 (by omega) c)
  have s₄ := Stays.inert_pass (xs := xsys) (X := st (k + 1) n 0 1 r) [([k, 0], c)]
    (pairsFrom 1 r) fun e he => by
      obtain ⟨j, h₁, h₂, he' | he'⟩ := mem_pairsFrom.1 he
      · obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
        rw [he']
        exact inert_x (by omega) (by omega) (by omega) (by omega)
      · obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
        rw [he']
        exact inert_y (by omega) (by omega) (by omega) (by omega)
  rw [pairsFrom_length] at s₄
  have s₅ : Stays xsys (st (k + 1) n 0 1 r) ⟨[([k, 0], c)], .idle⟩ ⟨[], .idle⟩ 3 :=
    Stays.inert _ (inert_lone (by omega))
  have w := (((s₁.trans s₂).trans s₃).trans s₄).trans s₅
  have e : 3 * k + 1 + 1 + 3 * (2 * r) + 3 = 3 * k + 2 + 6 * r + 3 := by omega
  rw [e] at w
  exact w

/-- **A starved thread makes every claim.**  On `k + 1` agents that lead
nowhere and a chain of `n + 1` pairs, with two threads: the first passes the
agents and takes the first pair; the second then makes its whole pass and
finds nothing; from then on the first gets every `F`-th action.  It has
`n` more pairs to fire, with a pass before each, and the program is not at
rest after `F` times its count of actions, less `F`, or fewer. -/
theorem starved_chain (k n F : Nat) (hF : 0 < F) :
    ∀ i, i + F ≤ F * (3 + ((n + 1) * (3 * (k + 1)) + 10 * n)) →
      ¬ ((XMach.init (net (k + 1) (n + 1)) 2).trace xsys
        (handoff (3 * (k + 1) + 5) (3 * k + 2 + 6 * n + 3) F) i).1.resting = true := by
  intro i hi hr
  have hinit : XMach.init (net (k + 1) (n + 1)) 2 =
      ⟨net (k + 1) (n + 1), [⟨(net (k + 1) (n + 1)).agents, .idle⟩,
        ⟨lone k ++ (pairsFrom 0 (n + 1) ++ [([k, 0], c)]), .idle⟩]⟩ := by
    rw [XMach.init_two]
    show (⟨net (k + 1) (n + 1), [⟨(net (k + 1) (n + 1)).agents, .idle⟩,
      ⟨(lone k ++ pairsFrom 0 (n + 1)) ++ [([k, 0], c)], .idle⟩]⟩ : XMach Chain) = _
    rw [List.append_assoc]
  have w₀ := ((pass (k + 1) (n + 1) 0 0 (n + 1) (pairsFrom 0 (n + 1))).works.trans
    (fire0 (k + 1) (n + 1) n)).trace_at
    [⟨(net (k + 1) (n + 1)).agents, .idle⟩,
      ⟨lone k ++ (pairsFrom 0 (n + 1) ++ [([k, 0], c)]), .idle⟩] 0 rfl
  have w₁ := (idle_pass k (n + 1) n (Nat.le_refl _)).works.trace_at
    [⟨([0, 4], c) :: pairsFrom 1 n,
        .write [] [(([0, 3], 1), ([0, 4], 1)), (([0, 4], 1), ([0, 3], 1))]⟩,
      ⟨lone k ++ (pairsFrom 0 (n + 1) ++ [([k, 0], c)]), .idle⟩] 1 rfl
  have hs : ∀ d, ((⟨net (k + 1) (n + 1), [⟨(net (k + 1) (n + 1)).agents, .idle⟩,
        ⟨lone k ++ (pairsFrom 0 (n + 1) ++ [([k, 0], c)]), .idle⟩]⟩ : XMach Chain).trace xsys
        (handoff (3 * (k + 1) + 5) (3 * k + 2 + 6 * n + 3) F)
        (3 * (k + 1) + 5 + (3 * k + 2 + 6 * n + 3) + d)).1 =
      ((⟨st (k + 1) (n + 1) 0 1 n, [⟨([0, 4], c) :: pairsFrom 1 n,
          .write [] [(([0, 3], 1), ([0, 4], 1)), (([0, 4], 1), ([0, 3], 1))]⟩,
        ⟨[], .idle⟩]⟩ : XMach Chain).trace xsys (starve F) d).1 :=
    XMach.trace_handoff (xs := xsys) (F := F) w₀ w₁
  have hr' := XMach.resting_trace (xs := xsys) _ hr
    (3 * (k + 1) + 5 + (3 * k + 2 + 6 * n + 3))
  rw [Nat.add_comm i, hinit, hs i] at hr'
  refine XMach.starved_worker (xs := xsys) (u := 0) (starve F) (M := ⟨st (k + 1) (n + 1) 0 1 n,
      [⟨([0, 4], c) :: pairsFrom 1 n,
        .write [] [(([0, 3], 1), ([0, 4], 1)), (([0, 4], 1), ([0, 3], 1))]⟩,
      ⟨[], .idle⟩]⟩) rfl ?_ (paused (k + 1) (n + 1) n (Nat.le_refl _) _) hF
    (starve_sparse F) i hi hr'
  intro t T ht h
  cases t with
  | zero => exact absurd rfl ht
  | succ t =>
    cases t with
    | zero => exact (Option.some.inj h).symm
    | succ t => cases h

/-! The net is a valid input. -/

theorem wire_lone_aux {k n w j : Nat} {q' : Port}
    (h : ((([j, 0] : Id), 1), q') ∈ wires k n w) : q' = ([j, 2], 0) := by
  rcases mem_wires.1 h with ⟨j', hj', h | h⟩ | ⟨j', hj', h | h | h | h⟩ | h | h |
      ⟨j', hj', h | h | h | h⟩ <;>
    first
      | (simp at h; obtain ⟨rfl, rfl⟩ := h; rfl)
      | simp at h

theorem wire_loneFree2 {k n w j : Nat} {q' : Port}
    (h : ((([j, 2] : Id), 0), q') ∈ wires k n w) : q' = ([j, 0], 1) := by
  rcases mem_wires.1 h with ⟨j', hj', h | h⟩ | ⟨j', hj', h | h | h | h⟩ | h | h |
      ⟨j', hj', h | h | h | h⟩ <;>
    first
      | (simp at h; obtain ⟨rfl, rfl⟩ := h; rfl)
      | simp at h

theorem wire_head' {k n w : Nat} {q' : Port}
    (h : ((([0, 4] : Id), 0), q') ∈ wires k n w) : q' = ([0, 3], 0) := by
  rcases mem_wires.1 h with ⟨j', hj', h | h⟩ | ⟨j', hj', h | h | h | h⟩ | h | h |
      ⟨j', hj', h | h | h | h⟩ <;>
    first
      | (simp at h; rw [h])
      | simp at h

theorem agent_iff {k n : Nat} {i : Id} {α : Chain} :
    (net k n).toNet.agent i α ↔
      (∃ j, j < k ∧ i = [j, 0]) ∨ ∃ j, j < n ∧ (i = [j, 3] ∨ i = [j, 4]) := by
  show (i, α) ∈ lone k ++ pairsFrom 0 n ↔ _
  rw [List.mem_append, mem_lone, mem_pairsFrom]
  cases α
  constructor
  · rintro (⟨j, hj, h⟩ | ⟨j, -, hj, h | h⟩)
    · exact .inl ⟨j, hj, (Prod.mk.inj h).1⟩
    · exact .inr ⟨j, by omega, .inl (Prod.mk.inj h).1⟩
    · exact .inr ⟨j, by omega, .inr (Prod.mk.inj h).1⟩
  · rintro (⟨j, hj, rfl⟩ | ⟨j, hj, rfl | rfl⟩)
    · exact .inl ⟨j, hj, rfl⟩
    · exact .inr ⟨j, Nat.zero_le j, by omega, .inl rfl⟩
    · exact .inr ⟨j, Nat.zero_le j, by omega, .inr rfl⟩

theorem free_iff {k n : Nat} {p : Port} :
    (net k n).toNet.free p ↔
      (∃ j, j < k ∧ (p = ([j, 1], 0) ∨ p = ([j, 2], 0))) ∨ p = ([n, 3], 0) ∨ p = ([n, 4], 0) := by
  show p ∈ loneFree k ++ [([n, 3], 0), ([n, 4], 0)] ↔ _
  unfold loneFree
  simp only [List.mem_append, mem_gen, List.mem_cons, List.not_mem_nil, or_false]

theorem used_len {k n : Nat} {i : Id} (h : (net k n).toNet.Used i) : i.length = 2 := by
  rcases h with ⟨γ, hg⟩ | ⟨x, q, hl⟩ | ⟨x, hf⟩
  · rcases agent_iff.1 hg with ⟨j, -, rfl⟩ | ⟨j, -, rfl | rfl⟩ <;> rfl
  · rcases mem_wires.1 hl with ⟨j, hj, h | h⟩ | ⟨j, hj, h | h | h | h⟩ | h | h |
        ⟨j, hj, h | h | h | h⟩ <;>
      (rw [(Prod.mk.inj (Prod.mk.inj h).1).1]; rfl)
  · rcases free_iff.1 hf with ⟨j, -, e | e⟩ | e | e <;>
      (rw [(Prod.mk.inj e).1]; rfl)

/-- The net is a valid input: its segments match its ends in pairs. -/
theorem net_matching (k n : Nat) : (net k n).toNet.Matching ar := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro i α β _ _
    cases α
    cases β
    rfl
  · intro p q h
    rcases mem_wires.1 h with ⟨j, hj, h | h⟩ | ⟨j, hj, h | h | h | h⟩ | h | h |
      ⟨j, hj, h | h | h | h⟩ <;> obtain ⟨rfl, rfl⟩ := Prod.mk.inj h
    · omega
    · omega
    · exact mem_wires.2 (.inr (.inl ⟨j, hj, .inr (.inl rfl)⟩))
    · exact mem_wires.2 (.inr (.inl ⟨j, hj, .inl rfl⟩))
    · exact mem_wires.2 (.inr (.inl ⟨j, hj, .inr (.inr (.inr rfl))⟩))
    · exact mem_wires.2 (.inr (.inl ⟨j, hj, .inr (.inr (.inl rfl))⟩))
    · exact mem_wires.2 (.inr (.inr (.inr (.inl rfl))))
    · exact mem_wires.2 (.inr (.inr (.inl rfl)))
    · exact mem_wires.2 (.inr (.inr (.inr (.inr ⟨j, hj, .inr (.inl rfl)⟩))))
    · exact mem_wires.2 (.inr (.inr (.inr (.inr ⟨j, hj, .inl rfl⟩))))
    · exact mem_wires.2 (.inr (.inr (.inr (.inr ⟨j, hj, .inr (.inr (.inr rfl))⟩))))
    · exact mem_wires.2 (.inr (.inr (.inr (.inr ⟨j, hj, .inr (.inr (.inl rfl))⟩))))
  · intro p h
    rcases mem_wires.1 h with ⟨j, hj, h | h⟩ | ⟨j, hj, h | h | h | h⟩ | h | h |
        ⟨j, hj, h | h | h | h⟩ <;>
      (obtain ⟨h₁, h₂⟩ := Prod.mk.inj h; rw [h₁] at h₂; simp at h₂)
  · intro p q q' h h'
    rcases mem_wires.1 h with ⟨j, hj, h | h⟩ | ⟨j, hj, h | h | h | h⟩ | h | h |
      ⟨j, hj, h | h | h | h⟩ <;> obtain ⟨rfl, rfl⟩ := Prod.mk.inj h
    · omega
    · omega
    · exact (wire_lone h').symm
    · exact (wire_loneFree h').symm
    · exact (wire_lone_aux h').symm
    · exact (wire_loneFree2 h').symm
    · exact (wire_head h').symm
    · exact (wire_head' h').symm
    · rcases wire_x_aux h' with e | ⟨e, -⟩
      · exact e.symm
      · omega
    · exact (wire_x h').symm
    · rcases wire_y_aux h' with e | ⟨e, -⟩
      · exact e.symm
      · omega
    · exact (wire_y h').symm
  · intro p q h
    rcases mem_wires.1 h with ⟨j, hj, h | h⟩ | ⟨j, hj, h | h | h | h⟩ | h | h |
      ⟨j, hj, h | h | h | h⟩ <;> obtain ⟨rfl, rfl⟩ := Prod.mk.inj h
    · omega
    · omega
    · exact .inr ⟨c, agent_iff.2 (.inl ⟨j, hj, rfl⟩), Nat.zero_le _⟩
    · exact .inl (free_iff.2 (.inl ⟨j, hj, .inl rfl⟩))
    · exact .inr ⟨c, agent_iff.2 (.inl ⟨j, hj, rfl⟩), Nat.le_refl _⟩
    · exact .inl (free_iff.2 (.inl ⟨j, hj, .inr rfl⟩))
    · cases n with
      | zero => exact .inl (free_iff.2 (.inr (.inl rfl)))
      | succ n' => exact .inr ⟨c, agent_iff.2 (.inr ⟨0, Nat.succ_pos n', .inl rfl⟩), Nat.zero_le _⟩
    · cases n with
      | zero => exact .inl (free_iff.2 (.inr (.inr rfl)))
      | succ n' => exact .inr ⟨c, agent_iff.2 (.inr ⟨0, Nat.succ_pos n', .inr rfl⟩), Nat.zero_le _⟩
    · exact .inr ⟨c, agent_iff.2 (.inr ⟨j, hj, .inl rfl⟩), Nat.le_refl _⟩
    · rcases Nat.lt_or_ge (j + 1) n with h' | h'
      · exact .inr ⟨c, agent_iff.2 (.inr ⟨j + 1, h', .inl rfl⟩), Nat.zero_le _⟩
      · have e : j + 1 = n := by omega
        rw [e]
        exact .inl (free_iff.2 (.inr (.inl rfl)))
    · exact .inr ⟨c, agent_iff.2 (.inr ⟨j, hj, .inr rfl⟩), Nat.le_refl _⟩
    · rcases Nat.lt_or_ge (j + 1) n with h' | h'
      · exact .inr ⟨c, agent_iff.2 (.inr ⟨j + 1, h', .inr rfl⟩), Nat.zero_le _⟩
      · have e : j + 1 = n := by omega
        rw [e]
        exact .inl (free_iff.2 (.inr (.inr rfl)))
  · intro p h
    rcases h with hf | ⟨γ, hag, hle⟩
    · rcases free_iff.1 hf with ⟨j, hj, rfl | rfl⟩ | rfl | rfl
      · exact ⟨([j, 0], 0), mem_wires.2 (.inr (.inl ⟨j, hj, .inr (.inl rfl)⟩))⟩
      · exact ⟨([j, 0], 1), mem_wires.2 (.inr (.inl ⟨j, hj, .inr (.inr (.inr rfl))⟩))⟩
      · cases n with
        | zero => exact ⟨([0, 4], 0), mem_wires.2 (.inr (.inr (.inl rfl)))⟩
        | succ n' =>
          exact ⟨([n', 3], 1), mem_wires.2 (.inr (.inr (.inr (.inr
            ⟨n', Nat.lt_succ_self n', .inr (.inl rfl)⟩))))⟩
      · cases n with
        | zero => exact ⟨([0, 3], 0), mem_wires.2 (.inr (.inr (.inr (.inl rfl))))⟩
        | succ n' =>
          exact ⟨([n', 4], 1), mem_wires.2 (.inr (.inr (.inr (.inr
            ⟨n', Nat.lt_succ_self n', .inr (.inr (.inr rfl))⟩))))⟩
    · obtain ⟨i, x⟩ := p
      have hag' : (net k n).toNet.agent i γ := hag
      have hle' : x ≤ 1 := hle
      have hx : x = 0 ∨ x = 1 := by omega
      rcases agent_iff.1 hag' with ⟨j, hj, rfl⟩ | ⟨j, hj, rfl | rfl⟩
      · rcases hx with rfl | rfl
        · exact ⟨([j, 1], 0), mem_wires.2 (.inr (.inl ⟨j, hj, .inl rfl⟩))⟩
        · exact ⟨([j, 2], 0), mem_wires.2 (.inr (.inl ⟨j, hj, .inr (.inr (.inl rfl))⟩))⟩
      · rcases hx with rfl | rfl
        · cases j with
          | zero => exact ⟨([0, 4], 0), mem_wires.2 (.inr (.inr (.inl rfl)))⟩
          | succ j' =>
            exact ⟨([j', 3], 1), mem_wires.2 (.inr (.inr (.inr (.inr
              ⟨j', by omega, .inr (.inl rfl)⟩))))⟩
        · exact ⟨([j + 1, 3], 0), mem_wires.2 (.inr (.inr (.inr (.inr ⟨j, hj, .inl rfl⟩))))⟩
      · rcases hx with rfl | rfl
        · cases j with
          | zero => exact ⟨([0, 3], 0), mem_wires.2 (.inr (.inr (.inr (.inl rfl))))⟩
          | succ j' =>
            exact ⟨([j', 4], 1), mem_wires.2 (.inr (.inr (.inr (.inr
              ⟨j', by omega, .inr (.inr (.inr rfl))⟩))))⟩
        · exact ⟨([j + 1, 4], 0), mem_wires.2 (.inr (.inr (.inr (.inr
            ⟨j, hj, .inr (.inr (.inl rfl))⟩))))⟩
  · intro i x α hf hag
    rcases free_iff.1 hf with ⟨j, -, e | e⟩ | e | e <;>
      (have ei := (Prod.mk.inj e).1
       subst ei
       rcases agent_iff.1 hag with ⟨j', hj', e'⟩ | ⟨j', hj', e' | e'⟩ <;> simp at e' <;> omega)
  · intro a α l hag hu
    have ha : a.length = 2 := by
      rcases agent_iff.1 hag with ⟨j, -, rfl⟩ | ⟨j, -, rfl | rfl⟩ <;> rfl
    have hl := used_len hu
    rw [List.length_append, ha] at hl
    exact List.eq_nil_of_length_eq_zero (by omega)

/-- The net is well formed. -/
theorem net_wf (k n : Nat) : (net k n).toNet.WF ar :=
  (XNet.ok_iff_matching.2 (net_matching k n)).1

/-- No agent is listed twice. -/
theorem net_nodup (k n : Nat) : ((net k n).agents.map Prod.fst).Nodup := by
  show ((lone k ++ pairsFrom 0 n).map Prod.fst).Nodup
  rw [List.map_append]
  refine List.nodup_append.2 ⟨?_, ?_, fun a ha b hb e => ?_⟩
  · unfold lone
    rw [map_gen]
    refine nodup_gen (fun j => List.nodup_cons.2 ⟨List.not_mem_nil, List.nodup_nil⟩)
      (fun i j x hi hj => ?_) k
    have e₁ : x = [i, 0] := List.mem_singleton.1 hi
    have e₂ : x = [j, 0] := List.mem_singleton.1 hj
    rw [e₁] at e₂
    exact List.head_eq_of_cons_eq e₂
  · unfold pairsFrom
    rw [map_asc]
    refine nodup_asc (fun j => ?_) (fun i j x hi hj => ?_) n 0
    · show ([[j, 3], [j, 4]] : List Id).Nodup
      simp
    · have hi' : x = [i, 3] ∨ x = [i, 4] := by
        rcases List.mem_cons.1 hi with h | h
        · exact .inl h
        · exact .inr (List.mem_singleton.1 h)
      have hj' : x = [j, 3] ∨ x = [j, 4] := by
        rcases List.mem_cons.1 hj with h | h
        · exact .inl h
        · exact .inr (List.mem_singleton.1 h)
      rcases hi' with rfl | rfl <;> rcases hj' with h | h <;>
        exact List.head_eq_of_cons_eq h
  · obtain ⟨e₁, h₁, rfl⟩ := List.mem_map.1 ha
    obtain ⟨e₂, h₂, rfl⟩ := List.mem_map.1 hb
    obtain ⟨j, -, rfl⟩ := mem_lone.1 h₁
    obtain ⟨j', -, -, rfl | rfl⟩ := mem_pairsFrom.1 h₂ <;> simp at e

/-- The bound for one pass on this net: eleven actions for each agent that
leads nowhere and twenty for each pair, and two. -/
theorem net_passBound (k n : Nat) : (net k n).passBound n 0 2 = 11 * k + 20 * n + 2 := by
  have h₁ := length_gen
    (f := fun j => [((([j, 0] : Id), 0), (([j, 1] : Id), 0)), (([j, 1], 0), ([j, 0], 0)),
      (([j, 0], 1), ([j, 2], 0)), (([j, 2], 0), ([j, 0], 1))]) (c := 4) (fun _ => rfl) k
  have h₂ := length_gen
    (f := fun j => [((([j, 3] : Id), 1), (([j + 1, 3] : Id), 0)), (([j + 1, 3], 0), ([j, 3], 1)),
      (([j, 4], 1), ([j + 1, 4], 0)), (([j + 1, 4], 0), ([j, 4], 1))]) (c := 4) (fun _ => rfl) n
  have ha : (net k n).agents.length = k + 2 * n := by
    show (lone k ++ pairsFrom 0 n).length = _
    rw [List.length_append, lone_length, pairsFrom_length]
  have hw : (net k n).wires.length = 4 * k + (2 + 4 * n) := by
    show ([] ++ (loneWires k ++ (headWires ++ chainWires n))).length = _
    rw [List.nil_append, List.length_append, List.length_append]
    show (gen _ k).length + (2 + (gen _ n).length) = _
    rw [h₁, h₂]
  show 7 * ((net k n).agents.length + 0 * n) + ((net k n).wires.length + 2 * n) = _
  rw [ha, hw]
  omega

/-- **One thread alone on the chain**: with `n + 1` pairs it is at rest
after `3 * k + 8 + (n + 1) * (3 * k) + 10 * n` actions, with every pair
fired, and not before. -/
theorem solo_exact (k n : Nat) :
    (XMach.init (net k (n + 1)) 1).trace xsys (fun _ => 0)
        (3 * k + 8 + ((n + 1) * (3 * k) + 10 * n)) =
        (⟨st k (n + 1) (n + 1) (n + 1) 0, [⟨[], .idle⟩]⟩, n + 1) ∧
      ∀ i, i < 3 * k + 8 + ((n + 1) * (3 * k) + 10 * n) →
        ¬ ((XMach.init (net k (n + 1)) 1).trace xsys (fun _ => 0) i).1.resting = true := by
  have w := (runs0 k (n + 1) n (Nat.le_refl _)).trace
  rw [XMach.init_one]
  exact w

/-- The chain of `n + 1` pairs has a normal form, `n + 1` steps away. -/
theorem net_steps (k n : Nat) :
    ∃ N', Steps (Step xsys.sys) (n + 1) (net k (n + 1)).toNet N' ∧
      Normal (Step xsys.sys) N' := by
  obtain ⟨hL, -⟩ := solo_exact k n
  have hX : (net k (n + 1)).toNet.WF xsys.sys.ar := net_wf k (n + 1)
  have live := XMach.trace_live (xs := xsys) (fun _ => 0)
    (XMach.init_live hX (Nat.succ_pos 0))
  have hrest : ((XMach.init (net k (n + 1)) 1).trace xsys (fun _ => 0)
      (3 * k + 8 + ((n + 1) * (3 * k) + 10 * n))).1.resting = true := by
    rw [hL]
    rfl
  have hc : ((XMach.init (net k (n + 1)) 1).trace xsys (fun _ => 0)
      (3 * k + 8 + ((n + 1) * (3 * k) + 10 * n))).2 = n + 1 := by rw [hL]
  obtain ⟨hq, hnorm⟩ := (live _).rest hrest
  have run := XMach.trace_run xsys (fun _ => 0) (XMach.init (net k (n + 1)) 1)
    (3 * k + 8 + ((n + 1) * (3 * k) + 10 * n))
  rw [XMach.init_toMach, hc] at run
  exact ⟨_, (run.final hX hq hnorm).1, hnorm⟩

/-- **The window multiplies every pass.**  On `k + 1` agents that lead
nowhere and a chain of `n + 1` pairs, take two threads, a window `F` longer
than a pass over the agents and than a look at every pair, and the schedule
`handoff`, which is fair with that window.  The bound of `XMach.fair_bound`
puts the threads at rest after `F` times

    (n + 2) * (11 * k + 20 * n + 33) + 3 * n + 4

actions, and they are not at rest after `F` times

    (n + 1) * (3 * (k + 1)) + 10 * n + 3

actions, less `F`: every one of the `n + 1` passes of the starved thread is
stretched by the window. -/
theorem window_chain (k n F : Nat) (hF : 3 * k + 6 * n + 8 < F) :
    (∀ u, u < 2 → ∀ i, ∃ j, i ≤ j ∧ j < i + F ∧
        handoff (3 * (k + 1) + 5) (3 * k + 2 + 6 * n + 3) F j = u) ∧
      (∀ i, F * ((n + 2) * (11 * k + 20 * n + 33) + 3 * n + 4) ≤ i →
        ((XMach.init (net (k + 1) (n + 1)) 2).trace xsys
          (handoff (3 * (k + 1) + 5) (3 * k + 2 + 6 * n + 3) F) i).1.resting = true) ∧
      ∀ i, i + F ≤ F * ((n + 1) * (3 * (k + 1)) + 10 * n + 3) →
        ¬ ((XMach.init (net (k + 1) (n + 1)) 2).trace xsys
          (handoff (3 * (k + 1) + 5) (3 * k + 2 + 6 * n + 3) F) i).1.resting = true := by
  have hfair := handoff_fair (b := 3 * (k + 1) + 5) (c := 3 * k + 2 + 6 * n + 3) (F := F)
    (by omega) (by omega) (by omega) (by omega)
  refine ⟨hfair, fun i hi => ?_, fun i hi => ?_⟩
  · obtain ⟨N', hs, hn⟩ := net_steps (k + 1) n
    have hX : (net (k + 1) (n + 1)).toNet.WF xsys.sys.ar := net_wf (k + 1) (n + 1)
    have hb := XMach.fair_bound (xs := xsys) hX (net_nodup (k + 1) (n + 1)) (nt := 2)
      (by decide) xsys_bounded hs hn _ hfair i
    refine (hb ?_).1
    rw [net_passBound]
    have e₁ : n + 1 + 1 = n + 2 := rfl
    have e₂ : 11 * (k + 1) + 20 * (n + 1) + 2 = 11 * k + 20 * n + 33 := by omega
    rw [e₁, e₂]
    have e₃ : (n + 2) * (11 * k + 20 * n + 33) + (n + 1) * (0 + 2 + 1) + 1 =
        (n + 2) * (11 * k + 20 * n + 33) + 3 * n + 4 := by omega
    rw [e₃]
    exact hi
  · refine starved_chain k n F (by omega) i ?_
    have e : 3 + ((n + 1) * (3 * (k + 1)) + 10 * n) =
        (n + 1) * (3 * (k + 1)) + 10 * n + 3 := by omega
    rw [e]
    exact hi

/-! ### The chain listed from the last pair to the first

The same net with the pairs listed the other way round: a pass now meets
the pairs that are not active yet before the one that is.  With two threads
that take turns, the second, which starts one agent further down the list,
takes the first pair; the first thread, three actions behind, has passed
every other pair by then, finds the first pair gone, and rests for good.
From then on the second thread makes every claim, however short the window
in which it is starved. -/

/-- The pairs from number `s` on, `r` of them, the last one first. -/
def pairsDown (s r : Nat) : List (Id × Chain) := desc (fun j => [([j, 3], c), ([j, 4], c)]) s r

theorem pairsDown_perm (s r : Nat) : (pairsDown s r).Perm (pairsFrom s r) := desc_perm _ r s

theorem mem_pairsDown {s r : Nat} {e : Id × Chain} :
    e ∈ pairsDown s r ↔ ∃ j, s ≤ j ∧ j < s + r ∧ (e = ([j, 3], c) ∨ e = ([j, 4], c)) :=
  (pairsDown_perm s r).mem_iff.trans mem_pairsFrom

theorem pairsDown_length (s r : Nat) : (pairsDown s r).length = 2 * r := by
  rw [(pairsDown_perm s r).length_eq, pairsFrom_length]

/-- The memory `st` with the pairs listed the last one first. -/
def rst (k n w s r : Nat) : XNet Chain :=
  ⟨lone k ++ pairsDown s r, loneFree k ++ [([n, 3], 0), ([n, 4], 0)], wires k n w⟩

/-- `k` agents that lead nowhere, listed first, and a chain of `n` pairs
listed from the last to the first, which is the active one. -/
def rnet (k n : Nat) : XNet Chain := rst k n 0 0 n

theorem rst_perm (k n w s r : Nat) : (rst k n w s r).agents.Perm (st k n w s r).agents :=
  List.Perm.append_left (lone k) (pairsDown_perm s r)

/-- The same agents are in memory. -/
theorem rst_assoc (k n w s r : Nat) (i : Id) :
    assoc i (rst k n w s r).agents = assoc i (st k n w s r).agents := by
  have hm : ∀ e, e ∈ (rst k n w s r).agents ↔ e ∈ (st k n w s r).agents :=
    fun e => (rst_perm k n w s r).mem_iff
  cases h : assoc i (st k n w s r).agents with
  | some v =>
    cases v
    exact assoc_some ((hm _).2 (assoc_mem h))
  | none =>
    cases h' : assoc i (rst k n w s r).agents with
    | none => rfl
    | some v =>
      cases v
      have h'' := assoc_some ((hm _).1 (assoc_mem h'))
      rw [h] at h''
      cases h''

/-- An agent that leads nowhere does so in whatever order the agents are
listed. -/
theorem rst_inert {k n w s r : Nat} {e : Id × Chain} (h : (st k n w s r).Inert e) :
    (rst k n w s r).Inert e := by
  obtain ⟨h₁, q, h₂, h₃, h₄⟩ := h
  refine ⟨?_, q, h₂, ?_, h₄⟩
  · rw [rst_assoc]
    exact h₁
  · rw [rst_assoc]
    exact h₃

/-- A thread passes agents that lead nowhere in three actions each. -/
theorem rpass {k k' : Nat} (hk : k' ≤ k) (n w s r : Nat) (rest : List (Id × Chain)) :
    Stays xsys (rst k n w s r) ⟨lone k' ++ rest, .idle⟩ ⟨rest, .idle⟩ (3 * k') := by
  have h := Stays.inert_pass (xs := xsys) (X := rst k n w s r) rest (lone k') fun e he => by
    obtain ⟨j, hj, rfl⟩ := mem_lone.1 he
    exact rst_inert (inert_lone (by omega))
  rw [lone_length] at h
  exact h

/-- It passes the pairs that are not active yet in six actions each: none
of them is the first pair left, and the pair before each has not had its
segment written. -/
theorem rpending {k n w s r s' r' : Nat} (hw : w < s') (h₁ : s ≤ s') (h₂ : s' + r' ≤ s + r)
    (hn : s' + r' ≤ n + 1) (rest : List (Id × Chain)) :
    Stays xsys (rst k n w s r) ⟨pairsDown s' r' ++ rest, .idle⟩ ⟨rest, .idle⟩ (6 * r') := by
  have h := Stays.inert_pass (xs := xsys) (X := rst k n w s r) rest (pairsDown s' r')
    fun e he => by
      obtain ⟨j, hj₁, hj₂, he' | he'⟩ := mem_pairsDown.1 he
      · obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
        rw [he']
        exact rst_inert (inert_x (by omega) (by omega) (by omega) (by omega))
      · obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
        rw [he']
        exact rst_inert (inert_y (by omega) (by omega) (by omega) (by omega))
  rw [pairsDown_length] at h
  have e : 3 * (2 * r') = 6 * r' := by omega
  rw [e] at h
  exact h

/-- Taking the two agents of the first pair left leaves the rest. -/
theorem rtake_pair (k n w s r : Nat) :
    ((rst k n w s (r + 1)).takeAgent [s, 3]).takeAgent [s, 4] = rst k n w (s + 1) r := by
  have hl : ∀ e, e ∈ lone k → e.1 ≠ [s, 3] ∧ e.1 ≠ [s, 4] := by
    intro e he
    obtain ⟨j, -, rfl⟩ := mem_lone.1 he
    simp
  have hp : ∀ e, e ∈ pairsDown (s + 1) r → e.1 ≠ [s, 3] ∧ e.1 ≠ [s, 4] := by
    intro e he
    obtain ⟨j, hj, -, rfl | rfl⟩ := mem_pairsDown.1 he
    · constructor
      · intro h
        simp at h
        omega
      · intro h
        simp at h
    · constructor
      · intro h
        simp at h
      · intro h
        simp at h
        omega
  have hne : ([s, 4] : Id) ≠ [s, 3] := by simp
  have e1 : (lone k ++ pairsDown s (r + 1)).filter (fun e => decide (e.1 ≠ [s, 3])) =
      lone k ++ (pairsDown (s + 1) r ++ [([s, 4], c)]) := by
    show (lone k ++ (pairsDown (s + 1) r ++ (([s, 3], c) :: [([s, 4], c)]))).filter _ = _
    rw [List.filter_append, List.filter_append, filter_ne fun e he => (hl e he).1,
      filter_ne fun e he => (hp e he).1, filter_ne_cons_same, filter_ne_cons_other hne]
    rfl
  have e2 : (lone k ++ (pairsDown (s + 1) r ++ [([s, 4], c)])).filter
      (fun e => decide (e.1 ≠ [s, 4])) = lone k ++ pairsDown (s + 1) r := by
    rw [List.filter_append, List.filter_append, filter_ne fun e he => (hl e he).2,
      filter_ne fun e he => (hp e he).2, filter_ne_cons_same]
    show lone k ++ (pairsDown (s + 1) r ++ []) = _
    rw [List.append_nil]
  show (⟨((lone k ++ pairsDown s (r + 1)).filter fun e => decide (e.1 ≠ [s, 3])).filter
      fun e => decide (e.1 ≠ [s, 4]), loneFree k ++ [([n, 3], 0), ([n, 4], 0)],
      wires k n w⟩ : XNet Chain) =
    ⟨lone k ++ pairsDown (s + 1) r, loneFree k ++ [([n, 3], 0), ([n, 4], 0)], wires k n w⟩
  rw [e1, e2]

/-- A thread that has found the first pair left takes its first agent. -/
theorem rready (k n w s r : Nat) (rest : List (Id × Chain)) :
    XMach.act xsys (rst k n w s (r + 1)) ⟨rest, .ready [s, 3] [s, 4] c c⟩ =
      ((rst k n w s (r + 1)).takeAgent [s, 3], ⟨rest, .half [s, 3] [s, 4] c c⟩, 0) :=
  XMach.act_ready (by
    rw [rst_assoc]
    exact agent_x (Nat.le_refl s) (by omega))

/-- It then takes the second, which completes the claim, and has two
segments to write. -/
theorem rhalf (k n w s r : Nat) (rest : List (Id × Chain)) :
    XMach.act xsys ((rst k n w s (r + 1)).takeAgent [s, 3]) ⟨rest, .half [s, 3] [s, 4] c c⟩ =
      (rst k n w (s + 1) r,
        ⟨rest, .write [] [(([s, 3], 1), ([s, 4], 1)), (([s, 4], 1), ([s, 3], 1))]⟩, 1) := by
  have hne : ([s, 3] : Id) ≠ [s, 4] := by simp
  have hb : (([s, 4] : Id), c) ∈ ((rst k n w s (r + 1)).takeAgent [s, 3]).agents :=
    XNet.mem_takeAgent.2 ⟨List.mem_append_right _
      (mem_pairsDown.2 ⟨s, Nat.le_refl s, by omega, .inr rfl⟩), Ne.symm hne⟩
  have s₂ := XMach.act_half (xs := xsys) (X := (rst k n w s (r + 1)).takeAgent [s, 3])
    (todo := rest) (a := [s, 3]) (b := [s, 4]) (α := c) (β := c) (R := rhs)
    (by rw [ite_pos' ⟨assoc_some hb, hne⟩]; exact rule_cc)
  rw [rhs_agents, rhs_links, rtake_pair] at s₂
  exact s₂

theorem rtake (k n w s r : Nat) (rest : List (Id × Chain)) :
    Works xsys (rst k n w s (r + 1)) ⟨rest, .ready [s, 3] [s, 4] c c⟩ (rst k n w (s + 1) r)
      ⟨rest, .write [] [(([s, 3], 1), ([s, 4], 1)), (([s, 4], 1), ([s, 3], 1))]⟩ 1 2 :=
  .step (c₁ := 0) (c := 1) (k := 1) (fun h => by cases h) (rready k n w s r rest)
    (.step (c₁ := 1) (c := 0) (k := 0) (fun h => by cases h) (rhalf k n w s r rest) (.refl _ _))

/-- It writes them and takes a fresh list of agents, in three actions. -/
theorem rwrites (k n w r : Nat) (rest : List (Id × Chain)) :
    Works xsys (rst k n w (w + 1) r)
      ⟨rest, .write [] [(([w, 3], 1), ([w, 4], 1)), (([w, 4], 1), ([w, 3], 1))]⟩
      (rst k n (w + 1) (w + 1) r) ⟨(rst k n (w + 1) (w + 1) r).agents, .idle⟩ 0 3 := by
  have s₁ : XMach.act xsys (rst k n w (w + 1) r)
      ⟨rest, .write [] [(([w, 3], 1), ([w, 4], 1)), (([w, 4], 1), ([w, 3], 1))]⟩ =
      ((rst k n w (w + 1) r).putLink ([w, 3], 1) ([w, 4], 1),
        ⟨rest, .write [] [(([w, 4], 1), ([w, 3], 1))]⟩, 0) := rfl
  have s₂ : XMach.act xsys ((rst k n w (w + 1) r).putLink ([w, 3], 1) ([w, 4], 1))
      ⟨rest, .write [] [(([w, 4], 1), ([w, 3], 1))]⟩ =
      (rst k n (w + 1) (w + 1) r, ⟨rest, .write [] []⟩, 0) := rfl
  have s₃ : XMach.act xsys (rst k n (w + 1) (w + 1) r) ⟨rest, .write [] []⟩ =
      (rst k n (w + 1) (w + 1) r, ⟨(rst k n (w + 1) (w + 1) r).agents, .idle⟩, 0) := rfl
  exact .step (c₁ := 0) (c := 0) (k := 2) (fun h => by cases h) s₁
    (.step (c₁ := 0) (c := 0) (k := 1) (fun h => by cases h) s₂
      (.step (c₁ := 0) (c := 0) (k := 0) (fun h => by cases h) s₃ (.refl _ _)))

/-- At the first agent of the first pair, a thread finds the second in
three actions. -/
theorem rfound0 (k n r : Nat) (rest : List (Id × Chain)) :
    Stays xsys (rst k n 0 0 (r + 1)) ⟨([0, 3], c) :: rest, .idle⟩
      ⟨rest, .ready [0, 3] [0, 4] c c⟩ 3 := by
  have ha : assoc [0, 3] (rst k n 0 0 (r + 1)).agents = some c := by
    rw [rst_assoc]
    exact agent_x (Nat.le_refl 0) (by omega)
  have hb : assoc [0, 4] (rst k n 0 0 (r + 1)).agents = some c := by
    rw [rst_assoc]
    exact agent_y (Nat.le_refl 0) (by omega)
  have hwire : assoc (([0, 3] : Id), 0) (rst k n 0 0 (r + 1)).wires = some ([0, 4], 0) :=
    assoc_eq_of_unique (mem_wires.2 (.inr (.inr (.inl rfl)))) fun q' hq' => wire_head hq'
  exact .step (k := 2) (fun h => by cases h) (XMach.act_idle_pos ha)
    (.step (k := 1) (fun h => by cases h) (XMach.act_look hwire)
      (.step (k := 0) (fun h => by cases h)
        (XMach.act_seek_found (c := ([0, 4], 0))
          (by
            show (if (0 : Nat) = 0 then assoc [0, 4] (rst k n 0 0 (r + 1)).agents
              else none) = some c
            rw [ite_pos' rfl]
            exact hb)
          ⟨by simp, by rw [rule_cc]; rfl⟩) (.refl _)))

/-- At the first agent of a later pair, once the pair before it has had its
segment written, a thread finds the second in five actions. -/
theorem rfoundS (k n j r : Nat) (hj : j < n) (rest : List (Id × Chain)) :
    Stays xsys (rst k n (j + 1) (j + 1) (r + 1)) ⟨([j + 1, 3], c) :: rest, .idle⟩
      ⟨rest, .ready [j + 1, 3] [j + 1, 4] c c⟩ 5 := by
  have ha : assoc [j + 1, 3] (rst k n (j + 1) (j + 1) (r + 1)).agents = some c := by
    rw [rst_assoc]
    exact agent_x (Nat.le_refl _) (by omega)
  have hb : assoc [j + 1, 4] (rst k n (j + 1) (j + 1) (r + 1)).agents = some c := by
    rw [rst_assoc]
    exact agent_y (Nat.le_refl _) (by omega)
  have hwire : assoc (([j + 1, 3] : Id), 0) (rst k n (j + 1) (j + 1) (r + 1)).wires =
      some ([j, 3], 1) :=
    assoc_eq_of_unique (mem_wires.2 (.inr (.inr (.inr (.inr ⟨j, hj, .inr (.inl rfl)⟩)))))
      fun q' hq' => wire_x hq'
  have hn₁ : nextSeg (rst k n (j + 1) (j + 1) (r + 1)).wires ([j, 3], 1) ([j + 1, 3], 0) =
      some ([j, 4], 1) :=
    nextSeg_some (mem_wires.2 (.inl ⟨j, Nat.lt_succ_self j, .inr rfl⟩)) (by simp)
      fun q hq hne => by
        rcases wire_x_aux hq with h | ⟨-, h⟩
        · exact absurd h hne
        · exact h
  have hn₂ : nextSeg (rst k n (j + 1) (j + 1) (r + 1)).wires ([j, 4], 1) ([j, 3], 1) =
      some ([j + 1, 4], 0) :=
    nextSeg_some
      (mem_wires.2 (.inr (.inr (.inr (.inr ⟨j, hj, .inr (.inr (.inl rfl))⟩))))) (by simp)
      fun q hq hne => by
        rcases wire_y_aux hq with h | ⟨-, h⟩
        · exact h
        · exact absurd h hne
  exact .step (k := 4) (fun h => by cases h) (XMach.act_idle_pos ha)
    (.step (k := 3) (fun h => by cases h) (XMach.act_look hwire)
      (.step (k := 2) (fun h => by cases h)
        (XMach.act_seek_next (c := ([j, 3], 1)) (ite_neg' (by simp)) hn₁)
        (.step (k := 1) (fun h => by cases h)
          (XMach.act_seek_next (c := ([j, 4], 1)) (ite_neg' (by simp)) hn₂)
          (.step (k := 0) (fun h => by cases h)
            (XMach.act_seek_found (c := ([j + 1, 4], 0))
              (by
                show (if (0 : Nat) = 0 then
                  assoc [j + 1, 4] (rst k n (j + 1) (j + 1) (r + 1)).agents else none) = some c
                rw [ite_pos' rfl]
                exact hb)
              ⟨by simp, by rw [rule_cc]; rfl⟩) (.refl _)))))

/-- From the second pair on, one thread alone: before each pair a pass over
the agents that lead nowhere and over the pairs that are not active yet,
ten actions for the pair, and one more pass at the end. -/
theorem rrunsS (k n : Nat) : ∀ (r j : Nat), j + 1 + r ≤ n →
    Works xsys (rst k n (j + 1) (j + 1) r) ⟨(rst k n (j + 1) (j + 1) r).agents, .idle⟩
      (rst k n (j + 1 + r) (j + 1 + r) 0) ⟨[], .idle⟩ r
      ((r + 1) * (3 * k) + 3 * (r * r) + 7 * r)
  | 0, j, _ => by
    have w := (rpass (Nat.le_refl k) n (j + 1) (j + 1) 0 []).works
    have e : (0 + 1) * (3 * k) + 3 * (0 * 0) + 7 * 0 = 3 * k := by omega
    rw [e]
    exact w
  | r + 1, j, h => by
    have w₁ := (rpass (Nat.le_refl k) n (j + 1) (j + 1) (r + 1)
      (pairsDown (j + 2) r ++ [([j + 1, 3], c), ([j + 1, 4], c)])).works
    have w₂ := (rpending (k := k) (n := n) (w := j + 1) (s := j + 1) (r := r + 1)
      (s' := j + 2) (r' := r) (by omega) (by omega) (by omega) (by omega)
      [([j + 1, 3], c), ([j + 1, 4], c)]).works
    have w₃ := (rfoundS k n j r (by omega) [([j + 1, 4], c)]).works
    have w₄ := rtake k n (j + 1) (j + 1) r [([j + 1, 4], c)]
    have w₅ := rwrites k n (j + 1) r [([j + 1, 4], c)]
    have w₆ := rrunsS k n r (j + 1) (by omega)
    have w := ((((w₁.trans w₂).trans w₃).trans w₄).trans w₅).trans w₆
    have e₀ : j + 1 + 1 + r = j + 1 + (r + 1) := by omega
    have e₁ : 0 + 0 + 0 + 1 + 0 + r = r + 1 := by omega
    have sq : (r + 1) * (r + 1) = r * r + 2 * r + 1 := by
      rw [Nat.add_mul, Nat.mul_add, Nat.mul_one, Nat.one_mul]
      omega
    have e₂ : 3 * k + 6 * r + 5 + 2 + 3 + ((r + 1) * (3 * k) + 3 * (r * r) + 7 * r) =
        (r + 1 + 1) * (3 * k) + 3 * ((r + 1) * (r + 1)) + 7 * (r + 1) := by
      rw [Nat.add_mul (r + 1) 1 (3 * k), Nat.one_mul, sq]
      omega
    rw [e₀, e₁, e₂] at w
    exact w

/-- A thread that has taken the first pair and has its segments to write
goes on alone to the end. -/
theorem rpaused (k n r : Nat) (h : r + 1 ≤ n) (rest : List (Id × Chain)) :
    Works xsys (rst k n 0 1 r)
      ⟨rest, .write [] [(([0, 3], 1), ([0, 4], 1)), (([0, 4], 1), ([0, 3], 1))]⟩
      (rst k n (r + 1) (r + 1) 0) ⟨[], .idle⟩ r
      (3 + ((r + 1) * (3 * k) + 3 * (r * r) + 7 * r)) := by
  have w := (rwrites k n 0 r rest).trans (rrunsS k n r 0 (by omega))
  have e₀ : 0 + 1 + r = r + 1 := by omega
  have e₁ : 0 + r = r := by omega
  rw [e₀, e₁] at w
  exact w

/-- **The opening.**  Two threads on the chain listed from the last pair,
taking turns, the second first.  After `3 * k + 6 * n + 5` actions each, the
second has passed every agent, found the first pair and taken it, and has
its segments to write; the first, which started one agent behind, has
passed every other pair, found the first pair gone, and is at rest. -/
theorem ropening (k n : Nat) :
    ((XMach.init (rnet (k + 1) (n + 1)) 2).trace xsys (fun i => (i + 1) % 2)
      (2 * (3 * k + 6 * n + 5))).1 =
      ⟨rst (k + 1) (n + 1) 0 1 n, [⟨[], .idle⟩,
        ⟨[([0, 4], c), ([k, 0], c)],
          .write [] [(([0, 3], 1), ([0, 4], 1)), (([0, 4], 1), ([0, 3], 1))]⟩]⟩ := by
  have hinit : XMach.init (rnet (k + 1) (n + 1)) 2 =
      ⟨rst (k + 1) (n + 1) 0 0 (n + 1),
        [⟨([k, 0], c) :: (lone k ++ (pairsDown 1 n ++ [([0, 3], c), ([0, 4], c)])), .idle⟩,
          ⟨lone k ++ (pairsDown 1 n ++ [([0, 3], c), ([0, 4], c), ([k, 0], c)]), .idle⟩]⟩ := by
    rw [XMach.init_two]
    show (⟨rst (k + 1) (n + 1) 0 0 (n + 1),
      [⟨([k, 0], c) :: (lone k ++ (pairsDown 1 n ++ [([0, 3], c), ([0, 4], c)])), .idle⟩,
        ⟨(lone k ++ (pairsDown 1 n ++ [([0, 3], c), ([0, 4], c)])) ++ [([k, 0], c)], .idle⟩]⟩ :
      XMach Chain) = _
    rw [List.append_assoc, List.append_assoc]
    rfl
  have r₁ : Stays xsys (rst (k + 1) (n + 1) 0 0 (n + 1))
      ⟨([k, 0], c) :: (lone k ++ (pairsDown 1 n ++ [([0, 3], c), ([0, 4], c)])), .idle⟩
      ⟨lone k ++ (pairsDown 1 n ++ [([0, 3], c), ([0, 4], c)]), .idle⟩ 3 :=
    Stays.inert _ (rst_inert (inert_lone (by omega)))
  have r₂ := rpass (k := k + 1) (k' := k) (by omega) (n + 1) 0 0 (n + 1)
    (pairsDown 1 n ++ [([0, 3], c), ([0, 4], c)])
  have r₃ := rpending (k := k + 1) (n := n + 1) (w := 0) (s := 0) (r := n + 1) (s' := 1)
    (r' := n) (by omega) (by omega) (by omega) (by omega) [([0, 3], c), ([0, 4], c)]
  have sR := (r₁.trans r₂).trans r₃
  have q₁ := rpass (k := k + 1) (k' := k) (by omega) (n + 1) 0 0 (n + 1)
    (pairsDown 1 n ++ [([0, 3], c), ([0, 4], c), ([k, 0], c)])
  have q₂ := rpending (k := k + 1) (n := n + 1) (w := 0) (s := 0) (r := n + 1) (s' := 1)
    (r' := n) (by omega) (by omega) (by omega) (by omega)
    [([0, 3], c), ([0, 4], c), ([k, 0], c)]
  have q₃ := rfound0 (k + 1) (n + 1) n [([0, 4], c), ([k, 0], c)]
  have sS := (q₁.trans q₂).trans q₃
  have eR : 3 + 3 * k + 6 * n = 3 * k + 6 * n + 3 := by omega
  rw [eR] at sR
  have t₀ := XMach.trace_turns (xs := xsys) sR sS
  have a₁ := rready (k + 1) (n + 1) 0 0 n [([0, 4], c), ([k, 0], c)]
  have a₂ : XMach.act xsys ((rst (k + 1) (n + 1) 0 0 (n + 1)).takeAgent [0, 3])
      ⟨([0, 3], c) :: [([0, 4], c)], .idle⟩ =
      ((rst (k + 1) (n + 1) 0 0 (n + 1)).takeAgent [0, 3], ⟨[([0, 4], c)], .idle⟩, 0) :=
    XMach.act_idle_neg fun h => (XNet.mem_takeAgent.1 (assoc_mem h)).2 rfl
  have a₃ := rhalf (k + 1) (n + 1) 0 0 n [([0, 4], c), ([k, 0], c)]
  have a₄ : XMach.act xsys (rst (k + 1) (n + 1) 0 (0 + 1) n) ⟨[([0, 4], c)], .idle⟩ =
      (rst (k + 1) (n + 1) 0 (0 + 1) n, ⟨[], .idle⟩, 0) :=
    XMach.act_idle_neg (by
      rw [rst_assoc]
      exact agent_gone (by omega) 4 (by omega) c)
  have h₂ := XMach.trace_round (xs := xsys) a₃ a₄
  have e : 3 * k + 6 * n + 5 = 3 * k + 6 * n + 3 + 1 + 1 := by omega
  rw [hinit, e, XMach.trace_turns_add xsys _ (3 * k + 6 * n + 3 + 1) 1,
    XMach.trace_turns_add xsys _ (3 * k + 6 * n + 3) 1, t₀, XMach.trace_round a₁ a₂]
  exact h₂

/-- **A starved thread makes every claim, whatever the window.**  On
`k + 1` agents that lead nowhere and a chain of `n + 1` pairs listed from
the last to the first, with two threads: after the opening the first thread
is at rest, and the second gets every `F`-th action.  It has `n` more pairs
to fire, with a pass before each, and the program is not at rest after `F`
times its count of actions, less `F`, or fewer. -/
theorem starved_short (k n F : Nat) (hF : 0 < F) :
    ∀ i, i + F ≤ F * (3 + ((n + 1) * (3 * (k + 1)) + 3 * (n * n) + 7 * n)) →
      ¬ ((XMach.init (rnet (k + 1) (n + 1)) 2).trace xsys
        (abreast (3 * k + 6 * n + 5) F) i).1.resting = true := by
  intro i hi hr
  have hs := XMach.trace_abreast (xs := xsys) (F := F) (ropening k n)
  have hr' := XMach.resting_trace (xs := xsys) _ hr (2 * (3 * k + 6 * n + 5))
  rw [Nat.add_comm i, hs i] at hr'
  refine XMach.starved_worker (xs := xsys) (u := 1) (starveSnd F)
    (M := ⟨rst (k + 1) (n + 1) 0 1 n, [⟨[], .idle⟩,
      ⟨[([0, 4], c), ([k, 0], c)],
        .write [] [(([0, 3], 1), ([0, 4], 1)), (([0, 4], 1), ([0, 3], 1))]⟩]⟩) rfl ?_
    (rpaused (k + 1) (n + 1) n (Nat.le_refl _) _) hF (starveSnd_sparse F) i hi hr'
  intro t T ht h
  cases t with
  | zero => exact (Option.some.inj h).symm
  | succ t =>
    cases t with
    | zero => exact absurd rfl ht
    | succ t => cases h

/-! The net is the chain, listed in another order. -/

theorem rnet_toNet (k n : Nat) : (rnet k n).toNet = (net k n).toNet :=
  Net.ext' (fun _ _ => (rst_perm k n 0 0 n).mem_iff) (fun _ _ => Iff.rfl) (fun _ => Iff.rfl)

theorem rnet_wf (k n : Nat) : (rnet k n).toNet.WF ar := by
  rw [rnet_toNet]
  exact net_wf k n

theorem rnet_nodup (k n : Nat) : ((rnet k n).agents.map Prod.fst).Nodup :=
  ((rst_perm k n 0 0 n).map Prod.fst).nodup_iff.2 (net_nodup k n)

theorem rnet_passBound (k n : Nat) : (rnet k n).passBound n 0 2 = 11 * k + 20 * n + 2 := by
  show 7 * ((rst k n 0 0 n).agents.length + 0 * n) + ((net k n).wires.length + 2 * n) = _
  rw [(rst_perm k n 0 0 n).length_eq]
  exact net_passBound k n

theorem rnet_steps (k n : Nat) :
    ∃ N', Steps (Step xsys.sys) (n + 1) (rnet k (n + 1)).toNet N' ∧
      Normal (Step xsys.sys) N' := by
  rw [rnet_toNet]
  exact net_steps k n

/-- On these nets the bound is at most twelve times the count of the
starved thread's actions. -/
theorem short_bound_le (k n : Nat) :
    (n + 2) * (11 * k + 20 * n + 33) + 3 * n + 4 ≤
      12 * ((n + 1) * (3 * (k + 1)) + 3 * (n * n) + 7 * n + 3) := by
  have h₁ : (n + 2) * (11 * k + 20 * n + 33) =
      11 * (n * k) + 20 * (n * n) + 33 * n + 2 * (11 * k + 20 * n + 33) := by
    rw [Nat.add_mul n 2 (11 * k + 20 * n + 33), Nat.mul_add n (11 * k + 20 * n) 33,
      Nat.mul_add n (11 * k) (20 * n), Nat.mul_left_comm n 11 k, Nat.mul_left_comm n 20 n,
      Nat.mul_comm n 33]
  have h₂ : (n + 1) * (3 * (k + 1)) = 3 * (n * k) + 3 * n + 3 * (k + 1) := by
    rw [Nat.add_mul n 1 (3 * (k + 1)), Nat.one_mul, Nat.mul_left_comm n 3 (k + 1),
      Nat.mul_add n k 1, Nat.mul_one, Nat.mul_add 3 (n * k) n]
  rw [h₁, h₂]
  omega

/-- **The window multiplies every pass, however short it is.**  On `k + 1`
agents that lead nowhere and a chain of `n + 1` pairs listed from the last
to the first, take two threads, any window `F` with room for both, and the
schedule `abreast`, which is fair with that window.  The bound of
`XMach.fair_bound` puts the threads at rest after `F` times

    (n + 2) * (11 * k + 20 * n + 33) + 3 * n + 4

actions, and they are not at rest after `F` times

    (n + 1) * (3 * (k + 1)) + 3 * (n * n) + 7 * n + 3

actions, less `F`: every pass of the starved thread after its first claim
is stretched by the window.  The first count is at most twelve times the
second (`short_bound_le`), so on these nets the bound is right up to a
constant, for every window. -/
theorem window_short (k n F : Nat) (hF : 2 ≤ F) :
    (∀ u, u < 2 → ∀ i, ∃ j, i ≤ j ∧ j < i + F ∧ abreast (3 * k + 6 * n + 5) F j = u) ∧
      (∀ i, F * ((n + 2) * (11 * k + 20 * n + 33) + 3 * n + 4) ≤ i →
        ((XMach.init (rnet (k + 1) (n + 1)) 2).trace xsys
          (abreast (3 * k + 6 * n + 5) F) i).1.resting = true) ∧
      ∀ i, i + F ≤ F * ((n + 1) * (3 * (k + 1)) + 3 * (n * n) + 7 * n + 3) →
        ¬ ((XMach.init (rnet (k + 1) (n + 1)) 2).trace xsys
          (abreast (3 * k + 6 * n + 5) F) i).1.resting = true := by
  have hfair := abreast_fair (P := 3 * k + 6 * n + 5) hF
  refine ⟨hfair, fun i hi => ?_, fun i hi => ?_⟩
  · obtain ⟨N', hs, hn⟩ := rnet_steps (k + 1) n
    have hX : (rnet (k + 1) (n + 1)).toNet.WF xsys.sys.ar := rnet_wf (k + 1) (n + 1)
    have hb := XMach.fair_bound (xs := xsys) hX (rnet_nodup (k + 1) (n + 1)) (nt := 2)
      (by decide) xsys_bounded hs hn _ hfair i
    refine (hb ?_).1
    rw [rnet_passBound]
    have e₁ : n + 1 + 1 = n + 2 := rfl
    have e₂ : 11 * (k + 1) + 20 * (n + 1) + 2 = 11 * k + 20 * n + 33 := by omega
    rw [e₁, e₂]
    have e₃ : (n + 2) * (11 * k + 20 * n + 33) + (n + 1) * (0 + 2 + 1) + 1 =
        (n + 2) * (11 * k + 20 * n + 33) + 3 * n + 4 := by omega
    rw [e₃]
    exact hi
  · refine starved_short k n F (by omega) i ?_
    have e : 3 + ((n + 1) * (3 * (k + 1)) + 3 * (n * n) + 7 * n) =
        (n + 1) * (3 * (k + 1)) + 3 * (n * n) + 7 * n + 3 := by omega
    rw [e]
    exact hi

/-! The time of a run with claims. -/

theorem wires_length (k n w : Nat) : (wires k n w).length = 2 * w + 4 * k + 4 * n + 2 := by
  have h₀ := length_gen
    (f := fun j => [((([j, 4] : Id), 1), (([j, 3] : Id), 1)), (([j, 3], 1), ([j, 4], 1))])
    (c := 2) (fun _ => rfl) w
  have h₁ := length_gen
    (f := fun j => [((([j, 0] : Id), 0), (([j, 1] : Id), 0)), (([j, 1], 0), ([j, 0], 0)),
      (([j, 0], 1), ([j, 2], 0)), (([j, 2], 0), ([j, 0], 1))]) (c := 4) (fun _ => rfl) k
  have h₂ := length_gen
    (f := fun j => [((([j, 3] : Id), 1), (([j + 1, 3] : Id), 0)), (([j + 1, 3], 0), ([j, 3], 1)),
      (([j, 4], 1), ([j + 1, 4], 0)), (([j + 1, 4], 0), ([j, 4], 1))]) (c := 4) (fun _ => rfl) n
  show (written w ++ (loneWires k ++ (headWires ++ chainWires n))).length = _
  rw [List.length_append, List.length_append, List.length_append]
  show (gen _ w).length + ((gen _ k).length + (2 + (gen _ n).length)) = _
  rw [h₀, h₁, h₂]
  omega

theorem rst_agents_length (k n w s r : Nat) : (rst k n w s r).agents.length = k + 2 * r := by
  show (lone k ++ pairsDown s r).length = _
  rw [List.length_append, lone_length, pairsDown_length]

/-- A pass over the agents that lead nowhere reads the whole memory for
each of them. -/
theorem rpass_spent {k k' : Nat} (hk : k' ≤ k) (n w s r : Nat) (rest : List (Id × Chain)) :
    k' * (5 * k + 4 * n + 5) ≤
      (⟨lone k' ++ rest, .idle⟩ : XThread Chain).spent xsys (rst k n w s r) (3 * k') := by
  have h := XThread.spent_inert_pass (xs := xsys) (X := rst k n w s r) rest (lone k')
    fun e he => by
      obtain ⟨j, hj, rfl⟩ := mem_lone.1 he
      exact ⟨rst_inert (inert_lone (by omega)), fun q hq => by rw [wire_lone (assoc_mem hq)]⟩
  have hw : (rst k n w s r).wires.length = 2 * w + 4 * k + 4 * n + 2 := wires_length k n w
  rw [lone_length, rst_agents_length, hw] at h
  exact Nat.le_trans (Nat.mul_le_mul_left k' (by omega)) h

/-- A pass over the pairs that are not active yet reads every segment for
each of their agents. -/
theorem rpending_spent {k n w s r s' r' : Nat} (hw : w < s') (h₁ : s ≤ s')
    (h₂ : s' + r' ≤ s + r) (hn : s' + r' ≤ n + 1) (rest : List (Id × Chain)) :
    2 * r' * (4 * k + 4 * n + 5) ≤
      (⟨pairsDown s' r' ++ rest, .idle⟩ : XThread Chain).spent xsys (rst k n w s r)
        (6 * r') := by
  have h := XThread.spent_stuck_pass (xs := xsys) (X := rst k n w s r) rest (pairsDown s' r')
    fun e he => by
      obtain ⟨j, hj₁, hj₂, he' | he'⟩ := mem_pairsDown.1 he
      · obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
        rw [he']
        exact rst_inert (inert_x (by omega) (by omega) (by omega) (by omega))
      · obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
        rw [he']
        exact rst_inert (inert_y (by omega) (by omega) (by omega) (by omega))
  have e : 3 * (2 * r') = 6 * r' := by omega
  have hwl : (rst k n w s r).wires.length = 2 * w + 4 * k + 4 * n + 2 := wires_length k n w
  rw [pairsDown_length, e, hwl] at h
  exact Nat.le_trans (Nat.mul_le_mul_left (2 * r') (by omega)) h

/-- The time of the run from the second pair on: before each pair a pass
that reads the whole memory for each agent that leads nowhere, and every
segment for each agent of a pair that is not active yet. -/
theorem rrunsS_time (k n : Nat) : ∀ (r j : Nat), j + 1 + r ≤ n →
    (r + 1) * (k * (5 * k + 4 * n + 5)) + (r * r - r) * (4 * k + 4 * n + 5) ≤
      XMach.soloTime xsys (rst k n (j + 1) (j + 1) r)
        ⟨(rst k n (j + 1) (j + 1) r).agents, .idle⟩
        ((r + 1) * (3 * k) + 3 * (r * r) + 7 * r)
  | 0, j, _ => by
    have st := rpass (Nat.le_refl k) n (j + 1) (j + 1) 0 []
    have sp := rpass_spent (Nat.le_refl k) n (j + 1) (j + 1) 0 []
    have e : (0 + 1) * (3 * k) + 3 * (0 * 0) + 7 * 0 = 3 * k := by omega
    have z : (0 * 0 - 0) * (4 * k + 4 * n + 5) = 0 := Nat.zero_mul _
    have o : (0 + 1) * (k * (5 * k + 4 * n + 5)) = k * (5 * k + 4 * n + 5) := Nat.one_mul _
    rw [e, z, o, Nat.add_zero]
    show _ ≤ XMach.soloTime xsys (rst k n (j + 1) (j + 1) 0) ⟨lone k ++ [], .idle⟩ (3 * k)
    rw [st.soloTime]
    exact sp
  | r + 1, j, h => by
    have p₁ := rpass (Nat.le_refl k) n (j + 1) (j + 1) (r + 1)
      (pairsDown (j + 2) r ++ [([j + 1, 3], c), ([j + 1, 4], c)])
    have p₂ := rpending (k := k) (n := n) (w := j + 1) (s := j + 1) (r := r + 1)
      (s' := j + 2) (r' := r) (by omega) (by omega) (by omega) (by omega)
      [([j + 1, 3], c), ([j + 1, 4], c)]
    have w₁ := p₁.works
    have w₂ := p₂.works
    have w₃ := (rfoundS k n j r (by omega) [([j + 1, 4], c)]).works
    have w₄ := rtake k n (j + 1) (j + 1) r [([j + 1, 4], c)]
    have w₅ := rwrites k n (j + 1) r [([j + 1, 4], c)]
    have t₁ : k * (5 * k + 4 * n + 5) ≤ XMach.soloTime xsys (rst k n (j + 1) (j + 1) (r + 1))
        ⟨lone k ++ (pairsDown (j + 2) r ++ [([j + 1, 3], c), ([j + 1, 4], c)]), .idle⟩
        (3 * k) := by
      rw [p₁.soloTime]
      exact rpass_spent (Nat.le_refl k) n (j + 1) (j + 1) (r + 1) _
    have t₂ : 2 * r * (4 * k + 4 * n + 5) ≤
        XMach.soloTime xsys (rst k n (j + 1) (j + 1) (r + 1))
          ⟨pairsDown (j + 2) r ++ [([j + 1, 3], c), ([j + 1, 4], c)], .idle⟩ (6 * r) := by
      rw [p₂.soloTime]
      exact rpending_spent (by omega) (by omega) (by omega) (by omega) _
    have s₂ := w₁.soloTime_ge t₁ t₂
    have s₃ := (w₁.trans w₂).soloTime_ge s₂ (b := 0) (j := 5) (Nat.zero_le _)
    have s₄ := ((w₁.trans w₂).trans w₃).soloTime_ge s₃ (b := 0) (j := 2) (Nat.zero_le _)
    have s₅ := (((w₁.trans w₂).trans w₃).trans w₄).soloTime_ge s₄ (b := 0) (j := 3)
      (Nat.zero_le _)
    have s₆ := ((((w₁.trans w₂).trans w₃).trans w₄).trans w₅).soloTime_ge s₅
      (rrunsS_time k n r (j + 1) (by omega))
    have sq : (r + 1) * (r + 1) = r * r + 2 * r + 1 := by
      rw [Nat.add_mul, Nat.mul_add, Nat.mul_one, Nat.one_mul]
      omega
    have e₂ : 3 * k + 6 * r + 5 + 2 + 3 + ((r + 1) * (3 * k) + 3 * (r * r) + 7 * r) =
        (r + 1 + 1) * (3 * k) + 3 * ((r + 1) * (r + 1)) + 7 * (r + 1) := by
      rw [Nat.add_mul (r + 1) 1 (3 * k), Nat.one_mul, sq]
      omega
    rw [e₂] at s₆
    have hr := Nat.le_mul_self r
    have e₃ : (r + 1) * (r + 1) - (r + 1) = (r * r - r) + 2 * r := by
      rw [sq]
      omega
    rw [e₃, Nat.add_mul (r * r - r) (2 * r) (4 * k + 4 * n + 5),
      Nat.add_mul (r + 1) 1 (k * (5 * k + 4 * n + 5)), Nat.one_mul]
    exact Nat.le_trans (by omega) s₆

/-- **The run of one thread on the chain listed from the last pair,
counted.** -/
theorem rruns0 (k n : Nat) :
    Works xsys (rst k (n + 1) 0 0 (n + 1)) ⟨(rst k (n + 1) 0 0 (n + 1)).agents, .idle⟩
      (rst k (n + 1) (n + 1) (n + 1) 0) ⟨[], .idle⟩ (n + 1)
      (3 * k + 6 * n + 8 + ((n + 1) * (3 * k) + 3 * (n * n) + 7 * n)) := by
  have v₁ := (rpass (Nat.le_refl k) (n + 1) 0 0 (n + 1)
    (pairsDown 1 n ++ [([0, 3], c), ([0, 4], c)])).works
  have v₂ := (rpending (k := k) (n := n + 1) (w := 0) (s := 0) (r := n + 1) (s' := 1)
    (r' := n) (by omega) (by omega) (by omega) (by omega) [([0, 3], c), ([0, 4], c)]).works
  have v₃ := (rfound0 k (n + 1) n [([0, 4], c)]).works
  have v₄ := rtake k (n + 1) 0 0 n [([0, 4], c)]
  have v₅ := rpaused k (n + 1) n (Nat.le_refl _) [([0, 4], c)]
  have w := (((v₁.trans v₂).trans v₃).trans v₄).trans v₅
  have e₁ : 0 + 0 + 0 + 1 + n = n + 1 := by omega
  have e₂ : 3 * k + 6 * n + 3 + 2 + (3 + ((n + 1) * (3 * k) + 3 * (n * n) + 7 * n)) =
      3 * k + 6 * n + 8 + ((n + 1) * (3 * k) + 3 * (n * n) + 7 * n) := by omega
  rw [e₁, e₂] at w
  exact w

/-- **The time of that run**: `n + 2` passes that read the whole memory for
each agent that leads nowhere, and every segment for each agent of a pair
that is not active yet. -/
theorem rruns0_time (k n : Nat) :
    (n + 2) * (k * (5 * k + 4 * n + 9)) + (n * n + n) * (4 * k + 4 * n + 9) ≤
      XMach.soloTime xsys (rst k (n + 1) 0 0 (n + 1))
        ⟨(rst k (n + 1) 0 0 (n + 1)).agents, .idle⟩
        (3 * k + 6 * n + 8 + ((n + 1) * (3 * k) + 3 * (n * n) + 7 * n)) := by
  have p₁ := rpass (Nat.le_refl k) (n + 1) 0 0 (n + 1)
    (pairsDown 1 n ++ [([0, 3], c), ([0, 4], c)])
  have p₂ := rpending (k := k) (n := n + 1) (w := 0) (s := 0) (r := n + 1) (s' := 1)
    (r' := n) (by omega) (by omega) (by omega) (by omega) [([0, 3], c), ([0, 4], c)]
  have v₁ := p₁.works
  have v₂ := p₂.works
  have v₃ := (rfound0 k (n + 1) n [([0, 4], c)]).works
  have v₄ := rtake k (n + 1) 0 0 n [([0, 4], c)]
  have v₅ := rwrites k (n + 1) 0 n [([0, 4], c)]
  have t₁ : k * (5 * k + 4 * (n + 1) + 5) ≤ XMach.soloTime xsys (rst k (n + 1) 0 0 (n + 1))
      ⟨lone k ++ (pairsDown 1 n ++ [([0, 3], c), ([0, 4], c)]), .idle⟩ (3 * k) := by
    rw [p₁.soloTime]
    exact rpass_spent (Nat.le_refl k) (n + 1) 0 0 (n + 1) _
  have t₂ : 2 * n * (4 * k + 4 * (n + 1) + 5) ≤
      XMach.soloTime xsys (rst k (n + 1) 0 0 (n + 1))
        ⟨pairsDown 1 n ++ [([0, 3], c), ([0, 4], c)], .idle⟩ (6 * n) := by
    rw [p₂.soloTime]
    exact rpending_spent (by omega) (by omega) (by omega) (by omega) _
  have s₂ := v₁.soloTime_ge t₁ t₂
  have s₃ := (v₁.trans v₂).soloTime_ge s₂ (b := 0) (j := 3) (Nat.zero_le _)
  have s₄ := ((v₁.trans v₂).trans v₃).soloTime_ge s₃ (b := 0) (j := 2) (Nat.zero_le _)
  have s₅ := (((v₁.trans v₂).trans v₃).trans v₄).soloTime_ge s₄ (b := 0) (j := 3)
    (Nat.zero_le _)
  have s₆ := ((((v₁.trans v₂).trans v₃).trans v₄).trans v₅).soloTime_ge s₅
    (rrunsS_time k (n + 1) n 0 (by omega))
  have e₂ : 3 * k + 6 * n + 3 + 2 + 3 + ((n + 1) * (3 * k) + 3 * (n * n) + 7 * n) =
      3 * k + 6 * n + 8 + ((n + 1) * (3 * k) + 3 * (n * n) + 7 * n) := by omega
  rw [e₂] at s₆
  have a₁ : 5 * k + 4 * (n + 1) + 5 = 5 * k + 4 * n + 9 := by omega
  have a₂ : 4 * k + 4 * (n + 1) + 5 = 4 * k + 4 * n + 9 := by omega
  rw [a₁, a₂] at s₆
  have hn := Nat.le_mul_self n
  have e₃ : n * n + n = (n * n - n) + 2 * n := by omega
  rw [e₃, Nat.add_mul (n * n - n) (2 * n) (4 * k + 4 * n + 9),
    Nat.add_mul (n + 1) 1 (k * (5 * k + 4 * n + 9)), Nat.one_mul]
  exact Nat.le_trans (by omega) s₆

/-- **The bound on the time against a run with claims.**  One thread on
`k` agents that lead nowhere and a chain of `n + 1` pairs listed from the
last to the first: the bound of `XMach.time_bound` is the first count, and
by the time the thread is at rest it has taken the second or more.  After
every claim it reads the whole memory again for each agent that leads
nowhere, and every segment for each agent of a pair still to come. -/
theorem time_chain (k n : Nat) :
    (∀ i, (XMach.init (rnet k (n + 1)) 1).time xsys (fun _ => 0) i ≤
        ((n + 2) * (11 * k + 20 * n + 22) + 3 * n + 3) * (6 * k + 10 * n + 15)) ∧
      ∀ i, ((XMach.init (rnet k (n + 1)) 1).trace xsys (fun _ => 0) i).1.resting = true →
        (n + 2) * (k * (5 * k + 4 * n + 9)) + (n * n + n) * (4 * k + 4 * n + 9) ≤
          (XMach.init (rnet k (n + 1)) 1).time xsys (fun _ => 0) i := by
  constructor
  · intro i
    obtain ⟨N', hs, hn⟩ := rnet_steps k n
    have hX : (rnet k (n + 1)).toNet.WF xsys.sys.ar := rnet_wf k (n + 1)
    have h := XMach.time_bound (xs := xsys) hX (rnet_nodup k (n + 1)) (nt := 1) (by decide)
      xsys_bounded hs hn (fun _ => 0) i
    have ha : (rnet k (n + 1)).agents.length = k + 2 * (n + 1) :=
      rst_agents_length k (n + 1) 0 0 (n + 1)
    have hw : (rnet k (n + 1)).wires.length = 2 * 0 + 4 * k + 4 * (n + 1) + 2 :=
      wires_length k (n + 1) 0
    rw [rnet_passBound, ha, hw] at h
    have a : 1 + (n + 1) = n + 2 := by omega
    have b : 11 * k + 20 * (n + 1) + 2 = 11 * k + 20 * n + 22 := by omega
    rw [a, b] at h
    have e₁ : (n + 2) * (11 * k + 20 * n + 22) + (n + 1) * (0 + 2 + 1) =
        (n + 2) * (11 * k + 20 * n + 22) + 3 * n + 3 := by omega
    have e₂ : 2 * (k + 2 * (n + 1) + 0 * (n + 1)) +
        (2 * 0 + 4 * k + 4 * (n + 1) + 2 + 2 * (n + 1)) + 0 + 2 + 1 =
        6 * k + 10 * n + 15 := by omega
    rw [e₁, e₂] at h
    exact h
  · intro i hr
    have hinit : XMach.init (rnet k (n + 1)) 1 =
        ⟨rst k (n + 1) 0 0 (n + 1), [⟨(rst k (n + 1) 0 0 (n + 1)).agents, .idle⟩]⟩ :=
      XMach.init_one _
    rw [hinit] at hr ⊢
    have ht := XMach.time_lone (xs := xsys)
      (M := ⟨rst k (n + 1) 0 0 (n + 1), [⟨(rst k (n + 1) 0 0 (n + 1)).agents, .idle⟩]⟩)
      (u := 0) (fun _ => 0) rfl (fun t T ht h => by
        cases t with
        | zero => exact absurd rfl ht
        | succ t => cases h) i
    rw [hits_const] at ht
    rw [ht]
    have hi : 3 * k + 6 * n + 8 + ((n + 1) * (3 * k) + 3 * (n * n) + 7 * n) ≤ i := by
      rcases Nat.lt_or_ge i (3 * k + 6 * n + 8 + ((n + 1) * (3 * k) + 3 * (n * n) + 7 * n))
        with h | h
      · exact absurd hr ((rruns0 k n).trace.2 i h)
      · exact h
    exact Nat.le_trans (rruns0_time k n) (XMach.soloTime_mono xsys _ _ hi)

/-- With at least one agent that leads nowhere, the bound is at most 168
times that time. -/
theorem time_chain_le (k n : Nat) (hk : 0 < k) :
    ((n + 2) * (11 * k + 20 * n + 22) + 3 * n + 3) * (6 * k + 10 * n + 15) ≤
      168 * ((n + 2) * (k * (5 * k + 4 * n + 9)) + (n * n + n) * (4 * k + 4 * n + 9)) := by
  have hX : n + 2 ≤ (n + 2) * k := Nat.le_mul_of_pos_right (n + 2) hk
  have hP : (n + 2) * (11 * k + 20 * n + 22) + 3 * n + 3 ≤
      56 * ((n + 2) * k + (n * n + n)) := by
    have e : (n + 2) * (11 * k + 20 * n + 22) =
        11 * ((n + 2) * k) + 20 * (n * n + 2 * n) + (n + 2) * 22 := by
      rw [Nat.mul_add (n + 2) (11 * k + 20 * n) 22, Nat.mul_add (n + 2) (11 * k) (20 * n),
        Nat.mul_left_comm (n + 2) 11 k, Nat.mul_left_comm (n + 2) 20 n, Nat.add_mul n 2 n]
    rw [e]
    omega
  have hα : 6 * k + 10 * n + 15 ≤ 3 * (5 * k + 4 * n + 9) := by omega
  have hβ : 6 * k + 10 * n + 15 ≤ 3 * (4 * k + 4 * n + 9) := by omega
  have h₁ := Nat.mul_le_mul_left ((n + 2) * k) hα
  have h₂ := Nat.mul_le_mul_left (n * n + n) hβ
  have e₁ : (n + 2) * k * (3 * (5 * k + 4 * n + 9)) =
      3 * ((n + 2) * (k * (5 * k + 4 * n + 9))) := by
    rw [Nat.mul_left_comm ((n + 2) * k) 3 (5 * k + 4 * n + 9),
      Nat.mul_assoc (n + 2) k (5 * k + 4 * n + 9)]
  rw [e₁] at h₁
  rw [Nat.mul_left_comm (n * n + n) 3] at h₂
  have hGQ : ((n + 2) * k + (n * n + n)) * (6 * k + 10 * n + 15) ≤
      3 * ((n + 2) * (k * (5 * k + 4 * n + 9)) + (n * n + n) * (4 * k + 4 * n + 9)) := by
    rw [Nat.add_mul, Nat.mul_add 3]
    exact Nat.add_le_add h₁ h₂
  have s₁ := Nat.mul_le_mul_right (6 * k + 10 * n + 15) hP
  rw [Nat.mul_assoc 56] at s₁
  have s₃ := Nat.mul_le_mul_left 56 hGQ
  rw [← Nat.mul_assoc 56 3] at s₃
  exact Nat.le_trans s₁ s₃

/-- The bound on the indexed time for one thread on `k` agents that lead
nowhere and a chain of `n + 1` pairs listed from the last to the first. -/
theorem itime_chain (k n : Nat) (σ : Nat → Nat) :
    ∀ i, (IMach.init (rnet k (n + 1)) 1).time xsys σ i ≤
      9 * ((n + 2) * (11 * k + 20 * n + 22) + 3 * n + 3) +
        (2 * n + 3) * (k + 2 * n + 2) := by
  intro i
  obtain ⟨N', hs, hn⟩ := rnet_steps k n
  have hX : (rnet k (n + 1)).toNet.WF xsys.sys.ar := rnet_wf k (n + 1)
  have h := IMach.time_bound (xs := xsys) hX (rnet_nodup k (n + 1)) (nt := 1) (by decide)
    xsys_bounded hs hn σ i
  have ha : (rnet k (n + 1)).agents.length = k + 2 * (n + 1) :=
    rst_agents_length k (n + 1) 0 0 (n + 1)
  rw [rnet_passBound, ha] at h
  have a : 1 + (n + 1) = n + 2 := by omega
  have b : 11 * k + 20 * (n + 1) + 2 = 11 * k + 20 * n + 22 := by omega
  rw [a, b] at h
  have e₁ : (n + 2) * (11 * k + 20 * n + 22) + (n + 1) * (0 + 2 + 1) =
      (n + 2) * (11 * k + 20 * n + 22) + 3 * n + 3 := by omega
  have e₂ : 2 * (n + 1) + 1 = 2 * n + 3 := by omega
  have e₃ : k + 2 * (n + 1) + 0 * (n + 1) = k + 2 * n + 2 := by omega
  rw [e₁, e₂, e₃, Nat.mul_comm _ (0 + 2 + 7)] at h
  exact h

/-- **What the index gains on a run with claims.**  One thread on `k`
agents that lead nowhere, at least one, and a chain of `n + 1` pairs
listed from the last to the first: by the time the thread is at rest
lists have taken `(6 * k + 10 * n + 15) / 1680` times as long as the
indexed memory, or more.  The constant is crude; the gain grows with the
net. -/
theorem index_gain (k n : Nat) (hk : 0 < k) (i : Nat)
    (hr : ((XMach.init (rnet k (n + 1)) 1).trace xsys (fun _ => 0) i).1.resting = true) :
    (6 * k + 10 * n + 15) * (IMach.init (rnet k (n + 1)) 1).time xsys (fun _ => 0) i ≤
      1680 * (XMach.init (rnet k (n + 1)) 1).time xsys (fun _ => 0) i := by
  have h₁ := itime_chain k n (fun _ => 0) i
  have h₂ := (time_chain k n).2 i hr
  have h₃ := time_chain_le k n hk
  have hs : (2 * n + 3) * (k + 2 * n + 2) ≤ (n + 2) * (11 * k + 20 * n + 22) := by
    have a := Nat.mul_le_mul (show 2 * n + 3 ≤ 2 * (n + 2) by omega)
      (Nat.le_refl (k + 2 * n + 2))
    have b := Nat.mul_le_mul_left (n + 2)
      (show 2 * (k + 2 * n + 2) ≤ 11 * k + 20 * n + 22 by omega)
    have e : 2 * (n + 2) * (k + 2 * n + 2) = (n + 2) * (2 * (k + 2 * n + 2)) := by
      rw [Nat.mul_comm 2 (n + 2), Nat.mul_assoc]
    rw [e] at a
    exact Nat.le_trans a b
  have h₄ : (IMach.init (rnet k (n + 1)) 1).time xsys (fun _ => 0) i ≤
      10 * ((n + 2) * (11 * k + 20 * n + 22) + 3 * n + 3) := by omega
  have h₅ := Nat.mul_le_mul_left (6 * k + 10 * n + 15) h₄
  have e : (6 * k + 10 * n + 15) * (10 * ((n + 2) * (11 * k + 20 * n + 22) + 3 * n + 3)) =
      10 * (((n + 2) * (11 * k + 20 * n + 22) + 3 * n + 3) * (6 * k + 10 * n + 15)) := by
    rw [Nat.mul_left_comm, Nat.mul_comm (6 * k + 10 * n + 15)]
  rw [e] at h₅
  have h₆ := Nat.mul_le_mul_left 10 h₃
  rw [← Nat.mul_assoc 10 168] at h₆
  exact Nat.le_trans h₅ (Nat.le_trans h₆ (Nat.mul_le_mul_left 1680 h₂))

/-- **The work of the run with claims.**  One thread on `k` agents that
lead nowhere and a chain of `n + 1` pairs listed from the last to the
first makes this many actions before it rests, and no other. -/
theorem work_chain (k n : Nat) (i : Nat)
    (hr : ((XMach.init (rnet k (n + 1)) 1).trace xsys (fun _ => 0) i).1.resting = true) :
    (XMach.init (rnet k (n + 1)) 1).work xsys (fun _ => 0) i =
      3 * k + 6 * n + 8 + ((n + 1) * (3 * k) + 3 * (n * n) + 7 * n) := by
  have hinit : XMach.init (rnet k (n + 1)) 1 =
      ⟨rst k (n + 1) 0 0 (n + 1), [⟨(rst k (n + 1) 0 0 (n + 1)).agents, .idle⟩]⟩ :=
    XMach.init_one _
  rw [hinit] at hr ⊢
  obtain ⟨tr, nr⟩ := (rruns0 k n).trace
  have hi : 3 * k + 6 * n + 8 + ((n + 1) * (3 * k) + 3 * (n * n) + 7 * n) ≤ i := by
    rcases Nat.lt_or_ge i (3 * k + 6 * n + 8 + ((n + 1) * (3 * k) + 3 * (n * n) + 7 * n))
      with h | h
    · exact absurd hr (nr i h)
    · exact h
  obtain ⟨d, rfl⟩ : ∃ d, i = 3 * k + 6 * n + 8 + ((n + 1) * (3 * k) + 3 * (n * n) + 7 * n) + d :=
    ⟨i - (3 * k + 6 * n + 8 + ((n + 1) * (3 * k) + 3 * (n * n) + 7 * n)), by omega⟩
  have hK : ((⟨rst k (n + 1) 0 0 (n + 1), [⟨(rst k (n + 1) 0 0 (n + 1)).agents, .idle⟩]⟩ :
      XMach Chain).trace xsys (fun _ => 0)
        (3 * k + 6 * n + 8 + ((n + 1) * (3 * k) + 3 * (n * n) + 7 * n))).1.resting = true := by
    rw [tr]
    rfl
  rw [XMach.work_rest (xs := xsys) (fun _ => 0) hK d]
  exact XMach.work_single nr _ (Nat.le_refl _)

/-- **The indexed time of that run from below.**  By the time the thread
is at rest the indexed program has taken twice its actions, less one for
each claim, or more. -/
theorem itime_ge (k n : Nat) (i : Nat)
    (hr : ((XMach.init (rnet k (n + 1)) 1).trace xsys (fun _ => 0) i).1.resting = true) :
    (n + 2) * (6 * k) + 6 * (n * n) + 25 * n + 15 ≤
      (IMach.init (rnet k (n + 1)) 1).time xsys (fun _ => 0) i := by
  have hw := work_chain k n i hr
  have hX : (rnet k (n + 1)).toNet.WF xsys.sys.ar := rnet_wf k (n + 1)
  have h := IMach.time_ge_work (xs := xsys) hX (rnet_nodup k (n + 1)) (nt := 1) (by decide)
    (fun _ => 0) i
  rw [hw] at h
  obtain ⟨N', hs, hn⟩ := rnet_steps k n
  obtain ⟨Φ, -, hΦ⟩ := XMach.work_measure (xs := xsys) hX (rnet_nodup k (n + 1)) (nt := 1)
    (by decide) xsys_bounded hs hn (fun _ => 0)
  have hc := (hΦ i).2.1
  have e : (n + 2) * (6 * k) = 2 * ((n + 1) * (3 * k)) + 6 * k := by
    rw [Nat.add_mul n 2 (6 * k), Nat.add_mul n 1 (3 * k), Nat.mul_left_comm n 6 k,
      Nat.mul_left_comm n 3 k]
    omega
  omega

/-- The bound on the indexed time is at most thirty-one times that. -/
theorem itime_chain_le (k n : Nat) :
    9 * ((n + 2) * (11 * k + 20 * n + 22) + 3 * n + 3) + (2 * n + 3) * (k + 2 * n + 2) ≤
      31 * ((n + 2) * (6 * k) + 6 * (n * n) + 25 * n + 15) := by
  have e₁ : (n + 2) * (11 * k + 20 * n + 22) =
      11 * (n * k) + 22 * k + 20 * (n * n) + 62 * n + 44 := by
    rw [Nat.mul_add, Nat.mul_add, Nat.add_mul n 2 (11 * k), Nat.add_mul n 2 (20 * n),
      Nat.add_mul n 2 22, Nat.mul_left_comm n 11 k, Nat.mul_left_comm n 20 n]
    omega
  have e₂ : (2 * n + 3) * (k + 2 * n + 2) =
      2 * (n * k) + 3 * k + 4 * (n * n) + 10 * n + 6 := by
    rw [Nat.mul_add, Nat.mul_add, Nat.add_mul (2 * n) 3 k, Nat.add_mul (2 * n) 3 (2 * n),
      Nat.add_mul (2 * n) 3 2, Nat.mul_assoc 2 n k, Nat.mul_assoc 2 n (2 * n),
      Nat.mul_left_comm n 2 n]
    omega
  have e₃ : (n + 2) * (6 * k) = 6 * (n * k) + 12 * k := by
    rw [Nat.add_mul n 2 (6 * k), Nat.mul_left_comm n 6 k]
    omega
  rw [e₁, e₂, e₃]
  omega

/-- The bound on the work for that run, whatever the schedule. -/
theorem work_bound (k n : Nat) (σ : Nat → Nat) :
    ∀ i, (XMach.init (rnet k (n + 1)) 1).work xsys σ i ≤
      (n + 2) * (11 * k + 20 * n + 22) + 3 * n + 3 := by
  intro i
  obtain ⟨N', hs, hn⟩ := rnet_steps k n
  have hX : (rnet k (n + 1)).toNet.WF xsys.sys.ar := rnet_wf k (n + 1)
  have h := XMach.work_le (xs := xsys) hX (rnet_nodup k (n + 1)) (nt := 1) (by decide)
    xsys_bounded hs hn σ i
  rw [rnet_passBound] at h
  have a : 1 + (n + 1) = n + 2 := by omega
  have b : 11 * k + 20 * (n + 1) + 2 = 11 * k + 20 * n + 22 := by omega
  rw [a, b] at h
  have e₁ : (n + 2) * (11 * k + 20 * n + 22) + (n + 1) * (0 + 2 + 1) =
      (n + 2) * (11 * k + 20 * n + 22) + 3 * n + 3 := by omega
  rw [e₁] at h
  exact h

/-- **The bound on the work is right up to a factor of seven** for one
thread on the chain: it is at most seven times the actions the thread
makes. -/
theorem work_bound_le (k n : Nat) :
    (n + 2) * (11 * k + 20 * n + 22) + 3 * n + 3 ≤
      7 * (3 * k + 6 * n + 8 + ((n + 1) * (3 * k) + 3 * (n * n) + 7 * n)) := by
  have e₁ : (n + 2) * (11 * k + 20 * n + 22) =
      11 * (n * k) + 22 * k + 20 * (n * n) + 62 * n + 44 := by
    rw [Nat.mul_add, Nat.mul_add, Nat.add_mul n 2 (11 * k), Nat.add_mul n 2 (20 * n),
      Nat.add_mul n 2 22, Nat.mul_left_comm n 11 k, Nat.mul_left_comm n 20 n]
    omega
  have e₂ : (n + 1) * (3 * k) = 3 * (n * k) + 3 * k := by
    rw [Nat.add_mul n 1 (3 * k), Nat.mul_left_comm n 3 k]
    omega
  rw [e₁, e₂]
  omega

end Chain

end INet

/-! ## Measuring the compiled program

No theorem of this file is about compiled code.  This section is the
program that was compiled and timed for the note on measurement in the
scope notes: it runs addition on ordered maps alone, on one thread, once
with everything counted and then, for the same number of actions, with
nothing counted and the clock running.  Nothing here is proved, and
nothing above depends on it. -/

namespace INet.Arith

/-- The actions to rest and the time with everything counted. -/
def runCount (X : XNet Arith) (fuel : Nat) : Nat × Nat := Id.run do
  let mut cur := OMach.init X 1
  let mut ct := 0
  for i in [0:fuel] do
    if cur.resting then return (i, ct)
    ct := ct + cur.stepFcost xsys 0
    cur := (cur.step xsys 0).1
  return (fuel, ct)

/-- The program alone: `steps` actions, nothing counted. -/
def runPlain (X : XNet Arith) (steps : Nat) : Nat := Id.run do
  let mut cur := OMach.init X 1
  for _ in [0:steps] do
    cur := (cur.step xsys 0).1
  return cur.mem.stamp

end INet.Arith

/-- For `k + k` with `k` from 24 to 768: the actions, the count, the time
of a run in nanoseconds, and the time for each unit counted in
picoseconds. -/
def main : IO Unit := do
  for k in [24, 48, 96, 192, 384, 768] do
    let X := INet.Arith.sum k k
    let (steps, cnt) := INet.Arith.runCount X 10000000
    let reps := if k ≤ 96 then 20 else 5
    let mut acc := 0
    let t0 ← IO.monoNanosNow
    for _ in [0:reps] do
      acc := acc + INet.Arith.runPlain X steps
    let t1 ← IO.monoNanosNow
    let ns := (t1 - t0) / reps
    IO.println s!"{k} actions={steps} count={cnt} ns={ns} ps/count={ns * 1000 / cnt} check={acc}"
