def predicate.resolving.visit
  (context : predicate.Context) (id : Std.U32)
  (state : predicate.resolving.State) (arena : predicate.Arena) (meter : Meter)
  :
  Result ((core.result.Result Unit Diagnostic) × predicate.resolving.State ×
    predicate.Arena × Meter)
  := do
  let r ← syntax.Tree.node context.tree id
  match r with
  | core.result.Result.Ok value =>
    match value.form with
    | syntax.Form.Atom =>
      let r1 ← syntax.Tree.atom context.tree context.source id
      match r1 with
      | core.result.Result.Ok value1 =>
        let (r2, meter1) ←
          predicate.resolving.literal value1 value.span meter
        match r2 with
        | core.result.Result.Ok value2 =>
          let (kind, ty) := value2
          let (r3, arena1, meter2) ←
            predicate.Arena.push arena
              {
                kind,
                ty,
                span := value.span,
                total := true,
                uses_output := false
              } meter1
          match r3 with
          | core.result.Result.Ok value3 =>
            let v ← alloc.vec.Vec.push state.values value3
            ok (core.result.Result.Ok (), { state with values := v }, arena1,
              meter2)
          | core.result.Result.Err failure =>
            ok (core.result.Result.Err failure, state, arena1, meter2)
        | core.result.Result.Err failure =>
          ok (core.result.Result.Err failure, state, arena, meter1)
      | core.result.Result.Err failure =>
        ok (core.result.Result.Err failure, state, arena, meter)
    | syntax.Form.Round children =>
      let s := alloc.vec.Vec.deref children
      predicate.resolving.round context { children := s, span := value.span }
        state arena meter
    | syntax.Form.Square _ =>
      let d ←
        Diagnostic.new DiagnosticKind.Unsupported value.span (toStr
          "executable quotations are not logical terms; refer to a typed program binding")
      ok (core.result.Result.Err d, state, arena, meter)
