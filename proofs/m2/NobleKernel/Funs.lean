def contracts.nominal.generic_descriptor_matches
  (decl : contracts.GenericVariantDecl) (args : Array types.Ty 2#usize)
  (shape : types.NominalShape) :
  Result Bool
  := do
  let left ← Array.index_usize decl.payload_params 0#usize
  let right ← Array.index_usize decl.payload_params 1#usize
  match shape with
  | types.NominalShape.Opaque _ => ok false
  | types.NominalShape.Variant first second =>
    let b ←
      match left with
      | 0#uscalar => match right with
                     | 1#uscalar => ok true
                     | _ => ok false
      | 1#uscalar => match right with
                     | 0#uscalar => ok true
                     | _ => ok false
      | _ => ok false
    if b
    then
      let i ← lift (core.convert.num.FromUsizeU8.from left)
      let t ← Array.index_usize args i
      let b1 ← contracts.nominal.same_generic_arg first t
      if b1
      then
        let i1 ← lift (core.convert.num.FromUsizeU8.from right)
        let t1 ← Array.index_usize args i1
        contracts.nominal.same_generic_arg second t1
      else ok false
    else ok false

