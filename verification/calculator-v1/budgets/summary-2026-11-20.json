 "revision": {
  "date": "2026-11-20",
  "decision": "OWNER DECISION 2026-11-20: \"... the reviewed revision of the four drifted CALC-08 control rows is authorized ...\"",
  "reason": "The four control rows below were written for the 44329dc replay design. CALC-STATE-02's selected committed-session route removed the host replay preflight and made a dead or memory-capped worker end the session, so two rows asserted a refusal that cannot fire and two expected silent recovery. Each change is recorded here and on its row; no category bracket or its predicted boundary N was changed, and no row was re-pointed at an observation.",
  "changes": [
   {
    "row": "control/history-bytes",
    "change": "retired",
    "explanation": "The `HostLimit HistoryBytes` replay preflight no longer exists; the 65,536-byte input frame is the surviving host bound and control/transport-limit exercises it."
   },
   {
    "row": "control/replay-work",
    "change": "retired",
    "explanation": "The `HostLimit ReplayWork` replay preflight no longer exists for the same reason."
   },
   {
    "row": "control/worker-killed",
    "change": "expectation replaced",
    "explanation": "CALC-STATE-02 requires a restore verification failure to end the session, so a killed worker now ends it with `noble calculator: calculator restore failed` and exit 2 instead of the 44329dc silent recovery with exit 0."
   },
   {
    "row": "control/memory-cap",
    "change": "expectation replaced",
    "explanation": "A scope too small for the worker now closes the reply stream, which the host reports as `noble calculator: engine worker closed its reply stream` with exit 2, instead of an externally killed process with no output."
   }
  ]
 },
