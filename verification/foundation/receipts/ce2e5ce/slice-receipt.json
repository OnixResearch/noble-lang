    "theorems": [
      {
        "name": "NobleFoundation.sub_operand_order",
        "statement": "NobleFoundation.sub_operand_order : ∀ (pre t : NobleContracts.Stack), (NobleContracts.Exec (NobleFoundation.lowerAll [NobleFoundation.AOp.push 3, NobleFoundation.AOp.push 8, NobleFoundation.AOp.sub]) pre t ↔ t = pre ++ [NobleFoundation.i64v (-5)]) ∧ (NobleContracts.Exec (NobleFoundation.lowerAll [NobleFoundation.AOp.push 8, NobleFoundation.AOp.push 3, NobleFoundation.AOp.sub]) pre t ↔ t = pre ++ [NobleFoundation.i64v 5]) ∧ NobleFoundation.i64v (-5) ≠ NobleFoundation.i64v 5",
        "axioms": [
          "propext",
          "Classical.choice",
          "Quot.sound"
        ]
      },
      {
        "name": "NobleFoundation.helper_refines_step",
        "statement": "@NobleFoundation.helper_refines_step : ∀ {limit quota w : ℕ} {f : NobleFoundation.WState → NobleFoundation.WState}, NobleFoundation.helper limit quota w = some f → ∀ {a b : BitVec 64} {vs : NobleContracts.Stack} {ss : List NobleFoundation.Slot}, NobleFoundation.SlotsRel vs ss → (ss.length + 2) * 16 ≤ limit → ∃ t, NobleContracts.Step (NobleContracts.Op.word w) (NobleContracts.Value.i64 b :: NobleContracts.Value.i64 a :: vs) t ∧ (∀ (t' : NobleContracts.Stack), NobleContracts.Step (NobleContracts.Op.word w) (NobleContracts.Value.i64 b :: NobleContracts.Value.i64 a :: vs) t' → t' = t) ∧ ∃ ss', f { slots := { tag := 1, payload := b } :: { tag := 1, payload := a } :: ss, failure := 0 } = { slots := ss', failure := 0 } ∧ NobleFoundation.SlotsRel t ss'",
        "axioms": [
          "propext",
          "Quot.sound"
        ]
      },
      {
        "name": "NobleFoundation.helper_fails_when_stuck",
        "statement": "@NobleFoundation.helper_fails_when_stuck : ∀ {limit quota w : ℕ} {f : NobleFoundation.WState → NobleFoundation.WState}, NobleFoundation.helper limit quota w = some f → ∀ {u v : NobleContracts.Value} {vs : NobleContracts.Stack} {su sv : NobleFoundation.Slot} {ss : List NobleFoundation.Slot}, NobleFoundation.SlotsRel (v :: u :: vs) (sv :: su :: ss) → ((∀ (x : BitVec 64), v ≠ NobleContracts.Value.i64 x) ∨ ∀ (x : BitVec 64), u ≠ NobleContracts.Value.i64 x) → (∀ (t : NobleContracts.Stack), ¬NobleContracts.Step (NobleContracts.Op.word w) (v :: u :: vs) t) ∧ (f { slots := sv :: su :: ss, failure := 0 }).failure = 4",
        "axioms": [
          "propext"
        ]
      },
      {
        "name": "NobleFoundation.swapped_helper_refuted",
        "statement": "NobleFoundation.swapped_helper_refuted : NobleFoundation.opBinary 64 1 (fun x1 x2 => x1 - x2) { slots := [{ tag := 1, payload := 8 }, { tag := 1, payload := 3 }], failure := 0 } = { slots := [{ tag := 1, payload := BitVec.ofInt 64 (-5) }], failure := 0 } ∧ NobleFoundation.opBinarySwapped 64 1 (fun x1 x2 => x1 - x2) { slots := [{ tag := 1, payload := 8 }, { tag := 1, payload := 3 }], failure := 0 } = { slots := [{ tag := 1, payload := 5 }], failure := 0 } ∧ BitVec.ofInt 64 (-5) ≠ 5",
        "axioms": [
          "propext"
        ]
      },
      {
        "name": "NobleFoundation.slice_body_exec",
        "statement": "NobleFoundation.slice_body_exec : ∀ (pre : NobleContracts.Stack) (n : BitVec 64) (t : NobleContracts.Stack), NobleContracts.Exec NobleFoundation.sliceBody (pre ++ [NobleContracts.Value.i64 n]) t ↔ t = pre ++ [NobleContracts.Value.i64 (n + 1)]",
        "axioms": [
          "propext",
          "Quot.sound"
        ]
      },
      {
        "name": "NobleFoundation.slice_body_signed",
        "statement": "NobleFoundation.slice_body_signed : ∀ (pre : NobleContracts.Stack) (x : ℤ) (t : NobleContracts.Stack), NobleContracts.Exec NobleFoundation.sliceBody (pre ++ [NobleFoundation.i64v x]) t ↔ t = pre ++ [NobleFoundation.i64v (MathlibI64.wrap (x + 1))]",
        "axioms": [
          "propext",
          "Classical.choice",
          "Quot.sound"
        ]
      },
      {
        "name": "NobleFoundation.slice_root_inert",
        "statement": "NobleFoundation.slice_root_inert : ∀ (s t : NobleContracts.Stack), NobleContracts.Exec NobleFoundation.sliceRoot s t ↔ t = s ++ [NobleContracts.Value.program NobleFoundation.sliceBody]",
        "axioms": [
          "propext",
          "Quot.sound"
        ]
      },
      {
        "name": "NobleFoundation.slice_driver",
        "statement": "NobleFoundation.slice_driver : ∀ (pre : NobleContracts.Stack) (x : ℤ) (t : NobleContracts.Stack), NobleContracts.Exec (NobleFoundation.sliceRoot ++ [NobleContracts.Op.word 10]) (pre ++ [NobleFoundation.i64v x]) t ↔ t = pre ++ [NobleFoundation.i64v (MathlibI64.wrap (x + 1))]",
        "axioms": [
          "propext",
          "Classical.choice",
          "Quot.sound"
        ]
      },
      {
        "name": "NobleFoundation.slice_body_typed",
        "statement": "NobleFoundation.slice_body_typed : ∀ (base : List NobleContracts.Ty), NobleContracts.CodeTyped NobleFoundation.sliceBody (base ++ [NobleContracts.Ty.i64]) (base ++ [NobleContracts.Ty.i64])",
        "axioms": [
          "propext"
        ]
      },
      {
        "name": "NobleFoundation.slice_exported_claim",
        "statement": "NobleFoundation.slice_exported_claim : NobleContracts.exportedClaim NobleFoundation.sliceBody [NobleContracts.Ty.i64] [NobleContracts.Ty.i64] [] (fun x x_1 x_2 => True) fun before after x => ∃ n, before = [NobleContracts.Value.i64 n] ∧ after = [NobleContracts.Value.i64 (n + 1)]",
        "axioms": [
          "propext",
          "Quot.sound"
        ]
      },
      {
        "name": "NobleFoundation.slice_examples",
        "statement": "NobleFoundation.slice_examples : ∀ (pre t : NobleContracts.Stack), (NobleContracts.Exec (NobleFoundation.sliceRoot ++ [NobleContracts.Op.word 10]) (pre ++ [NobleFoundation.i64v 41]) t ↔ t = pre ++ [NobleFoundation.i64v 42]) ∧ (NobleContracts.Exec (NobleFoundation.sliceRoot ++ [NobleContracts.Op.word 10]) (pre ++ [NobleFoundation.i64v 9223372036854775807]) t ↔ t = pre ++ [NobleFoundation.i64v (-9223372036854775808)])",
        "axioms": [
          "propext",
          "Classical.choice",
          "Quot.sound"
        ]
      }
