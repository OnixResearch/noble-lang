  "theorems": [
    {
      "name": "NobleFoundation.PExpr.exec_inputs_run",
      "statement": "NobleFoundation.PExpr.exec_inputs_run : ∀ (P : NobleFoundation.PExpr) (ins : List NobleFoundation.AOp) {zs' : List ℤ}, NobleFoundation.refRun (ins ++ P.flat) [] = some zs' → ∀ (pre t : NobleContracts.Stack), NobleContracts.Exec (NobleFoundation.lowerAll ins ++ (P.code ++ [NobleContracts.Op.word 10])) pre t ↔ t = pre ++ NobleFoundation.enc zs'",
      "axioms": [
        "propext",
        "Classical.choice",
        "Quot.sound"
      ]
    },
    {
      "name": "NobleFoundation.exec_lowerAll_from_empty",
      "statement": "@NobleFoundation.exec_lowerAll_from_empty : ∀ {ops : List NobleFoundation.AOp} {zs' : List ℤ}, NobleFoundation.refRun ops [] = some zs' → ∀ (pre t : NobleContracts.Stack), NobleContracts.Exec (NobleFoundation.lowerAll ops) pre t ↔ t = pre ++ NobleFoundation.enc zs'",
      "axioms": [
        "propext",
        "Classical.choice",
        "Quot.sound"
      ]
    },
    {
      "name": "NobleFoundation.exec_inputs_nested",
      "statement": "NobleFoundation.exec_inputs_nested : ∀ (ins ops : List NobleFoundation.AOp) {zs' : List ℤ}, NobleFoundation.refRun (ins ++ ops) [] = some zs' → ∀ (pre t : NobleContracts.Stack), NobleContracts.Exec (NobleFoundation.lowerAll ins ++ [NobleContracts.Op.block (NobleFoundation.lowerAll ops), NobleContracts.Op.word 8, NobleContracts.Op.word 10, NobleContracts.Op.word 10]) pre t ↔ t = pre ++ NobleFoundation.enc zs'",
      "axioms": [
        "propext",
        "Classical.choice",
        "Quot.sound"
      ]
    },
    {
      "name": "NobleFoundation.exec_lowerAll",
      "statement": "@NobleFoundation.exec_lowerAll : ∀ {ops : List NobleFoundation.AOp} {zs zs' : List ℤ}, NobleFoundation.refRun ops zs = some zs' → ∀ (pre t : NobleContracts.Stack), NobleContracts.Exec (NobleFoundation.lowerAll ops) (pre ++ NobleFoundation.enc zs) t ↔ t = pre ++ NobleFoundation.enc zs'",
      "axioms": [
        "propext",
        "Classical.choice",
        "Quot.sound"
      ]
    },
    {
      "name": "NobleFoundation.PExpr.exec_run_ref",
      "statement": "NobleFoundation.PExpr.exec_run_ref : ∀ (P : NobleFoundation.PExpr) {zs zs' : List ℤ}, NobleFoundation.refRun P.flat zs = some zs' → ∀ (pre t : NobleContracts.Stack), NobleContracts.Exec (P.code ++ [NobleContracts.Op.word 10]) (pre ++ NobleFoundation.enc zs) t ↔ t = pre ++ NobleFoundation.enc zs'",
      "axioms": [
        "propext",
        "Classical.choice",
        "Quot.sound"
      ]
    },
    {
      "name": "NobleFoundation.accumulate_eq_acceptLiteral",
      "statement": "NobleFoundation.accumulate_eq_acceptLiteral : ∀ (negative : Bool) (ds : List (Fin 10)), NobleFoundation.accumulate negative ds = NobleFoundation.acceptLiteral negative ds",
      "axioms": [
        "propext",
        "Classical.choice",
        "Quot.sound"
      ]
    },
    {
      "name": "NobleFoundation.refRun_range",
      "statement": "@NobleFoundation.refRun_range : ∀ {ops : List NobleFoundation.AOp} {zs zs' : List ℤ}, NobleFoundation.refRun ops zs = some zs' → (∀ z ∈ zs, NobleFoundation.I64Range z) → ∀ z ∈ zs', NobleFoundation.I64Range z",
      "axioms": [
        "propext",
        "Classical.choice",
        "Quot.sound"
      ]
    },
    {
      "name": "NobleFoundation.wrap_eq_knum01",
      "statement": "NobleFoundation.wrap_eq_knum01 : ∀ (z : ℤ), MathlibI64.wrap z = (z + 2 ^ 63) % 2 ^ 64 - 2 ^ 63",
      "axioms": [
        "propext",
        "Classical.choice",
        "Quot.sound"
      ]
    }
  ],
