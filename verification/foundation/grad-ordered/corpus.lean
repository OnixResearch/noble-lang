import NobleFoundation.ReverseADOrdered

/-!
# Ordered binary32 gradient corpus (issue #45)

Prints one case per line. Every forward value and every gradient in a line comes from the ordered
binary32 reference `NobleFoundation.ReverseAD.Ordered` and from nothing else.
`crates/noble-ngraph/tests/grad_ordered/differential.rs` builds each graph with the Rust IR, runs
`grad::forward` and `grad::backward` for `f32`, and compares, so the expected values are
independent of the implementation under test.

Line format (fields separated by one space):

```text
NAME nodes=N;N;... slots=HEX,... seeds=OUTPUT:HEX,... values=HEX,... grads=HEX,...
```

A node is `iK` or `pK` (input or parameter slot `K`), `cHEX` (a binary32 constant), or `aX.Y`,
`sX.Y`, `mX.Y` (add, subtract, multiply of nodes `X` and `Y`). Slots are numbered in node order, as
`GraphBuilder` numbers them, and both kinds read the same slot list, as `grad::forward` does. Every
`HEX` is eight lowercase hexadecimal digits of a binary32 encoding.

The first cases are the fixtures of `ReverseADOrdered.lean`. The rest are generated by SplitMix64
from a fixed seed over value pools chosen for absorption (`2^24`), exact cancellation, signed zeros,
subnormals and overflow.

Run from `proofs/foundation`:

```text
lake env lean --run ../../verification/foundation/grad-ordered/corpus.lean \
  > ../../crates/noble-ngraph/tests/grad_ordered/corpus.txt
```
-/

namespace NobleFoundation.ReverseAD.Ordered.Corpus

open NobleFoundation.ReverseAD.Ordered
open NobleFoundation.Binary32 (Bits zeroOf oneBits negOneBits twoPow24Bits)

def hex (bits : Bits) : String :=
  let digits := Nat.toDigits 16 bits.toNat
  String.ofList (List.replicate (8 - digits.length) '0' ++ digits)

def nodeText : Node → String
  | .input slot => s!"i{slot}"
  | .param slot => s!"p{slot}"
  | .constant bits => s!"c{hex bits}"
  | .add a b => s!"a{a}.{b}"
  | .sub a b => s!"s{a}.{b}"
  | .mul a b => s!"m{a}.{b}"

structure Case where
  name : String
  nodes : List Node
  slots : List Bits
  seeds : List (Nat × Bits)

def line (c : Case) : String :=
  let lookup := fun slot => c.slots.getD slot zero
  let values := forward c.nodes lookup lookup
  let grads := backward c.nodes values c.seeds
  let seedText := c.seeds.map (fun seed => s!"{seed.1}:{hex seed.2}")
  s!"{c.name} nodes={";".intercalate (c.nodes.map nodeText)} slots={",".intercalate (c.slots.map hex)} " ++
    s!"seeds={",".intercalate seedText} values={",".intercalate (values.map hex)} " ++
    s!"grads={",".intercalate (grads.map hex)}"

/-- The fixtures of `ReverseADOrdered.lean`, with their slot values and seeds. -/
def fixtures : List Case := [
  ⟨"fixture-cancel-first", cancelFirst, [oneBits], outputSeed⟩,
  ⟨"fixture-cancel-second", cancelSecond, [oneBits], outputSeed⟩,
  ⟨"fixture-repeated", repeated, [oneBits], [(4, oneBits)]⟩,
  ⟨"fixture-repeated-seeds", identity, [oneBits], [(0, oneBits), (0, twoBits)]⟩,
  ⟨"fixture-negative-zero-seed", identity, [oneBits], [(0, zeroOf true)]⟩,
  ⟨"fixture-square", square, [threeBits], [(3, oneBits)]⟩
]

/-! ## Generated cases -/

/-- SplitMix64, the generator `noble_ngraph::prng` also uses. -/
structure Rng where
  state : UInt64

def Rng.next (rng : Rng) : UInt64 × Rng :=
  let state := rng.state + 0x9E3779B97F4A7C15
  let z := (state ^^^ (state >>> 30)) * 0xBF58476D1CE4E5B9
  let z := (z ^^^ (z >>> 27)) * 0x94D049BB133111EB
  (z ^^^ (z >>> 31), ⟨state⟩)

/-- A uniform choice below `bound`, which must be positive. -/
def Rng.below (rng : Rng) (bound : Nat) : Nat × Rng :=
  let (value, rng) := rng.next
  (value.toNat % bound, rng)

def Rng.pick {α : Type} [Inhabited α] (rng : Rng) (pool : List α) : α × Rng :=
  let (index, rng) := rng.below pool.length
  (pool.getD index default, rng)

/-- Finite constants: units, small integers, `±2^24`, `2^-24`, the largest finite value, a
subnormal and negative zero. -/
def constantPool : List Bits :=
  [oneBits, negOneBits, 0x3F000000, twoBits, threeBits, twoPow24Bits, negTwoPow24Bits, 0x33800000,
    0x7F7FFFFF, 0x00000003, zeroOf true]

/-- Slot values: the constants plus positive zero and a value near the largest finite. -/
def slotPool : List Bits := constantPool ++ [zeroOf false, 0x7F000000]

/-- Seeds: units, a half, `2^24`, three and negative zero. -/
def seedPool : List Bits := [oneBits, negOneBits, 0x3F000000, twoPow24Bits, threeBits, zeroOf true]

def iterate {σ : Type} (count : Nat) (step : Nat → σ → σ) (start : σ) : σ :=
  (List.range count).foldl (fun state index => step index state) start

def operandsOf : Node → List Nat
  | .add a b | .sub a b | .mul a b => [a, b]
  | _ => []

/-- The Rust checker refuses a node that reaches no output. Scanning down from the newest node, a
node that no output reaches becomes an output itself, with a seed from the pool, so every node is
live and the extra outputs exercise seeds on interior, slot and constant nodes. -/
def closeOutputs (nodes : List Node) (seeds : List (Nat × Bits)) (rng : Rng) :
    List (Nat × Bits) × Rng :=
  let start : List Bool := (List.range nodes.length).map (fun index => seeds.any (·.1 == index))
  let (_, seeds, rng) := (List.range nodes.length).reverse.foldl (fun (live, seeds, rng) index =>
    let (live, seeds, rng) :=
      if live.getD index false then (live, seeds, rng)
      else
        let (seed, rng) := rng.pick seedPool
        (live.set index true, seeds ++ [(index, seed)], rng)
    let live := (operandsOf (nodes.getD index (.constant zero))).foldl
      (fun live operand => live.set operand true) live
    (live, seeds, rng)) (start, seeds, rng)
  (seeds, rng)

/-- One generated graph: one to three slots, up to two constants, one to eight arithmetic nodes over
earlier nodes (operands may repeat), one or two outputs and their seeds, plus an output for every
node no other output reaches. -/
def generate (name : String) (rng : Rng) : Case × Rng :=
  let (slotCount, rng) := rng.below 3
  let slotCount := slotCount + 1
  let (nodes, slots, rng) := iterate slotCount (fun slot (nodes, slots, rng) =>
    let (kind, rng) := rng.below 2
    let (value, rng) := rng.pick slotPool
    let node : Node := if kind = 0 then .input slot else .param slot
    (nodes ++ [node], slots ++ [value], rng)) (([] : List Node), ([] : List Bits), rng)
  let (constantCount, rng) := rng.below 3
  let (nodes, rng) := iterate constantCount (fun _ (nodes, rng) =>
    let (value, rng) := rng.pick constantPool
    (nodes ++ [Node.constant value], rng)) (nodes, rng)
  let (operationCount, rng) := rng.below 8
  let (nodes, rng) := iterate (operationCount + 1) (fun _ (nodes, rng) =>
    let (kind, rng) := rng.below 3
    let (a, rng) := rng.below nodes.length
    let (b, rng) := rng.below nodes.length
    let node : Node := if kind = 0 then .add a b else if kind = 1 then .sub a b else .mul a b
    (nodes ++ [node], rng)) (nodes, rng)
  let last := nodes.length - 1
  let (firstSeed, rng) := rng.pick seedPool
  let (extra, rng) := rng.below 2
  let (other, rng) := rng.below nodes.length
  let (otherSeed, rng) := rng.pick seedPool
  let seeds := if extra = 0 then [(last, firstSeed)] else [(last, firstSeed), (other, otherSeed)]
  let (seeds, rng) := closeOutputs nodes seeds rng
  (⟨name, nodes, slots, seeds⟩, rng)

def generated (count : Nat) : List Case :=
  (iterate count (fun index (cases, rng) =>
    let (c, rng) := generate s!"generated-{index}" rng
    (cases ++ [c], rng)) (([] : List Case), (⟨0x4E4F424C45343500⟩ : Rng))).1

end NobleFoundation.ReverseAD.Ordered.Corpus

open NobleFoundation.ReverseAD.Ordered.Corpus in
def main : IO Unit := do
  let cases := fixtures ++ generated 300
  IO.println s!"# cases: {cases.length}"
  for c in cases do
    IO.println (line c)
