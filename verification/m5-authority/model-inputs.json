  "scope": "Retained M5 Charon/Aeneas translation of the authority ledger, compiled anew for each run. The checker binds every Rust source file with a generated declaration reachable from the inventoried theorems to its extraction-recorded bytes; the translation step itself is not re-run.",
  "mutation_controls": [
    {
      "id": "omitted-quota-charge",
      "removes": "the checkpoint-local quota charge in charge_quota (both the existing-record and the new-record branch)",
      "edits": [
        {
          "find": "      let v := index_mut_back { qr1 with spent }\n",
          "replace": "      let v := index_mut_back { qr1 with spent := qr1.spent }\n"
        },
        {
          "find": "           spent := plan.description.constraints.units\n",
          "replace": "           spent := 0#u64\n"
        }
      ],
      "must_lose_strict_axioms": [
        "M5Authority.charge_quota_charges_the_plan_units",
        "M5Authority.committed_admission_charges_within_the_supplied_quota"
      ]
    },
    {
      "id": "omitted-witness-consumption",
      "removes": "marking the claimed witness consumed in commit",
      "edits": [
        {
          "find": "        { wr with state := authority.permit.WitnessState.Consumed }\n",
          "replace": "        { wr with state := wr.state }\n"
        }
      ],
      "must_lose_strict_axioms": [
        "M5Authority.commit_consumes_the_claimed_witness",
        "M5Authority.committed_admission_consumes_one_live_witness"
      ]
    },
    {
      "id": "omitted-exact-plan-comparison",
      "removes": "the retained-witness exact-plan comparison in validate_entry",
      "edits": [
        {
          "find": "              authority.Plan.Insts.CoreCmpPartialEqPlan value.plan request.plan\n",
          "replace": "              authority.Plan.Insts.CoreCmpPartialEqPlan request.plan request.plan\n"
        }
      ],
      "must_lose_strict_axioms": [
        "M5Authority.validate_entry_requires_the_exact_plan",
        "M5Authority.committed_admission_binds_the_exact_plan"
      ]
    },
    {
      "id": "omitted-checkpoint-validation",
      "removes": "the facts checkpoint comparison in validate_facts",
      "edits": [
        {
          "find": "            facts.checkpoint self.profile.checkpoint\n",
          "replace": "            self.profile.checkpoint self.profile.checkpoint\n"
        }
      ],
      "must_lose_strict_axioms": [
        "M5Authority.validate_facts_requires_the_current_checkpoint",
        "M5Authority.committed_admission_requires_the_current_checkpoint"
      ]
    },
    {
      "id": "omitted-started-refusal",
      "removes": "the already-started refusal in start_execution",
      "edits": [
        {
          "find": "    if value.started\n    then\n      ok (core.result.Result.Err authority.report.BoundaryError.AlreadyStarted,\n",
          "replace": "    if false && value.started\n    then\n      ok (core.result.Result.Err authority.report.BoundaryError.AlreadyStarted,\n"
        }
      ],
      "must_lose_strict_axioms": [
        "M5Authority.start_execution_refuses_a_started_attempt",
        "M5Authority.started_attempt_cannot_start_again"
      ]
    },
    {
      "id": "omitted-protected-operation-count",
      "removes": "the protected-operation increment in start_execution",
      "edits": [
        {
          "find": "        let i ← self.counters.protected_operations + 1#u32\n",
          "replace": "        let i ← self.counters.protected_operations + 0#u32\n"
        }
      ],
      "must_lose_strict_axioms": [
        "M5Authority.start_execution_marks_one_unstarted_attempt",
        "M5Authority.reachable_ledger_consistent"
      ]
    },
    {
      "id": "retire-consumed-witness",
      "removes": "the live-state guard in retire_witness, which then retires a consumed witness",
      "edits": [
        {
          "find": "    | authority.permit.WitnessState.Live =>\n      let (wr, index_mut_back) ←\n        alloc.vec.Vec.index_mut (core.slice.index.SliceIndexUsizeSlice\n          authority.WitnessRecord) self.witnesses witness.claim.slot\n",
          "replace": "    | authority.permit.WitnessState.Consumed =>\n      let (wr, index_mut_back) ←\n        alloc.vec.Vec.index_mut (core.slice.index.SliceIndexUsizeSlice\n          authority.WitnessRecord) self.witnesses witness.claim.slot\n"
        },
        {
          "find": "    | authority.permit.WitnessState.Consumed =>\n      ok (core.result.Result.Err authority.permit.Denial.ConsumedWitness, self)\n",
          "replace": "    | authority.permit.WitnessState.Live =>\n      ok (core.result.Result.Err authority.permit.Denial.ConsumedWitness, self)\n"
        }
      ],
      "must_lose_strict_axioms": [
        "M5Authority.retire_moves_ledger",
        "M5Authority.consumed_witness_never_returns_to_live",
        "M5Authority.reachable_ledger_consistent"
      ]
    }
  ]
}
