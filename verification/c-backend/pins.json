  "negative_controls": [
    {
      "id": "CB-NC-01",
      "control": "Cached bubblewrap/libseccomp or the Lean proof sandbox",
      "insufficient_shortcut": "Package availability is not native runner selection",
      "required_gate": "Reviewed separate default-disabled C policy, exact pins and owner approval",
      "requirements": ["CB-SANDBOX-01"],
      "cases": ["CB-CASE-08", "CB-CASE-10"],
      "status": "not-executed"
    },
    {
      "id": "CB-NC-02",
      "control": "../, ancestor symlink, hardlink or swapped parent",
      "insufficient_shortcut": "canonicalize, final-component O_NOFOLLOW and pathname digest race",
      "required_gate": "Descriptor-anchored no-symlink walk and sealed byte snapshot",
      "requirements": ["CB-ADMIT-01"],
      "cases": ["CB-CASE-05"],
      "status": "not-executed"
    },
    {
      "id": "CB-NC-03",
      "control": "Forged C comment or ELF inert-section change",
      "insufficient_shortcut": "Syntax, manifest flag or .text hash cannot establish native correspondence",
      "required_gate": "Trusted C re-emission and reproducible full-ELF byte equality",
      "requirements": ["CB-ADMIT-01"],
      "cases": ["CB-CASE-05"],
      "status": "not-executed"
    },
    {
      "id": "CB-NC-04",
      "control": "PT_INTERP, LD_PRELOAD, writable loader or executable mapping",
      "insufficient_shortcut": "Outside code runs despite admitted ELF bytes",
      "required_gate": "Reviewed static startup or exact immutable loader/ABI closure and post-load filter",
      "requirements": ["CB-SANDBOX-01", "CB-ADMIT-01"],
      "cases": ["CB-CASE-08"],
      "status": "not-executed"
    },
    {
      "id": "CB-NC-05",
      "control": "Deny all execve before initial load, or allow it afterward",
      "insufficient_shortcut": "First prevents launch; second permits substitution",
      "required_gate": "Trusted initial-load versus final no-exec stage before guest instructions",
      "requirements": ["CB-SANDBOX-01"],
      "cases": ["CB-CASE-08"],
      "status": "not-executed"
    },
    {
      "id": "CB-NC-06",
      "control": "vDSO clock_gettime/time/gettimeofday, coarse clocks, direct vvar reads, x86 rdtsc/rdtscp",
      "insufficient_shortcut": "All bypass syscall seccomp/bubblewrap namespace flags; TSC-only trap/offset leaves host time or elapsed time",
      "required_gate": "Reviewed complete clock/vvar/TSC barrier or equivalent; otherwise no native launch",
      "requirements": ["CB-SANDBOX-01"],
      "cases": ["CB-CASE-08"],
      "status": "not-executed"
    },
    {
      "id": "CB-NC-07",
      "control": "Inherited secret FD, /proc/self/fd or revoked test.emit grant",
      "insufficient_shortcut": "Direct disclosure or forged/stale protected request",
      "required_gate": "Fixed private FD allowlist, bounded IPC, independent mediator checking current authority on every request",
      "requirements": ["CB-HOST-01", "CB-SANDBOX-01"],
      "cases": ["CB-CASE-07", "CB-CASE-08"],
      "status": "not-executed"
    },
    {
      "id": "CB-NC-08",
      "control": "Crash, timeout, leaked descendant or partial JSON",
      "insufficient_shortcut": "Partial output is not Noble completion",
      "required_gate": "Parent-owned cgroup limits, kill/reap entire worker set and typed failure without post-failure effects",
      "requirements": ["CB-LIMIT-01", "CB-SANDBOX-01"],
      "cases": ["CB-CASE-06"],
      "status": "not-executed"
    }
  ],
