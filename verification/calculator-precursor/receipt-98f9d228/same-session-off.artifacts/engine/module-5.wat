(module
(type $entry (func (param i32)))
(import "noble" "memory" (memory 16 16))
(import "noble" "table" (table 16384 16384 funcref))
(import "noble" "failure" (global $failure (mut i32)))
(import "noble" "quota_reason" (global $quota_reason (mut i32)))
(import "noble" "phase" (global $phase (mut i32)))
(import "noble" "heap_cursor" (global $heap_cursor (mut i32)))
(import "noble" "heap_baseline" (global $heap_baseline (mut i32)))
(import "noble" "allocation_limit" (global $allocation_limit (mut i32)))
(import "noble" "recipe_limit" (global $recipe_limit (mut i32)))
(import "noble" "depth_limit" (global $depth_limit (mut i32)))
(import "noble" "operand_limit" (global $operand_limit (mut i32)))
(import "noble" "continuation_limit" (global $continuation_limit (mut i32)))
(import "noble" "step_limit" (global $step_limit (mut i32)))
(import "noble" "allocation_peak" (global $allocation_peak (mut i32)))
(import "noble" "operand_peak" (global $operand_peak (mut i32)))
(import "noble" "continuation_peak" (global $continuation_peak (mut i32)))
(import "noble" "steps" (global $steps (mut i32)))
(import "noble" "quote_invocations" (global $quote_invocations (mut i32)))
(import "noble" "sp" (global $sp (mut i32)))
(import "noble" "cp" (global $cp (mut i32)))
(import "noble" "observed_program" (global $observed_program (mut i32)))
(import "noble" "recipe_count" (global $recipe_count (mut i32)))
(import "noble" "reflection_steps" (global $reflection_steps (mut i32)))
(import "noble" "rp" (global $rp (mut i32)))
(import "noble" "generation" (global $generation (mut i32)))
(import "noble" "allocated_total" (global $allocated_total (mut i64)))
(import "noble" "released_total" (global $released_total (mut i64)))
(export "memory" (memory 0))
(global $source_reflection i32 (i32.const 1))
(global $cell_limit i32 (i32.const 4096))
(global $allocation_ceiling i32 (i32.const 196608))
;; Shared allocation, quota and metric semantics for both experimental and source ABIs.
(func $fail (param $code i32)
 (if (i32.eqz (global.get $failure)) (then (global.set $failure (local.get $code)))))
(func $quota (param $reason i32)
 (if (i32.eqz (global.get $failure)) (then
  (global.set $quota_reason (local.get $reason))
  (global.set $failure (i32.add (i32.const 1) (global.get $phase))))))
(func $live_bytes (result i32)
 (i32.mul (i32.sub (global.get $heap_cursor) (global.get $heap_baseline)) (i32.const 48)))
(func $runtime_tick (result i32)
 (if (global.get $failure) (then (return (i32.const 0))))
 (if (i32.ge_u (global.get $steps) (global.get $step_limit))
  (then (call $quota (i32.const 6)) (return (i32.const 0))))
 (global.set $steps (i32.add (global.get $steps) (i32.const 1)))
 (i32.const 1))
(func $reserve (result i32) (local $next i32) (local $bytes i32)
 (if (global.get $failure) (then (return (i32.const 0))))
 (local.set $next (i32.add (global.get $heap_cursor) (i32.const 1)))
 (local.set $bytes (i32.mul (i32.sub (local.get $next) (global.get $heap_baseline)) (i32.const 48)))
 (if (i32.or (i32.gt_u (local.get $next) (global.get $cell_limit))
             (i32.gt_u (local.get $bytes) (global.get $allocation_limit)))
  (then (call $quota (i32.const 1)) (return (i32.const 0))))
 (if (i32.eqz (call $storage_ensure (local.get $next)))
  (then (call $quota (i32.const 1)) (return (i32.const 0))))
 (global.set $heap_cursor (local.get $next))
 (global.set $allocated_total (i64.add (global.get $allocated_total) (i64.const 48)))
 (if (i32.gt_u (local.get $bytes) (global.get $allocation_peak))
  (then (global.set $allocation_peak (local.get $bytes))))
 (local.get $next))
(func $rollback (param $mark i32)
 (block $done (loop $next
  (br_if $done (i32.le_u (global.get $heap_cursor) (local.get $mark)))
  (call $storage_discard (global.get $heap_cursor))
  (global.set $heap_cursor (i32.sub (global.get $heap_cursor) (i32.const 1)))
  (global.set $released_total (i64.add (global.get $released_total) (i64.const 48)))
  (br $next))))
(func (export "metric") (param $key i32) (result i64)
 (if (i32.eq (local.get $key) (i32.const 0)) (then (return (i64.extend_i32_u (global.get $failure)))))
 (if (i32.eq (local.get $key) (i32.const 1)) (then (return (i64.extend_i32_u (global.get $quota_reason)))))
 (if (i32.eq (local.get $key) (i32.const 2)) (then (return (global.get $allocated_total))))
 (if (i32.eq (local.get $key) (i32.const 3)) (then (return (global.get $released_total))))
 (if (i32.eq (local.get $key) (i32.const 4)) (then (return (i64.extend_i32_u (call $live_bytes)))))
 (if (i32.eq (local.get $key) (i32.const 5)) (then (return (i64.extend_i32_u (global.get $allocation_peak)))))
 (if (i32.eq (local.get $key) (i32.const 6)) (then (return (i64.extend_i32_u (global.get $operand_peak)))))
 (if (i32.eq (local.get $key) (i32.const 7)) (then (return (i64.extend_i32_u (global.get $continuation_peak)))))
 (if (i32.eq (local.get $key) (i32.const 8)) (then (return (i64.extend_i32_u (global.get $steps)))))
 (if (i32.eq (local.get $key) (i32.const 9)) (then (return (i64.extend_i32_u (global.get $quote_invocations)))))
 (if (i32.eq (local.get $key) (i32.const 10)) (then (return (i64.extend_i32_u (i32.mul (memory.size) (i32.const 65536))))))
 (if (i32.eq (local.get $key) (i32.const 11)) (then (return (i64.extend_i32_u (i32.mul (global.get $heap_baseline) (i32.const 48))))))
 (if (i32.eq (local.get $key) (i32.const 12)) (then (return (i64.extend_i32_u (global.get $sp)))))
 (if (i32.eq (local.get $key) (i32.const 13)) (then (return (i64.extend_i32_u (global.get $reflection_steps)))))
 (i64.const -1))

;; Ordinary cells occupy [65536, 262144): 4096 immutable 48-byte records.
;; Check the unsigned handle range before subtraction/multiplication.
(func $linear_address (param $h i32) (result i32)
  (if (i32.gt_u (i32.sub (local.get $h) (i32.const 1)) (i32.const 4095))
    (then unreachable))
  (i32.add
    (i32.const 65536)
    (i32.mul (i32.sub (local.get $h) (i32.const 1)) (i32.const 48))))

;; A current cell has both its expected id and a live kind, never a zero object.
(func $linear_live_address (param $h i32) (result i32)
  (local $p i32)
  (if (i32.gt_u (local.get $h) (global.get $heap_cursor))
    (then unreachable))
  (local.set $p (call $linear_address (local.get $h)))
  (if (i32.ne (i32.load offset=4 (local.get $p)) (local.get $h))
    (then unreachable))
  (if (i32.gt_u
        (i32.sub (i32.load (local.get $p)) (i32.const 1))
        (i32.const 15))
    (then unreachable))
  (local.get $p))

(func $storage_is_live (param $h i32) (result i32)
  (local $p i32)
  (if (i32.or (i32.eqz (local.get $h))
              (i32.gt_u (local.get $h) (global.get $heap_cursor)))
    (then (return (i32.const 0))))
  (local.set $p (call $linear_address (local.get $h)))
  (i32.and
    (i32.eq (i32.load offset=4 (local.get $p)) (local.get $h))
    (i32.le_u (i32.sub (i32.load (local.get $p)) (i32.const 1))
              (i32.const 15))))

(func $storage_live_count (result i32)
  (global.get $heap_cursor))

;; Nullable edges point only backward to existing cells, preserving acyclicity.
(func $linear_child (param $child i32) (param $parent i32) (result i32)
  (if (i32.eqz (local.get $child))
    (then (return (i32.const 0))))
  (if (i32.ge_u (local.get $child) (local.get $parent))
    (then unreachable))
  (drop (call $linear_live_address (local.get $child)))
  (local.get $child))

(func $storage_init
  ;; Leave scratch and common accounting untouched; initially this range is empty.
  (memory.fill
    (i32.const 65536)
    (i32.const 0)
    (i32.shl (i32.sub (memory.size) (i32.const 1)) (i32.const 16))))

(func $storage_ensure (param $h i32) (result i32)
  (local $needed i32)
  (local $current i32)
  (if (i32.gt_u (i32.sub (local.get $h) (i32.const 1))
                 (i32.sub (global.get $cell_limit) (i32.const 1)))
    (then (return (i32.const 0))))
  ;; Physical address, not logical handle, selects the required page.
  ;; Calculator's third disjoint region grows beyond the first MiB;
  ;; the first two regions and all Text/ingress addresses stay unchanged.
  (local.set $needed
    (i32.add
      (i32.const 1)
      (i32.shr_u
        (i32.add (call $linear_address (local.get $h)) (i32.const 47))
        (i32.const 16))))
  (if (i32.and (i32.gt_u (local.get $h) (i32.const 4096))
               (i32.le_u (local.get $h) (i32.const 6826)))
    (then (local.set $needed (i32.const 8))))
  (local.set $current (memory.size))
  (if (i32.ge_u (local.get $current) (local.get $needed))
    (then (return (i32.const 1))))
  ;; reserve charges only after this succeeds; failed growth publishes no cell.
  (i32.ne
    (memory.grow (i32.sub (local.get $needed) (local.get $current)))
    (i32.const -1)))

(func $storage_discard (param $h i32)
  ;; Clear kind and id together. Pages remain allocated; handles are region-private.
  (i64.store (call $linear_live_address (local.get $h)) (i64.const 0)))

(func $new
  (param $kind i32) (param $payload i64)
  (param $a i32) (param $b i32) (param $c i32)
  (param $x i32) (param $y i32) (param $z i32)
  (param $w i32) (param $n i32)
  (result i32)
  (local $h i32)
  (local $p i32)
  (local.set $h (call $reserve))
  ;; In particular, failed reservations must not inspect child handles.
  (if (i32.eqz (local.get $h))
    (then (return (i32.const 0))))
  (local.set $p (call $linear_address (local.get $h)))
  (if (i32.gt_u (i32.sub (local.get $kind) (i32.const 1)) (i32.const 15))
    (then unreachable))
  (local.set $a (call $linear_child (local.get $a) (local.get $h)))
  (local.set $b (call $linear_child (local.get $b) (local.get $h)))
  (local.set $c (call $linear_child (local.get $c) (local.get $h)))
  (i64.store offset=8 (local.get $p) (local.get $payload))
  (i32.store offset=16 (local.get $p) (local.get $a))
  (i32.store offset=20 (local.get $p) (local.get $b))
  (i32.store offset=24 (local.get $p) (local.get $c))
  (i32.store offset=28 (local.get $p) (local.get $x))
  (i32.store offset=32 (local.get $p) (local.get $y))
  (i32.store offset=36 (local.get $p) (local.get $z))
  (i32.store offset=40 (local.get $p) (local.get $w))
  (i32.store offset=44 (local.get $p) (local.get $n))
  ;; Publish the live header only after every immutable field is initialized.
  (i32.store offset=4 (local.get $p) (local.get $h))
  (i32.store (local.get $p) (local.get $kind))
  (local.get $h))

(func $kind (param $h i32) (result i32)
  (i32.load (call $linear_live_address (local.get $h))))

(func $payload (param $h i32) (result i64)
  (i64.load offset=8 (call $linear_live_address (local.get $h))))

(func $a (param $h i32) (result i32)
  (call $linear_child
    (i32.load offset=16 (call $linear_live_address (local.get $h)))
    (local.get $h)))

(func $b (param $h i32) (result i32)
  (call $linear_child
    (i32.load offset=20 (call $linear_live_address (local.get $h)))
    (local.get $h)))

(func $c (param $h i32) (result i32)
  (call $linear_child
    (i32.load offset=24 (call $linear_live_address (local.get $h)))
    (local.get $h)))

(func $x (param $h i32) (result i32)
  (i32.load offset=28 (call $linear_live_address (local.get $h))))

(func $y (param $h i32) (result i32)
  (i32.load offset=32 (call $linear_live_address (local.get $h))))

(func $z (param $h i32) (result i32)
  (i32.load offset=36 (call $linear_live_address (local.get $h))))

(func $w (param $h i32) (result i32)
  (i32.load offset=40 (call $linear_live_address (local.get $h))))

(func $n (param $h i32) (result i32)
  (i32.load offset=44 (call $linear_live_address (local.get $h))))

;; Operand slots: tag:i32, padding:i32, payload:i64; no heap allocation for arithmetic.
(func $need (param $count i32) (result i32)
 (if (global.get $failure) (then (return (i32.const 0))))
 (if (i32.lt_u (global.get $sp) (local.get $count))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (i32.const 1))
(func $slot_kind (param $index i32) (result i32)
 (if (i32.ge_u (local.get $index) (global.get $sp))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 (i32.load (i32.mul (local.get $index) (i32.const 16))))
(func $slot_value (param $index i32) (result i64)
 (if (i32.ge_u (local.get $index) (global.get $sp))
  (then (call $fail (i32.const 4)) (return (i64.const 0))))
 (i64.load offset=8 (i32.mul (local.get $index) (i32.const 16))))
(func $push_tag (param $kind i32) (param $value i64) (local $bytes i32) (local $address i32)
 (if (global.get $failure) (then (return)))
 (local.set $bytes (i32.mul (i32.add (global.get $sp) (i32.const 1)) (i32.const 16)))
 (if (i32.gt_u (local.get $bytes) (global.get $operand_limit))
  (then (call $quota (i32.const 4)) (return)))
 (local.set $address (i32.mul (global.get $sp) (i32.const 16)))
 (i32.store (local.get $address) (local.get $kind))
 (i64.store offset=8 (local.get $address) (local.get $value))
 (global.set $sp (i32.add (global.get $sp) (i32.const 1)))
 (if (i32.gt_u (local.get $bytes) (global.get $operand_peak))
  (then (global.set $operand_peak (local.get $bytes)))))
(func $push_i64 (param $value i64) (call $push_tag (i32.const 1) (local.get $value)))
(func $push_bool (param $value i32)
 (call $push_tag (i32.const 2) (i64.extend_i32_u (local.get $value))))
(func $push_unit (call $push_tag (i32.const 3) (i64.const 0)))
(func $push_ref (param $handle i32)
 (if (global.get $failure) (then (return)))
 (call $push_tag (call $kind (local.get $handle)) (i64.extend_i32_u (local.get $handle))))
(func $take (result i64) (local $address i32) (local $value i64)
 (if (i32.eqz (call $need (i32.const 1))) (then (return (i64.const 0))))
 (global.set $sp (i32.sub (global.get $sp) (i32.const 1)))
 (local.set $address (i32.mul (global.get $sp) (i32.const 16)))
 (local.set $value (i64.load offset=8 (local.get $address)))
 (i64.store (local.get $address) (i64.const 0))
 (i64.store offset=8 (local.get $address) (i64.const 0))
 (local.get $value))
(func $pop_kind (param $expected i32) (result i64)
 (if (i32.eqz (call $need (i32.const 1))) (then (return (i64.const 0))))
 (if (i32.ne (call $slot_kind (i32.sub (global.get $sp) (i32.const 1))) (local.get $expected))
  (then (call $fail (i32.const 4)) (return (i64.const 0))))
 (call $take))
(func $pop_box (result i32) (local $tag i32) (local $value i64)
 (if (i32.eqz (call $need (i32.const 1))) (then (return (i32.const 0))))
 (local.set $tag (call $slot_kind (i32.sub (global.get $sp) (i32.const 1))))
 (local.set $value (call $take))
 (if (i32.ge_u (local.get $tag) (i32.const 4)) (then (return (i32.wrap_i64 (local.get $value)))))
 (call $new (local.get $tag) (local.get $value)
  (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)
  (i32.const 0) (i32.const 0) (i32.const 0)))
(func $unbox (param $handle i32) (local $tag i32)
 (if (global.get $failure) (then (return)))
 (local.set $tag (call $kind (local.get $handle)))
 (if (i32.lt_u (local.get $tag) (i32.const 4))
  (then (call $push_tag (local.get $tag) (call $payload (local.get $handle))))
  (else (call $push_ref (local.get $handle)))))

;; Continuation slots occupy [4096,8192): index:i32, environment:i32.
(func $enqueue (param $index i32) (param $environment i32) (local $bytes i32) (local $address i32)
 (if (global.get $failure) (then (return)))
 (local.set $bytes (i32.mul (i32.add (global.get $cp) (i32.const 1)) (i32.const 8)))
 (if (i32.gt_u (local.get $bytes) (global.get $continuation_limit))
  (then (call $quota (i32.const 5)) (return)))
 (local.set $address (i32.add (i32.const 4096) (i32.mul (global.get $cp) (i32.const 8))))
 (i32.store (local.get $address) (local.get $index))
 (i32.store offset=4 (local.get $address) (local.get $environment))
 (global.set $cp (i32.add (global.get $cp) (i32.const 1)))
 (if (i32.gt_u (local.get $bytes) (global.get $continuation_peak))
  (then (global.set $continuation_peak (local.get $bytes)))))
(func $enqueue_program (param $program i32)
 (if (global.get $failure) (then (return)))
 (if (i32.ne (call $kind (local.get $program)) (i32.const 4))
  (then (call $fail (i32.const 4)) (return)))
 (call $enqueue (call $x (local.get $program)) (local.get $program)))
(func $dispatch (local $index i32) (local $environment i32) (local $address i32)
 (block $done (loop $next
  (br_if $done (i32.or (global.get $failure) (i32.eqz (global.get $cp))))
  (if (i32.eqz (call $runtime_tick)) (then (br $done)))
  (global.set $cp (i32.sub (global.get $cp) (i32.const 1)))
  (local.set $address (i32.add (i32.const 4096) (i32.mul (global.get $cp) (i32.const 8))))
  (local.set $index (i32.load (local.get $address)))
  (local.set $environment (i32.load offset=4 (local.get $address)))
  (i64.store (local.get $address) (i64.const 0))
  (call_indirect (type $entry) (local.get $environment) (local.get $index))
  (br $next))))

(func $atom (param $kind i32) (param $value i64) (param $child i32) (result i32)
 (call $new (i32.const 8) (local.get $value) (local.get $child)
  (i32.const 0) (i32.const 0) (local.get $kind) (i32.const 0)
  (i32.const 0) (i32.const 0) (i32.const 0)))
(func $concat_recipe (param $left i32) (param $right i32) (result i32)
 (if (global.get $failure) (then (return (i32.const 0))))
 (if (i32.eqz (local.get $left)) (then (return (local.get $right))))
 (if (i32.eqz (local.get $right)) (then (return (local.get $left))))
 (call $new (i32.const 9) (i64.const 0) (local.get $left) (local.get $right)
  (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
(func $program (param $entry_index i32) (param $input i32) (param $output i32)
 (param $recipe i32) (param $capture i64) (param $left i32) (param $right i32)
 (param $depth i32) (param $leaves i32) (result i32)
 (if (global.get $failure) (then (return (i32.const 0))))
 (if (i32.gt_u (local.get $leaves) (global.get $recipe_limit))
  (then (call $quota (i32.const 2)) (return (i32.const 0))))
 (if (i32.gt_u (local.get $depth) (global.get $depth_limit))
  (then (call $quota (i32.const 3)) (return (i32.const 0))))
 (call $new (i32.const 4) (local.get $capture) (local.get $left) (local.get $right)
  (local.get $recipe) (local.get $entry_index) (local.get $input) (local.get $output)
  (local.get $depth) (local.get $leaves)))
(func $compose (param $left i32) (param $right i32) (result i32)
 (local $depth i32) (local $leaves i32) (local $recipe i32)
 (if (global.get $failure) (then (return (i32.const 0))))
 (if (i32.or (i32.ne (call $kind (local.get $left)) (i32.const 4))
             (i32.ne (call $kind (local.get $right)) (i32.const 4)))
  (then (call $fail (i32.const 4)) (return (i32.const 0))))
 ;; Complete ordered signature IDs, not argument counts or suffix matches.
 (if (i32.ne (call $z (local.get $left)) (call $y (local.get $right)))
  (then (call $fail (i32.const 3)) (return (i32.const 0))))
 (local.set $leaves (i32.add (call $n (local.get $left)) (call $n (local.get $right))))
 (local.set $depth (call $w (local.get $left)))
 (if (i32.gt_u (call $w (local.get $right)) (local.get $depth))
  (then (local.set $depth (call $w (local.get $right)))))
 (local.set $depth (i32.add (local.get $depth) (i32.const 1)))
 ;; Check both bounds before allocating recipe metadata or the program cell.
 (if (i32.gt_u (local.get $leaves) (global.get $recipe_limit))
  (then (call $quota (i32.const 2)) (return (i32.const 0))))
 (if (i32.gt_u (local.get $depth) (global.get $depth_limit))
  (then (call $quota (i32.const 3)) (return (i32.const 0))))
 (local.set $recipe (call $concat_recipe (call $c (local.get $left)) (call $c (local.get $right))))
 (call $program (i32.const 2) (call $y (local.get $left)) (call $z (local.get $right))
  (local.get $recipe)
  (if (result i64) (global.get $source_reflection)
   (then (i64.or (call $payload (local.get $left)) (call $payload (local.get $right))))
   (else (i64.const 0)))
  (local.get $left) (local.get $right)
  (local.get $depth) (local.get $leaves)))
(func $empty_entry (type $entry) (param $environment i32))
(func $quote_entry (type $entry) (param $environment i32)
 (global.set $quote_invocations (i32.add (global.get $quote_invocations) (i32.const 1)))
