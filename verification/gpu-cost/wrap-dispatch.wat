;; Measurement wrappers appended to a compiled Noble Core-Bootstrap module-1.wat.
;; Uses scratch slot 458744 (page 7, disjoint from stack [0,65536), cell heap
;; [65536,262144), and passive signature literals starting at 262144).

(func (export "measure_null") (param $count i32) (result i64)
  (local $i i32) (local $acc i64)
  (block $done (loop $next
    (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
    (local.set $acc (i64.add (i64.mul (local.get $acc) (i64.const 33)) (i64.extend_i32_u (local.get $i))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $next)))
  (local.get $acc))

(func (export "eval_one") (param $program i32) (param $input i64) (result i64)
  (global.set $sp (i32.const 0))
  (global.set $cp (i32.const 0))
  (call $push_i64 (local.get $input))
  (if (global.get $failure) (then (return (i64.const 0))))
  (call $enqueue_program (local.get $program))
  (if (global.get $failure) (then (return (i64.const 0))))
  (call $dispatch)
  (if (global.get $failure) (then (return (i64.const 0))))
  (if (i32.ne (global.get $sp) (i32.const 1)) (then (call $fail (i32.const 4)) (return (i64.const 0))))
  (call $pop_kind (i32.const 1)))

(func (export "measure_dispatch") (param $program i32) (param $count i32) (param $input i64) (result i64)
  (local $i i32) (local $acc i64) (local $result i64)
  (global.set $sp (i32.const 0))
  (global.set $cp (i32.const 0))
  (local.set $acc (i64.const 0))
  (block $done (loop $next
    (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
    (call $push_i64 (i64.add (local.get $input) (i64.extend_i32_u (local.get $i))))
    (if (global.get $failure) (then (br $done)))
    (call $enqueue_program (local.get $program))
    (if (global.get $failure) (then (br $done)))
    (call $dispatch)
    (if (global.get $failure) (then (br $done)))
    (if (i32.ne (global.get $sp) (i32.const 1)) (then (call $fail (i32.const 4)) (br $done)))
    (local.set $result (call $pop_kind (i32.const 1)))
    (local.set $acc (i64.add (i64.mul (local.get $acc) (i64.const 33)) (local.get $result)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $next)))
  (local.get $acc))

(func (export "build_list") (param $count i32) (param $seed i64) (result i32)
  (local $list i32) (local $box i32) (local $i i32)
  (global.set $sp (i32.const 0))
  (global.set $cp (i32.const 0))
  (local.set $list (call $new (i32.const 7) (i64.const 0)
    (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)
    (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
  (if (global.get $failure) (then (return (i32.const 0))))
  (block $done (loop $next
    (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
    (local.set $box (call $new (i32.const 1)
      (i64.add (local.get $seed) (i64.extend_i32_u (local.get $i)))
      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)
      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
    (if (global.get $failure) (then (br $done)))
    (local.set $list (call $new (i32.const 6) (i64.const 0)
      (local.get $box) (local.get $list) (i32.const 0) (i32.const 0)
      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
    (if (global.get $failure) (then (br $done)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $next)))
  (local.get $list))

(func (export "measure_cpu_map") (param $program i32) (param $list i32) (param $count i32) (result i64)
  (local $i i32) (local $node i32) (local $out i32) (local $box i32) (local $acc i64) (local $val i64) (local $res i64)
  (global.set $sp (i32.const 0))
  (global.set $cp (i32.const 0))
  (local.set $node (local.get $list))
  (local.set $out (call $new (i32.const 7) (i64.const 0)
    (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)
    (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
  (if (global.get $failure) (then (return (i64.const 0))))
  (block $done (loop $next
    (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
    (local.set $val (call $payload (call $a (local.get $node))))
    (call $push_i64 (local.get $val))
    (if (global.get $failure) (then (br $done)))
    (call $enqueue_program (local.get $program))
    (if (global.get $failure) (then (br $done)))
    (call $dispatch)
    (if (global.get $failure) (then (br $done)))
    (if (i32.ne (global.get $sp) (i32.const 1)) (then (call $fail (i32.const 4)) (br $done)))
    (local.set $res (call $pop_kind (i32.const 1)))
    (local.set $box (call $new (i32.const 1) (local.get $res)
      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)
      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
    (if (global.get $failure) (then (br $done)))
    (local.set $out (call $new (i32.const 6) (i64.const 0)
      (local.get $box) (local.get $out) (i32.const 0) (i32.const 0)
      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
    (if (global.get $failure) (then (br $done)))
    (local.set $acc (i64.add (i64.mul (local.get $acc) (i64.const 33)) (local.get $res)))
    (local.set $node (call $b (local.get $node)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $next)))
  (i32.store (i32.const 458744) (local.get $out))
  (local.get $acc))

(func (export "last_out_list") (result i32)
  (i32.load (i32.const 458744)))

(func (export "verify_list") (param $list i32) (param $count i32) (result i64)
  (local $i i32) (local $node i32) (local $head i32) (local $acc i64)
  (local.set $node (local.get $list))
  (block $done (loop $next
    (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
    (if (i32.ne (call $kind (local.get $node)) (i32.const 6))
      (then (call $fail (i32.const 4)) (return (i64.const 0))))
    (local.set $head (call $a (local.get $node)))
    (if (i32.ne (call $kind (local.get $head)) (i32.const 1))
      (then (call $fail (i32.const 4)) (return (i64.const 0))))
    (local.set $acc (i64.add (i64.mul (local.get $acc) (i64.const 33)) (call $payload (local.get $head))))
    (local.set $node (call $b (local.get $node)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $next)))
  (if (i32.ne (call $kind (local.get $node)) (i32.const 7))
    (then (call $fail (i32.const 4)) (return (i64.const 0))))
  (local.get $acc))
