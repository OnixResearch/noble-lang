;; Helper cost wrappers for c_alloc, c_traverse, c_pack, c_unpack, c_load_only.
;; Flat staging buffer starts at 458752 (page 7 = 7 * 65536; 2048 * 8 = 16384
;; bytes ends at 475136 < 1048576), completely disjoint from operand/continuation
;; slots [0,65536), ordinary 48-byte cells [65536,262144), and passive signature
;; literal segments starting at 262144. Slot 458744 holds the last rebuilt handle.

(func (export "measure_null") (param $count i32) (result i64)
  (local $i i32) (local $acc i64)
  (block $done (loop $next
    (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
    (local.set $acc (i64.add (i64.mul (local.get $acc) (i64.const 33)) (i64.extend_i32_u (local.get $i))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $next)))
  (local.get $acc))

(func (export "build_control") (param $count i32) (param $seed i64) (result i64)
  (local $i i32) (local $acc i64) (local $value i64)
  (block $done (loop $next
    (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
    (local.set $value (i64.add (local.get $seed) (i64.extend_i32_u (local.get $i))))
    (local.set $acc (i64.add (i64.mul (local.get $acc) (i64.const 33)) (local.get $value)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $next)))
  (local.get $acc))

(func (export "build_list") (param $count i32) (param $seed i64) (result i32)
  (local $list i32) (local $box i32) (local $i i32)
  (global.set $sp (i32.const 0))
  (global.set $cp (i32.const 0))
  (local.set $list (call $new (i32.const 7) (i64.const 0)
    (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)
    (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
  (if (global.get $failure) (then (return (i32.const 0))))
  (block $done (loop $next
    (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
    (local.set $box (call $new (i32.const 1)
      (i64.add (local.get $seed) (i64.extend_i32_u (local.get $i)))
      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)
      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
    (if (global.get $failure) (then (br $done)))
    (local.set $list (call $new (i32.const 6) (i64.const 0)
      (local.get $box) (local.get $list) (i32.const 0) (i32.const 0)
      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
    (if (global.get $failure) (then (br $done)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $next)))
  (local.get $list))

(func (export "measure_pack") (param $list i32) (param $count i32) (result i64)
  (local $i i32) (local $node i32) (local $acc i64) (local $value i64)
  (local.set $node (local.get $list))
  (block $done (loop $next
    (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
    (local.set $value (call $payload (call $a (local.get $node))))
    (i64.store (i32.add (i32.const 458752) (i32.mul (local.get $i) (i32.const 8))) (local.get $value))
    (local.set $acc (i64.add (i64.mul (local.get $acc) (i64.const 33)) (local.get $value)))
    (local.set $node (call $b (local.get $node)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $next)))
  (local.get $acc))

(func (export "measure_pack_traverse") (param $list i32) (param $count i32) (result i64)
  (local $i i32) (local $node i32) (local $acc i64)
  (local.set $node (local.get $list))
  (block $done (loop $next
    (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
    (local.set $acc (i64.add (i64.mul (local.get $acc) (i64.const 33)) (call $payload (call $a (local.get $node)))))
    (local.set $node (call $b (local.get $node)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $next)))
  (local.get $acc))

(func (export "measure_unpack") (param $count i32) (result i64)
  (local $i i32) (local $list i32) (local $box i32) (local $acc i64) (local $value i64)
  (local.set $list (call $new (i32.const 7) (i64.const 0)
    (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)
    (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
  (if (global.get $failure) (then (return (i64.const 0))))
  (block $done (loop $next
    (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
    (local.set $value (i64.load (i32.add (i32.const 458752) (i32.mul (local.get $i) (i32.const 8)))))
    (local.set $box (call $new (i32.const 1) (local.get $value)
      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)
      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
    (if (global.get $failure) (then (br $done)))
    (local.set $list (call $new (i32.const 6) (i64.const 0)
      (local.get $box) (local.get $list) (i32.const 0) (i32.const 0)
      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
    (if (global.get $failure) (then (br $done)))
    (local.set $acc (i64.add (i64.mul (local.get $acc) (i64.const 33)) (local.get $value)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $next)))
  (i32.store (i32.const 458744) (local.get $list))
  (local.get $acc))

(func (export "measure_load_only") (param $count i32) (result i64)
  (local $i i32) (local $acc i64)
  (block $done (loop $next
    (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
    (local.set $acc (i64.add (i64.mul (local.get $acc) (i64.const 33))
      (i64.load (i32.add (i32.const 458752) (i32.mul (local.get $i) (i32.const 8))))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $next)))
  (local.get $acc))

(func (export "last_unpack_list") (result i32)
  (i32.load (i32.const 458744)))

(func (export "verify_flat") (param $count i32) (result i64)
  (local $i i32) (local $acc i64)
  (block $done (loop $next
    (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
    (local.set $acc (i64.add (i64.mul (local.get $acc) (i64.const 33))
      (i64.load (i32.add (i32.const 458752) (i32.mul (local.get $i) (i32.const 8))))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $next)))
  (local.get $acc))

(func (export "verify_list") (param $list i32) (param $count i32) (result i64)
  (local $i i32) (local $node i32) (local $head i32) (local $acc i64)
  (local.set $node (local.get $list))
  (block $done (loop $next
    (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
    (if (i32.ne (call $kind (local.get $node)) (i32.const 6))
      (then (call $fail (i32.const 4)) (return (i64.const 0))))
    (local.set $head (call $a (local.get $node)))
    (if (i32.ne (call $kind (local.get $head)) (i32.const 1))
      (then (call $fail (i32.const 4)) (return (i64.const 0))))
    (local.set $acc (i64.add (i64.mul (local.get $acc) (i64.const 33)) (call $payload (local.get $head))))
    (local.set $node (call $b (local.get $node)))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $next)))
  (if (i32.ne (call $kind (local.get $node)) (i32.const 7))
    (then (call $fail (i32.const 4)) (return (i64.const 0))))
  (local.get $acc))
