          -- S result@1.Result<Pair<I64,numeric_budget@1.Budget>,calc_errors@1.NumericError> ! pure ]
    def scan_pages_i64 [
        768 numeric_budget@1.charge_native_steps
        [ [ 4 pair ScanPageState.new scan_page_i64 ] dip swap
