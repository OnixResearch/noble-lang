    # The same checked traversal retains the original signed-I64 range gate.
    signature scan_bits_i64 forall<S:stack>
        [ S List<Bool> numeric_budget@1.Budget
          -- S result@1.Result<Pair<I64,numeric_budget@1.Budget>,calc_errors@1.NumericError> ! pure ]
