          -- S result@1.Result<Pair<I64,numeric_budget@1.Budget>,calc_errors@1.NumericError> ! pure ]
    def scan_pages_full_i64 [
        1024 numeric_budget@1.charge_native_steps
        [ [ 8 pair ScanPageState.new scan_page_i64 ] dip swap
          [ ScanState.into unpair [ dup bitstep@1.is_zero ] dip swap
            [ [ drop ] dip swap pair result@1.Result.Ok ]
            [ [ swap ] dip swap
              [ pair ScanState.new ] dip scan_pages_full_i64 ] if ]
          [ swap drop result@1.Result.Err ]
