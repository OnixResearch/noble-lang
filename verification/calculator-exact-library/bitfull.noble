module bitfull@1 [
    signature add forall<S:stack> [ S Bool Bool Bool -- S Bool Bool ! pure ]
    export add
    def add [
        [ 1 ] [ 0 ] if
        swap [ 1 ] [ 0 ] if +
        swap [ 1 ] [ 0 ] if +
        dup 2 < [ 1 = false ] [ 3 = true ] if
    ]

    signature subtract forall<S:stack> [ S Bool Bool Bool -- S Bool Bool ! pure ]
    export subtract
    def subtract [
        [ 1 ] [ 0 ] if
        swap [ 1 ] [ 0 ] if +
        swap [ 1 ] [ 0 ] if swap -
        dup 0 < [ -1 = true ] [ 1 = false ] if
    ]

    signature compare_bit forall<S:stack> [ S Bool Bool -- S I64 ! pure ]
    export compare_bit
    def compare_bit [
        [ 1 ] [ 0 ] if
        swap [ 1 ] [ 0 ] if swap -
    ]
]
