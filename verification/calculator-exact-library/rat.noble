    signature call_depth_error forall<S:stack>
        [ S -- S calc_errors@1.NumericError ! pure ]
    def call_depth_error [
        unit calc_errors@1.LimitDepth.CallDepth
        calc_errors@1.LimitRemaining.NestedDepth
        calc_errors@1.LimitCategory.Remaining
        calc_errors@1.NumericError.ResourceLimit
