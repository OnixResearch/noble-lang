module rat@1 [
    opaque Rat Pair<bigint@1.BigInt,bigint@1.BigInt> private
    export Rat

    # The recursive power helper is exported for signed-self admission, but
    # only this module can mint its intermediate accumulator/exponent state.
    opaque PowerStepState Pair<Pair<Rat,Rat>,bigint@1.BigInt> private
    export PowerStepState

    # Only Euclid mints the remainder and preceding divisor together.
    opaque GcdState Pair<Pair<bigint@1.BigInt,bigint@1.BigInt>,Pair<bigint@1.BigInt,bigint@1.BigInt>> private
    export GcdState

    # A bounded operand projection is an optimization, not an alternate
    # authority: the original Rats and their charged Budget survive any
    # Beyond result and return to the general BigInt arithmetic.
    variant SmallProducts Both Pair<I64,I64> public Either Unit public
    variant SmallRats Both Pair<Pair<I64,I64>,Pair<I64,I64>> public Either Unit public
    variant TinyResult Finished Rat public Absent Unit public

    opaque TinyGcdState Pair<Pair<I64,I64>,I64> private
