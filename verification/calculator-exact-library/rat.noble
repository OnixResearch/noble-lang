    export gcd_remainder
    def gcd_remainder [
        512 numeric_budget@1.charge_native_steps
        [ [ GcdState.into unpair ] dip
          [ dup unpair swap drop ] dip is_zero
          [ unpair swap
            [ [ drop ] dip [ unpair swap drop ] dip
              pair result@1.Result.Ok ]
            [ [ dup unpair swap drop ] dip [ bigint@1.one ] dip bigint@1.compare
              [ unpair [ 0 = ] dip swap
                [ [ drop ] dip [ drop ] dip
                  [ bigint@1.one ] dip pair result@1.Result.Ok ]
                [ [ unpair swap drop ] dip
                  [[ unpair swap drop ] dip ] dip gcd ] if ]
              [ swap drop swap drop result@1.Result.Err ]
              result@1.Result.match ] if ]
          [ swap drop swap drop result@1.Result.Err ]
          result@1.Result.match ]
        [ swap drop result@1.Result.Err ] result@1.Result.match
    ]

    signature gcd_ordered forall<S:stack>
        [ S bigint@1.BigInt bigint@1.BigInt numeric_budget@1.Budget -- S result@1.Result<Pair<bigint@1.BigInt,numeric_budget@1.Budget>,calc_errors@1.NumericError> ! pure ]
    def gcd_ordered [
        [ pair ] dip [ dup unpair ] dip bigint@1.compare
        [ unpair [ dup -1 = ] dip swap
          [ [ drop ] dip [ unpair swap ] dip gcd ]
          [ [ drop ] dip [ unpair ] dip gcd ] if ]
        [ swap drop result@1.Result.Err ]
        result@1.Result.match
