          [ swap
            [[ dup unpair swap drop ] dip swap ] dip bigint@1.to_small_i64
            [ unpair swap
              [ swap [ pair SmallProducts.Both ] dip pair result@1.Result.Ok ]
              [ drop [ drop ] dip [ unit SmallProducts.Either ] dip pair result@1.Result.Ok ]
              bigint@1.SmallValue.match ]
            [ swap drop swap drop result@1.Result.Err ] result@1.Result.match ]
          [ drop [ unit SmallProducts.Either ] dip pair result@1.Result.Ok ]
          bigint@1.SmallValue.match ]
