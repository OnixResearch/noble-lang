          [ [ dup unpair drop ] dip bigint@1.bit_length
            [ unpair [ drop ] dip [ Rat.new ] dip
              pair result@1.Result.Ok ]
            [ swap drop result@1.Result.Err ]
            result@1.Result.match ]
          [ unit_candidate
            [ unpair swap
              [ [ Rat.new ] dip pair result@1.Result.Ok ]
              [ make_regular ] if ]
            [ swap drop result@1.Result.Err ]
            result@1.Result.match ] if ]
        [ swap drop result@1.Result.Err ] result@1.Result.match
    ]

    signature make forall<S:stack>
        [ S bigint@1.BigInt bigint@1.BigInt numeric_budget@1.Budget -- S result@1.Result<Pair<Rat,numeric_budget@1.Budget>,calc_errors@1.NumericError> ! pure ]
