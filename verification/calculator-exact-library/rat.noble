        [ [ dup ] dip bigint@1.bit_length
          [ unpair [ drop ] dip [ bigint@1.one pair Rat.new ] dip
            pair result@1.Result.Ok ]
          [ swap drop result@1.Result.Err ] result@1.Result.match ]
        [ swap drop result@1.Result.Err ] result@1.Result.match
    ]

    # The BigInt digit constructor has just checked this exact shared Budget.
    # No arbitrary BigInt enters this path: callers supply validated digits
    # rather than a previously constructed value with a different budget.
    signature accepted_decimal_integer forall<S:stack>
        [ S bigint@1.BigInt numeric_budget@1.Budget -- S result@1.Result<Pair<Rat,numeric_budget@1.Budget>,calc_errors@1.NumericError> ! pure ]
    def accepted_decimal_integer [
        [ bigint@1.one pair Rat.new ] dip pair result@1.Result.Ok
    ]

    signature from_decimal_digits forall<S:stack>
        [ S List<I64> Bool numeric_budget@1.Budget -- S result@1.Result<Pair<Rat,numeric_budget@1.Budget>,calc_errors@1.NumericError> ! pure ]
    export from_decimal_digits
    def from_decimal_digits [
        512 numeric_budget@1.charge_native_steps
        [ [ swap ] dip bigint@1.from_decimal_digits
          [ unpair [ swap ] dip swap
            [ bigint@1.negate
              [ unpair accepted_decimal_integer ]
              [ result@1.Result.Err ] result@1.Result.match ]
            [ accepted_decimal_integer ] if ]
          [ swap drop result@1.Result.Err ] result@1.Result.match ]
        [ swap drop swap drop result@1.Result.Err ] result@1.Result.match
