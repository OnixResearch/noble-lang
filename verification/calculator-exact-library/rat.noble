    signature tiny_subtract_pair forall<S:stack> [ S I64 I64 -- S Pair<I64,I64> ! pure ]
    def tiny_subtract_pair [ dup [ swap ] dip - swap pair ]

    # A bounded subtraction either discovers the exact positive gcd or
    # returns Exhausted. Exhaustion must use the original, charged BigInts.
    signature tiny_gcd_transition forall<S:stack> [ S TinyGcdState -- S TinyGcdStep ! pure ]
    def tiny_gcd_transition [
        TinyGcdState.into unpair
        [ dup unpair drop 0 = ] dip swap
        [ drop unpair swap drop TinyGcdStep.Found ]
        [ [ dup unpair swap drop 0 = ] dip swap
          [ drop unpair drop TinyGcdStep.Found ]
          [ [ dup unpair = ] dip swap
            [ drop unpair drop TinyGcdStep.Found ]
            [ [ dup unpair drop 1 = ] dip swap
              [ drop drop 1 TinyGcdStep.Found ]
              [ [ dup unpair swap drop 1 = ] dip swap
                [ drop drop 1 TinyGcdStep.Found ]
                [ dup 0 =
                  [ drop drop unit TinyGcdStep.Exhausted ]
