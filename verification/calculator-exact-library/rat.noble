    signature parts forall<S:stack> [ S Rat -- S bigint@1.BigInt bigint@1.BigInt ! pure ]
    export parts
    def parts [ Rat.into unpair ]

    signature project_small_products forall<S:stack>
        [ S Pair<bigint@1.BigInt,bigint@1.BigInt> numeric_budget@1.Budget
          -- S Pair<bigint@1.BigInt,bigint@1.BigInt> result@1.Result<Pair<SmallProducts,numeric_budget@1.Budget>,calc_errors@1.NumericError> ! pure ]
    def project_small_products [
        [ dup ] dip [ unpair drop ] dip bigint@1.to_small_i64
