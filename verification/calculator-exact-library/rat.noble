    def gcd [
        512 numeric_budget@1.charge_native_steps
        [ [ pair ] dip 0 reserve_pair
          [ unpair [ dup unpair swap drop ] dip is_zero
            [ unpair swap
              [ [ unpair ] dip [ drop ] dip pair result@1.Result.Ok ]
              [ [ dup unpair ] dip bigint@1.divide_rem
                [ unpair [ pair GcdState.new ] dip gcd_remainder ]
                [ swap drop result@1.Result.Err ] result@1.Result.match ] if ]
            [ swap drop result@1.Result.Err ] result@1.Result.match ]
          [ result@1.Result.Err ] result@1.Result.match ]
        [ swap drop swap drop result@1.Result.Err ] result@1.Result.match
