    signature is_negative forall<S:stack>
        [ S bigint@1.BigInt numeric_budget@1.Budget -- S result@1.Result<Pair<Bool,numeric_budget@1.Budget>,calc_errors@1.NumericError> ! pure ]
    def is_negative [
