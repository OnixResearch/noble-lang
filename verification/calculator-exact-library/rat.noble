        [ dup [ swap ] dip ] dip bigint@1.divide_rem
        [ unpair [ unpair drop ] dip
          [ swap ] dip [[ swap ] dip ] dip bigint@1.divide_rem
          [ unpair [ unpair drop ] dip [ swap ] dip
            [ pair ] dip [ Rat.new ] dip pair result@1.Result.Ok ]
          [ swap drop result@1.Result.Err ] result@1.Result.match ]
        [ swap drop swap drop result@1.Result.Err ] result@1.Result.match
    ]

    # gcd one proves this already-canonical pair needs no quotient construction.
    signature reduce_gcd forall<S:stack>
        [ S Pair<bigint@1.BigInt,bigint@1.BigInt> bigint@1.BigInt numeric_budget@1.Budget -- S result@1.Result<Pair<Rat,numeric_budget@1.Budget>,calc_errors@1.NumericError> ! pure ]
