    def unit_candidate [
        [ dup unpair drop ] dip abs_bigint
        [ unpair [ bigint@1.one ] dip bigint@1.compare
          [ unpair [ 0 = ] dip pair result@1.Result.Ok ]
          [ result@1.Result.Err ] result@1.Result.match ]
        [ result@1.Result.Err ] result@1.Result.match
