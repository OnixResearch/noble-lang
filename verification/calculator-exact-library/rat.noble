        [ swap drop unpair swap
          [ swap
            [[ dup unpair swap drop parts pair ] dip swap ] dip
            project_small_products
            [ swap drop unpair swap
              [ swap [ pair SmallRats.Both ] dip pair result@1.Result.Ok ]
              [ drop [ drop ] dip [ unit SmallRats.Either ] dip pair result@1.Result.Ok ]
              SmallProducts.match ]
            [ swap drop swap drop result@1.Result.Err ] result@1.Result.match ]
          [ drop [ unit SmallRats.Either ] dip pair result@1.Result.Ok ]
          SmallProducts.match ]
        [ swap drop result@1.Result.Err ] result@1.Result.match
    ]

    # All four projected magnitudes are at most 255. Cross products are at
    # most 65,025 and a cross sum/difference at most 130,050: raw I64 cannot
    # wrap. Bounds on the *inputs*, not the result, decide this path.
    signature tiny_cross_left forall<S:stack> [ S Pair<Pair<I64,I64>,Pair<I64,I64>> -- S I64 ! pure ]
    def tiny_cross_left [ unpair [ unpair drop ] dip unpair swap drop * ]
    signature tiny_cross_right forall<S:stack> [ S Pair<Pair<I64,I64>,Pair<I64,I64>> -- S I64 ! pure ]
    def tiny_cross_right [ unpair swap pair tiny_cross_left ]
    signature tiny_numer_product forall<S:stack> [ S Pair<Pair<I64,I64>,Pair<I64,I64>> -- S I64 ! pure ]
    def tiny_numer_product [ unpair [ unpair drop ] dip unpair drop * ]
    signature tiny_den_product forall<S:stack> [ S Pair<Pair<I64,I64>,Pair<I64,I64>> -- S I64 ! pure ]
    def tiny_den_product [ unpair [ unpair swap drop ] dip unpair swap drop * ]
    signature tiny_sum_cross forall<S:stack> [ S Pair<Pair<I64,I64>,Pair<I64,I64>> -- S I64 ! pure ]
    def tiny_sum_cross [ dup tiny_cross_left swap tiny_cross_right + ]
    signature tiny_diff_cross forall<S:stack> [ S Pair<Pair<I64,I64>,Pair<I64,I64>> -- S I64 ! pure ]
    def tiny_diff_cross [ dup tiny_cross_left swap tiny_cross_right - ]
    signature tiny_plus_pair forall<S:stack> [ S Pair<Pair<I64,I64>,Pair<I64,I64>> -- S Pair<I64,I64> ! pure ]
    def tiny_plus_pair [ dup tiny_sum_cross swap tiny_den_product pair ]
    signature tiny_minus_pair forall<S:stack> [ S Pair<Pair<I64,I64>,Pair<I64,I64>> -- S Pair<I64,I64> ! pure ]
    def tiny_minus_pair [ dup tiny_diff_cross swap tiny_den_product pair ]
    signature tiny_times_pair forall<S:stack> [ S Pair<Pair<I64,I64>,Pair<I64,I64>> -- S Pair<I64,I64> ! pure ]
    def tiny_times_pair [ dup tiny_numer_product swap tiny_den_product pair ]
    signature tiny_divide_pair forall<S:stack> [ S Pair<Pair<I64,I64>,Pair<I64,I64>> -- S Pair<I64,I64> ! pure ]
    def tiny_divide_pair [ dup tiny_cross_left swap tiny_cross_right pair ]
    signature tiny_normalize_sign forall<S:stack> [ S Pair<I64,I64> -- S Pair<I64,I64> ! pure ]
    def tiny_normalize_sign [ unpair dup 0 < [ 0 swap - [ 0 swap - ] dip pair ] [ pair ] if ]
    signature tiny_abs forall<S:stack> [ S I64 -- S I64 ! pure ]
