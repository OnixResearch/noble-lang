    def reduce_nonunit [
        [ dup unpair ] dip [ swap ] dip abs_bigint
        [ unpair [ swap ] dip gcd_ordered
          [ unpair reduce_gcd ]
          [ swap drop result@1.Result.Err ] result@1.Result.match ]
        [ swap drop swap drop result@1.Result.Err ]
        result@1.Result.match
    ]

    # A canonical positive unit denominator already has gcd one.
    signature reduce_unit_denominator forall<S:stack>
        [ S Pair<bigint@1.BigInt,bigint@1.BigInt> numeric_budget@1.Budget -- S result@1.Result<Pair<Rat,numeric_budget@1.Budget>,calc_errors@1.NumericError> ! pure ]
    def reduce_unit_denominator [
        [ dup unpair swap drop ] dip [ bigint@1.one ] dip bigint@1.compare
        [ unpair [ 0 = ] dip swap
          [ [ Rat.new ] dip pair result@1.Result.Ok ]
          [ reduce_signed ] if ]
        [ swap drop result@1.Result.Err ] result@1.Result.match
