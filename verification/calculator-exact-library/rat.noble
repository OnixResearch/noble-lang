    signature width_limit forall<S:stack>
        [ S I64 -- S result@1.Result<I64,calc_errors@1.NumericError> ! pure ]
    def width_limit [
        dup 0 < [ drop call_depth_error result@1.Result.Err ]
        [ dup 1000000000 < [ result@1.Result.Ok ]
          [ drop call_depth_error result@1.Result.Err ] if ] if
    ]

    signature max_i64 forall<S:stack> [ S I64 I64 -- S I64 ! pure ]
    def max_i64 [
        pair dup unpair <
        [ unpair swap drop ] [ unpair drop ] if
    ]

    # UNVERIFIED Rat caller-frame hypothesis over BigInt's source queue model.
    # Compiled continuation peaks must validate 4*(current bits+1)+136.
    signature reserve_depth forall<S:stack>
        [ S I64 I64 numeric_budget@1.Budget -- S result@1.Result<numeric_budget@1.Budget,calc_errors@1.NumericError> ! pure ]
    def reserve_depth [
        [ dup 0 < ] dip swap
        [ drop drop drop call_depth_error result@1.Result.Err ]
        [ [ dup 480 < ] dip swap
          [ [ swap ] dip [ 1 + 4 * ] dip [ + 136 + ] dip swap
            dup 480 <
          [ numeric_budget@1.admit_call ]
          [ drop drop call_depth_error result@1.Result.Err ] if ]
          [ drop drop drop call_depth_error result@1.Result.Err ] if ] if
    ]

    signature pair_width forall<S:stack>
        [ S Pair<bigint@1.BigInt,bigint@1.BigInt> numeric_budget@1.Budget -- S result@1.Result<Pair<Pair<Pair<bigint@1.BigInt,bigint@1.BigInt>,I64>,numeric_budget@1.Budget>,calc_errors@1.NumericError> ! pure ]
    def pair_width [
        [ dup unpair drop ] dip bigint@1.bit_length
        [ unpair [ width_limit ] dip swap
          [ swap [[ dup unpair swap drop ] dip ] dip
            [ swap ] dip bigint@1.bit_length
            [ unpair [ width_limit ] dip swap
              [ swap [ max_i64 ] dip [ pair ] dip pair result@1.Result.Ok ]
              [ swap drop swap drop swap drop result@1.Result.Err ]
              result@1.Result.match ]
            [ swap drop swap drop result@1.Result.Err ]
            result@1.Result.match ]
          [ swap drop swap drop result@1.Result.Err ]
          result@1.Result.match ]
        [ swap drop result@1.Result.Err ] result@1.Result.match
    ]

    signature reserve_pair forall<S:stack>
        [ S Pair<bigint@1.BigInt,bigint@1.BigInt> numeric_budget@1.Budget I64 -- S result@1.Result<Pair<Pair<bigint@1.BigInt,bigint@1.BigInt>,numeric_budget@1.Budget>,calc_errors@1.NumericError> ! pure ]
    def reserve_pair [
        [ pair_width ] dip swap
        [ unpair [ unpair ] dip [[ swap ] dip ] dip [ swap ] dip
          reserve_depth
          [ pair result@1.Result.Ok ]
          [ swap drop result@1.Result.Err ] result@1.Result.match ]
        [ swap drop result@1.Result.Err ] result@1.Result.match
