    signature normalize_sign forall<S:stack>
        [ S Pair<bigint@1.BigInt,bigint@1.BigInt> numeric_budget@1.Budget -- S result@1.Result<Pair<Rat,numeric_budget@1.Budget>,calc_errors@1.NumericError> ! pure ]
    def normalize_sign [
        [ dup unpair swap drop ] dip is_negative
        [ unpair swap
          [ [ unpair ] dip bigint@1.negate
            [ unpair [ swap ] dip bigint@1.negate
              [ unpair [ swap ] dip [ pair ] dip reduce_unit_denominator ]
              [ swap drop result@1.Result.Err ] result@1.Result.match ]
            [ swap drop result@1.Result.Err ] result@1.Result.match ]
          [ reduce_unit_denominator ] if ]
        [ swap drop result@1.Result.Err ] result@1.Result.match
