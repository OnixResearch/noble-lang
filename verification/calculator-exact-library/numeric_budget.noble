    opaque Budget Pair<I64,Pair<I64,Pair<I64,Pair<I64,Pair<I64,Pair<I64,Pair<I64,I64>>>>>>> private
    export Budget
    signature charge_input_bytes forall<S:stack>
        [ S Budget I64 -- S result@1.Result<Budget,calc_errors@1.NumericError> ! pure ]
    export charge_input_bytes
    def charge_input_bytes [
        [ Budget.into unpair ] dip
        swap [ numeric_budget_limits@1.input_bytes ] dip swap
        [ swap pair Budget.new result@1.Result.Ok ]
        [ swap drop result@1.Result.Err ]
