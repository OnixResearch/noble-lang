        [ swap [ swap ] dip
          [ 1 numeric_budget_limits@1.numeric_digits ] dip swap
          [ swap pair pair Budget.new result@1.Result.Ok ]
          [ swap drop swap drop result@1.Result.Err ]
          result@1.Result.match ]
        [ swap drop swap drop result@1.Result.Err ]
        result@1.Result.match
    ]

