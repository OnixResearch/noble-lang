    signature raw_multiply forall<S:stack> [ S BigInt BigInt -- S BigInt ! pure ]
    def raw_multiply [
        BigInt.into swap BigInt.into swap
        bitrelation@1.multiply BigInt.new
    ]

    signature raw_multiply_ordered forall<S:stack>
        [ S Pair<BigInt,BigInt> Pair<I64,I64> -- S BigInt ! pure ]
    def raw_multiply_ordered [
        unpair >
        [ unpair swap raw_multiply ]
        [ unpair raw_multiply ] if
    ]

    signature multiply forall<S:stack>
        [ S BigInt BigInt numeric_budget@1.Budget
          -- S result@1.Result<Pair<BigInt,numeric_budget@1.Budget>,calc_errors@1.NumericError> ! pure ]
    export multiply
    def multiply [
        [ pair ] dip [ dup unpair ] dip inspect_two
        [ unpair [ dup ] dip preflight_product
          [ [ raw_multiply_ordered ] dip pair result@1.Result.Ok ]
          [ swap drop swap drop result@1.Result.Err ]
          result@1.Result.match ]
        [ swap drop result@1.Result.Err ]
        result@1.Result.match
    ]

    signature small_divide_unwind forall<S:stack>
        [ S Pair<I64,I64> Pair<I64,I64> -- S Pair<I64,I64> ! pure ]
    def small_divide_unwind [
        pair dup unpair [ unpair drop ] dip
        unpair swap drop >
        [ unpair swap drop ]
        [ unpair [ unpair ] dip unpair
          [ + ] dip [ swap ] dip swap - pair ] if
    ]

    # State = ((nonnegative dividend,positive divisor),(scaled divisor,power)).
    # A private state token bounds this exported recursive word to <=13
    # ascent frames, one unwind for each possible quotient bit.
    signature small_divide forall<S:stack>
        [ S SmallDivisionState -- S Pair<I64,I64> ! pure ]
    export small_divide
    def small_divide [
        SmallDivisionState.into unpair
        [ dup unpair drop ] dip swap
        [ dup unpair drop ] dip swap <
        [ drop unpair drop 0 swap pair ]
        [ [ dup ] dip
          dup unpair [ 2 * ] dip 2 * pair
          [ swap ] dip pair SmallDivisionState.new small_divide
          [ swap drop ] dip small_divide_unwind ] if
    ]

    signature small_divide_unsigned forall<S:stack>
        [ S List<Bool> List<Bool> -- S Pair<List<Bool>,List<Bool>> ! pure ]
    def small_divide_unsigned [
        [ bitstep@1.fold_unsigned ] dip bitstep@1.fold_unsigned
        dup 1 pair [ pair ] dip pair
        SmallDivisionState.new small_divide
        unpair [ chunk_bits ] dip chunk_bits pair
    ]

    signature small_sign_different forall<S:stack>
        [ S Bool Bool -- S Bool ! pure ]
    def small_sign_different [ [ [ false ] [ true ] if ] [ ] if ]

    signature small_signed_divide_rem forall<S:stack>
        [ S Pair<Bool,List<Bool>> Pair<Bool,List<Bool>>
          -- S Pair<Pair<Bool,List<Bool>>,Pair<Bool,List<Bool>>> ! pure ]
    def small_signed_divide_rem [
        unpair [ swap ] dip swap unpair
        [[ swap ] dip ] dip
        swap [ swap ] dip
        pair [ swap ] dip
        [ small_divide_unsigned ] dip
        [ unpair ] dip
        [ swap ] dip
        dup unpair small_sign_different
        swap [ swap bitsigned@1.normalize ] dip
        [ swap ] dip unpair
        [ swap ] dip
        [[ drop ] dip ] dip
        swap bitsigned@1.normalize pair
    ]

    signature raw_small_divide_rem forall<S:stack>
        [ S BigInt BigInt -- S Pair<BigInt,BigInt> ! pure ]
    def raw_small_divide_rem [
        BigInt.into swap BigInt.into swap
        small_signed_divide_rem unpair
        [ BigInt.new ] dip BigInt.new pair
    ]

    signature raw_divide_rem forall<S:stack>
        [ S BigInt BigInt -- S result@1.Result<Pair<BigInt,BigInt>,calc_errors@1.NumericError> ! pure ]
    def raw_divide_rem [
        dup BigInt.into unpair swap drop bitstep@1.is_zero
        [ drop drop
          unit calc_errors@1.DomainArithmetic.DivisionByZero
          calc_errors@1.DomainExtended.Arithmetic
          calc_errors@1.DomainError.Extended
          calc_errors@1.NumericError.Domain result@1.Result.Err
        ] [
          BigInt.into swap BigInt.into swap
          bitquotient@1.divide_rem unpair
          [ BigInt.new ] dip BigInt.new
          pair result@1.Result.Ok
        ] if
    ]

    signature divide_rem forall<S:stack>
        [ S BigInt BigInt numeric_budget@1.Budget
          -- S result@1.Result<Pair<Pair<BigInt,BigInt>,numeric_budget@1.Budget>,calc_errors@1.NumericError> ! pure ]
    export divide_rem
    def divide_rem [
        [ pair ] dip [ dup unpair ] dip inspect_two
        [ unpair [ short_division_widths ] dip swap
          [ preflight_small_division
            [ [ unpair ] dip [ raw_small_divide_rem ] dip
              pair result@1.Result.Ok ]
            [ swap drop result@1.Result.Err ]
            result@1.Result.match ]
          [ preflight_division
            [ [ unpair ] dip [ raw_divide_rem ] dip swap
              [ swap pair result@1.Result.Ok ]
              [ swap drop result@1.Result.Err ]
              result@1.Result.match ]
            [ swap drop result@1.Result.Err ]
            result@1.Result.match ] if ]
        [ swap drop result@1.Result.Err ]
        result@1.Result.match
    ]
]
