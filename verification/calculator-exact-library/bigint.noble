    signature raw_subtract forall<S:stack> [ S BigInt BigInt -- S BigInt ! pure ]
    def raw_subtract [ raw_negate raw_add ]

    signature subtract forall<S:stack>
        [ S BigInt BigInt numeric_budget@1.Budget
          -- S result@1.Result<Pair<BigInt,numeric_budget@1.Budget>,calc_errors@1.NumericError> ! pure ]
    export subtract
    def subtract [
        [ pair ] dip [ dup unpair ] dip inspect_two
        [ unpair preflight_additive
          [ [ unpair ] dip [ raw_subtract ] dip pair result@1.Result.Ok ]
          [ swap drop result@1.Result.Err ]
          result@1.Result.match ]
        [ swap drop result@1.Result.Err ]
