          [ 128 numeric_budget@1.charge_native_steps
            [ [ raw_negate ] dip pair result@1.Result.Ok ]
            [ swap drop result@1.Result.Err ]
            result@1.Result.match ]
          [ swap drop result@1.Result.Err ]
          result@1.Result.match ]
        [ swap drop result@1.Result.Err ]
        result@1.Result.match
    ]

    signature raw_compare forall<S:stack> [ S BigInt BigInt -- S I64 ! pure ]
    def raw_compare [
        BigInt.into swap BigInt.into swap
        bitrelation@1.compare
    ]

    signature compare forall<S:stack>
        [ S BigInt BigInt numeric_budget@1.Budget
          -- S result@1.Result<Pair<I64,numeric_budget@1.Budget>,calc_errors@1.NumericError> ! pure ]
    export compare
    def compare [
        [ pair ] dip [ dup unpair ] dip inspect_two
        [ unpair preflight_compare
          [ [ unpair ] dip [ raw_compare ] dip pair result@1.Result.Ok ]
          [ swap drop result@1.Result.Err ]
          result@1.Result.match ]
        [ swap drop result@1.Result.Err ]
        result@1.Result.match
