module calc_diagnostic@1 [
    # All spans are zero-based half-open UTF-8 byte offsets. Provenance is
    # unavailable for expressions submitted through the calculator shell.
    opaque Span Pair<I64,I64> private
    export Span
    signature span forall<S:stack> [ S I64 I64 -- S Span ! pure ]
    export span
    def span [ pair Span.new ]
    signature bounds forall<S:stack> [ S Span -- S I64 I64 ! pure ]
    export bounds
    def bounds [ Span.into unpair ]

    # Every declared variant is binary. The public error remains one nominal
    # Diagnostic; private levels group the six categories without I64 tags.
    variant ParseDiagnostic SyntaxError Span private TrailingInput Span private
    variant NameDiagnostic UnknownName Span private WrongArity Span private
    variant EarlyDiagnostic Parse ParseDiagnostic private Name NameDiagnostic private
    variant LateDiagnostic DefinitionError Span private Numeric Pair<Span,calc_errors@1.NumericError> private
    variant Diagnostic Early EarlyDiagnostic private Late LateDiagnostic private
    export Diagnostic

    signature syntax_error forall<S:stack> [ S Span -- S Diagnostic ! pure ]
    export syntax_error
    def syntax_error [ ParseDiagnostic.SyntaxError EarlyDiagnostic.Parse Diagnostic.Early ]
    signature trailing_input forall<S:stack> [ S Span -- S Diagnostic ! pure ]
    export trailing_input
    def trailing_input [ ParseDiagnostic.TrailingInput EarlyDiagnostic.Parse Diagnostic.Early ]
    signature unknown_name forall<S:stack> [ S Span -- S Diagnostic ! pure ]
    export unknown_name
    def unknown_name [ NameDiagnostic.UnknownName EarlyDiagnostic.Name Diagnostic.Early ]
    signature wrong_arity forall<S:stack> [ S Span -- S Diagnostic ! pure ]
    export wrong_arity
    def wrong_arity [ NameDiagnostic.WrongArity EarlyDiagnostic.Name Diagnostic.Early ]
    signature definition_error forall<S:stack> [ S Span -- S Diagnostic ! pure ]
    export definition_error
    def definition_error [ LateDiagnostic.DefinitionError Diagnostic.Late ]

    signature numeric forall<S:stack>
        [ S I64 I64 calc_errors@1.NumericError -- S Diagnostic ! pure ]
    export numeric
    def numeric [ [ span ] dip pair LateDiagnostic.Numeric Diagnostic.Late ]
]
