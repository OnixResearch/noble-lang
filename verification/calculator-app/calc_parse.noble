                  left_bp machine frame_min_bp <
                  [ machine frame_state charged pair result@1.Result.Ok ]
                  [ machine frame_state calc_parse_state@1.advance charged
                    machine frame_depth 1 + right_bp 0 0 0 0 step
                    [ unpair let after let rhs
                      rhs machine frame_token calc_token@1.kind 0
                      machine frame_token calc_parse_state@1.emit
                      after machine frame_depth machine frame_min_bp 1 0 0 0 step ]
                    [ result@1.Result.Err ] result@1.Result.match ] if ]
