    # A recursive step captures one frame instead of rebuilding seven
    # closures for every alternative of both tagged dispatches.
    opaque Frame Pair<Pair<calc_parse_state@1.State,numeric_budget@1.Budget>,Pair<Pair<I64,I64>,Pair<I64,Pair<Call,calc_token@1.Token>>>> private
    signature frame forall<S:stack>
