    variant Mode Operand Unit public Infix Unit public
        CallOpen Unit public CallContinue Unit public CallRequired Unit public
    signature classify forall<S:stack> [ S I64 -- S Mode ! pure ]
    def classify [
        dup 0 = [ drop unit Mode.Operand ]
        [ dup 1 = [ drop unit Mode.Infix ]
          [ dup 2 = [ drop unit Mode.CallOpen ]
            [ dup 3 = [ drop unit Mode.CallContinue ]
              [ drop unit Mode.CallRequired ] if ] if ] if ] if
