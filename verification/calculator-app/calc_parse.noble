    export step
    def step [
        frame let machine
        machine frame_depth 64 <
        [ machine frame_budget machine frame_depth numeric_budget@1.admit_syntax
          [ let admitted
            admitted 1 numeric_budget@1.charge_work
            [ let charged
              machine frame_mode classify
              [ drop machine frame_token calc_token@1.kind let kind
                kind prefix_kind
                [ drop machine frame_state calc_parse_state@1.advance charged
                  machine frame_depth 1 + 30 0 0 0 0 step
                  [ unpair let after let operand
                    operand
                    kind 43 = [ 128 ] [ 129 ] if
                    0 machine frame_token calc_parse_state@1.emit let emitted
                    emitted after machine frame_depth machine frame_min_bp 1 0 0 0 step ]
                  [ result@1.Result.Err ] result@1.Result.match ]
                [ drop machine frame_state calc_parse_state@1.advance charged
