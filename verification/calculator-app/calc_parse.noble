    signature binding_power forall<S:stack> [ S I64 -- S I64 I64 ! pure ]
    def binding_power [
        let kind
        kind 43 = [ 10 11 ] [
        kind 45 = [ 10 11 ] [
        kind 42 = [ 20 21 ] [
        kind 47 = [ 20 21 ] [
        kind 94 = [ 40 40 ] [ -1 -1 ] if
        ] if ] if ] if ] if
