                      [ closing syntax result@1.Result.Err ] if ]
                    [ result@1.Result.Err ] result@1.Result.match ]
                [ drop machine frame_state calc_parse_state@1.advance
                      256 0 machine frame_token calc_parse_state@1.emit let emitted
                      emitted charged machine frame_depth machine frame_min_bp 1 0 0 0 step ]
                [ drop machine frame_state calc_parse_state@1.advance let after_name
                        after_name calc_parse_state@1.front calc_token@1.kind 40 =
                        [ machine frame_token calc_token@1.span let end let begin
                          after_name calc_parse_state@1.advance
                          charged machine frame_depth machine frame_min_bp 2 begin end 0 step ]
                        [ after_name 257 0 machine frame_token calc_parse_state@1.emit
                          charged machine frame_depth machine frame_min_bp 1 0 0 0 step ] if ]
                [ drop machine frame_token syntax result@1.Result.Err ]
                Prefix.match ]
