+private def typedLocalParamWat : String :=
+  "(module (type $entry (func (param i32) (result i32))) (func (type $entry) (param $environment i32) (result i32) local.get $environment))"
+
+private def typedLocalParamDecoded : Bool :=
+  match decodeForVerification typedLocalParamWat with
+  | .ok module =>
+    match module.funcs with
+    | [func] =>
+      match func.params, func.results, func.body with
+      | [.i32], [.i32], [.localGet 0] => true
+      | _, _, _ => false
+    | _ => false
+  | .error _ => false
+
+#eval if typedLocalParamDecoded then pure () else
+  throw <| IO.userError "typed function local name did not decode to local 0"
+
+private def namedDataSegmentsWat : String :=
+  "(module (memory 1) (data $bytes \"x\") (func (export \"copy\") " ++
+  "i32.const 0 i32.const 0 i32.const 1 memory.init $bytes data.drop $bytes))"
+
+private def namedDataSegmentsDecoded : Bool :=
+  match decodeForVerification namedDataSegmentsWat with
+  | .ok module =>
+    match module.funcs with
+    | [func] =>
+      match func.body with
+      | [.const 0, .const 0, .const 1, .memoryInit 0, .dataDrop 0] => true
+      | _ => false
+    | _ => false
+  | .error _ => false
+
+#eval if namedDataSegmentsDecoded then pure () else
+  throw <| IO.userError "named data segment did not decode to memory.init/data.drop index 0"
+
 end Wasm.Decoder.Wat
