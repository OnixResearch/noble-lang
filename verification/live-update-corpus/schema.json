{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onixresearch.org/noble/schemas/live-update-corpus-v1.json",
  "title": "Noble bounded live-update corpus envelope",
  "description": "Versioned envelope for bounded live-update observations exported from Noble's authoritative fixture lanes for later comparison with an external runtime. The envelope keeps case and runtime identities, raw-report provenance, independently declared expectations, the exact edits and checkpoint ordering, selected identities, effect prefixes and a per-runtime profile distinct. It is an experimental corpus, not a conformance promotion and not a model-to-implementation claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "corpus_revision", "generated_at", "profile", "runtime", "source",
    "pins", "result_classes", "canonical_cases", "scenarios", "non_claims"],
  "properties": {
    "schema": {"const": "noble-live-update-corpus/v1"},
    "corpus_revision": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "profile": {"$ref": "#/$defs/profile"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "source": {"$ref": "#/$defs/source"},
    "pins": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
    "result_classes": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {"$ref": "#/$defs/resultClass"}
    },
    "canonical_cases": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "states"],
      "properties": {
        "path": {"const": "specs/conformance/live-reference-cases.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "states": {"type": "object", "minProperties": 9,
          "additionalProperties": {"$ref": "#/$defs/caseState"}}
      }
    },
    "scenarios": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/scenario"}},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "what": {"type": "string"}
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "id", "sha256"],
      "properties": {
        "path": {"const": "verification/live-update-corpus/profiles/noble.json"},
        "id": {"const": "noble-live-update-profile/noble-v1"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "engine", "selection_command", "cli", "sources"],
      "properties": {
        "name": {"const": "noble"},
        "engine": {"const": "v8"},
        "selection_command": {"type": "string", "minLength": 1},
        "cli": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "sources": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/binding"}}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "clean"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "clean": {"const": true},
        "git": {"type": "string"}
      }
    },
    "resultClass": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "meaning"],
      "properties": {
        "id": {"enum": ["contract-violation", "intentional-semantic-difference",
          "supported-outcome", "unexpected-refusal", "runtime-failure", "unsupported", "not-run"]},
        "meaning": {"type": "string", "minLength": 1}
      }
    },
    "caseState": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation", "execution", "proof", "trust", "evidence"],
      "properties": {
        "implementation": {"type": "string"},
        "execution": {"type": "string"},
        "proof": {"type": "string"},
        "trust": {"type": "string"},
        "evidence": {"type": "array", "maxItems": 0}
      }
    },
    "lane": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "sha256", "variants", "exit", "report_kind", "report_valid",
        "duration_ms", "stdout_sha256", "stdout_bytes"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "runner": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "variants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "exit": {"type": "integer"},
        "report_kind": {"enum": ["json", "jsonl", "text", "empty"]},
        "report_valid": {"type": "boolean"},
        "duration_ms": {"type": "number", "minimum": 0},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stdout_bytes": {"type": "integer", "minimum": 0},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "role", "sha256", "bytes", "retained"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "role": {"enum": ["lane-stdout", "lane-stderr", "requests", "responses",
          "session-log", "lane-summary"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0},
        "retained": {"type": "boolean"},
        "reason": {"type": ["string", "null"]}
      }
    },
    "expectation": {
      "type": "object", "additionalProperties": false,
      "required": ["expectation_id", "origin", "claim", "declared", "observed", "status",
        "mismatch_class", "mapping"],
      "properties": {
        "expectation_id": {"type": "string", "minLength": 1},
        "origin": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "ref", "text"],
          "properties": {
            "kind": {"enum": ["canonical", "exporter-table"]},
            "ref": {"type": "string", "minLength": 1},
            "text": {"type": "string", "minLength": 1}
          }
        },
        "claim": {"enum": ["equals", "not-equals", "matches"]},
        "declared": {},
        "observed": {},
        "status": {"enum": ["holds", "mismatch", "unsupported"]},
        "mismatch_class": {"enum": ["contract-violation", "unexpected-refusal",
          "intentional-semantic-difference"]},
        "mapping": {"type": "string", "minLength": 1}
      }
    },
    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["started_at", "ended_at", "duration_ms", "bound_to"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "duration_ms": {"type": "number", "minimum": 0},
        "bound_to": {
          "type": "object", "additionalProperties": false,
          "required": ["case_id", "source_commit", "result_class", "admission_outcome"],
          "properties": {
            "case_id": {"type": "string", "minLength": 1},
            "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "result_class": {"type": "string", "minLength": 1},
            "admission_outcome": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["expectation_id", "status", "observed"],
                "properties": {
                  "expectation_id": {"type": "string", "minLength": 1},
                  "status": {"enum": ["holds", "mismatch", "unsupported"]},
                  "observed": {}
                }
              }
            }
          }
        }
      }
    },
    "otherRuntime": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "profile", "result_class", "reason", "anticipated_differences"],
      "properties": {
        "name": {"const": "makepad-relax"},
        "profile": {"type": "null"},
        "result_class": {"const": "not-run"},
        "reason": {"type": "string", "minLength": 1},
        "anticipated_differences": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["dimension", "noble", "relax", "classification_rule"],
          "properties": {
            "dimension": {"type": "string", "minLength": 1},
            "noble": {"type": "string", "minLength": 1},
            "relax": {"type": "string", "minLength": 1},
            "classification_rule": {"type": "string", "minLength": 1}
          }
        }}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "title", "bounded", "canonical_refs", "profile_refs", "lanes",
        "provenance", "runtime_identities", "edits", "ordering", "selected_identities",
        "effect_prefixes", "event_binding", "expectations", "observations", "comparison",
        "other_runtime", "timing"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^noble-live-update/[a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "bounded": {
          "type": "object", "additionalProperties": false, "required": ["statement", "limits"],
          "properties": {
            "statement": {"type": "string", "minLength": 1},
            "limits": {
              "type": "object", "minProperties": 1,
              "additionalProperties": {"type": "integer", "minimum": 0}
            }
          }
        },
        "canonical_refs": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["file", "id"],
          "properties": {
            "file": {"type": "string", "minLength": 1},
            "id": {"type": "string", "minLength": 1},
            "lines": {"type": "string"},
            "requirement": {"type": "string"}
          }
        }},
        "profile_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "lanes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lane"}},
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}},
        "runtime_identities": {
          "type": "object", "additionalProperties": true,
          "required": ["cli_sha256", "engine"],
          "properties": {
            "cli_sha256": {"$ref": "#/$defs/sha256"},
            "engine": {"const": "v8"}
          }
        },
        "edits": {
          "type": "object", "additionalProperties": false, "required": ["variants"],
          "properties": {"variants": {"type": "array", "minItems": 1, "items": {
            "type": "object", "additionalProperties": false,
            "required": ["variant", "count", "operations", "requests_sha256"],
            "properties": {
              "variant": {"type": "string", "minLength": 1},
              "count": {"type": "integer", "minimum": 1},
              "operations": {"type": "array", "minItems": 1,
                "items": {"type": "string", "minLength": 1}},
              "requests_sha256": {"$ref": "#/$defs/sha256"},
              "retained": {"type": "boolean"},
              "reason": {"type": ["string", "null"]}
            }
          }}}
        },
        "ordering": {
          "type": "object", "additionalProperties": false,
          "required": ["checkpoints", "publications", "roots"],
          "properties": {
            "checkpoints": {"type": "array", "items": {}},
            "publications": {"type": "array", "items": {}},
            "roots": {"type": "array", "items": {}}
          }
        },
        "selected_identities": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["subject", "slot", "generation", "incarnation"],
          "properties": {
            "subject": {"type": "string", "minLength": 1},
            "slot": {"type": "string", "minLength": 1},
            "generation": {"type": "string", "minLength": 1},
            "incarnation": {"type": "string", "minLength": 1},
            "programValueId": {"type": ["string", "null"]},
            "artifactSha256": {"type": ["string", "null"]},
            "rootEpoch": {"type": ["string", "null"]}
          }
        }},
        "effect_prefixes": {
          "type": "object", "additionalProperties": false, "required": ["normal", "abnormal"],
          "properties": {
            "normal": {"type": "array", "items": {}},
            "abnormal": {"type": "array", "items": {}}
          }
        },
        "event_binding": {
          "type": "object", "additionalProperties": false,
          "required": ["files", "sha256"],
          "properties": {
            "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "expectations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expectation"}},
        "observations": {"type": "object", "minProperties": 1},
        "comparison": {
          "type": "object", "additionalProperties": false,
          "required": ["runtime", "result_class", "reasons", "faithful_mapping",
            "unsupported_dimensions", "intentional_differences"],
          "properties": {
            "runtime": {"const": "noble"},
            "result_class": {"enum": ["contract-violation", "intentional-semantic-difference",
              "supported-outcome", "unexpected-refusal", "runtime-failure", "unsupported"]},
            "reasons": {"type": "array", "items": {"type": "string"}},
            "faithful_mapping": {"type": "string", "minLength": 1},
            "unsupported_dimensions": {"type": "array", "items": {"type": "string"}},
            "intentional_differences": {"type": "array", "items": {}}
          }
        },
        "other_runtime": {"$ref": "#/$defs/otherRuntime"},
        "timing": {"$ref": "#/$defs/timing"}
      }
    }
  }
}
