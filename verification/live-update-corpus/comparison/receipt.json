      }
    },
    {
      "case_id": "noble-live-update/typed-cases-and-bounds",
      "title": "Typed generated cases, negative families and the declared host bounds",
      "noble": {
        "result_class": "supported-outcome",
        "unsupported_dimensions": [
          "structural coercion between differing slot interfaces"
        ]
      },
      "relax": {
        "result_class": "intentional-semantic-difference",
        "scenario": "typed-admission",
        "reason": "Relax holds its own profile and differs from Noble on typed-admission.",
        "faithful_mapping": "Noble's negative admission families map to edits that the pinned rustc rejects: a type error, a signature change without its caller, and a borrow error. Noble's incompatible schema maps to a layout change of a struct that a thread-local holds. The admission of each candidate is compared by whether its body ran, not by message text.",
        "unsupported_dimensions": [
          "generated typed cases and declared host bounds: the Relax lane runs one fixed sequence.",
          "effect ceilings and nominal resource schemas: Rust has no direct counterpart."
        ],
        "relations": [
          {
            "dimension": "typed-admission",
            "relation": "intentional-semantic-difference"
          }
        ],
