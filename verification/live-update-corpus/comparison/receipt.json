  "scenarios": [
    {
      "case_id": "noble-live-update/held-root-and-new-root",
      "title": "Held root, nested replacement and a new root under one pinned map",
      "noble": {
        "result_class": "supported-outcome",
        "unsupported_dimensions": [
          "a single invocation routing to two emitting slots cannot be built from this authority shape",
          "two host threads sharing one registry"
        ]
      },
      "relax": {
        "result_class": "intentional-semantic-difference",
        "scenario": "held-root-and-new-root",
        "reason": "Relax holds its own profile and differs from Noble on version-selection-boundary, held-root-mixing.",
        "faithful_mapping": "Noble's held root maps to a root_a call parked on a thread across the edit, its nested replacement to the edit of leaf_b, and the new root to a fresh root_a call after the edit. The transitive chain root_t -> mid_c -> leaf_d maps to Noble's transitive dispatch. Relax has no root-scoped map, so selected versions are compared, not maps or epochs.",
        "unsupported_dimensions": [
          "root-scoped-version-pin: Relax declares per-call selection.",
          "stale compare-and-set, omission and retention-budget controls: Relax has no publication compare-and-set or retention budget."
        ],
        "relations": [
          {
            "dimension": "version-selection-boundary",
            "relation": "intentional-semantic-difference"
          },
          {
            "dimension": "held-root-mixing",
            "relation": "intentional-semantic-difference"
          }
        ],
        "admission_settings": [
          {
            "admission": "default",
            "result_class": "intentional-semantic-difference",
            "relax_contract": "supported-outcome",
            "temporal_admission": null
          }
        ]
      }
    },
    {
      "case_id": "noble-live-update/saved-program-and-package-retention",
      "title": "Saved Program, package retention and the retained-version quota",
      "noble": {
        "result_class": "supported-outcome",
        "unsupported_dimensions": [
          "cross-process persistence of the registry",
          "a multi-slot atomic publication group"
        ]
      },
      "relax": {
        "result_class": "intentional-semantic-difference",
        "scenario": "saved-callables-and-retention",
        "reason": "Relax holds its own profile and differs from Noble on retention-unit.",
        "faithful_mapping": "A saved Noble Program maps to a stored boxed closure and to a stored fn pointer, both saved in the first run. Replacements map to edits of leaf and make. Retention maps to calls of the stored values after later edits. Relax declares no retention quota, so Noble's quota boundary has no counterpart.",
        "unsupported_dimensions": [
          "retention-quota: Relax declares no bound on retained code.",
          "package retirement order and saved-owner tokens: Relax has no per-value owner."
        ],
        "relations": [
          {
            "dimension": "retention-unit",
            "relation": "intentional-semantic-difference"
          }
        ],
        "admission_settings": [
          {
            "admission": "default",
            "result_class": "intentional-semantic-difference",
            "relax_contract": "supported-outcome",
            "temporal_admission": null
          }
        ]
      }
    },
    {
      "case_id": "noble-live-update/relocation-and-effect-prefix",
      "title": "Event relocation under a pinned map and the abnormal effect prefix",
      "noble": {
        "result_class": "unsupported",
        "unsupported_dimensions": [
          "a duplicate-vs-omission ratio for one invocation routing to two emitting slots"
        ]
      },
      "relax": {
        "result_class": "supported-outcome",
        "scenario": "effect-prefix-and-rollback",
        "reason": "",
        "faithful_mapping": "Noble's abnormal effect prefix maps to the effect lines that the panicking version printed before its panic. Noble's abnormal root exit maps to Relax's rollback of the patch group and its rerun. Event relocation has no Relax counterpart.",
        "unsupported_dimensions": [
          "event-relocation: Relax has no counterpart of Noble's relocation witness.",
          "effect owner: Noble performs an effect for the checked target slot; a Relax effect belongs to the code that ran, so no owner correspondence is claimed."
        ],
        "relations": [
          {
            "dimension": "effect-performed-for",
            "relation": "unsupported"
          }
        ],
        "admission_settings": [
          {
            "admission": "default",
