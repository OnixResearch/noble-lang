+    ⟨(3 * (m' + 1 - (j + 1)) + 3 * (p + 1) + 5 + ((3 * (m' + 1 - (j + 1)) + 11) / 16 - 1)) - (17 * (m' + 1) + 7), by omega⟩
+  have e0 : (3 * (m' + 1 - (j + 1)) + 3 * (p + 1) + 5 + ((3 * (m' + 1 - (j + 1)) + 11) / 16 - 1)) - (17 * (m' + 1) + 7) = d := by omega
