+      (Y3'.putLink ([0, n + 4], 2) ([0, n + 4], 1), ⟨l, .write [] []⟩, 0) := rfl
+  have r4 : XMach.act xsys Y4' ⟨l, .write [] []⟩ = (Y4', ⟨Y4'.agents, .idle⟩, 0) := rfl
+  exact ⟨Y0', Y1', Y2', Y3', Y4', F5, ⟨Y4'.agents, .idle⟩, V, Fin, fun Qs Qs' rows => by
