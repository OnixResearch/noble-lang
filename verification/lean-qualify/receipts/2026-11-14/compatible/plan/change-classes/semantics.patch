+      d = 9) ∧ ((3 * (m' + 1 - (j + 1)) + 3 * (p + 1) + 5 + ((3 * (m' + 1 - (j + 1)) + 11) / 16 - 1)) + 4) = 17 * (m' + 1) + 11 + d ∧
+      ((3 * (m' + 1 - (j + 1)) + 3 * (p + 1) + 5 + ((3 * (m' + 1 - (j + 1)) + 11) / 16 - 1)) = 17 * (m' + 1) + 15 ↔ d = 8)) :=
