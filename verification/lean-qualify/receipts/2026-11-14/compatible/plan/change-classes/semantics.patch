+    .step (c₁ := 0) (c := 1) (k := 1) (fun h => by cases h) s₄
+      (.step (c₁ := 1) (c := 0) (k := 0) (fun h => by cases h) s₅ (.refl _ _))
+  refine ⟨?_, (w₃.trans w₅).solo.1⟩
