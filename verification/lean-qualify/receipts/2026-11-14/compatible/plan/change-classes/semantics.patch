+/-- The thread that races among the `k` threads after the first: of those
+that come to the zero of the first argument at one of the ten moments, the
+one with the largest number, which is the first to come there. -/
+def racerOf (m n : Nat) : Nat → Option Nat
+  | 0 => none
+  | t + 1 =>
+    if 17 * m + 7 ≤ turnAt m n t ∧ turnAt m n t ≤ 17 * m + 16 then some t else racerOf m n t
+
+theorem racerOf_none {m n : Nat} : ∀ k, racerOf m n k = none → ∀ t, t < k →
+    ¬ (17 * m + 7 ≤ turnAt m n t ∧ turnAt m n t ≤ 17 * m + 16)
+  | 0, _, t, ht => absurd ht (Nat.not_lt_zero t)
+  | k + 1, h, t, ht => by
+    have h' : (if 17 * m + 7 ≤ turnAt m n k ∧ turnAt m n k ≤ 17 * m + 16 then some k
+      else racerOf m n k) = none := h
+    by_cases c : 17 * m + 7 ≤ turnAt m n k ∧ turnAt m n k ≤ 17 * m + 16
+    · rw [ite_pos' c] at h'
+      cases h'
+    · rw [ite_neg' c] at h'
+      by_cases e : t = k
+      · rw [e]
+        exact c
+      · exact racerOf_none k h' t (by omega)
+
+theorem racerOf_some {m n : Nat} : ∀ k r, racerOf m n k = some r →
+    r < k ∧ (17 * m + 7 ≤ turnAt m n r ∧ turnAt m n r ≤ 17 * m + 16) ∧
+      ∀ t, r < t → t < k → ¬ (17 * m + 7 ≤ turnAt m n t ∧ turnAt m n t ≤ 17 * m + 16)
+  | 0, _, h => by cases h
+  | k + 1, r, h => by
+    have h' : (if 17 * m + 7 ≤ turnAt m n k ∧ turnAt m n k ≤ 17 * m + 16 then some k
+      else racerOf m n k) = some r := h
+    by_cases c : 17 * m + 7 ≤ turnAt m n k ∧ turnAt m n k ≤ 17 * m + 16
+    · rw [ite_pos' c] at h'
+      have e : k = r := Option.some.inj h'
+      subst e
+      exact ⟨Nat.lt_succ_self _, c, fun t h1 h2 => absurd h2 (by omega)⟩
+    · rw [ite_neg' c] at h'
+      obtain ⟨a, b, d⟩ := racerOf_some k r h'
+      exact ⟨Nat.lt_succ_of_lt a, b, fun t h1 h2 => by
+        by_cases e : t = k
+        · rw [e]
+          exact c
+        · exact d t h1 (by omega)⟩
+
+/-- **What `k + 1` threads in turn do in all on the net for `(m + 1) + n`.**
+If none of the `k` threads after the first comes to the zero of the first
+argument at one of the ten moments of the race, the work of one thread and
+the actions of `k` readers.  Otherwise the first of them to come there
+then, `racerOf m n k`, races the first thread: `raceWork` for the two; for
+the thread numbered one below it, which comes next, the actions to that
+zero and four more for it, three for the zero of the second argument and
+one for each top successor; for the threads numbered below that one, one
+action for that zero instead of four; and for the threads numbered above
+the one that races, which passed that zero before the race, three. -/
+def allWork (m n k : Nat) : Nat :=
+  match racerOf m n k with
+  | none => soloWork (m + 1) n + turnSum m n k
+  | some 0 => raceWork m n (turnAt m n 0 - (17 * m + 7)) + turnSumFrom m n 1 (k - 1)
+  | some (j + 1) =>
+    raceWork m n (turnAt m n (j + 1) - (17 * m + 7)) +
+      (if turnAt m n (j + 1) = 17 * m + 15 then j + 1 else 0) +
+      sumTo (fun t => turnAt m n t + t + 5) j + (turnAt m n j + (j + 1) + 7) +
+      turnSumFrom m n (j + 2) (k - (j + 2))
+
+/-- Threads that pass the zero of the first argument before the race, if
+there are any. -/
+theorem threads_early_opt (m n' j W : Nat)
+    (tot : (XMach.init (sum (m + 1) (n' + 1)) (j + 1)).Total xsys (fun i => i % (j + 1)) W) :
+    ∀ k, (1 ≤ k → turnAt m (n' + 1) j ≤ 17 * m + 6) → j + k + 1 ≤ m →
+      20 * (j + k) ≤ 3 * m + 3 * (n' + 1) + 23 →
+      (XMach.init (sum (m + 1) (n' + 1)) (j + k + 1)).Total xsys (fun i => i % (j + k + 1))
+        (W + turnSumFrom m (n' + 1) j k)
+  | 0, _, _, _ => tot
+  | k + 1, hA, hm, hk => threads_early_many m n' j W (hA (Nat.succ_pos k)) tot (k + 1) hm hk
+
+/-- **Any number of threads in turn, every size, to the action.**  On the
+net for `(m + 1) + n`, with `m` from four on, `k + 1` threads acting in
+turn, `k + 1 ≤ m` and `20 * k ≤ 3 * m + 3 * n + 21`, make exactly
+`allWork m n k` actions that are not rests. -/
+theorem threads_exact (m n k : Nat) (hm4 : 4 ≤ m) (hm : k + 1 ≤ m)
+    (hn : 20 * k ≤ 3 * m + 3 * n + 21) :
+    (XMach.init (sum (m + 1) n) (k + 1)).Total xsys (fun i => i % (k + 1)) (allWork m n k) := by
+  unfold allWork
+  cases hr : racerOf m n k with
+  | none =>
+    show (XMach.init (sum (m + 1) n) (k + 1)).Total xsys (fun i => i % (k + 1))
+      (soloWork (m + 1) n + turnSum m n k)
+    exact threads_total m n k (by omega) (by omega) (fun t ht => by
+      have h := racerOf_none k hr t ht
+      omega)
+  | some r =>
+    obtain ⟨hrk, hw, hlater⟩ := racerOf_some k r hr
+    obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by
+      have h := hw.1
+      unfold turnAt at h
+      omega⟩
+    cases r with
+    | zero =>
+      show (XMach.init (sum (m + 1) (n' + 1)) (k + 1)).Total xsys (fun i => i % (k + 1))
+        (raceWork m (n' + 1) (turnAt m (n' + 1) 0 - (17 * m + 7)) +
+          turnSumFrom m (n' + 1) 1 (k - 1))
+      have base : (XMach.init (sum (m + 1) (n' + 1)) (1 + 1)).Total xsys (fun i => i % (1 + 1))
+          (raceWork m (n' + 1) (turnAt m (n' + 1) 0 - (17 * m + 7))) :=
+        two_threads_race_at m (n' + 1) hm4 hw.1 hw.2
+      have res := threads_early_opt m n' 1 _ base (k - 1) (fun h1 => by
+        have hn1 := hlater 1 (by omega) (by omega)
+        have h0 := hw.2
+        unfold turnAt at hn1 h0 ⊢
+        omega) (by omega) (by omega)
+      rw [show 1 + (k - 1) + 1 = k + 1 by omega] at res
+      exact res
+    | succ j =>
+      show (XMach.init (sum (m + 1) (n' + 1)) (k + 1)).Total xsys (fun i => i % (k + 1))
+        (raceWork m (n' + 1) (turnAt m (n' + 1) (j + 1) - (17 * m + 7)) +
+          (if turnAt m (n' + 1) (j + 1) = 17 * m + 15 then j + 1 else 0) +
+          sumTo (fun t => turnAt m (n' + 1) t + t + 5) j +
+          (turnAt m (n' + 1) j + (j + 1) + 7) +
+          turnSumFrom m (n' + 1) (j + 2) (k - (j + 2)))
+      have base : (XMach.init (sum (m + 1) (n' + 1)) (j + 2 + 1)).Total xsys
+          (fun i => i % (j + 2 + 1))
+          (raceWork m (n' + 1) (turnAt m (n' + 1) (j + 1) - (17 * m + 7)) +
+            (if turnAt m (n' + 1) (j + 1) = 17 * m + 15 then j + 1 else 0) +
+            sumTo (fun t => turnAt m (n' + 1) t + t + 5) j +
+            (turnAt m (n' + 1) j + (j + 1) + 7)) :=
+        threads_race_last m (n' + 1) j (by omega) hw.1 hw.2
+      have res := threads_early_opt m n' (j + 2) _ base (k - (j + 2)) (fun h1 => by
+        have hn1 := hlater (j + 2) (by omega) (by omega)
+        have h0 := hw.2
+        unfold turnAt at hn1 h0 ⊢
+        omega) (by omega) (by omega)
+      rw [show j + 2 + (k - (j + 2)) + 1 = k + 1 by omega] at res
+      exact res
+
+example : (XMach.init (sum 8 38) 5).Total xsys (fun i => i % 5) 1014 :=
+  (threads_exact 7 38 4 (by decide) (by decide) (by decide)).cast (by decide)
+
+example : (XMach.init (sum 8 40) 5).Total xsys (fun i => i % 5) 898 :=
+  (threads_exact 7 40 4 (by decide) (by decide) (by decide)).cast (by decide)
+
+example : (XMach.init (sum 14 66) 6).Total xsys (fun i => i % 6) 1992 :=
+  (threads_exact 13 66 5 (by decide) (by decide) (by decide)).cast (by decide)
+
+example : (XMach.init (sum 8 38) 7).Total xsys (fun i => i % 7) 1284 :=
+  (threads_exact 7 38 6 (by decide) (by decide) (by decide)).cast (by decide)
+
+example : (XMach.init (sum 13 60) 8).Total xsys (fun i => i % 8) 2258 :=
+  (threads_exact 12 60 7 (by decide) (by decide) (by decide)).cast (by decide)
+
+/-- Each thread comes to the zero of the first argument three or four
+actions before the thread numbered one below it. -/
+theorem turnAt_step (m n t : Nat) (ht : t + 1 ≤ m) :
+    turnAt m n t = turnAt m n (t + 1) + 3 ∨ turnAt m n t = turnAt m n (t + 1) + 4 := by
+  unfold turnAt
+  omega
+
+/-- And at least three actions for each thread between them. -/
+theorem turnAt_gap (m n : Nat) {t s : Nat} (h : t ≤ s) (hs : s ≤ m) :
+    turnAt m n s + 3 * (s - t) ≤ turnAt m n t := by
+  unfold turnAt
+  omega
+
+theorem turnAt_ge (m n t : Nat) (ht : t + 1 ≤ m) : 3 * n + 4 ≤ turnAt m n t := by
+  unfold turnAt
+  omega
+
+theorem win_pos {m n t : Nat} (h : 17 * m + 7 ≤ turnAt m n t) : 1 ≤ n := by
+  unfold turnAt at h
+  omega
+
+theorem racerOf_out {m n k : Nat}
+    (h : ¬ (17 * m + 7 ≤ turnAt m n k ∧ turnAt m n k ≤ 17 * m + 16)) :
+    racerOf m n (k + 1) = racerOf m n k := by
+  show (if 17 * m + 7 ≤ turnAt m n k ∧ turnAt m n k ≤ 17 * m + 16 then some k
+    else racerOf m n k) = racerOf m n k
+  rw [ite_neg' h]
+
+theorem racerOf_in {m n k : Nat}
+    (h : 17 * m + 7 ≤ turnAt m n k ∧ turnAt m n k ≤ 17 * m + 16) :
+    racerOf m n (k + 1) = some k := by
+  show (if 17 * m + 7 ≤ turnAt m n k ∧ turnAt m n k ≤ 17 * m + 16 then some k
+    else racerOf m n k) = some k
+  rw [ite_pos' h]
+
+theorem racerOf_none_of {m n : Nat} : ∀ k,
+    (∀ t, t < k → ¬ (17 * m + 7 ≤ turnAt m n t ∧ turnAt m n t ≤ 17 * m + 16)) →
+    racerOf m n k = none
+  | 0, _ => rfl
+  | k + 1, h => by
+    rw [racerOf_out (h k (Nat.lt_succ_self k))]
+    exact racerOf_none_of k (fun t ht => h t (Nat.lt_succ_of_lt ht))
+
+theorem allWork_none {m n k : Nat} (h : racerOf m n k = none) :
+    allWork m n k = soloWork (m + 1) n + turnSum m n k := by
+  unfold allWork
+  simp only [h]
+
+theorem allWork_first {m n k : Nat} (h : racerOf m n k = some 0) :
+    allWork m n k =
+      raceWork m n (turnAt m n 0 - (17 * m + 7)) + turnSumFrom m n 1 (k - 1) := by
+  unfold allWork
+  simp only [h]
+
+theorem allWork_later {m n k j : Nat} (h : racerOf m n k = some (j + 1)) :
+    allWork m n k = raceWork m n (turnAt m n (j + 1) - (17 * m + 7)) +
+      (if turnAt m n (j + 1) = 17 * m + 15 then j + 1 else 0) +
+      sumTo (fun t => turnAt m n t + t + 5) j + (turnAt m n j + (j + 1) + 7) +
+      turnSumFrom m n (j + 2) (k - (j + 2)) := by
+  unfold allWork
+  simp only [h]
+
+theorem allWork_zero (m n : Nat) : allWork m n 0 = soloWork (m + 1) n := rfl
+
+/-- The work when the second thread races and there are no others. -/
+theorem allWork_second (m n : Nat)
+    (h : 17 * m + 7 ≤ turnAt m n 0 ∧ turnAt m n 0 ≤ 17 * m + 16) :
+    allWork m n (0 + 1) = raceWork m n (turnAt m n 0 - (17 * m + 7)) := by
+  rw [allWork_first (racerOf_in h)]
+  rfl
+
+/-- The work when the last thread races. -/
+theorem allWork_last (m n j : Nat)
+    (h : 17 * m + 7 ≤ turnAt m n (j + 1) ∧ turnAt m n (j + 1) ≤ 17 * m + 16) :
+    allWork m n (j + 1 + 1) = raceWork m n (turnAt m n (j + 1) - (17 * m + 7)) +
+      (if turnAt m n (j + 1) = 17 * m + 15 then j + 1 else 0) +
+      sumTo (fun t => turnAt m n t + t + 5) j + (turnAt m n j + (j + 1) + 7) := by
+  rw [allWork_later (racerOf_in h), show j + 1 + 1 - (j + 2) = 0 by omega]
+  rfl
+
+theorem turnSumFrom_succ (m n j q : Nat) :
+    turnSumFrom m n j (q + 1) = turnSumFrom m n j q + turnRest m n (j + q) := rfl
+
+/-- **A thread that is not in the race adds exactly its own actions.**  If
+the thread numbered `k + 1` does not come to the zero of the first argument
+at one of the ten moments, the work with it is the work without it and
+`turnRest m n k`. -/
+theorem allWork_succ_out (m n k : Nat)
+    (h : ¬ (17 * m + 7 ≤ turnAt m n k ∧ turnAt m n k ≤ 17 * m + 16)) :
+    allWork m n (k + 1) = allWork m n k + turnRest m n k := by
+  cases hr : racerOf m n k with
+  | none =>
+    rw [allWork_none hr, allWork_none ((racerOf_out h).trans hr)]
+    show soloWork (m + 1) n + (turnSum m n k + turnRest m n k) = _
+    omega
+  | some r =>
+    obtain ⟨hrk, -, -⟩ := racerOf_some k r hr
+    cases r with
+    | zero =>
+      rw [allWork_first hr, allWork_first ((racerOf_out h).trans hr)]
+      have e1 : k + 1 - 1 = (k - 1) + 1 := by omega
+      have e2 : 1 + (k - 1) = k := by omega
+      rw [e1, turnSumFrom_succ, e2]
+      omega
+    | succ j =>
+      rw [allWork_later hr, allWork_later ((racerOf_out h).trans hr)]
+      have e1 : k + 1 - (j + 2) = (k - (j + 2)) + 1 := by omega
+      have e2 : j + 2 + (k - (j + 2)) = k := by omega
+      rw [e1, turnSumFrom_succ, e2]
+      omega
+
+theorem turnRest_pos (m n t : Nat) (hn : 1 ≤ n) :
+    turnRest m n t = turnAt m n t + zeroCost m (turnAt m n t) + 3 + (t + 1) := by
+  obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by omega⟩
+  rfl
+
+theorem zeroCost_le (m A : Nat) : zeroCost m A ≤ 4 := by
+  unfold zeroCost
+  by_cases h1 : A ≤ 17 * m + 6
+  · rw [ite_pos' h1]
+    omega
+  · rw [ite_neg' h1]
+    by_cases h2 : A ≤ 17 * m + 20
+    · rw [ite_pos' h2]
+      omega
+    · rw [ite_neg' h2]
+      omega
+
+/-- A thread that only reads makes at least the actions that bring it to
+the zero of the first argument, and two fewer than one thread alone makes
+at most. -/
+theorem turnRest_bounds (m n t : Nat) (ht : t ≤ m) :
+    turnAt m n t ≤ turnRest m n t ∧ turnRest m n t + 2 ≤ soloWork (m + 1) n := by
+  rw [soloWork_succ]
+  cases n with
+  | zero =>
+    show turnAt m 0 t ≤ 3 * (m - t) + 8 + (3 * (m - t) + 15) / 16 + t ∧
+      3 * (m - t) + 8 + (3 * (m - t) + 15) / 16 + t + 2 ≤ 22 * (m + 1) + 3 * 0 + 13
+    unfold turnAt
+    omega
+  | succ n' =>
+    rw [turnRest_pos m (n' + 1) t (by omega)]
+    have z := zeroCost_le m (turnAt m (n' + 1) t)
+    have a : turnAt m (n' + 1) t + t ≤ 3 * m + 3 * (n' + 1) + 1 + (3 * m + 11) / 16 := by
+      unfold turnAt
+      omega
+    omega
+
+theorem turnSum_late (m n : Nat) (hn : 1 ≤ n) : ∀ q,
+    (∀ t, t < q → 17 * m + 21 ≤ turnAt m n t) →
+    turnSum m n q = sumTo (fun t => turnAt m n t + t + 5) q
+  | 0, _ => rfl
+  | q + 1, h => by
+    show turnSum m n q + turnRest m n q =
+      sumTo (fun t => turnAt m n t + t + 5) q + (turnAt m n q + q + 5)
+    rw [turnSum_late m n hn q (fun t ht => h t (Nat.lt_succ_of_lt ht)), turnRest_pos m n q hn]
+    have hq := h q (Nat.lt_succ_self q)
+    have z : zeroCost m (turnAt m n q) = 1 := by
+      unfold zeroCost
+      rw [ite_neg' (by omega), ite_neg' (by omega)]
+    rw [z]
+    omega
+
+theorem turnSum_near (m n : Nat) (hn : 1 ≤ n) : ∀ q,
+    (∀ t, t < q → 17 * m + 20 ≤ turnAt m n t) →
+    (∀ t, t + 1 < q → 17 * m + 21 ≤ turnAt m n t) →
+    sumTo (fun t => turnAt m n t + t + 5) q ≤ turnSum m n q ∧
+      turnSum m n q ≤ sumTo (fun t => turnAt m n t + t + 5) q + 3
+  | 0, _, _ => ⟨Nat.le_refl _, Nat.zero_le _⟩
+  | q + 1, h1, h2 => by
+    have e := turnSum_late m n hn q (fun t ht => h2 t (by omega))
+    have tr := turnRest_pos m n q hn
+    have hq := h1 q (Nat.lt_succ_self q)
+    have z : zeroCost m (turnAt m n q) = 4 ∨ zeroCost m (turnAt m n q) = 1 := by
+      unfold zeroCost
+      rw [ite_neg' (by omega)]
+      by_cases c : turnAt m n q ≤ 17 * m + 20
+      · rw [ite_pos' c]
+        exact Or.inl rfl
+      · rw [ite_neg' c]
+        exact Or.inr rfl
+    show sumTo (fun t => turnAt m n t + t + 5) q + (turnAt m n q + q + 5) ≤
+        turnSum m n q + turnRest m n q ∧
+      turnSum m n q + turnRest m n q ≤
+        sumTo (fun t => turnAt m n t + t + 5) q + (turnAt m n q + q + 5) + 3
+    rw [e, tr]
+    omega
+
+/-- The work of the race is `39 * m + 3 * n + 60` when the first thread
+keeps the pair, and from `44 * m + 6 * n + 52` to `44 * m + 6 * n + 68`
+otherwise. -/
+theorem raceWork_cases (m n d : Nat) :
+    (d = 8 ∧ raceWork m n d = 39 * m + 3 * n + 60) ∨
+    (d ≠ 8 ∧ 44 * m + 6 * n + 52 ≤ raceWork m n d ∧ raceWork m n d ≤ 44 * m + 6 * n + 68) := by
+  by_cases h8 : d = 8
+  · subst h8
+    exact Or.inl ⟨rfl, rfl⟩
+  · refine Or.inr ⟨h8, ?_, raceWork_le m n d⟩
+    unfold raceWork
+    split <;> omega
+
+/-- The race of a thread and the race of the thread that comes three or
+four actions after it. -/
+theorem raceWork_next (m n d e : Nat) (h : e = d + 3 ∨ e = d + 4) (he : e ≤ 9) :
+    (e = 8 ∧ raceWork m n d = raceWork m n e + 5 * m + 3 * n + (d - 3)) ∨
+    (e ≠ 8 ∧ raceWork m n d ≤ raceWork m n e ∧ raceWork m n e ≤ raceWork m n d + 9) := by
+  have hd : d = 0 ∨ d = 1 ∨ d = 2 ∨ d = 3 ∨ d = 4 ∨ d = 5 ∨ d = 6 := by omega
+  rcases hd with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> rcases h with rfl | rfl <;>
+    simp only [raceWork] <;> first | omega | (refine Or.inl ⟨trivial, ?_⟩; omega)
+
+/-- **What one more thread in turn adds.**  With `k ≤ m`, the work of
+`k + 2` threads is at least that of `k + 1` and the `turnAt m n k` actions
+that bring the new thread to the zero of the first argument, and at most
+that of `k + 1` and two fewer than the work of one thread alone. -/
+theorem allWork_succ (m n k : Nat) (hk : k ≤ m) :
+    allWork m n k + turnAt m n k ≤ allWork m n (k + 1) ∧
+      allWork m n (k + 1) + 2 ≤ allWork m n k + soloWork (m + 1) n := by
+  by_cases hW : 17 * m + 7 ≤ turnAt m n k ∧ turnAt m n k ≤ 17 * m + 16
+  · have hn : 1 ≤ n := win_pos hW.1
+    cases k with
+    | zero =>
+      rw [allWork_second m n hW, allWork_zero, soloWork_succ]
+      rcases raceWork_cases m n (turnAt m n 0 - (17 * m + 7)) with ⟨h8, hR⟩ | ⟨h8, hR1, hR2⟩
+      · omega
+      · omega
+    | succ k' =>
+      have st := turnAt_step m n k' (by omega)
+      by_cases hW' : 17 * m + 7 ≤ turnAt m n k' ∧ turnAt m n k' ≤ 17 * m + 16
+      · have nx := raceWork_next m n (turnAt m n (k' + 1) - (17 * m + 7))
+          (turnAt m n k' - (17 * m + 7)) (by omega) (by omega)
+        have b : (if turnAt m n (k' + 1) = 17 * m + 15 then k' + 1 else 0) = 0 :=
+          ite_neg' (by omega)
+        cases k' with
+        | zero =>
+          have e2 := allWork_last m n 0 hW
+          have s0 : sumTo (fun t => turnAt m n t + t + 5) 0 = 0 := rfl
+          rw [b, s0] at e2
+          rw [e2, allWork_second m n hW', soloWork_succ]
+          rcases nx with ⟨h8, hR⟩ | ⟨h8, hR1, hR2⟩
+          · omega
+          · omega
+        | succ j =>
+          have e2 := allWork_last m n (j + 1) hW
+          have s : sumTo (fun t => turnAt m n t + t + 5) (j + 1) =
+              sumTo (fun t => turnAt m n t + t + 5) j + (turnAt m n j + j + 5) := rfl
+          rw [b, s] at e2
+          rw [e2, allWork_last m n j hW', soloWork_succ]
+          rcases nx with ⟨h8, hR⟩ | ⟨h8, hR1, hR2⟩
+          · have b1 : (if turnAt m n (j + 1) = 17 * m + 15 then j + 1 else 0) = j + 1 :=
+              ite_pos' (by omega)
+            rw [b1]
+            omega
+          · have b1 : (if turnAt m n (j + 1) = 17 * m + 15 then j + 1 else 0) = 0 :=
+              ite_neg' (by omega)
+            rw [b1]
+            omega
+      · have hlate : ∀ t, t ≤ k' → 17 * m + 17 + 3 * (k' - t) ≤ turnAt m n t := fun t ht => by
+          have g := turnAt_gap m n ht (by omega : k' ≤ m)
+          omega
+        have hnone : racerOf m n (k' + 1) = none := racerOf_none_of (k' + 1) (fun t ht => by
+          have g := hlate t (by omega)
+          omega)
+        have near := turnSum_near m n hn k'
+          (fun t ht => by
+            have g := hlate t (by omega)
+            omega)
+          (fun t ht => by
+            have g := hlate t (by omega)
+            omega)
+        have ts : turnSum m n (k' + 1) = turnSum m n k' + turnRest m n k' := rfl
+        have zc : zeroCost m (turnAt m n k') = 4 := by
+          have g := hlate k' (Nat.le_refl k')
+          unfold zeroCost
+          rw [ite_neg' (by omega), ite_pos' (by omega)]
+        rw [allWork_last m n k' hW, allWork_none hnone, ts, turnRest_pos m n k' hn, zc,
+          soloWork_succ]
+        rcases raceWork_cases m n (turnAt m n (k' + 1) - (17 * m + 7)) with
+          ⟨h8, hR⟩ | ⟨h8, hR1, hR2⟩
+        · have b1 : (if turnAt m n (k' + 1) = 17 * m + 15 then k' + 1 else 0) = k' + 1 :=
+            ite_pos' (by omega)
+          rw [b1]
+          omega
+        · have b1 : (if turnAt m n (k' + 1) = 17 * m + 15 then k' + 1 else 0) = 0 :=
+            ite_neg' (by omega)
+          rw [b1]
+          omega
+  · rw [allWork_succ_out m n k hW]
+    have tb := turnRest_bounds m n k hk
+    omega
+
+/-- With `k ≤ m`, `k + 1` threads in turn do at most `k + 1` times the work
+of one thread, less two for each thread after the first. -/
+theorem allWork_le (m n : Nat) : ∀ k, k ≤ m →
+    allWork m n k + 2 * k ≤ (k + 1) * soloWork (m + 1) n
+  | 0, _ => by
+    rw [allWork_zero]
+    omega
+  | k + 1, h => by
+    have ih := allWork_le m n k (by omega)
+    have st := (allWork_succ m n k (by omega)).2
+    have e : (k + 1 + 1) * soloWork (m + 1) n =
+        (k + 1) * soloWork (m + 1) n + soloWork (m + 1) n := Nat.succ_mul _ _
+    rw [e]
+    omega
+
+/-- And at least the work of one thread and, for each thread after the
+first, the actions that bring it to the zero of the first argument. -/
+theorem allWork_ge (m n : Nat) : ∀ k, k ≤ m →
+    soloWork (m + 1) n + sumTo (turnAt m n) k ≤ allWork m n k
+  | 0, _ => Nat.le_refl _
+  | k + 1, h => by
+    have ih := allWork_ge m n k (by omega)
+    have st := (allWork_succ m n k (by omega)).1
+    show soloWork (m + 1) n + (sumTo (turnAt m n) k + turnAt m n k) ≤ allWork m n (k + 1)
+    omega
+
+/-- **One more thread in turn never saves work.**  On the net for
+`(m + 1) + n`, with `m` from four on, `k + 2 ≤ m` and
+`20 * (k + 1) ≤ 3 * m + 3 * n + 21`: the run of `k + 2` threads in turn
+makes more actions that are not rests than the run of `k + 1`, by at least
+the `turnAt m n k` actions that bring the new thread to the zero of the
+first argument, and by at most two fewer than the work of one thread
+alone. -/
+theorem threads_more (m n k : Nat) (hm4 : 4 ≤ m) (hm : k + 2 ≤ m)
+    (hn : 20 * (k + 1) ≤ 3 * m + 3 * n + 21) :
+    ∃ W W', (XMach.init (sum (m + 1) n) (k + 1)).Total xsys (fun i => i % (k + 1)) W ∧
+      (XMach.init (sum (m + 1) n) (k + 1 + 1)).Total xsys (fun i => i % (k + 1 + 1)) W' ∧
+      W + turnAt m n k ≤ W' ∧ W' + 2 ≤ W + soloWork (m + 1) n :=
+  ⟨allWork m n k, allWork m n (k + 1), threads_exact m n k hm4 (by omega) (by omega),
+    threads_exact m n (k + 1) hm4 hm hn, allWork_succ m n k (by omega)⟩
+
+/-- **Threads in turn: more than the work of one, less than the work of
+each.**  On the net for `(m + 1) + n`, with `m` from four on, `k + 1 ≤ m`
+and `20 * k ≤ 3 * m + 3 * n + 21`, the work `W` of `k + 1` threads in turn
+is at least that of one thread and `3 * n + 4` for each thread after the
+first, and at most `k + 1` times that of one thread, less two for each
+thread after the first. -/
+theorem threads_bounds (m n k : Nat) (hm4 : 4 ≤ m) (hm : k + 1 ≤ m)
+    (hn : 20 * k ≤ 3 * m + 3 * n + 21) :
+    ∃ W, (XMach.init (sum (m + 1) n) (k + 1)).Total xsys (fun i => i % (k + 1)) W ∧
+      soloWork (m + 1) n + k * (3 * n + 4) ≤ W ∧
+      W + 2 * k ≤ (k + 1) * soloWork (m + 1) n := by
+  refine ⟨allWork m n k, threads_exact m n k hm4 hm hn, ?_, allWork_le m n k (by omega)⟩
+  have g := allWork_ge m n k (by omega)
+  have s : k * (3 * n + 4) ≤ sumTo (turnAt m n) k :=
+    sumTo_ge k (fun t ht => turnAt_ge m n t (by omega))
+  omega
+
+example : allWork 7 38 5 = allWork 7 38 4 + 136 := by decide
+
+example : allWork 7 38 6 = allWork 7 38 5 + 134 := by decide
+
+example : soloWork 8 38 = 303 := by decide
+
+/-- The second bound is reached: two threads on `6 + 28` make 456 actions
+that are not rests, one thread 229. -/
+example : (XMach.init (sum 6 28) 2).Total xsys (fun i => i % 2) (2 * soloWork 6 28 - 2) :=
+  (threads_exact 5 28 1 (by decide) (by decide) (by decide)).cast (by decide)
+
+example : 2 * soloWork 6 28 - 2 = 456 := by decide
+
+/-- `Rounds c M R`: the `c` threads of `M`, acting in turn, are all at rest
+after `R` rounds, and not after fewer. -/
+def Rounds (c : Nat) (M : XMach Arith) (R : Nat) : Prop :=
+  (M.trace xsys (fun i => i % c) (c * R)).1.resting = true ∧
+    ∀ R', R' < R → ¬ (M.trace xsys (fun i => i % c) (c * R')).1.resting = true
+
+theorem Rounds.cast {c : Nat} {M : XMach Arith} {R R' : Nat} (h : Rounds c M R) (e : R = R') :
+    Rounds c M R' := by
+  subst e
+  exact h
+
+/-- A run takes one number of rounds. -/
+theorem Rounds.unique {c : Nat} {M : XMach Arith} {R R' : Nat} (h : Rounds c M R)
+    (h' : Rounds c M R') : R = R' := by
+  have a : ¬ R < R' := fun lt => h'.2 R lt h.1
+  have b : ¬ R' < R := fun lt => h.2 R' lt h'.1
+  omega
+
+/-- A run that is at rest after `N` actions has made all its work by then,
+one action at most at a time. -/
+theorem total_le_rest {c : Nat} {M : XMach Arith} {W N : Nat}
+    (t : M.Total xsys (fun i => i % c) W)
+    (h : (M.trace xsys (fun i => i % c) N).1.resting = true) : W ≤ N := by
+  obtain ⟨N0, hN0⟩ := t
+  have e := XMach.work_rest (xs := xsys) (fun i => i % c) h N0
+  have e2 := hN0 (N + N0) (by omega)
+  have le := XMach.work_le_count xsys (fun i => i % c) M N
+  omega
+
+theorem all_rest_resting {Y : XNet Arith} {Ts : List (XThread Arith)}
+    (h : ∀ T, T ∈ Ts → T = ⟨[], .idle⟩) : (⟨Y, Ts⟩ : XMach Arith).resting = true :=
+  List.all_eq_true.2 fun T hT => by
+    rw [h T hT]
+    rfl
+
+theorem first_of_resting {Y : XNet Arith} {T : XThread Arith} {Ts : List (XThread Arith)}
+    (h : (⟨Y, T :: Ts⟩ : XMach Arith).resting = true) : T = ⟨[], .idle⟩ :=
+  XThread.eq_rest (List.all_eq_true.1 h T List.mem_cons_self)
+
+/-- **The rounds of a run in which every thread but the first only reads.**
+If the first thread alone is at rest after `A + 1` actions and not after
+`A`, and the others, which leave the memory as it is, are at rest by then,
+the run of all of them in turn takes exactly `A + 1` rounds. -/
+theorem rounds_readers {X : XNet Arith} {T₀ : XThread Arith} {Ts : List (XThread Arith)}
+    {A : Nat}
+    (h : ∀ T, T ∈ Ts → ∀ a,
+      (XMach.act xsys (XMach.solo xsys X T₀ (a + 1)).1 (XMach.reader xsys X T₀ T a)).1 =
+          (XMach.solo xsys X T₀ (a + 1)).1 ∧
+        (XMach.act xsys (XMach.solo xsys X T₀ (a + 1)).1 (XMach.reader xsys X T₀ T a)).2.2 = 0)
+    (h0 : (XMach.solo xsys X T₀ A).2 ≠ ⟨[], .idle⟩)
+    (h1 : (XMach.solo xsys X T₀ (A + 1)).2 = ⟨[], .idle⟩)
+    (hr : ∀ T, T ∈ Ts → XMach.reader xsys X T₀ T (A + 1) = ⟨[], .idle⟩) :
+    Rounds (Ts.length + 1) ⟨X, T₀ :: Ts⟩ (A + 1) := by
+  have tr : ∀ a, ((⟨X, T₀ :: Ts⟩ : XMach Arith).trace xsys (fun i => i % (Ts.length + 1))
+      ((Ts.length + 1) * a)).1 = ⟨(XMach.solo xsys X T₀ a).1, (XMach.solo xsys X T₀ a).2 ::
+        Ts.map fun T => XMach.reader xsys X T₀ T a⟩ := fun a =>
+    congrArg Prod.fst (XMach.trace_readers (xs := xsys) (A := a)
+      (fun T hT a' _ => h T hT a') a (Nat.le_refl a))
+  refine ⟨?_, fun R' hR' hrest => ?_⟩
+  · rw [tr]
+    exact all_rest_resting fun T hT => by
+      rcases List.mem_cons.1 hT with e | hT
+      · rw [e]
+        exact h1
+      · obtain ⟨T', hT', rfl⟩ := List.mem_map.1 hT
+        exact hr T' hT'
+  · obtain ⟨d, rfl⟩ : ∃ d, A = R' + d := ⟨A - R', by omega⟩
+    have h2 := XMach.resting_trace (xs := xsys) (fun i => i % (Ts.length + 1)) hrest
+      ((Ts.length + 1) * d)
+    rw [← Nat.mul_add, tr] at h2
+    exact h0 (first_of_resting h2)
+
+/-- Outside the race the thread numbered `t + 1` only reads and is at rest
+after `turnRest m n t` actions. -/
+theorem turn_reader_rest (m n t : Nat) (ht : t + 2 ≤ m)
+    (hw : turnAt m n t ≤ 17 * m + 6 ∨ 17 * m + 17 ≤ turnAt m n t)
+    (hk : 20 * t ≤ 3 * m + 3 * n + 1) :
+    RdAt m n ⟨(sum (m + 1) n).agents.drop (t + 1) ++ (sum (m + 1) n).agents.take (t + 1),
+      .idle⟩ (turnRest m n t) ⟨[], .idle⟩ := by
+  cases n with
+  | zero =>
+    obtain ⟨b, eb, r, -⟩ := turn_reader_zero m t ht (by omega)
+    rw [turn_list_zero m t (by omega), eb]
+    exact r
+  | succ n' =>
+    obtain ⟨b, eb, r, -⟩ := turn_reader_quiet m n' t ht hw (by
+      unfold turnAt
+      omega)
+    rw [turn_list_succ m n' t (by omega), eb]
+    exact r
+
+/-- **Threads in turn outside the race take the rounds of one thread.**  On
+the net for `(m + 1) + n` take `k + 1` threads that act in turn, with
+`k + 1 ≤ m` and `20 * k ≤ 3 * m + 3 * n + 21`.  If none of the threads after
+the first comes to the zero of the first argument at one of the ten moments
+of the race, all are at rest after exactly `soloWork (m + 1) n` rounds, the
+number of actions one thread alone needs: the others save no time. -/
+theorem threads_rounds (m n k : Nat) (hm : k + 1 ≤ m) (hk : 20 * k ≤ 3 * m + 3 * n + 21)
+    (hw : ∀ t, t < k → turnAt m n t ≤ 17 * m + 6 ∨ 17 * m + 17 ≤ turnAt m n t) :
+    Rounds (k + 1) (XMach.init (sum (m + 1) n) (k + 1)) (soloWork (m + 1) n) := by
+  rw [XMach.init_succ]
+  obtain ⟨hr, -, hb⟩ := solo_work (m + 1) n
+  rw [XMach.init_one] at hr hb
+  obtain ⟨A, hA⟩ : ∃ A, soloWork (m + 1) n = A + 1 := ⟨soloWork (m + 1) n - 1, by
+    rw [soloWork_succ]
+    omega⟩
+  have s0 : (XMach.solo xsys (sum (m + 1) n) ⟨(sum (m + 1) n).agents, .idle⟩ A).2 ≠
+      ⟨[], .idle⟩ := fun e => by
+    have h := hb A (by omega)
+    rw [XMach.trace_one] at h
+    exact h (all_rest_resting fun T hT => by
+      rcases List.mem_cons.1 hT with e' | hT
+      · rw [e']
+        exact e
+      · cases hT)
+  have s1 : (XMach.solo xsys (sum (m + 1) n) ⟨(sum (m + 1) n).agents, .idle⟩ (A + 1)).2 =
+      ⟨[], .idle⟩ := by
+    rw [hA, XMach.trace_one] at hr
+    exact XMach.resting_single hr
+  have rd : ∀ T, T ∈ ((List.range k).map fun t => (⟨(sum (m + 1) n).agents.drop (t + 1) ++
+      (sum (m + 1) n).agents.take (t + 1), .idle⟩ : XThread Arith)) →
+      RdAt m n T (A + 1) ⟨[], .idle⟩ := by
+    intro T hT
+    obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hT
+    have ht' : t < k := List.mem_range.1 ht
+    have r := turn_reader_rest m n t (by omega) (hw t ht') (by omega)
+    have tb := (turnRest_bounds m n t (by omega)).2
+    obtain ⟨d, hd⟩ : ∃ d, A + 1 = turnRest m n t + d := ⟨A + 1 - turnRest m n t, by omega⟩
+    rw [hd]
+    exact r.rest d
+  have res := rounds_readers (X := sum (m + 1) n) (T₀ := ⟨(sum (m + 1) n).agents, .idle⟩)
+    (Ts := (List.range k).map fun t => (⟨(sum (m + 1) n).agents.drop (t + 1) ++
+      (sum (m + 1) n).agents.take (t + 1), .idle⟩ : XThread Arith)) (A := A)
+    (fun T hT a => ((rd T hT).rest (a + 1)).2 a (by omega)) s0 s1 (fun T hT => (rd T hT).1)
+  rw [List.length_map, List.length_range] at res
+  rw [hA]
+  exact res
+
+/-- The same, the condition read off `racerOf`. -/
+theorem threads_rounds_none (m n k : Nat) (hm : k + 1 ≤ m) (hk : 20 * k ≤ 3 * m + 3 * n + 21)
+    (h : racerOf m n k = none) :
+    Rounds (k + 1) (XMach.init (sum (m + 1) n) (k + 1)) (soloWork (m + 1) n) :=
+  threads_rounds m n k hm hk fun t ht => by
+    have g := racerOf_none k h t ht
+    omega
+
+/-- **Outside the race more threads are pure overhead**: the run takes the
+rounds of one thread alone, and its work is that of one thread and the
+actions of the others. -/
+theorem threads_overhead (m n k : Nat) (hm : k + 1 ≤ m) (hk : 20 * k ≤ 3 * m + 3 * n + 21)
+    (h : racerOf m n k = none) :
+    Rounds (k + 1) (XMach.init (sum (m + 1) n) (k + 1)) (soloWork (m + 1) n) ∧
+      (XMach.init (sum (m + 1) n) (k + 1)).Total xsys (fun i => i % (k + 1))
+        (soloWork (m + 1) n + turnSum m n k) :=
+  ⟨threads_rounds_none m n k hm hk h, threads_total m n k hm hk fun t ht => by
+    have g := racerOf_none k h t ht
+    omega⟩
+
+/-- In every case the rounds are at least the work shared among the
+threads. -/
+theorem threads_rounds_ge (m n k R : Nat) (hm4 : 4 ≤ m) (hm : k + 1 ≤ m)
+    (hn : 20 * k ≤ 3 * m + 3 * n + 21)
+    (h : Rounds (k + 1) (XMach.init (sum (m + 1) n) (k + 1)) R) :
+    allWork m n k ≤ (k + 1) * R :=
+  total_le_rest (threads_exact m n k hm4 hm hn) h.1
+
+/-- **Two threads in the race end at most nine rounds sooner than one**,
+when the first thread does not keep the pair. -/
+theorem two_threads_rounds_ge (m n R : Nat) (hm : 4 ≤ m)
+    (h1 : 17 * m + 7 ≤ turnAt m n 0) (h2 : turnAt m n 0 ≤ 17 * m + 16)
+    (h8 : turnAt m n 0 ≠ 17 * m + 15)
+    (h : Rounds 2 (XMach.init (sum (m + 1) n) 2) R) : soloWork (m + 1) n ≤ R + 9 := by
+  have e : twoAt m n = turnAt m n 0 := rfl
+  have le := total_le_rest (two_threads_race_at m n hm h1 h2) h.1
+  rw [soloWork_succ]
+  rcases raceWork_cases m n (twoAt m n - (17 * m + 7)) with ⟨e8, -⟩ | ⟨-, lo, -⟩
+  · omega
+  · omega
+
+example : Rounds 3 (XMach.init (sum 8 28) 3) 273 :=
+  (threads_rounds_none 7 28 2 (by decide) (by decide) (by decide)).cast (by decide)
+
+example : Rounds 5 (XMach.init (sum 9 34) 5) 313 :=
+  (threads_rounds_none 8 34 4 (by decide) (by decide) (by decide)).cast (by decide)
+
+/-- **The rounds of threads that only read.**  If each thread of `Ts` only
+reads in the memory `Y` and comes to rest in `K` actions at most, and one
+of them in exactly `K`, all of them in turn are at rest after `K` rounds
+and not after fewer. -/
+theorem rounds_stays {Y : XNet Arith} {Ts : List (XThread Arith)} {K : Nat}
+    (hs : ∀ T, T ∈ Ts → ∃ k, k ≤ K ∧ Stays xsys Y T ⟨[], .idle⟩ k)
+    (hK : ∃ T, T ∈ Ts ∧ Stays xsys Y T ⟨[], .idle⟩ K) :
+    Rounds Ts.length ⟨Y, Ts⟩ K := by
+  have hR : ∀ T, T ∈ Ts → T.Reads xsys Y := fun T hT => by
+    obtain ⟨k, -, s⟩ := hs T hT
+    exact (s.after rfl).1
+  have tr : ∀ i (t : Nat) (T : XThread Arith), Ts[t]? = some T →
+      ((⟨Y, Ts⟩ : XMach Arith).trace xsys (fun i => i % Ts.length) i).1.ths[t]? =
+        some (T.after xsys Y (hits (fun i => i % Ts.length) t i)) := fun i =>
+    (XMach.trace_reads (xs := xsys) (M := ⟨Y, Ts⟩) (fun i => i % Ts.length) hR i).2.2
+  have ln : ∀ i, ((⟨Y, Ts⟩ : XMach Arith).trace xsys (fun i => i % Ts.length) i).1.ths.length =
+      Ts.length := fun i =>
+    (XMach.trace_reads (xs := xsys) (M := ⟨Y, Ts⟩) (fun i => i % Ts.length) hR i).2.1
+  refine ⟨?_, fun R' hR' hrest => ?_⟩
+  · refine List.all_eq_true.2 fun T' hT' => ?_
+    obtain ⟨t, e⟩ := List.mem_iff_getElem?.1 hT'
+    obtain ⟨hlt, -⟩ := List.getElem?_eq_some_iff.1 e
+    rw [ln] at hlt
+    obtain ⟨T, hT⟩ : ∃ T, Ts[t]? = some T := ⟨Ts[t], List.getElem?_eq_getElem hlt⟩
+    have e2 := tr (Ts.length * K) t T hT
+    rw [hits_mod Ts.length t hlt K] at e2
+    obtain ⟨k, hk, s⟩ := hs T (List.mem_of_getElem? hT)
+    have e3 : T' = ⟨[], .idle⟩ := by
+      have e4 := Option.some.inj (e.symm.trans e2)
+      rw [e4]
+      exact (s.after rfl).2.2 K hk
+    rw [e3]
+    rfl
+  · obtain ⟨T, hT, s⟩ := hK
+    obtain ⟨t, e⟩ := List.mem_iff_getElem?.1 hT
+    obtain ⟨hlt, -⟩ := List.getElem?_eq_some_iff.1 e
+    have e2 := tr (Ts.length * R') t T e
+    rw [hits_mod Ts.length t hlt R'] at e2
+    exact (s.after rfl).2.1 R' hR'
+      (XThread.eq_rest (List.all_eq_true.1 hrest _ (List.mem_of_getElem? e2)))
+
+/-- The rounds of a run, in two parts. -/
+theorem rounds_after (c : Nat) {M M' : XMach Arith} {E R : Nat}
+    (h : (M.trace xsys (fun i => i % c) (c * E)).1 = M') (hR : Rounds c M' R) (R1 : 1 ≤ R) :
+    Rounds c M (E + R) := by
+  subst h
+  refine ⟨?_, fun R' hR' hrest => ?_⟩
+  · rw [trace_mod_add]
+    exact hR.1
+  · obtain ⟨d, hd⟩ : ∃ d, E + (R - 1) = R' + d := ⟨E + (R - 1) - R', by omega⟩
+    have h2 := XMach.resting_trace (xs := xsys) (fun i => i % c) hrest (c * d)
+    rw [← Nat.mul_add, ← hd, trace_mod_add] at h2
+    exact hR.2 (R - 1) (by omega) h2
+
+/-- **The rounds of a run that ends with every thread reading**: `w`
+rounds to a memory in which each thread only reads, then the rounds of the
+thread that reads longest. -/
+theorem rounds_sweepsK {M : XMach Arith} {Y : XNet Arith} {Ts : List (XThread Arith)}
+    {w K : Nat} (s : SweepsK M ⟨Y, Ts⟩ w)
+    (hs : ∀ T, T ∈ Ts → ∃ k, k ≤ K ∧ Stays xsys Y T ⟨[], .idle⟩ k)
+    (hK : ∃ T, T ∈ Ts ∧ Stays xsys Y T ⟨[], .idle⟩ K) (K1 : 1 ≤ K) :
+    Rounds M.ths.length M (w + K) := by
+  have hl : Ts.length = M.ths.length := s.len
+  have r := rounds_stays hs hK
+  rw [hl] at r
+  exact rounds_after M.ths.length s.trace r K1
+
+/-- **The rounds of two threads from the race on**: five rounds, then those
+of the thread that still has more to do. -/
+theorem RaceEnd.rounds_two {m n : Nat} {M0 : XNet Arith} {F0 R0 : XThread Arith}
+    {kF kR K : Nat} (h : RaceEnd m n M0 F0 R0 kF kR) (hF : kF ≤ K) (hR : kR ≤ K)
+    (hK : kF = K ∨ kR = K) : Rounds 2 ⟨M0, [F0, R0]⟩ (5 + K) := by
+  obtain ⟨Y0, Y1, Y2, Y3, Y4, F5, R5, -, -, sw, sF, sR, h1F, -⟩ := h
+  have s : SweepsK ⟨M0, [F0, R0]⟩ ⟨Y4, [F5, R5]⟩ 5 := sw [] [] .nil
+  exact rounds_sweepsK s
+    (fun T hT => by
+      rcases List.mem_cons.1 hT with e | hT
+      · rw [e]
+        exact ⟨kF, hF, sF⟩
+      · rcases List.mem_cons.1 hT with e | hT
+        · rw [e]
+          exact ⟨kR, hR, sR⟩
+        · cases hT)
+    (by
+      rcases hK with e | e
+      · exact ⟨F5, List.mem_cons_self, by
+          rw [← e]
+          exact sF⟩
+      · exact ⟨R5, List.mem_cons_of_mem _ List.mem_cons_self, by
+          rw [← e]
+          exact sR⟩)
+    (by omega)
+
+/-- The rounds a race saves two threads, by the moment the second thread
+comes to the zero of the first argument. -/
+def raceSave : Nat → Nat
+  | 0 => 9
+  | 1 => 8
+  | 2 => 7
+  | 3 => 6
+  | 4 => 4
+  | 5 => 4
+  | 6 => 3
+  | 7 => 2
+  | _ => 0
+
+/-- From the entry to the race to the rest of both threads. -/
+theorem rounds_close {m n aE c R : Nat} {X : XNet Arith} {T Rr : XThread Arith}
+    (htr : (XMach.init (sum (m + 1) n) 2).trace xsys (fun i => i % 2) (2 * aE) =
+      (⟨(XMach.solo xsys (sum (m + 1) n) ⟨(sum (m + 1) n).agents, .idle⟩ aE).1,
+        [(XMach.solo xsys (sum (m + 1) n) ⟨(sum (m + 1) n).agents, .idle⟩ aE).2, Rr]⟩, c))
+    (hs : XMach.solo xsys (sum (m + 1) n) ⟨(sum (m + 1) n).agents, .idle⟩ aE = (X, T))
+    (hE : Rounds 2 (⟨X, [T, Rr]⟩ : XMach Arith) R) (R1 : 1 ≤ R) :
+    Rounds 2 (XMach.init (sum (m + 1) n) 2) (aE + R) := by
+  rw [hs] at htr
+  exact rounds_after 2 (congrArg Prod.fst htr) hE R1
+
+/-- **Two threads in the race, the rounds to the action.**  On the net for
+`(m + 1) + n`, with `m` from four on: when the second thread comes to the
+zero of the first argument after `17 * m + 7 + d` actions, `d` up to nine,
+both threads are at rest after `raceSave d` rounds fewer than the actions
+one thread alone needs, and not sooner. -/
+theorem two_threads_race_rounds (m n : Nat) (hm : 4 ≤ m) (h1 : 17 * m + 7 ≤ turnAt m n 0)
+    (h2 : turnAt m n 0 ≤ 17 * m + 16) :
+    Rounds 2 (XMach.init (sum (m + 1) n) 2)
+      (soloWork (m + 1) n - raceSave (turnAt m n 0 - (17 * m + 7))) := by
+  have h1' : 17 * m + 7 ≤ twoAt m n := h1
+  have h2' : twoAt m n ≤ 17 * m + 16 := h2
+  show Rounds 2 (XMach.init (sum (m + 1) n) 2)
+    (soloWork (m + 1) n - raceSave (twoAt m n - (17 * m + 7)))
+  rw [soloWork_succ]
+  unfold twoAt at h1' h2' ⊢
+  obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by omega⟩
+  obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
+  obtain ⟨K, hK⟩ : ∃ K, (3 * (m' + 1) + 11) / 16 = K + 1 :=
+    ⟨(3 * (m' + 1) + 11) / 16 - 1, by omega⟩
+  rw [hK] at h1' h2' ⊢
+  obtain ⟨c, htr⟩ := two_entry_exact (m' + 1) n' K hm (by omega) (by omega) (by omega)
+    (by omega)
+  obtain ⟨V, todo, rest, p5, q5, p6, q6, p7, q7, p8, q8, B, s11, s12, s13, s14, s15⟩ :=
+    race_write (m' + 1) (n' + 1) (by omega)
+  obtain ⟨s16, s17, s18, s19, s20⟩ := B.states
+  have lk12 := solo_look_two (m' + 1) (n' + 1) (17 * (m' + 1) + 12)
+  rw [s12] at lk12
+  have lk13 := solo_look_two (m' + 1) (n' + 1) (17 * (m' + 1) + 13)
+  rw [s13] at lk13
+  have lk14 := solo_look_two (m' + 1) (n' + 1) (17 * (m' + 1) + 14)
+  rw [s14] at lk14
+  have sk13 := (solo_seek_two (m' + 1) (n' + 1) (by omega) (17 * (m' + 1) + 13)).1 (by omega)
+  rw [s13] at sk13
+  have sk14 := (solo_seek_two (m' + 1) (n' + 1) (by omega) (17 * (m' + 1) + 14)).1 (by omega)
+  rw [s14] at sk14
+  have hS11 : ∀ j, 3 ≤ j → j ≤ n' + 1 + 2 →
+      ((([j], 0), ([j + 1], 1)) : Port × Port) ∈ V.wires := fun j a b => by
+    have h := assoc_mem (solo_look_snd (m' + 1) (n' + 1) (j := j) a b (17 * (m' + 1) + 11)).1
+    rw [s11] at h
+    exact h
+  have hS12 : ∀ j, 3 ≤ j → j ≤ n' + 1 + 2 →
+      ((([j], 0), ([j + 1], 1)) : Port × Port) ∈ (V.putLink p5 q5).wires := fun j a b => by
+    have h := assoc_mem (solo_look_snd (m' + 1) (n' + 1) (j := j) a b (17 * (m' + 1) + 12)).1
+    rw [s12] at h
+    exact h
+  have hS13 : ∀ j, 3 ≤ j → j ≤ n' + 1 + 2 →
+      ((([j], 0), ([j + 1], 1)) : Port × Port) ∈ ((V.putLink p5 q5).putLink p6 q6).wires :=
+    fun j a b => by
+      have h := assoc_mem (solo_look_snd (m' + 1) (n' + 1) (j := j) a b (17 * (m' + 1) + 13)).1
+      rw [s13] at h
+      exact h
+  have ht : Tops (n' + 1) [([n' + 1 + 3 + (m' + 1) + 1], Arith.succ)] := fun e he => by
+    rw [List.mem_singleton.1 he]
+    exact ⟨n' + 1 + 3 + (m' + 1) + 1, by omega, rfl⟩
+  obtain ⟨d, hd⟩ : ∃ d, 3 * (m' + 1) + 3 * n' + 5 + K = 17 * (m' + 1) + 7 + d :=
+    ⟨3 * (m' + 1) + 3 * n' + 5 + K - (17 * (m' + 1) + 7), by omega⟩
+  have e0 : 3 * (m' + 1) + 3 * (n' + 1) + 1 + (K + 1) - (17 * (m' + 1) + 7) = d := by omega
+  rw [e0]
+  have hd' : d = 0 ∨ d = 1 ∨ d = 2 ∨ d = 3 ∨ d = 4 ∨ d = 5 ∨ d = 6 ∨ d = 7 ∨ d = 8 ∨
+      d = 9 := by omega
+  rcases hd' with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
+  · exact (rounds_close htr (solo_at s11 (by omega))
+      ((race_e_d0 B todo _ lk12 lk13 sk13 sk14 hS11).rounds_two
+        (K := 5 * (m' + 1) + 3 * (n' + 1) + 10) (by omega) (by omega) (by omega))
+      (by omega)).cast (by
+        show _ = 22 * (m' + 1 + 1) + 3 * (n' + 1) + 13 - 9
+        omega)
+  · exact (rounds_close htr (solo_at s12 (by omega))
+      ((race_e_d1 B todo _ lk13 lk14 sk14 hS12).rounds_two
+        (K := 5 * (m' + 1) + 3 * (n' + 1) + 10) (by omega) (by omega) (by omega))
+      (by omega)).cast (by
+        show _ = 22 * (m' + 1 + 1) + 3 * (n' + 1) + 13 - 8
+        omega)
+  · exact (rounds_close htr (solo_at s13 (by omega))
+      ((race_e_d2 B todo _ lk14 hS13).rounds_two
+        (K := 5 * (m' + 1) + 3 * (n' + 1) + 10) (by omega) (by omega) (by omega))
+      (by omega)).cast (by
+        show _ = 22 * (m' + 1 + 1) + 3 * (n' + 1) + 13 - 7
+        omega)
+  · exact (rounds_close htr (solo_at s14 (by omega))
+      ((race_e_d3 B todo _).rounds_two
+        (K := 5 * (m' + 1) + 3 * (n' + 1) + 10) (by omega) (by omega) (by omega))
+      (by omega)).cast (by
+        show _ = 22 * (m' + 1 + 1) + 3 * (n' + 1) + 13 - 6
+        omega)
+  · exact (rounds_close htr (solo_at s15 (by omega))
+      ((race_e_d4 B todo _).rounds_two
+        (K := 5 * (m' + 1) + 3 * (n' + 1) + 11) (by omega) (by omega) (by omega))
+      (by omega)).cast (by
+        show _ = 22 * (m' + 1 + 1) + 3 * (n' + 1) + 13 - 4
+        omega)
+  · exact (rounds_close htr (solo_at s16 (by omega))
+      ((race_e_d5 B _).rounds_two
+        (K := 5 * (m' + 1) + 3 * (n' + 1) + 10) (by omega) (by omega) (by omega))
+      (by omega)).cast (by
+        show _ = 22 * (m' + 1 + 1) + 3 * (n' + 1) + 13 - 4
+        omega)
+  · exact (rounds_close htr (solo_at s17 (by omega))
+      ((race_e_d6 B _).rounds_two
+        (K := 5 * (m' + 1) + 3 * (n' + 1) + 10) (by omega) (by omega) (by omega))
+      (by omega)).cast (by
+        show _ = 22 * (m' + 1 + 1) + 3 * (n' + 1) + 13 - 3
+        omega)
+  · exact (rounds_close htr (solo_at s18 (by omega))
+      ((race_e_d7 B _).rounds_two
+        (K := 5 * (m' + 1) + 3 * (n' + 1) + 10) (by omega) (by omega) (by omega))
+      (by omega)).cast (by
+        show _ = 22 * (m' + 1 + 1) + 3 * (n' + 1) + 13 - 2
+        omega)
+  · exact (rounds_close htr (solo_at s19 (by omega))
+      (((race_e_d8 B ht (Nat.le_refl 1)).cast
+          (kF' := 5 * (m' + 1) + 3 * (n' + 1) + 11) (kR' := 1) (by omega) rfl).rounds_two
+        (K := 5 * (m' + 1) + 3 * (n' + 1) + 11) (by omega) (by omega) (by omega))
+      (by omega)).cast (by
+        show _ = 22 * (m' + 1 + 1) + 3 * (n' + 1) + 13 - 0
+        omega)
+  · exact (rounds_close htr (solo_at s20 (by omega))
+      ((race_e_d9 B _).rounds_two
+        (K := 5 * (m' + 1) + 3 * (n' + 1) + 10) (by omega) (by omega) (by omega))
+      (by omega)).cast (by
+        show _ = 22 * (m' + 1 + 1) + 3 * (n' + 1) + 13 - 0
+        omega)
+
+/-- The rounds of two threads in turn on the net for `(m + 1) + n`: those
+of one thread, less what the race saves when there is one. -/
+def twoRounds (m n : Nat) : Nat :=
+  if 17 * m + 7 ≤ turnAt m n 0 ∧ turnAt m n 0 ≤ 17 * m + 16 then
+    soloWork (m + 1) n - raceSave (turnAt m n 0 - (17 * m + 7))
+  else soloWork (m + 1) n
+
+/-- **Two threads in turn, every size, the rounds to the action.**  On the
+net for `(m + 1) + n`, with `m` from four on, two threads acting in turn
+are at rest after exactly `twoRounds m n` rounds. -/
+theorem two_threads_rounds (m n : Nat) (hm : 4 ≤ m) :
+    Rounds 2 (XMach.init (sum (m + 1) n) 2) (twoRounds m n) := by
+  unfold twoRounds
+  by_cases hW : 17 * m + 7 ≤ turnAt m n 0 ∧ turnAt m n 0 ≤ 17 * m + 16
+  · rw [ite_pos' hW]
+    exact two_threads_race_rounds m n hm hW.1 hW.2
+  · rw [ite_neg' hW]
+    exact threads_rounds m n 1 (by omega) (by omega) fun t ht => by
+      have e : t = 0 := by omega
+      subst e
+      omega
+
+theorem raceSave_le (d : Nat) : raceSave d ≤ 9 := by
+  unfold raceSave
+  split <;> omega
+
+/-- **A second thread saves nine rounds at most, and costs none.**  On the
+net for `(m + 1) + n`, with `m` from four on, two threads in turn are at
+rest after `R` rounds with `R` at most the actions of one thread alone and
+at least nine fewer. -/
+theorem two_threads_rounds_bounds (m n : Nat) (hm : 4 ≤ m) :
+    ∃ R, Rounds 2 (XMach.init (sum (m + 1) n) 2) R ∧ R ≤ soloWork (m + 1) n ∧
+      soloWork (m + 1) n ≤ R + 9 := by
+  refine ⟨twoRounds m n, two_threads_rounds m n hm, ?_, ?_⟩
+  · unfold twoRounds
+    by_cases hW : 17 * m + 7 ≤ turnAt m n 0 ∧ turnAt m n 0 ≤ 17 * m + 16
+    · rw [ite_pos' hW]
+      omega
+    · rw [ite_neg' hW]
+      omega
+  · unfold twoRounds
+    by_cases hW : 17 * m + 7 ≤ turnAt m n 0 ∧ turnAt m n 0 ≤ 17 * m + 16
+    · rw [ite_pos' hW]
+      have s := raceSave_le (turnAt m n 0 - (17 * m + 7))
+      omega
+    · rw [ite_neg' hW]
+      omega
+
+example : Rounds 2 (XMach.init (sum 6 25) 2) 211 :=
+  (two_threads_rounds 5 25 (by decide)).cast (by decide)
+
+example : Rounds 2 (XMach.init (sum 6 26) 2) 217 :=
+  (two_threads_rounds 5 26 (by decide)).cast (by decide)
+
+example : Rounds 2 (XMach.init (sum 6 28) 2) 229 :=
+  (two_threads_rounds 5 28 (by decide)).cast (by decide)
+
+example : Rounds 2 (XMach.init (sum 10 46) 2) 371 :=
+  (two_threads_rounds 9 46 (by decide)).cast (by decide)
+
+example : soloWork 6 25 = 220 := by decide
+
+/-- **One more thread at the end that only reads and is at rest in time
+leaves the rounds of the run as they are.** -/
+theorem rounds_beside_end {X : XNet Arith} {Ts : List (XThread Arith)}
+    (s : Nat → XThread Arith)
+    (hs : ∀ w, XMach.act xsys
+        ((⟨X, Ts⟩ : XMach Arith).trace xsys (fun i => i % Ts.length) (Ts.length * (w + 1))).1.mem
+        (s w) =
+      (((⟨X, Ts⟩ : XMach Arith).trace xsys (fun i => i % Ts.length) (Ts.length * (w + 1))).1.mem,
+        s (w + 1), 0))
+    {R b : Nat} (rd : Rounds Ts.length ⟨X, Ts⟩ R)
+    (h0 : ∀ j, b ≤ j → s j = ⟨[], .idle⟩) (hb : b ≤ R) :
+    Rounds (Ts.length + 1) ⟨X, Ts ++ [s 0]⟩ R := by
+  have q := beside_end s hs
+  refine ⟨?_, fun R' hR' hrest => ?_⟩
+  · rw [(q R).1]
+    refine List.all_eq_true.2 fun T hT => ?_
+    rcases List.mem_append.1 hT with hT | hT
+    · exact List.all_eq_true.1 rd.1 T hT
+    · rw [List.mem_singleton.1 hT, h0 R hb]
+      rfl
+  · rw [(q R').1] at hrest
+    exact rd.2 R' hR' (List.all_eq_true.2 fun T hT =>
+      List.all_eq_true.1 hrest T (List.mem_append_left _ hT))
+
+/-- The same for the threads of a program. -/
+theorem init_rounds_end (X : XNet Arith) (k : Nat) (s : Nat → XThread Arith)
+    (e0 : s 0 = ⟨X.agents.drop (k + 1) ++ X.agents.take (k + 1), .idle⟩)
+    (hs : ∀ w, XMach.act xsys
+        ((XMach.init X (k + 1)).trace xsys (fun i => i % (k + 1)) ((k + 1) * (w + 1))).1.mem
+        (s w) =
+      (((XMach.init X (k + 1)).trace xsys (fun i => i % (k + 1)) ((k + 1) * (w + 1))).1.mem,
+        s (w + 1), 0))
+    {R b : Nat} (rd : Rounds (k + 1) (XMach.init X (k + 1)) R)
+    (h0 : ∀ j, b ≤ j → s j = ⟨[], .idle⟩) (hb : b ≤ R) :
+    Rounds (k + 1 + 1) (XMach.init X (k + 1 + 1)) R := by
+  have hl : (XMach.init X (k + 1)).ths.length = k + 1 := init_len X (k + 1)
+  have hmem : (XMach.init X (k + 1)).mem = X := rfl
+  rw [init_snoc, ← e0]
+  generalize XMach.init X (k + 1) = M at hs rd hl hmem ⊢
+  obtain ⟨Y, Ts⟩ := M
+  have hY : Y = X := hmem
+  subst hY
+  have hl' : Ts.length = k + 1 := hl
+  rw [← hl'] at hs rd ⊢
+  exact rounds_beside_end s hs rd h0 hb
+
+/-- **A thread that passes the zero of the first argument before the race
+leaves the rounds as they are**, when the run goes on long enough for it
+to come to rest. -/
+theorem threads_early_last_rounds (m n' k R : Nat) (hm : k + 2 ≤ m)
+    (hA : turnAt m (n' + 1) k ≤ 17 * m + 6) (hG : 17 * k ≤ turnAt m (n' + 1) k + 1)
+    (hR : turnAt m (n' + 1) k + 3 + 3 + (k + 1) ≤ R)
+    (rd : Rounds (k + 1) (XMach.init (sum (m + 1) (n' + 1)) (k + 1)) R) :
+    Rounds (k + 1 + 1) (XMach.init (sum (m + 1) (n' + 1)) (k + 1 + 1)) R := by
+  obtain ⟨s, e0, hs, -, h0⟩ := early_reader_end m n' k hm hA hG
+  exact init_rounds_end (sum (m + 1) (n' + 1)) k s e0 hs rd h0 hR
+
+/-- So do any number of such threads. -/
+theorem threads_early_many_rounds (m n' j R : Nat) (hA : turnAt m (n' + 1) j ≤ 17 * m + 6)
+    (hR : turnAt m (n' + 1) j + j + 7 ≤ R)
+    (rd : Rounds (j + 1) (XMach.init (sum (m + 1) (n' + 1)) (j + 1)) R) :
+    ∀ k, j + k + 1 ≤ m → 20 * (j + k) ≤ 3 * m + 3 * (n' + 1) + 23 →
+      Rounds (j + k + 1) (XMach.init (sum (m + 1) (n' + 1)) (j + k + 1)) R
+  | 0, _, _ => rd
+  | k + 1, hm, hk => by
+    have ih := threads_early_many_rounds m n' j R hA hR rd k (by omega) (by omega)
+    exact threads_early_last_rounds m n' (j + k) R (by omega)
+      (by
+        unfold turnAt at hA ⊢
+        omega)
+      (by
+        unfold turnAt
+        omega)
+      (by
+        unfold turnAt at hR ⊢
+        omega) ih
+
+/-- The same, if there are any. -/
