+theorem least_of_exists {P : Nat → Prop} : ∀ N, (∃ a, a ≤ N ∧ P a) →
+    ∃ a, P a ∧ ∀ b, b < a → ¬ P b
+  | 0, ⟨a, ha, hp⟩ => by
+    have e : a = 0 := by omega
+    subst e
