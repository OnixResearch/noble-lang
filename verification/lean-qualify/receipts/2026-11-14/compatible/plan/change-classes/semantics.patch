+        N'.scan (X.wires.length + D * n) (X.agents.take k) +
+          N'.scan (X.wires.length + D * n) (X.agents.drop k) := by
+      rw [← Net.scan_append, List.take_append_drop]
+    rw [hp, Net.scan_append] at h1
