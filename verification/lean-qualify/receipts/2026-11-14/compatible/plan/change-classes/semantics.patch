+  assoc_eq_of_unique ((F.up (snd_sum (m + 1) n) (j := 3) (by omega) (by omega) _).2 rfl)
+    (fun q' hq => (F.up (snd_sum (m + 1) n) (j := 3) (by omega) (by omega) q').1 hq)
+
