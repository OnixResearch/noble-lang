+    (XMach.init X nt).work xs σ i ≤
+      t + (7 * (X.agents.length + C * n) + (X.wires.length + D * n)) +
+        Rs.length *
+          (7 * X.agents.length + (X.wires.length + D * n) + (X.wires.length + D * n) + 6) +
+        (n - c) * (C + D + 7 * (X.agents.length + C * n) + (X.wires.length + D * n) + 1) := by
