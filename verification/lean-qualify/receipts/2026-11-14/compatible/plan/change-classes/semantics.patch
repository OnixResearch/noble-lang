+  have e2 : (fun i => blockSched ((t, k) :: bs) (k + i)) = blockSched bs :=
+    funext fun i => blockSched_add t k bs i
+  rw [XMach.work_add xs (blockSched ((t, k) :: bs)) M k j, e0, e1, e2]
