+theorem filter_ne_idem (l : List (Id × Arith)) (a : Id) :
+    (l.filter fun e => decide (e.1 ≠ a)).filter (fun e => decide (e.1 ≠ a)) =
+      l.filter fun e => decide (e.1 ≠ a) := by
+  rw [List.filter_filter]
+  congr 1
+  funext e
+  exact Bool.and_self _
