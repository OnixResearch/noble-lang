+  have hKj : ((3 * (m' + 1 - j) + 11) / 16 - 1) = ((3 * (m' + 1 - (j + 1)) + 11) / 16 - 1) ∨ ((3 * (m' + 1 - j) + 11) / 16 - 1) = ((3 * (m' + 1 - (j + 1)) + 11) / 16 - 1) + 1 := by omega
