+in turn comes to exactly `W` work. -/
+structure XMach.Ends (xs : XSys S) (M : XMach S) (W : Nat) : Prop where
+  total : M.Total xs (fun i => i % 2) W
+  busy : ∀ (t : Nat) (T : XThread S), M.ths[t]? = some T → T ≠ ⟨[], .idle⟩
