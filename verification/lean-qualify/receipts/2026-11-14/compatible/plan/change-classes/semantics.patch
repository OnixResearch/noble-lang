+def tagSt (c : Nat) : TState Arith → TState Arith
+  | .idle => .idle
+  | .look a α => .look (a ++ [c]) α
+  | .seek a α p q => .seek (a ++ [c]) α (tagPort c p) (tagPort c q)
+  | .ready a b α β => .ready (a ++ [c]) (b ++ [c]) α β
+  | .half a b α β => .half (a ++ [c]) (b ++ [c]) α β
+  | .write as ls => .write (as.map (tagA c)) (ls.map (tagL c))
