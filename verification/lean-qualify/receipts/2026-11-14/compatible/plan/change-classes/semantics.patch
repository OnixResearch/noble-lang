+/-- The work of the run in that case: threads in turn, to the end. -/
+theorem race_k_d8 {m' n' : Nat} {X : XNet Arith} {rest : List (Id × Arith)}
+    (B : RaceBase (m' + 1) (n' + 1) X rest) {tops : List (Id × Arith)}
