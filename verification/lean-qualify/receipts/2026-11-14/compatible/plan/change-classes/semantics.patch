+    (sP : Stays xs X P ⟨[], .idle⟩ kP) (sQ : Stays xs X Q ⟨[], .idle⟩ kQ)
+    (hP : 1 ≤ kP) (hQ : 1 ≤ kQ) (hW : W = 2 * w + (kP + kQ)) : M.Ends xs W := by
+  subst hW
