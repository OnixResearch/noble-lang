+  have e : (M.trace xs (fun i => i % 2) (2 * a)).1.work xs (fun j => (2 * a + j) % 2) k =
+      (M.trace xs (fun i => i % 2) (2 * a)).1.work xs (fun i => i % 2) k :=
+    XMach.tally_congr XThread.busy xs _ k fun j _ => by
+      show (2 * a + j) % 2 = j % 2
+      omega
