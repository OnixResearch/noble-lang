+    (f3 : XMach.act xsys (Y2'.putLink ([0, n + 4], 1) ([0, n + 4], 2)) F3 = (Y3', F4, c3))
+    (f4 : XMach.act xsys (Y3'.putLink ([0, n + 4], 2) ([0, n + 4], 1)) F4 = (Y4', F5, c4))
+    (k1 : assoc (([2], 0) : Port) Y1'.wires = some ([n + 4], 1))
+    (k2 : nextSeg Y2'.wires ([n + 4], 1) ([2], 0) = some ([0, n + 4], 0))
