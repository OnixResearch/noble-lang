  "admission": null,
  "capability_classifications": [
    {
      "core_handling": "forbidden",
      "executor_role": "composition-root",
      "family": "filesystem",
      "rationale": "Only the CLI reads bounded contract, proof, rule-library and toolchain inputs, creates fresh artifacts, and removes its private temporary workspace."
    },
    {
      "core_handling": "forbidden",
      "executor_role": "composition-root",
      "family": "process",
      "rationale": "Only the CLI resolves the local Lean runtime closure, launches bounded proof workers through Linux bubblewrap and a user-systemd scope, captures their status, and terminates failed or expired workers. Missing isolation fails closed."
    },
    {
      "core_handling": "forbidden",
      "executor_role": "composition-root",
      "family": "environment",
      "rationale": "Only the CLI captures process arguments, consumer-selected absolute tool and rule-library paths, the user runtime directory, and the temporary-directory root. Child environments are cleared and explicitly populated."
    },
    {
      "core_handling": "forbidden",
      "executor_role": "composition-root",
      "family": "time",
      "rationale": "Only the CLI observes clocks for bounded proof-worker deadlines and private temporary-directory naming; clock values never enter contract meaning."
    },
    {
      "core_handling": "forbidden",
      "executor_role": "composition-root",
      "family": "concurrency",
      "rationale": "Only the CLI starts and joins bounded stdout/stderr readers and sleeps while supervising proof workers. Domain-core evaluation remains synchronous and effect-free."
    },
    {
      "core_handling": "forbidden",
      "executor_role": "composition-root",
      "family": "observability",
      "rationale": "Only the CLI emits verification reports, help, internal smoke outcomes and diagnostics. Explanation and statement generation do not launch proof tools."
    },
    {
      "core_handling": "forbidden",
      "executor_role": "composition-root",
      "family": "unsafe-code",
      "rationale": "All Noble-owned Rust forbids unsafe code. No unsafe executor exists."
    }
  ],
