      "family": "process",
      "protected": null,
      "rationale": "The shell queries the selected local Nix runtime closure, executes proof workers through the required user-systemd/bubblewrap boundary, supervises bounded output and deadlines, observes exit status, and reads its PID for private temporary naming. These local proof-tool operations grant no protected domain capability; missing isolation never authorizes an unsandboxed fallback."
    },
    {
      "authority": "unprotected",
      "executor_methods": [
        "noble::read_arguments",
        "noble::sandbox::configured_path",
        "noble::workflow::artifacts::Temporary::create"
      ],
      "executor_scope": "crates/noble-cli/src",
      "family": "environment",
      "protected": null,
      "rationale": "Arguments, explicit consumer tool/library selections, the user runtime directory and temporary root are boundary configuration, not domain authority. The no_std core receives explicit source bytes and limits instead of ambient environment access."
    },
    {
      "authority": "unprotected",
      "executor_methods": [
        "noble::sandbox::now",
        "noble::workflow::artifacts::Temporary::create"
      ],
      "executor_scope": "crates/noble-cli/src",
      "family": "time",
      "protected": null,
      "rationale": "Clock observations enforce the total proof-worker deadline and name fresh private temporary directories. They neither determine contract semantics nor authorize protected operations."
    },
    {
      "authority": "unprotected",
      "executor_methods": [
        "noble::sandbox::process::capture",
        "noble::sandbox::process::monitor"
      ],
      "executor_scope": "crates/noble-cli/src",
      "family": "concurrency",
      "protected": null,
      "rationale": "The shell starts and joins two bounded subprocess-output readers and sleeps while polling worker status. These local supervision threads grant no protected domain capability."
    },
    {
      "authority": "unprotected",
      "executor_methods": [
        "noble::main",
        "noble::write_outcome",
        "noble::workflow::print_report"
