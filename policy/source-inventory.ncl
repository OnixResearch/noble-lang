    "calculator::Session::submit_line::numeric_stage",
    "calculator::Session::submit_line::pending_bool_deny",
    "calculator::Session::submit_line::power_bool_gate",
    "calculator::Session::submit_line::power_route_gate",
    "calculator::Session::submit_line::route",
