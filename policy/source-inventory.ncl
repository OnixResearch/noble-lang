  # Every observed macro/expansion origin, including unnamed compiler expansion.
  # Candidate additions are exact names observed in the sealed 54-unit IR.
  # An origin entry is accounting, not execution, proof, effect admission or
  # acceptance of a required compiler unknown.
  macro_origins | Array String = [
    "<builtin>",
    "alloc::format",
    "alloc::vec",
    "anyhow::__anyhow",
    "anyhow::__fallback_ensure",
    "anyhow::anyhow",
    "anyhow::bail",
