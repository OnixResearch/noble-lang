let Subject = {
  qualified_path | String,
  package | String,
  category | [| 'body, 'generated, 'structural |],
  disposition | String,
  refinement | String,
  note | String,
} in
let
  body = fun qualified package_name text => {
    qualified_path = qualified,
    package = package_name,
    category = 'body,
    disposition = "open",
    refinement = "open",
    note = text,
  } | Subject in
let
  generated = fun qualified package_name text => {
    qualified_path = qualified,
    package = package_name,
    category = 'generated,
    disposition = "generated",
    refinement = "not-applicable",
    note = text,
  } | Subject in
let
  structural = fun qualified package_name text => {
    qualified_path = qualified,
    package = package_name,
    category = 'structural,
    disposition = "structural",
    refinement = "not-applicable",
    note = text,
  } | Subject in
{
  schema_version | String = "noble-source-inventory-policy/v1",
  owner | String = "noble-maintainers",
  scope_note | String = "Historical complete 32-unit selected Declared-Modules-v1 compiler inventory: noble-kernel, noble-contracts and noble-wasm remain domain-core; noble-cli and noble-syndicate remain composition roots. Source-derived nominal declarations, versioned import and explicit bounded host operations, recursive kernel eligibility, Wasm admission/emission and frontend/worker integration introduce authored bodies with OPEN extraction and refinement obligations. The independent typed Wasmtime kernel peer is verification-only outside production. Pinned Aeneas erases core.fmt.Arguments to Unit; formatted-string construction, diagnostic text and naming semantics are an external assumption, not proved by generated Lean, and their authored source bodies remain OPEN. Finite compiled-Wasm DX acceptance provides bounded execution evidence only. Retained M7 strict Lean roots remain separately bound and do not prove nominal source-to-Wasm, host, engine or whole-program refinement. The partial 54-unit candidate file reviews add 253 exact production paths (183 body/open, 2 generated, 68 structural) to reach 6069 reviewed paths (2778 body/open, 2133 generated, 1158 structural); 2284 observed paths remain unreviewed and 105 historical paths are stale. No candidate source-coverage acceptance or proof is claimed.",
  # The historical 32-unit production set was classified exactly once; the
  # candidate 54-unit file slice below is partial and leaves other omissions.
  # A path shared by an authored body and generated items retains the body obligation.
  # Authored named constant initializers are bodies. Compiler-generated #[test]
  # registration constants sharing authored function paths do not erase the
  # function body's obligation. Generated wrapper closures retain their parent
  # body's obligation and remain subject to compiler effect evaluation.
  subjects | Array Subject = [
    structural "ngraph_phase_b::Args" "noble-ngraph-experiment" "Renewed 2026-10-15 for issue #14 (noble-ngraph-experiment): declaration-only compiler kind (struct); accounting only, with no body obligation.",
