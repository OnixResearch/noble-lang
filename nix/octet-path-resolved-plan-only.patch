+    // r[verify octet.architecture.features.equivalence]
+    #[test]
+    fn equal_descriptions_with_distinct_resolved_closures_are_unambiguous() {
+        let original = json!({"version": 1, "units": [
+            {"pkg_id": "app", "features": [], "dependencies": [
+                {"index": 1, "extern_crate_name": "normal"},
+                {"index": 2, "extern_crate_name": "build"}
+            ]},
+            {"pkg_id": "serde_json", "features": ["default", "std"], "dependencies": [
+                {"index": 3, "extern_crate_name": "memchr"}
+            ]},
+            {"pkg_id": "serde_json", "features": ["default", "std"], "dependencies": [
+                {"index": 4, "extern_crate_name": "memchr"}
+            ]},
+            {"pkg_id": "memchr", "features": ["alloc", "default", "std"], "dependencies": []},
+            {"pkg_id": "memchr", "features": ["alloc", "std"], "dependencies": []}
+        ], "roots": [0]});
+        let expected = identity(&original).expect("distinct dependency feature selections");
+        let mut reordered = original.clone();
+        reordered["units"].as_array_mut().expect("units").swap(1, 2);
+        reordered["units"][0]["dependencies"][0]["index"] = json!(2);
+        reordered["units"][0]["dependencies"][1]["index"] = json!(1);
+        assert_eq!(identity(&reordered).expect("reindexed plan"), expected);
+        let mut crossed = original.clone();
+        crossed["units"][0]["dependencies"][0]["index"] = json!(2);
+        crossed["units"][0]["dependencies"][1]["index"] = json!(1);
+        assert_ne!(identity(&crossed).expect("cross-wired dependency variants"), expected);
+
+        let mut nested = original.clone();
+        for (index, grandchild) in [(3, 5), (4, 6)] {
+            nested["units"][index] = json!({"pkg_id": "bridge", "features": [],
+                "dependencies": [{"index": grandchild, "extern_crate_name": "memchr"}]});
+        }
+        nested["units"].as_array_mut().expect("units").extend([
+            original["units"][3].clone(),
+            original["units"][4].clone(),
+        ]);
+        let nested_identity = identity(&nested).expect("different transitive memchr variants");
+        let mut crossed_grandchildren = nested.clone();
+        crossed_grandchildren["units"][3]["dependencies"][0]["index"] = json!(6);
+        crossed_grandchildren["units"][4]["dependencies"][0]["index"] = json!(5);
+        assert_ne!(identity(&crossed_grandchildren).expect("cross-wired grandchildren"), nested_identity);
+
+        let mut changed = original.clone();
+        changed["units"][2]["dependencies"][0]["index"] = json!(3);
+        assert!(identity(&changed).expect_err("indistinguishable resolved units").contains("duplicate"));
+    }
