+let registered_modules () =
+  match Sys.getenv_opt "OWI_REGISTER_MODULES" with
+  | None | Some "" -> Ok []
+  | Some modules ->
+    List.fold_left
+      (fun parsed module_spec ->
+        let* parsed = parsed in
+        match String.split_on_char '=' module_spec with
+        | [ name; path ] when name <> "" && path <> "" ->
+          let+ path = Fpath.of_string path in
+          (name, path) :: parsed
+        | _ -> Fmt.error_msg "invalid OWI_REGISTER_MODULES entry: %s" module_spec )
+      (Ok []) (String.split_on_char ',' modules)
+    |> Result.map List.rev
+
+let rec link_registered_modules link_state = function
+  | [] -> Ok link_state
+  | (name, path) :: modules ->
+    let* _module, link_state =
+      Compile.File.until_link ~unsafe:false ~name:(Some name) link_state path
+    in
+    link_registered_modules link_state modules
+
