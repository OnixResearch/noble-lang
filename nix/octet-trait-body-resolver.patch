+
+pub struct ConcretePort;
+pub struct AlternatePort;
+
+impl Port for ConcretePort {
+    fn invoke(&self) {
+        let _ = std::fs::read("octet-concrete-impl-never-executed");
+    }
+}
+
+impl Port for AlternatePort {
+    fn invoke(&self) {}
+}
+
+pub fn call_concrete_port() {
+    ConcretePort.invoke();
+    Port::invoke(&ConcretePort);
+    AlternatePort.invoke();
+}
+
+pub trait DefaultPort {
+    fn default_invoke(&self) {}
+}
+
+impl DefaultPort for ConcretePort {}
+
+pub fn call_default_port() {
+    ConcretePort.default_invoke();
+}
+
+pub struct ConcreteEndpoint;
+
+impl std::net::ToSocketAddrs for ConcreteEndpoint {
+    type Iter = std::vec::IntoIter<std::net::SocketAddr>;
+
+    fn to_socket_addrs(&self) -> std::io::Result<Self::Iter> {
+        Ok(Vec::new().into_iter())
+    }
+}
+
+pub fn call_network_interface() {
+    use std::net::ToSocketAddrs;
+    let _ = ConcreteEndpoint.to_socket_addrs();
+}
+
+pub struct ConcreteExit;
+
+impl std::process::Termination for ConcreteExit {
+    fn report(self) -> std::process::ExitCode {
+        std::process::ExitCode::SUCCESS
+    }
+}
+
+pub fn call_process_interface() {
+    let _ = std::process::Termination::report(ConcreteExit);
+}
+
+pub fn try_read() -> Result<usize, std::io::Error> {
+    let bytes = std::fs::read("octet-try-never-executed")?;
+    Ok(bytes.len())
 }
