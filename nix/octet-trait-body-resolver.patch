+fn concrete_trait_body<'tcx>(
+    cx: &LateContext<'tcx>,
+    def_id: DefId,
+    args: ty::GenericArgsRef<'tcx>,
+) -> Option<DefId> {
+    let parent = cx.tcx.opt_parent(def_id)?;
+    if cx.tcx.def_kind(def_id) != DefKind::AssocFn
+        || cx.tcx.def_kind(parent) != DefKind::Trait
+        || args.len() != cx.tcx.generics_of(def_id).count()
+        || args.still_further_specializable()
+    {
+        return None;
+    }
+    let typing_env = ty::TypingEnv::post_analysis(cx.tcx, cx.typeck_results().hir_owner.def_id);
+    let ty::InstanceKind::Item(body) = ty::Instance::try_resolve(cx.tcx, typing_env, def_id, args).ok().flatten()?.def
+    else {
+        return None;
+    };
+    let body_parent = cx.tcx.opt_parent(body)?;
+    (body != def_id
+        && matches!(cx.tcx.def_kind(body), DefKind::AssocFn | DefKind::Fn)
+        && matches!(cx.tcx.def_kind(body_parent), DefKind::Impl { of_trait: true }))
+        .then_some(body)
+}
