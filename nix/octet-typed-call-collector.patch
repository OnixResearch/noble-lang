+#[test]
+#[ignore = "run via cargo test --test ui compiler_architecture_typed_calls -- --ignored --nocapture"]
+fn compiler_architecture_typed_calls() {
+    let toolchain = rustup_toolchain();
+    let library = build_library(&toolchain);
+    let host = host_triple();
+    let driver = build_driver(&toolchain);
+    let relative = "fixtures/compiler-architecture-ir/negative/typed_calls_and_boundaries.rs";
+    let source = fs::read(Path::new(env!("CARGO_MANIFEST_DIR")).join(relative)).expect("read typed calls fixture");
+    let shard = run_compiler_architecture_fixture(&driver, &library, &host, "negative/typed_calls_and_boundaries.rs");
+    assert_eq!(shard.collection_status, CollectionStatus::Complete);
+    assert_eq!(shard.unit.source_path, relative);
+
+    let call_at = |expression: &str| {
+        let spans = shard
+            .spans
+            .iter()
+            .filter(|span| {
+                matches!(&span.origin, SourceOrigin::Workspace { source_path } if source_path == relative)
+                    && source.get(span.byte_start as usize..span.byte_end as usize) == Some(expression.as_bytes())
+            })
+            .collect::<Vec<_>>();
+        assert_eq!(spans.len(), 1, "expected one compiler span for {expression}");
+        let span_id = spans[0].span_id.as_str();
+        let calls = shard
+            .facts
+            .iter()
+            .filter(|fact| matches!(fact, CompilerArchitectureFact::Call { span_id: call_span, .. } if call_span == span_id))
+            .collect::<Vec<_>>();
+        assert_eq!(calls.len(), 1, "expected one compiler call for {expression}");
+        (span_id, calls[0])
+    };
+    let unknown_at = |span_id: &str, owner: &str, kind| {
+        shard.unknowns.iter().any(|unknown| {
+            unknown.span_id.as_deref() == Some(span_id)
+                && unknown.owner_item_id.as_deref() == Some(owner)
+                && unknown.kind == kind
+        })
+    };
+    let item_exists = |item_id: &str| {
+        shard.facts.iter().any(|fact| {
+            matches!(fact, CompilerArchitectureFact::Item { item_id: current, .. } if current == item_id)
+        })
+    };
+
+    for expression in ["pure(7)", "filesystem()"] {
+        let (span_id, call) = call_at(expression);
+        let CompilerArchitectureFact::Call {
+            caller_item_id, callee_item_id: Some(callee), resolved_definition: Some(definition),
+            dispatch: DispatchKind::Static, ..
+        } = call else {
+            panic!("concrete closure call {expression} was not compiler-resolved: {call:#?}");
+        };
+        assert!(definition.contains("closure"), "unexpected closure body: {definition}");
+        assert!(item_exists(callee), "closure call has no exact local callee item");
+        assert!(!unknown_at(span_id, caller_item_id, UnknownFactKind::UnresolvedDefinition));
+    }
+
+    let (direct_span, direct_call) = call_at("direct_fn(output)");
+    let CompilerArchitectureFact::Call {
+        caller_item_id, callee_item_id: Some(callee), resolved_definition: Some(definition),
+        dispatch: DispatchKind::Static, ..
+    } = direct_call else {
+        panic!("local function item call was not compiler-resolved: {direct_call:#?}");
+    };
+    assert_eq!(definition, "typed_calls_and_boundaries::direct");
+    assert!(item_exists(callee), "local function item call has no callee item");
+    assert!(!unknown_at(direct_span, caller_item_id, UnknownFactKind::UnresolvedDefinition));
+
+    let (_, pure_call) = call_at("pure(7)");
+    let CompilerArchitectureFact::Call { callee_item_id: Some(pure_owner), .. } = pure_call else {
+        unreachable!("checked concrete pure closure above")
+    };
+    assert!(!shard.facts.iter().any(|fact| {
+        matches!(fact, CompilerArchitectureFact::Effect { caller_item_id, .. } if caller_item_id == pure_owner)
+    }), "pure closure acquired an unrelated capability");
+
+    let (_, filesystem_call) = call_at("filesystem()");
+    let CompilerArchitectureFact::Call { callee_item_id: Some(filesystem_owner), .. } = filesystem_call else {
+        unreachable!("checked concrete filesystem closure above")
+    };
+    let (read_span, read_call) = call_at("std::fs::read(\"octet-fixture-never-executed\")");
+    let CompilerArchitectureFact::Call {
+        caller_item_id: read_owner, resolved_definition: Some(read_definition), ..
+    } = read_call else {
+        panic!("filesystem primitive call not resolved: {read_call:#?}");
+    };
+    assert_eq!(read_owner, filesystem_owner, "filesystem effect belongs to a different closure");
+    assert!(shard.facts.iter().any(|fact| {
+        matches!(fact, CompilerArchitectureFact::Effect {
+            caller_item_id, capability_family: CapabilityFamily::Filesystem,
+            primitive_definition, span_id, ..
+        } if caller_item_id == filesystem_owner
+            && primitive_definition == read_definition && span_id == read_span)
+    }), "effectful closure lost the compiler-resolved filesystem effect");
+
+    let (constructor_span, constructor_call) = call_at("Self(value)");
+    let CompilerArchitectureFact::Call {
+        caller_item_id, callee_item_id: None, resolved_definition: Some(definition),
+        dispatch: DispatchKind::Static, ..
+    } = constructor_call else {
+        panic!("tuple constructor call was not compiler-resolved: {constructor_call:#?}");
+    };
+    assert!(shard.facts.iter().any(|fact| {
+        matches!(fact, CompilerArchitectureFact::Constructor {
+            constructor_definition: Some(current), span_id, ..
+        } if current == definition && span_id == constructor_span)
+    }), "tuple constructor result fact does not join its exact constructor definition");
+    assert!(!unknown_at(constructor_span, caller_item_id, UnknownFactKind::UnresolvedDefinition));
+
+    for expression in [
+        "generic(output)",
+        "dynamic(output)",
+        "pointer(output)",
+        "STORED_FUNCTION(output)",
+        "STORED_STATIC_FUNCTION(output)",
+    ] {
+        let (span_id, call) = call_at(expression);
+        let CompilerArchitectureFact::Call {
+            caller_item_id, callee_item_id: None, resolved_definition: None,
+            dispatch: DispatchKind::Unknown, ..
+        } = call else {
+            panic!("indirect call {expression} was incorrectly resolved: {call:#?}");
+        };
+        assert!(unknown_at(span_id, caller_item_id, UnknownFactKind::UnresolvedDefinition),
+            "indirect call {expression} was not blocked at its own compiler span");
+    }
+    let (dynamic_span, dynamic_call) = call_at("port.invoke()");
+    let CompilerArchitectureFact::Call {
+        caller_item_id, dispatch: DispatchKind::Dynamic, ..
+    } = dynamic_call else {
+        panic!("trait-object call lost dynamic dispatch: {dynamic_call:#?}");
+    };
+    assert!(unknown_at(dynamic_span, caller_item_id, UnknownFactKind::DynamicDispatch));
+    let (trait_span, trait_call) = call_at("generic_port.invoke()");
+    let CompilerArchitectureFact::Call {
+        caller_item_id, dispatch: DispatchKind::Trait, ..
+    } = trait_call else {
+        panic!("generic trait call lost unresolved trait dispatch: {trait_call:#?}");
+    };
+    assert!(unknown_at(trait_span, caller_item_id, UnknownFactKind::AmbiguousTraitDispatch));
+    assert!(!shard.unknowns.iter().any(|unknown| unknown.kind == UnknownFactKind::MissingBody),
+        "ordinary required trait declarations were misclassified as missing bodies");
+}
