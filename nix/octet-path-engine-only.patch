+        assert!(paths.normalize(Some(id), "generated/virtual.rs").unwrap_err().contains("missing"));
+        let spanless = build_finding(
+            1,
+            &json!({
+                "target": {"name": "root-package"},
+                "message": {"message": "compiler emitted an unspanned error", "level": "error", "spans": []}
+            }),
+            &crate::output::UNKNOWN_LINT_META,
+            "compiler_error",
+            "fixture-hash",
+            false,
+            &paths,
+        )
+        .expect("spanless compiler diagnostic is not falsely treated as a file");
+        assert_eq!(spanless.file, "unknown");
+        assert_eq!(spanless.severity, "error");
+        assert!(spanless.message.contains("unspanned error"));
+        assert_eq!(paths.normalize(Some(id), "src/../Cargo.toml").expect("root-package parent path"), "Cargo.toml");
+        assert!(paths.normalize(Some(id), "../Cargo.toml").is_err());
+    }
