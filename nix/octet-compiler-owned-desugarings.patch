 // These compiler passes synthesize code, not macro invocations. Keep their expansion
 // facts and all generated calls/effects, but do not require a nonexistent macro DefId.
+// The named desugarings have the same property: `?`, `for` and range syntax are
+// rewritten by the compiler with no user macro definition. The rewrite's generated
+// calls and effects are still collected from the expanded HIR, so this suppresses
+// only the missing-DefId unknown, not the effect facts. Keep this list explicit:
+// an unlisted desugaring remains unknown until its expansion is reviewed.
 // Every other definition-less expansion stays unknown.
 fn compiler_owned_expansion(kind: ExpnKind) -> bool {
-    matches!(kind, ExpnKind::AstPass(AstPass::StdImports | AstPass::TestHarness | AstPass::ProcMacroHarness))
+    matches!(
+        kind,
+        ExpnKind::AstPass(AstPass::StdImports | AstPass::TestHarness | AstPass::ProcMacroHarness)
+            | ExpnKind::Desugaring(
+                DesugaringKind::QuestionMark | DesugaringKind::ForLoop | DesugaringKind::RangeExpr
+            )
+    )
 }
 
