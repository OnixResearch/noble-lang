        "nested": {
          "contract": "head-of-nonempty-nested: input (xs (List (List I64))), requires (not (is-nil (in xs))), ensures true",
          "subject": "[ [ nil ] [ drop ] list.case ]",
          "argument": "nil dup 0 swap cons drop nil cons"
        }
      },
      "expected": {
        "stage": "applicability",
        "outcome": "reject-empty-accept-nonempty-with-the-session-preserved",
        "outcomes": [
          { "argument": "nil dup 0 swap cons drop", "outcome": "precondition-reject", "output": "1", "candidate_body_started": false },
          { "argument": "-9223372036854775808 nil cons", "outcome": "certified-invocation", "output": "-9223372036854775808" },
          { "argument": "7 8 nil cons cons", "outcome": "certified-invocation", "output": "7" }
        ],
        "nested": { "outcome": "certified-invocation", "output_type": "List", "output_items": 0 },
        "session_preserved": true,
        "tail_preserved": true,
        "guard_template_set_version": 2,
